def cell_install_binary_shared_root(base, switches):
    problems = []
    world = SelftestWorld(base, "binary", remote_configuration(), switches, ssh_exit=5)
    shared = os.path.join(world.root, "shared")
    outside = os.path.realpath(world.write("outside/prune-server", "fake binary\n"))
    inside = os.path.realpath(world.write("shared/build/prune-server", "fake binary\n"))
    world.write_configuration(remote_configuration() + [(SHARED_ROOTS_KEY, shared)])
    expect_refused(problems, world, world.run(["install", "--binary", outside]), ["install", "--binary", outside], [SHARED_ROOTS_KEY])
    code, _, error = world.run(["install", "--binary", inside])
    expect(problems, code == 5, f"共享根下的 --binary 该转去、带回对端的 5，退了 {code}：{error.strip()}")
    calls = world.ssh_calls()
    expect(problems, len(calls) == 1 and remote_words(calls[0]) == expected_remote_words(["install", "--binary", inside]),
           f"远端命令该是 {expected_remote_words(['install', '--binary', inside])}，fake-ssh 收到 {calls}")
    return problems


def cell_watch_forwarded_streams_lines(base, switches):
    world = SelftestWorld(base, "watch-stream", remote_configuration(), switches,
                          ssh_exit=1, ssh_delay=SELFTEST_STREAM_GAP_SECONDS)
    process = subprocess.Popen(world.command(["watch"]), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               env=world.environment())
    arrivals = []
    error_lines = []
    error_reader = threading.Thread(target=lambda: error_lines.extend(process.stderr), daemon=True)
    error_reader.start()
    for line in process.stdout:
        arrivals.append((time.monotonic(), line.decode("utf-8", "replace").rstrip("\n")))
    try:
        code = process.wait(timeout=SELFTEST_RUN_SECONDS)
    except subprocess.TimeoutExpired:
        process.kill()
        code = None
    ended = time.monotonic()
    error_reader.join(timeout=5)
    problems = []
    expect(problems, code == 1, f"watch 该带回对端的 1，退了 {code}：{b''.join(error_lines).decode('utf-8', 'replace').strip()}")
    first = [moment for moment, line in arrivals if line == FAKE_REMOTE_FIRST]
    expect(problems, [line for _, line in arrivals if line in (FAKE_REMOTE_FIRST, FAKE_REMOTE_LAST)] == [FAKE_REMOTE_FIRST, FAKE_REMOTE_LAST],
           f"对端的两行该先后都到，到的是 {[line for _, line in arrivals]}")
    if first:
        expect(problems, ended - first[0] >= 1.0, f"头一行在退出前 {ended - first[0]:.2f} 秒才到（对端隔 {SELFTEST_STREAM_GAP_SECONDS} 秒打下一行），没按行转打")
    calls = world.ssh_calls()
    expect(problems, len(calls) == 1 and "-n" not in calls[0] and "ServerAliveInterval=15" in calls[0],
           f"watch 的 ssh 不带 -n、带 ServerAliveInterval=15，fake-ssh 收到 {calls}")
    return problems


def cell_ssh_failure_reported(base, switches):
    world = SelftestWorld(base, "ssh-failure", remote_configuration(), switches, ssh_exit=SSH_FAILURE_EXIT)
    problems = []
    code, _, error = world.run(["watch"])
    expect(problems, code == 1 and "服务不通" in error, f"watch 的 ssh 退 255 该报服务不通、退 1，退了 {code}：{error.strip()}")
    code, _, error = world.run(["stop"])
    expect(problems, code == RUN_CONDITION_EXIT and "ssh -o BatchMode=yes" in error,
           f"stop 的 ssh 退 255 该退 {RUN_CONDITION_EXIT}、出路写 ssh 怎么核，退了 {code}：{error.strip()}")
    return problems


def cell_forwarded_watch_exits_on_hangup(base, switches):
    world = SelftestWorld(base, "hangup", host_configuration(LOCAL_ADDRESS), switches, serving=True)
    process = subprocess.Popen(world.command(["watch"]), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               env=world.environment({FORWARDED_VARIABLE: "1"}))
    problems = []
    time.sleep(SELFTEST_STREAM_GAP_SECONDS)
    if process.poll() is not None:
        output, error = process.communicate()
        return [f"转来的 watch 在单元在跑、服务通时就退了 {process.returncode}：{output.decode('utf-8', 'replace').strip()} {error.decode('utf-8', 'replace').strip()}"]
    try:
        # 不先自己 close()：communicate 没给 input 时会关标准输入，先关了它再 flush 会抛 ValueError
        output, error = process.communicate(timeout=SELFTEST_HANGUP_SECONDS)
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        return [f"关了标准输入 {SELFTEST_HANGUP_SECONDS} 秒还没退"]
    text = error.decode("utf-8", "replace")
    expect(problems, process.returncode == 1 and "断了" in text, f"关了标准输入该报那一端断了、退 1，退了 {process.returncode}：{text.strip()}")
    return problems


def file_text(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except FileNotFoundError:
        return ""


def cell_install_enables_restarting_unit(base, switches):
    """install 写出的单元带 Restart=always 与不超过上限的 RestartSec，只 start、不 enable（开机不自起），单元里没有 [Install]。"""
    world = SelftestWorld(base, "install-restart", host_configuration(LOCAL_ADDRESS), switches, recording=True)
    code, output, error = world.run(["install"])
    problems = []
    expect(problems, code == 0, f"install 退 {code}，该退 0；标准错误：{error.strip()}；标准输出末尾：{output.strip()[-300:]}")
    unit_lines = file_text(os.path.join(world.root, "systemd", UNIT_NAME)).splitlines()
    expect(problems, "Restart=always" in unit_lines, f"单元里没有 Restart=always：{unit_lines}")
    restart = [line[len("RestartSec="):] for line in unit_lines if line.startswith("RestartSec=")]
    expect(problems, len(restart) == 1 and restart[0].isdigit() and 0 < int(restart[0]) <= RESTART_SECONDS_CEILING,
           f"单元该有一行 RestartSec=<1 到 {RESTART_SECONDS_CEILING} 的整秒数>，有的是 {restart}")
    calls = file_text(os.path.join(world.root, "fake", "systemctl-calls.log")).splitlines()
    start_line, enable_line = f"--user start {UNIT_NAME}", f"--user enable {UNIT_NAME}"
    expect(problems, start_line in calls and enable_line not in calls, f"install 该只 start、不 enable（开机不自起），systemctl 的调用：{calls}")
    expect(problems, "[Install]" not in unit_lines, f"单元里不该有 [Install]（开机不自起）：{unit_lines}")
    return problems


def cell_stop_stays_stopped(base, switches):
    """stop 之后隔一阵再回读仍 inactive 退 0；假 systemctl 在 stop 之后又把单元拉起时 stop 退 1。"""
    problems = []
    for restarted in (False, True):
        world = SelftestWorld(base, "stop-stays", host_configuration(LOCAL_ADDRESS), switches, recording=True)
        world.write("fake/unit-state", "active\n")
        if restarted:
            world.write("fake/restarted-after-stop", "")
        code, output, error = world.run(["stop"])
        calls = file_text(os.path.join(world.root, "fake", "systemctl-calls.log")).splitlines()
        expect(problems, f"--user stop {UNIT_NAME}" in calls and not any(" kill " in f" {line} " or " disable " in f" {line} " for line in calls),
               f"stop 该用 systemctl stop（不 kill、不 disable），systemctl 的调用：{calls}")
        if restarted:
            expect(problems, code == 1 and "又被拉起" in error, f"stop 之后单元又被拉起时 stop 该退 1、说「又被拉起」，退了 {code}：{error.strip()}")
        else:
            is_active_after_stop = calls[calls.index(f"--user stop {UNIT_NAME}"):].count(f"--user is-active {UNIT_NAME}") if f"--user stop {UNIT_NAME}" in calls else 0
            expect(problems, code == 0 and "没被拉起" in output, f"stop 该退 0、说「没被拉起」，退了 {code}：{output.strip()[-300:]} {error.strip()}")
            expect(problems, is_active_after_stop >= 2, f"stop 之后该回读 is-active 两次（立刻一次、隔一阵一次），回读了 {is_active_after_stop} 次：{calls}")
    return problems


def cell_stop_refuses_unreadable_cgroup(base, switches):
    """systemctl show 问不到 cgroup 时 stop 退 1、点名读不到（读不到不能证明为空，不管 cgroup.procs 里还有没有进程）；
    show 好时 cgroup.procs 里还有进程退 1、没有退 0。"""
    problems = []
    for show_fails, leftover in ((True, True), (True, False), (False, True), (False, False)):
        label = f"show {'失败' if show_fails else '好'}、cgroup.procs {'还有进程' if leftover else '为空'}"
        world = SelftestWorld(base, "stop-cgroup", host_configuration(LOCAL_ADDRESS), switches, recording=True)
        world.write("fake/unit-state", "active\n")
        if show_fails:
            world.write("fake/show-exit", "1\n")
        if leftover:
            world.write("fake/stop-leaves-process", "")
        code, output, error = world.run(["stop"])
        if show_fails or leftover:
            expect(problems, code == 1, f"{label}：stop 该退 1，退了 {code}；标准输出末尾：{output.strip()[-200:]}")
            expect(problems, "cgroup 里没有进程" not in output, f"{label}：不该打「cgroup 里没有进程」：{output.strip()[-200:]}")
        else:
            expect(problems, code == 0 and "cgroup 里没有进程" in output, f"{label}：stop 该退 0、说「cgroup 里没有进程」，退了 {code}：{output.strip()[-200:]} {error.strip()}")
        if show_fails:
            expect(problems, "读不到" in error and "systemctl show" in error, f"{label}：该说 cgroup 读不到、点名 systemctl show，标准错误：{error.strip()}")
        elif leftover:
            expect(problems, "1 个" in error, f"{label}：该说 cgroup 里进程 1 个，标准错误：{error.strip()}")
    return problems


def cell_install_build_hint_saves_binary(base, switches):
    """缺二进制时 install 退 78，编法提示是同一条提交命令里编完就把二进制拷到共享根（编译目录任务一结束就被服务删，提示不叫人到编译目录取）。"""
    world = SelftestWorld(base, "build-hint", host_configuration(LOCAL_ADDRESS), switches)
    code, _, error = world.run(["install"])
    problems = []
    expect(problems, code == RUN_CONDITION_EXIT, f"二进制没装、没给 --binary 时 install 该退 {RUN_CONDITION_EXIT}，退了 {code}：{error.strip()}")
    expect(problems, "cargo build --release --offline --bin prune-server && cp " in error and "&& mv " in error,
           f"编法提示该是 cargo build 之后同一条命令里 && cp 到共享根再 && mv，标准错误：{error.strip()}")
    expect(problems, SHARED_ROOTS_KEY in error, f"编法提示该点名共享根 {SHARED_ROOTS_KEY}，标准错误：{error.strip()}")
    expect(problems, "<目录>/release/prune-server" not in error, f"编法提示不该叫人到编译目录取二进制，标准错误：{error.strip()}")
    return problems


def cell_watch_accepts_transitional_states(base, switches):
    """is-active 打 activating、reloading、deactivating 时 watch 不报单元不在跑（一直查、不退）；打 inactive 时报并退 1。"""
    problems = []
    running = []
    try:
        for state in ("activating", "reloading", "deactivating"):
            world = SelftestWorld(base, f"watch-{state}", host_configuration(LOCAL_ADDRESS), switches, recording=True)
            world.write("fake/unit-state", f"{state}\n")
            running.append((state, subprocess.Popen(world.command(["watch"]), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                                    stderr=subprocess.PIPE, env=world.environment())))
        stopped_world = SelftestWorld(base, "watch-inactive", host_configuration(LOCAL_ADDRESS), switches, recording=True)
        stopped_world.write("fake/unit-state", "inactive\n")
        code, output, error = stopped_world.run(["watch"])
        expect(problems, code == 1 and "不在跑" in output, f"is-active 打 inactive 时 watch 该报单元不在跑、退 1，退了 {code}：{output.strip()[-200:]} {error.strip()}")
        time.sleep(SELFTEST_STREAM_GAP_SECONDS)
        for state, process in running:
            if process.poll() is not None:
                expect(problems, False, f"is-active 打 {state} 时 watch 不该退，退了 {process.returncode}：{process.stdout.read().decode('utf-8', 'replace').strip()[-200:]}")
    finally:
        for _, process in running:
            if process.poll() is None:
                process.kill()
            process.communicate()
    return problems


def drop_world(base, cell, switches, unit_state):
    """drop-oversized-values 那几格的自证根：单元状态是 unit_state，单元文件的 ExecStart 指 <根>/installed/prune-server、--state-directory 指 <根>/unit-state
    （都不是 Paths 的缺省位置，证明是从单元文件取的）。"""
    world = SelftestWorld(base, cell, host_configuration(LOCAL_ADDRESS), switches, recording=True)
    world.write("installed/prune-server", FAKE_BINARY_RECORDING, executable=True)
    world.write("fake/unit-state", f"{unit_state}\n")
    world.write(f"systemd/{UNIT_NAME}", "[Service]\n"
                f"ExecStart={world.root}/installed/prune-server serve --spawned-by-parent --socket {world.root}/run/server.sock "
                f"--state-directory {world.root}/unit-state --multi-host-configuration {world.root}/multi-host.env\n")
    return world


def cell_drop_oversized_refused_while_running(base, switches):
    world = drop_world(base, "drop-running", switches, "active")
    code, _, error = world.run(["drop-oversized-values", "--dry-run"])
    problems = []
    expect(problems, code == RUN_CONDITION_EXIT and "control stop" in error,
           f"单元在跑时 drop-oversized-values 该退 {RUN_CONDITION_EXIT}、出路写 control stop，退了 {code}：{error.strip()}")
    calls = file_text(os.path.join(world.root, "fake", "binary-calls.log"))
    expect(problems, not calls, f"单元在跑时不该起二进制，它收到了：{calls.strip()}")
    return problems


def cell_drop_oversized_runs_installed_binary(base, switches):
    world = drop_world(base, "drop-stopped", switches, "inactive")
    problems = []
    state_directory = os.path.join(world.root, "unit-state")
    for arguments, expected in ((["drop-oversized-values", "--dry-run"], f"drop-oversized-values --state-directory {state_directory} --dry-run"),
                                (["drop-oversized-values"], f"drop-oversized-values --state-directory {state_directory}")):
        before = file_text(os.path.join(world.root, "fake", "binary-calls.log")).splitlines()
        code, output, error = world.run(arguments)
        received = file_text(os.path.join(world.root, "fake", "binary-calls.log")).splitlines()[len(before):]
        expect(problems, code == FAKE_DROP_EXIT, f"{' '.join(arguments)} 该退二进制的 {FAKE_DROP_EXIT}，退了 {code}：{error.strip()}")
        expect(problems, FAKE_DROP_LINE in output, f"{' '.join(arguments)} 该原样打出二进制的「{FAKE_DROP_LINE}」：{output.strip()[-300:]}")
        expect(problems, received == [expected], f"{' '.join(arguments)} 起二进制的参数该是「{expected}」，收到 {received}")
    return problems


def cell_drop_oversized_forwarded_over_ssh(base, switches):
    world = SelftestWorld(base, "drop-remote", remote_configuration(), switches, ssh_exit=5)
    code, _, error = world.run(["drop-oversized-values", "--dry-run"])
    problems = []
