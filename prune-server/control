           f"该经 ssh 到 {REMOTE_ADDRESS} 起 {expected}，fake-ssh 收到 {calls}")
    return problems


SELFTEST_CELLS = {
    "local-address-runs-here": cell_local_address_runs_here,
    "remote-address-forwarded-over-ssh": cell_remote_address_forwarded_over_ssh,
    "hosts-missing-refused": cell_hosts_missing_refused,
    "address-outside-hosts-refused": cell_address_outside_hosts_refused,
    "shared-judge-refusal-stops-here": cell_shared_judge_refusal_stops_here,
    "address-missing-refused": cell_address_missing_refused,
    "forwarded-loop-refused": cell_forwarded_loop_refused,
    "install-binary-shared-root": cell_install_binary_shared_root,
    "watch-forwarded-streams-lines": cell_watch_forwarded_streams_lines,
    "ssh-failure-reported": cell_ssh_failure_reported,
    "forwarded-watch-exits-on-hangup": cell_forwarded_watch_exits_on_hangup,
    "install-enables-restarting-unit": cell_install_enables_restarting_unit,
    "stop-stays-stopped": cell_stop_stays_stopped,
    "drop-oversized-refused-while-running": cell_drop_oversized_refused_while_running,
    "drop-oversized-runs-installed-binary": cell_drop_oversized_runs_installed_binary,
    "drop-oversized-forwarded-over-ssh": cell_drop_oversized_forwarded_over_ssh,
    "stop-refuses-unreadable-cgroup": cell_stop_refuses_unreadable_cgroup,
    "install-build-hint-saves-binary": cell_install_build_hint_saves_binary,
    "watch-accepts-transitional-states": cell_watch_accepts_transitional_states,
}


def selftest():
    if os.environ.get(BREAK_VARIABLE):
        return fail(f"{BREAK_VARIABLE} 管的是 prune-server --selftest 起的那几格，这份文件自己的自证不认", f"不设 {BREAK_VARIABLE} 再跑；弄坏这里的判法用 {CONTROL_BREAK_VARIABLE}", USAGE_EXIT)
    switches = [item.strip() for item in os.environ.get(CONTROL_BREAK_VARIABLE, "").split(",") if item.strip()]
    unknown = [item for item in switches if item not in SELFTEST_SWITCH_CELLS]
    if unknown:
        return fail(f"{CONTROL_BREAK_VARIABLE} 里认不出 {'、'.join(unknown)}", f"认得的：{'、'.join(SELFTEST_SWITCH_CELLS)}（文件头「自己的自证」）", USAGE_EXIT)
    dangling = sorted({cell for cells in SELFTEST_SWITCH_CELLS.values() for cell in cells} - set(SELFTEST_CELLS))
    if dangling:
        return fail(f"开关表点名的格 {'、'.join(dangling)} 不在格表里", "改 SELFTEST_SWITCH_CELLS 与 SELFTEST_CELLS 对上", 1)
    base = os.path.realpath(tempfile.mkdtemp(prefix="prune-server-control-selftest-"))
    results = {}
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(SELFTEST_CELLS)) as pool:
            futures = {name: pool.submit(function, base, [item for item in switches if name in SELFTEST_SWITCH_CELLS[item]])
                       for name, function in SELFTEST_CELLS.items()}
            for name, future in futures.items():
                try:
                    results[name] = future.result()
                except Exception as error:   # 一格自己崩了算红，不吃掉
                    results[name] = [f"这一格自己崩了：{type(error).__name__}: {error}"]
    finally:
        shutil.rmtree(base, ignore_errors=True)
    failed = [name for name in SELFTEST_CELLS if results.get(name) != []]
    for name in SELFTEST_CELLS:
        if name in failed:
            print(f"  ✗ {name}：{'；'.join(results.get(name) or ['没有结果'])}", flush=True)   # gate-lint:detail
        else:
            say(f"  ✓ {name}")
    say(f"{SELFTEST_SUMMARY_PREFIX} cells={len(SELFTEST_CELLS)} failed={len(failed)} break={','.join(switches) or '-'}")
    return 1 if failed or len(results) != len(SELFTEST_CELLS) else 0


def main(arguments):
    if arguments == ["--selftest"]:
        return selftest()
    for variable in (BREAK_VARIABLE, CONTROL_BREAK_VARIABLE):
        if os.environ.get(variable) and not os.environ.get(SELFTEST_ROOT_VARIABLE):
            return fail(f"{variable} 只在自证里认（设了 {SELFTEST_ROOT_VARIABLE} 时，或 --selftest）", f"不设 {variable} 再跑", USAGE_EXIT)
    here, forwarded_arguments = parse_arguments(arguments)
    if here is None:
        return fail(f"认不出「{' '.join(arguments)}」",
                    "写成 python3 prune-server/control install [--dry-run] [--binary <编好的 prune-server>] | start | stop | check | watch"
                    " | drop-oversized-values [--dry-run] | --selftest", USAGE_EXIT)
    paths = Paths()
    place, value = service_host(paths)
    if place == "refused":
        return value
    if place == "there":
        return forward(paths, value, forwarded_arguments)
    return here()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
