#!/usr/bin/env bash
# crash-point-replay 分片样本的假 cargo（样本档）：-V 打版本。每起一遍 test 往同目录的 cargo-calls 追加一行收到的参数（门禁照它打「到哪一步为止 cargo test 起了几遍」），
#   同目录 binaries/ 里的假测试二进制转过来的那几遍（环境里有 SAMPLE_BINARY_RUN）不记。
#   带 --no-run（计划那一步预先编、或片里自己编）：每个 --test 目标打一行进度，binaries/<目标> 在且可执行才照真 cargo 打「Executable tests/<目标>.rs (<路径>)」，退 0。
#   登记的崩溃枚举用例那一趟（不带 --lib、最后一个 --test 的目标有 cases/<目标>.log）：打一行进度再打那一份日志（case_log），退 0；
#   别的一律打 cases/default-pass.log、退出码照 cases/default-pass.exit（包里按条复用那一趟不该起：起了就判红）。
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# case_log <日志> <测试目标>：库里的块用 $here/.judged-blocks/<测试目标> 这个记号模拟。环境里有 SINGLEFS_CRASH_AMPLIFICATION_SHARE 的是一片（引擎判这一片领的块、写进库）：
#   日志原样打、留下记号；没有的是核账（整份 0/1）：记号在就是各片判过的块都从库里读到，CRASH_CASE_BLOCKS 那一行的 fresh 并进 reused、fresh 写 0；记号不在原样打
case_log() {
  if [[ -n "${SINGLEFS_CRASH_AMPLIFICATION_SHARE:-}" ]]; then
    mkdir -p "$here/.judged-blocks" && : > "$here/.judged-blocks/$2"
    cat "$1"
  elif [[ -f "$here/.judged-blocks/$2" ]]; then
    awk '/^CRASH_CASE_BLOCKS / { reused = fresh = 0; for (i = 1; i <= NF; i++) { if ($i ~ /^reused=/) { reused = substr($i, 8) + 0; reused_at = i } else if ($i ~ /^fresh=/) { fresh = substr($i, 7) + 0; fresh_at = i } } $reused_at = "reused=" (reused + fresh); $fresh_at = "fresh=0" } { print }' "$1"
  else
    cat "$1"
  fi
}
if [[ "${1:-}" == -V ]]; then echo "cargo 0.0.0-crash-point-replay-sample"; exit 0; fi
[[ "${1:-}" == test ]] || { echo "样本的假 cargo 只认 -V 与 test：$*"; exit 101; }
[[ -n "${SAMPLE_BINARY_RUN:-}" ]] || printf '%s\n' "$*" >>"$here/cargo-calls"
if [[ " $* " == *" --no-run "* ]]; then
  previous_word=""
  for word in "$@"; do
    if [[ "$previous_word" == --test ]]; then
      echo "CRASH_POINT_REPLAY_PROGRESS sample-cargo-build: target=$word"
      [[ ! -x "$here/binaries/$word" ]] || echo "  Executable tests/$word.rs ($here/binaries/$word)"
    fi
    previous_word="$word"
  done
  exit 0
fi
last_test=""
previous_word=""
for word in "$@"; do
  if [[ "$previous_word" == --test ]]; then last_test="$word"; fi
  previous_word="$word"
done
if [[ -n "$last_test" && " $* " != *" --lib "* && -f "$here/cases/$last_test.log" ]]; then
  echo "CRASH_POINT_REPLAY_PROGRESS sample-cargo-case: target=$last_test share=[${SINGLEFS_CRASH_AMPLIFICATION_SHARE-unset}] through-binary=[${SAMPLE_BINARY_RUN:-no}]"
  case_log "$here/cases/$last_test.log" "$last_test"
  exit 0
fi
echo "CRASH_POINT_REPLAY_PROGRESS sample-cargo-arguments: $*"
cat "$here/cases/default-pass.log"
exit "$(cat "$here/cases/default-pass.exit" 2>/dev/null || echo 0)"
