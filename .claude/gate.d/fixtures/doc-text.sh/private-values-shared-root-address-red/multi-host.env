# 样本：假的多机私有配置。所有值都是编的，不对应任何真机器。
HOSTS=172.31.250.199 172.31.250.188
SLICE_MEMORY_CAP_BY_HOST=172.31.250.199=60G 172.31.250.188=60G
ENABLE_ACROSS_MACHINES=1
ENABLE_GPU=0
# 两台同一绝对路径的共享根（冒号隔开）与数据根（落在其中一段下）
NFS_SHARED_ROOTS=/srv/sample-shared/data-root:/srv/sample-shared/code-tree
SHARED_DATA_ROOT=/srv/sample-shared/data-root
