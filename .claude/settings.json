{
  "permissions": {
    "allow": [
      "Bash(bash scripts/devices/vm-kernel.sh*)",
      "Bash(scripts/devices/vm-kernel.sh*)",
      "Bash(bash scripts/devices/vm-bench.sh*)",
      "Bash(scripts/devices/vm-bench.sh*)",
      "Bash(bash scripts/devices/vm-geom.sh*)",
      "Bash(scripts/devices/vm-geom.sh*)",
      "Bash(bash .claude/scripts/qemu.sh*)",
      "Bash(.claude/scripts/qemu.sh*)",
      "Bash(GATE_QEMU=1 bash .claude/scripts/gate.sh*)",
      "Bash(qemu-system-x86_64 *)",
      "Bash(qemu-img *)",
      "Bash(kvm *)",
      "Bash(lsblk*)",
      "Bash(blkid*)",
      "Bash(findmnt*)",
      "Bash(losetup -a*)",
      "Bash(losetup -l*)",
      "Bash(truncate *)",
      "Bash(fallocate *)",
      "Bash(dd *)",
      "Bash(parted *)",
      "Bash(sfdisk *)",
      "Bash(sgdisk *)",
      "Bash(fdisk *)",
      "Bash(wipefs *)",
      "Bash(mkfs.ext4 *)",
      "Bash(sudo -n losetup *)",
      "Bash(sudo -n dmsetup *)",
      "Bash(sudo -n mount /dev/loop*)",
      "Bash(sudo -n mount -o * /dev/loop*)",
      "Bash(sudo -n mount /dev/mapper/*)",
      "Bash(sudo -n mount -o * /dev/mapper/*)",
      "Bash(sudo -n umount /tmp/*)",
      "Bash(sudo -n umount /dev/loop*)",
      "Bash(sudo -n umount /dev/mapper/*)",
      "Bash(python3 .claude/singlefs-ai-sop/scripts/proc.py stop *)",
      "Bash(task-server/task submit -- python3 scripts/gate/hook-swap.py *)",
      "Bash(python3 scripts/kb/replace-once.py .claude/hooks/lib_project_code_runs.py *)",
      "Bash(python3 scripts/hosts/minimal-copy.py*)",
      "Bash(python3 scripts/hosts/lib_repository_copy.py entries*)"
    ],
    "deny": [
      "Bash(*losetup -D*)",
      "Bash(*losetup --detach-all*)",
      "Bash(*dmsetup remove_all*)",
      "Bash(*/dev/nvme0*)",
      "Bash(*/dev/disk/by-*)",
      "Bash(*udisksctl power-off*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/runner-dispatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/continuation-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/pattern-process-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-command-detector.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/project-code-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-scope-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/root-entry-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/write-guard.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask-user-claim-guard.sh"
          }
        ]
      },
      {
        "matcher": "CronCreate|ScheduleWakeup|RemoteTrigger|Skill|Monitor|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timer-only-remind-guard.sh"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/handback-scratch-check.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/handback-guard.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/completion-cleanup-guard.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/root-entry-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/borrowed-convention-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shared-index-stale-reminder.sh",
            "timeout": 40
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/root-entry-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/remind-rearm-stop-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/completion-cleanup-guard.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/singlefs-ai-sop/scripts/claude-hooks/handback-scratch-check.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/completion-cleanup-guard.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
