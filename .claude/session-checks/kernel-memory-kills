        library_specification = importlib.util.spec_from_file_location("lib_selftest_scratch", library_path)
        scratch = importlib.util.module_from_spec(library_specification)
        library_specification.loader.exec_module(scratch)
    except Exception as error:  # noqa: BLE001 —— 文件不在、语法错、导入时抛的都算读不到
        print(f"  ✗ 自检：{ITEM_NAME} 读不到共用的临时目录库 {library_path}（{error!r}）")
        print("    → 怎么办：恢复 .claude/hooks/lib_selftest_scratch.py，再跑 .claude/session-checks/kernel-memory-kills --selftest")
        return 1
    exit_code, problems = scratch.run_with_scratch(selftest_in, "kernel-memory-kills-selftest-", BROKEN_JUDGEMENT == "keepscratch",
                                                   SELFTEST_ROLE_VARIABLE, [sys.executable, os.path.realpath(__file__), "--selftest"])
    return scratch.merged_exit_code(exit_code, problems, ".claude/session-checks/kernel-memory-kills 的 selftest()", "KERNEL_MEMORY_KILLS_BREAK=keepscratch")


def refuse_break_outside_selftest(arguments):
    """弄坏开关只在自证里认：命令行不是单独一个 --selftest、也不是自证起的子进程（标记对得上）而 KERNEL_MEMORY_KILLS_BREAK 非空，读标准输入之前就退 2。"""
    if not BROKEN_JUDGEMENT or arguments == ["--selftest"] or os.environ.get(SELFTEST_MARK_VARIABLE) == SELFTEST_MARK_CONTENT:
        return None
    print(f"  ✗ {ITEM_NAME}：KERNEL_MEMORY_KILLS_BREAK={BROKEN_JUDGEMENT} 是弄坏开关，只在自证（{ITEM_NAME} --selftest）里认，平常跑设了就拒，这一次没补提示", file=sys.stderr)
    print(f"     → 怎么办：去掉 KERNEL_MEMORY_KILLS_BREAK 再跑；要证红就跑 KERNEL_MEMORY_KILLS_BREAK=<项> .claude/session-checks/{ITEM_NAME} --selftest", file=sys.stderr)
    return 2


def main(arguments):
    refused = refuse_break_outside_selftest(arguments)
    if refused is not None:
        return refused
    if arguments == ["--selftest"]:
        return selftest()
    return hook_main(sys.stdin.buffer.read())


if __name__ == "__main__":
    preflight(__file__)
    sys.exit(main(sys.argv[1:]))
