#!/usr/bin/env python3
# session-check-sources: startup resume
# session-check-timeout: 50
# admission: always Claude Code 每一次会话启动与恢复都要现读此刻的内核日志，上一次的结论不替这一次作保
# run-condition: command python3
"""会话检查项：启动与恢复时报近几小时内核因为内存不够杀过的进程，与显卡驱动报的显存不够。

登记在 .claude/session-checks/，由上游钩子 session-checks.sh 在 startup 与 resume 时起（rules/communication-discipline.md「会话启动与压缩之后的检测」）：
标准输入是钩子的 JSON，工作目录是项目根，退 0 的输出拼进上下文，退非 0 由上游报「没查成」并记一条检出。只报、不改任何东西。

近 KERNEL_MEMORY_KILLS_HOURS 小时（默认 12）里：
  内核因为内存不够杀过的进程：journalctl 里的 Killed process 行，每条写时间（UTC 与 JST）、进程号、进程名、anon-rss，整机 OOM 与内存上限（cgroup）里的分开列，外加一行「怎么办」。
    run-with-memory-cap.sh --selftest 故意造的（oom-kill 明细行里 task_memcg 带 singlefs_memory_selftest_）不算事故、不列。
    任务服务的内存上限里杀的编译进程不逐条列，只报一行个数：认的是同时满足的四样——不是整机 OOM、进程名是 rustc、oom-kill 明细行里 task_memcg 的末一段是
    singlefs-memory-cap-<…>.scope（task-server/attempt_runner.py 的 SCOPE_PREFIX 与 task_server_lib.py 的 MEMORY_CAP_SCOPE_PREFIX 给每条命令开的那种单元）、
    oom_memcg 与 task_memcg 是同一个 cgroup（撞的是这个单元自己的上限，服务对这种重来、上限乘 1.5）。认不出其中任何一样的（整机 OOM、别的进程名、别的 cgroup、
    撞的是外层 slice 的总上限、没有 oom-kill 明细行）照旧逐条列。
  显卡驱动报的显存不够：同一行既有 NVRM 又有 NV_ERR_NO_MEMORY 的行，按卡数次数、写头一次与末一次的时间，外加一行「怎么办」。
读不到内核日志（没有 journalctl、权限不够看不到内核日志、journalctl 出错或超时）报「没查成」，不当成没有 OOM、也不当成没撞显存。
近几小时按 journalctl _TRANSPORT=kernel 取（不用 -k：它只看这一次开机，卡死重启之后看不到死机之前那几行）。
别的 source（clear、compact）不报；标准输入不是 JSON 对象、判的时候抛异常退 1、stderr 一行写原因，上游报「没查成」。

  item 的退出码：0（有输出就拼进上下文）；1 输入或判的时候出错；2 平常跑设了弄坏开关。
  kernel-memory-kills --selftest  假 journalctl 放在临时目录的 PATH 最前面，喂造出来的内核日志；各格并行跑；弄坏开关见下，设着时自证必须判红

弄坏开关 KERNEL_MEMORY_KILLS_BREAK=<项>（只给 --selftest 证红用；平常跑设了就在读标准输入之前退 2、点名变量只在自证里认，自证起的子进程由 KERNEL_MEMORY_KILLS_SELFTEST_MARK 认），
打开后自证哪几格红（失败行「✗ 自检：<格名>：…」）：
  KERNEL_MEMORY_KILLS_BREAK=input-accepted  输入不是 JSON 对象也照常往下判、退 0
      「✗ 自检：坏 JSON 退 1 并点名原因」、「✗ 自检：JSON 数组退 1 并点名原因」
  KERNEL_MEMORY_KILLS_BREAK=exception-swallowed  判的时候抛的异常吞掉、退 0
      「✗ 自检：判的时候抛异常退 1 并点名原因」
  KERNEL_MEMORY_KILLS_BREAK=keepscratch  自证的临时目录走回 mkdtemp 不删
      「✗ 自检：通过那条路上临时目录没删」、「✗ 自检：red 那条路上临时目录没删」、「✗ 自检：crash 那条路上临时目录没删」
  KERNEL_MEMORY_KILLS_BREAK=skip-oom  内存 OOM 那一段整个不补
      「✗ 自检：startup 且近几小时有 OOM」、「✗ 自检：resume 且近几小时有 OOM」、「✗ 自检：杀得多时逐条列最大的、其余合计」、「✗ 自检：只有自检故意造的 OOM 不算事故」、
      「✗ 自检：看得到内核日志、没有 OOM」、「✗ 自检：只有显卡驱动报的显存不够」、「✗ 自检：内存 OOM 与显存不够一起」、「✗ 自检：权限不够看不到内核日志」、
      「✗ 自检：连一条内核消息都读不出」、「✗ 自检：重启之前那一次开机里的也读到」、「✗ 自检：journalctl 出错」、「✗ 自检：没有 journalctl」、
      「✗ 自检：任务服务的内存上限里杀的编译进程只报一行」、「✗ 自检：只有任务服务的编译进程时不叫人处置」、「✗ 自检：认不出落在服务单元里的照旧逐条列」
  KERNEL_MEMORY_KILLS_BREAK=unreadable-as-clean  读不到内核日志（权限不够、一条消息都读不出）也当成没有 OOM
      「✗ 自检：权限不够看不到内核日志」、「✗ 自检：连一条内核消息都读不出」
  KERNEL_MEMORY_KILLS_BREAK=count-selftest-kills  run-with-memory-cap.sh --selftest 故意造的 OOM 也算事故
      「✗ 自检：startup 且近几小时有 OOM」、「✗ 自检：resume 且近几小时有 OOM」、「✗ 自检：只有自检故意造的 OOM 不算事故」、「✗ 自检：内存 OOM 与显存不够一起」
  KERNEL_MEMORY_KILLS_BREAK=skip-gpu-oom  显卡驱动报的显存不够那一段不补
      「✗ 自检：只有显卡驱动报的显存不够」、「✗ 自检：内存 OOM 与显存不够一起」、「✗ 自检：重启之前那一次开机里的也读到」
  KERNEL_MEMORY_KILLS_BREAK=current-boot-only  近几小时只读这一次开机的内核日志（journalctl -k），不读重启之前那一次
      「✗ 自检：重启之前那一次开机里的也读到」
  KERNEL_MEMORY_KILLS_BREAK=service-compile-listed  任务服务的内存上限里杀的编译进程不折成一行、照旧逐条列
      「✗ 自检：任务服务的内存上限里杀的编译进程只报一行」、「✗ 自检：只有任务服务的编译进程时不叫人处置」
  KERNEL_MEMORY_KILLS_BREAK=any-process-folded  任务服务的内存上限里杀的进程不看进程名是不是 rustc，一概折成一行
      「✗ 自检：认不出落在服务单元里的照旧逐条列」
  KERNEL_MEMORY_KILLS_BREAK=any-cgroup-folded  rustc 不看 task_memcg 是不是任务服务开的单元，一概折成一行
      「✗ 自检：认不出落在服务单元里的照旧逐条列」
  KERNEL_MEMORY_KILLS_BREAK=slice-squeeze-folded  不比 oom_memcg 与 task_memcg，撞外层 slice 总上限被挤掉的 rustc 也折成一行
      「✗ 自检：认不出落在服务单元里的照旧逐条列」
"""
import concurrent.futures
import contextlib
import importlib.util
import io
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

HERE = os.path.dirname(os.path.realpath(__file__))
REPOSITORY = os.path.dirname(os.path.dirname(HERE))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(HERE, "..", "scripts"))
from project_preflight import preflight  # noqa: E402

ITEM_NAME = "kernel-memory-kills"
BROKEN_JUDGEMENT = os.environ.get("KERNEL_MEMORY_KILLS_BREAK", "")
DEFAULT_OOM_HOURS = 12        # 半天：会话夜里崩、第二天早上再开也罩得住，又不至于把前一天早已查清的 OOM 每次都翻出来
JOURNAL_TIMEOUT_SECONDS = 20  # journalctl 读大日志可能慢；超时就报没查成，不拖住会话启动
KILLS_LISTED_ONE_BY_ONE = 12  # 杀得多时逐条列 anon-rss 最大的这么多条，其余按进程名合计
REPORTED_SOURCES = ("startup", "resume")
KILLED_PROCESS_LINE = re.compile(
    r"^(?P<timestamp>\S+) \S+ kernel: (?P<kind>Memory cgroup out of memory|Out of memory)(?: \([^)]*\))?: "
    r"Killed process (?P<pid>\d+) \((?P<name>.*)\) total-vm:\d+kB, anon-rss:(?P<anon_rss_kibibytes>\d+)kB")
# oom-kill 明细行：带被杀进程所在的 cgroup（task_memcg）、撞的是哪个 cgroup 的上限（oom_memcg）与进程号，跟在 Killed process 行的前后
OOM_KILL_DETAIL_LINE = re.compile(r"kernel: oom-kill:constraint=\S*?task_memcg=(?P<memcg>[^,]+),task=[^,]+,pid=(?P<pid>\d+)")
OOM_MEMCG_FIELD = re.compile(r"[, ]oom_memcg=(?P<oom_memcg>[^,]+)")
# 显卡驱动报的显存不够：同一行既有 NVRM 又有 NV_ERR_NO_MEMORY（scripts/hosts/run-with-memory-cap.sh 命令退出之后认的是同一种行）
GPU_MEMORY_LINE = re.compile(r"^(?P<timestamp>\S+) \S+ kernel: NVRM: (?:(?P<gpu>GPU\d+) )?.*NV_ERR_NO_MEMORY")
SELFTEST_CGROUP_MARK = "singlefs_memory_selftest_"   # run-with-memory-cap.sh --selftest 给自己开的 slice 名；那里的 OOM 是自检故意造的
MEMORY_CAP_SCOPE_PREFIX = "singlefs-memory-cap-"      # 任务服务给每条命令开的内存上限单元的名字起头（task-server/attempt_runner.py 的 SCOPE_PREFIX）
SERVICE_COMPILER_NAME = "rustc"
# journalctl 看不到别人的日志时退 0、只在 stderr 给这句提示：不认它，读不到就会被当成「没有 OOM」
JOURNAL_PERMISSION_HINT = "not seeing messages from other users and the system"
TOKYO = ZoneInfo("Asia/Tokyo")
SELFTEST_MARK_VARIABLE = "KERNEL_MEMORY_KILLS_SELFTEST_MARK"
SELFTEST_MARK_CONTENT = "kernel-memory-kills --selftest 起的子进程"
SELFTEST_ROLE_VARIABLE = "KERNEL_MEMORY_KILLS_SELFTEST_ROLE"


def oom_hours():
    try:
        hours = float(os.environ.get("KERNEL_MEMORY_KILLS_HOURS", DEFAULT_OOM_HOURS))
    except ValueError:
        hours = DEFAULT_OOM_HOURS
    return hours if hours > 0 else DEFAULT_OOM_HOURS


def read_kernel_journal(hours):
    """(文本, None) 或 (None, 没查成的原因)。先确认看得到内核日志（最近一条内核消息读得出来），再读近 hours 小时的。"""
    if shutil.which("journalctl") is None:
        return None, "这台机器上没有 journalctl"
    try:
        probe = subprocess.run(["journalctl", "-k", "-n", "1", "--no-pager", "-q"], capture_output=True, text=True, timeout=JOURNAL_TIMEOUT_SECONDS)
        # 近几小时的内核消息按 _TRANSPORT=kernel 取、不用 -k：-k 隐含 -b（只看这一次开机），机器卡死重启之后会话开头就看不到死机之前那几小时
        recent_selector = ["-k"] if BROKEN_JUDGEMENT == "current-boot-only" else ["_TRANSPORT=kernel"]
        recent = subprocess.run(["journalctl", *recent_selector, "--since", f"-{hours:g}h", "--utc", "-o", "short-iso-precise", "--no-pager", "-q"],
                                capture_output=True, text=True, timeout=JOURNAL_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        return None, f"journalctl 过了 {JOURNAL_TIMEOUT_SECONDS} 秒没返回"
    except OSError as error:
        return None, f"journalctl 起不来（{error}）"
    for completed in (probe, recent):
        if completed.returncode != 0:
            return None, f"journalctl 退出码 {completed.returncode}：{completed.stderr.strip()[:200]}"
        if JOURNAL_PERMISSION_HINT in completed.stderr and BROKEN_JUDGEMENT != "unreadable-as-clean":
            return None, "权限不够，journalctl 看不到内核日志（要在 adm 或 systemd-journal 组里）"
    if not probe.stdout.strip() and BROKEN_JUDGEMENT != "unreadable-as-clean":
        return None, "journalctl -k 连最近一条内核消息都读不出来，看不到内核日志"
    return recent.stdout, None


def killed_processes(journal_text):
    memcg_by_pid = {}
    oom_memcg_by_pid = {}
    for line in journal_text.splitlines():
        detail = OOM_KILL_DETAIL_LINE.search(line)
        if detail:
            memcg_by_pid[detail.group("pid")] = detail.group("memcg")
            limit_field = OOM_MEMCG_FIELD.search(line)
            oom_memcg_by_pid[detail.group("pid")] = limit_field.group("oom_memcg") if limit_field else ""
    kills = []
    for line in journal_text.splitlines():
        matched = KILLED_PROCESS_LINE.match(line)
        if not matched:
            continue
        try:
            moment = datetime.fromisoformat(matched.group("timestamp")).astimezone(timezone.utc)
        except ValueError:
            continue
        memcg = memcg_by_pid.get(matched.group("pid"), "")
        kills.append({"moment": moment, "pid": matched.group("pid"), "name": matched.group("name"),
                      "anon_rss_kibibytes": int(matched.group("anon_rss_kibibytes")),
                      "whole_machine": matched.group("kind") == "Out of memory",
                      "memcg": memcg, "oom_memcg": oom_memcg_by_pid.get(matched.group("pid"), ""),
                      "selftest": SELFTEST_CGROUP_MARK in memcg and BROKEN_JUDGEMENT != "count-selftest-kills"})
    return kills


def folded_into_service_retry(kill):
    """任务服务的内存上限里杀的编译进程：不是整机 OOM、进程名是 rustc、task_memcg 的末一段是服务开的单元、oom_memcg 与 task_memcg 是同一个 cgroup
    （撞的是这个单元自己的上限，服务对这种重来、上限乘 1.5）。弄坏开关 service-compile-listed 下一概不折；any-process-folded 不看进程名；
    any-cgroup-folded 不看单元名；slice-squeeze-folded 不比 oom_memcg。"""
    if BROKEN_JUDGEMENT == "service-compile-listed" or kill["whole_machine"]:
        return False
    if kill["name"] != SERVICE_COMPILER_NAME and BROKEN_JUDGEMENT != "any-process-folded":
        return False
    unit = kill["memcg"].rsplit("/", 1)[-1]
    in_service_unit = unit.startswith(MEMORY_CAP_SCOPE_PREFIX) and unit.endswith(".scope")
    if not in_service_unit and BROKEN_JUDGEMENT != "any-cgroup-folded":
        return False
    if kill["memcg"] == "":
        return False
    return kill["oom_memcg"] == kill["memcg"] or BROKEN_JUDGEMENT == "slice-squeeze-folded"


def gpu_memory_events(journal_text):
    """显卡驱动报显存不够的每一行：{"moment", "gpu"}（行里没写第几张卡的记成「GPU?」）。弄坏开关 skip-gpu-oom 下一行都不认。"""
    if BROKEN_JUDGEMENT == "skip-gpu-oom":
        return []
    events = []
    for line in journal_text.splitlines():
        matched = GPU_MEMORY_LINE.match(line)
        if not matched:
            continue
        try:
            moment = datetime.fromisoformat(matched.group("timestamp")).astimezone(timezone.utc)
        except ValueError:
            continue
        events.append({"moment": moment, "gpu": matched.group("gpu") or "GPU?"})
    return events


def moment_text(moment):
    return f"{moment.strftime('%Y-%m-%d %H:%M:%S')} UTC / {moment.astimezone(TOKYO).strftime('%m-%d %H:%M:%S')} JST"


def gpu_memory_report(hours, events):
    counts = {}
    for event in events:
        counts[event["gpu"]] = counts.get(event["gpu"], 0) + 1
    return "\n".join([
        f"【近 {hours:g} 小时显卡驱动报过 {len(events)} 次显存不够（journalctl -k 里的 NVRM … NV_ERR_NO_MEMORY 行）】",
        "  - " + "、".join(f"{gpu} ×{count}" for gpu, count in sorted(counts.items())) + f"；头一次 {moment_text(min(event['moment'] for event in events))}，"
        f"末一次 {moment_text(max(event['moment'] for event in events))}",
        "- 怎么办：先查那段时间谁在用卡（经 scripts/hosts/run-with-memory-cap.sh 起、命令退出之后认出显存不够的那几条退 245；同一段时间的 Killed process 行也看一眼），"
        "查清之前别照原样重派同一件活；要上卡的经 task-server/task submit -- <命令> 交（哪台、哪几张卡、显存额度由服务分）。"])


def format_size(kibibytes):
    if kibibytes >= 1024 * 1024:
        return f"{kibibytes / (1024 * 1024):.1f} GiB"
    return f"{kibibytes / 1024:.0f} MiB"


def kill_lines(kills):
    """逐条列 anon-rss 最大的 KILLS_LISTED_ONE_BY_ONE 条（按时间排），其余按进程名合计成一行。"""
    listed_indexes = set(sorted(range(len(kills)), key=lambda index: -kills[index]["anon_rss_kibibytes"])[:KILLS_LISTED_ONE_BY_ONE])
    lines = [f"  - {kill['moment'].strftime('%Y-%m-%d %H:%M:%S')} UTC / {kill['moment'].astimezone(TOKYO).strftime('%m-%d %H:%M:%S')} JST  "
             f"进程 {kill['pid']}（{kill['name']}）anon-rss {format_size(kill['anon_rss_kibibytes'])}"
             for kill in sorted((kills[index] for index in listed_indexes), key=lambda kill: kill["moment"])]
    rest = [kill for index, kill in enumerate(kills) if index not in listed_indexes]
    if rest:
        counts = {}
        for kill in rest:
            counts[kill["name"]] = counts.get(kill["name"], 0) + 1
        largest = max(kill["anon_rss_kibibytes"] for kill in rest)
        lines.append(f"  - 另有 {len(rest)} 次没逐条列（anon-rss 都不超过 {format_size(largest)}）："
                     + "、".join(f"{name} ×{count}" for name, count in sorted(counts.items(), key=lambda item: -item[1])))
    return lines


def service_compile_sentence(count):
    return f"任务服务的内存上限里杀的编译进程 {count} 个（服务照乘 1.5 重来，不用处置）"


def selftest_kills_sentence(count):
    return f"{count} 个是 run-with-memory-cap.sh --selftest 故意造的（cgroup 名带 {SELFTEST_CGROUP_MARK}），不算事故"


def oom_report(hours):
    if BROKEN_JUDGEMENT == "skip-oom":
        return ""
    journal_text, problem = read_kernel_journal(hours)
    if problem is not None:
        return "\n".join([
            f"【没查成：近 {hours:g} 小时内核有没有因为内存不够杀进程、显卡驱动有没有报显存不够】{problem}。",
            f"- 怎么办：手动跑 `journalctl -k --since '-{hours:g}h' | grep -E 'Killed process|NV_ERR_NO_MEMORY'` 看一眼；查不了就当不知道，不当成没有 OOM——"
            "会话要是突然断掉才重开的，先别照原样重派断掉之前在跑的那件活。"])
    all_kills = killed_processes(journal_text)
    selftest_kills = [kill for kill in all_kills if kill["selftest"]]
    service_kills = [kill for kill in all_kills if not kill["selftest"] and folded_into_service_retry(kill)]
    kills = [kill for kill in all_kills if not kill["selftest"] and not folded_into_service_retry(kill)]
    gpu_events = gpu_memory_events(journal_text)
    gpu_text = gpu_memory_report(hours, gpu_events) if gpu_events else ""
    if not kills:
        if not selftest_kills and not service_kills:
            memory_text = f"近 {hours:g} 小时内核没有因为内存不够杀过进程（journalctl -k 查过，看得到内核日志）"
        elif not service_kills:
            memory_text = (f"近 {hours:g} 小时内核杀过的 {len(selftest_kills)} 个进程全是 run-with-memory-cap.sh --selftest 故意造的"
                           f"（cgroup 名带 {SELFTEST_CGROUP_MARK}），不算事故；别的没有（journalctl -k 查过，看得到内核日志）")
        else:
            pieces = ([selftest_kills_sentence(len(selftest_kills))] if selftest_kills else []) + [service_compile_sentence(len(service_kills))]
            memory_text = f"近 {hours:g} 小时内核杀过的进程里：" + "；".join(pieces) + "；别的没有（journalctl -k 查过，看得到内核日志）"
        return memory_text + ("。\n" + gpu_text if gpu_text else "；显卡驱动也没报过显存不够。")
    whole_machine = [kill for kill in kills if kill["whole_machine"]]
    capped = [kill for kill in kills if not kill["whole_machine"]]
    lines = [f"【近 {hours:g} 小时内核因为内存不够杀过 {len(kills)} 个进程（journalctl -k 里的 Killed process 行）】"]
    if whole_machine:
        lines.append(f"- 整机 OOM（Out of memory）杀的 {len(whole_machine)} 个：整机内存耗尽，本地模型服务与 Claude Code 会话可能被连带杀掉")
        lines += kill_lines(whole_machine)
    if capped:
        lines.append(f"- 内存上限（cgroup）里杀的 {len(capped)} 个：撞的是那一个 cgroup 的上限（例 run-with-memory-cap.sh 给变异定的），整机没耗尽")
        lines += kill_lines(capped)
    if service_kills:
        lines.append("- " + service_compile_sentence(len(service_kills)))
    if selftest_kills:
