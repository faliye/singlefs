def check_output(label, completed, wanted, unwanted=()):
    """一格的判定：退出码 0、wanted 都在标准输出里、unwanted 一个都不在；不对交一句失败说明，对交空串。"""
    missing = [piece for piece in wanted if piece not in completed.stdout]
    present = [piece for piece in unwanted if piece in completed.stdout]
    if completed.returncode != 0 or missing or present:
        return (f"{label}：退出码 {completed.returncode}（应当是 0），缺 {missing}，不该有却有 {present}；"
                f"输出：{completed.stdout[-600:]}{completed.stderr[-300:]}")
    return ""


def check_refusal(label, completed, wanted_in_error):
    """输入或判的时候出错的一格：退出码 1、标准输出空、stderr 点名原因。"""
    if completed.returncode != 1 or completed.stdout.strip() or wanted_in_error not in completed.stderr:
        return (f"{label}：应当退 1、不补提示、stderr 点名「{wanted_in_error}」；实际退 {completed.returncode}，"
                f"stdout {completed.stdout[:120]!r}，stderr {completed.stderr.strip()[:200]!r}")
    return ""


