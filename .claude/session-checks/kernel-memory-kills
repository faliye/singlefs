def raising_report_cell():
    """判的时候抛异常：退 1、stderr 点名原因。进程内换掉判的函数，标准输出与标准错误换成内存里的。"""
    def raising_report(hook_input):
        raise RuntimeError("自证造的异常")
    label = "判的时候抛异常退 1 并点名原因"
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        code = hook_main(json.dumps({"hook_event_name": "SessionStart", "source": "startup", "session_id": "s-raise"}).encode("utf-8"), raising_report)
    if code != 1 or out.getvalue() or "判的时候抛异常（RuntimeError: 自证造的异常）" not in err.getvalue():
        return f"{label}：应当退 1、不补提示、stderr 点名异常；实际退 {code}，stdout {out.getvalue()[:120]!r}，stderr {err.getvalue().strip()[:200]!r}"
    return ""


def selftest_in(work):
    cells = prepare_cells(work)
    sys.path.insert(0, os.path.join(REPOSITORY, "scripts", "hosts"))
    import heavy_threads
    try:
        threads = heavy_threads.default_heavy_threads()
    except heavy_threads.HeavyThreadDefaultError as error:
        print(f"  ✗ 自检：取不了每台默认重活线程数：{error}")
        print(f"    → 怎么办：{error.howto}")
        return 1
    parallel = max(1, min(threads, len(cells)))
    with concurrent.futures.ThreadPoolExecutor(max_workers=parallel) as pool:
        results = list(pool.map(lambda cell: cell[1](), cells))
    failures = [result for result in results if result]
    if len(results) != len(cells):
        failures.append(f"收回的格数 {len(results)} 与派出去的 {len(cells)} 对不上")
    exception_failure = raising_report_cell()
