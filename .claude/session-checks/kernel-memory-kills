def hook_main(raw, build_report=report_for):
    """钩子的原始输入（字节）→ 退出码。要补的提示打到标准输出；输入不对与判的时候抛异常退 1、stderr 一行写原因（上游报「没查成」并记检出）。"""
    try:
        hook_input = json.loads(raw.decode("utf-8"))
        problem = None if isinstance(hook_input, dict) else f"输入顶层是 {type(hook_input).__name__}，不是 JSON 对象"
    except ValueError as error:
        hook_input, problem = None, f"输入不是合法的 JSON（{error}；前 200 字节：{raw[:200].decode('utf-8', 'replace')!r}）"
    if problem and BROKEN_JUDGEMENT != "input-accepted":
        print(f"{ITEM_NAME}：{problem}，这一次没判", file=sys.stderr)
        return 1
    if problem:
        hook_input = {}
    try:
        text = build_report(hook_input)
    except Exception as error:  # noqa: BLE001 —— 判的时候出什么错都退 1、点名原因，不吞
        if BROKEN_JUDGEMENT == "exception-swallowed":
            return 0
        print(f"{ITEM_NAME}：判的时候抛异常（{type(error).__name__}: {error}），这一次没判", file=sys.stderr)
        return 1
    if text:
        print(text)
    return 0


