#!/usr/bin/env bash
# git 的 pre-commit 钩子：判法都在 scripts/gate/large-file-git-hook.py（先调私有的提交窗口闸，再判暂存区里有没有超过单文件上限的文件）。
# 经 core.hooksPath（主工作树钩子目录的绝对路径）生效，装与核对见 scripts/gate/git-hooks-install.py。
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if ! command -v python3 > /dev/null 2>&1; then
  echo "  ✗ pre-commit：PATH 上没有 python3，大文件判不了，这一次提交不放行" >&2
  echo "     → 怎么办：装好 python3 再提交；确要不经钩子提交的是用户的决定，由用户自己 git commit --no-verify" >&2
  exit 1
fi
exec python3 -B "$here/../large-file-git-hook.py" pre-commit "$@"
