#!/usr/bin/env python3
"""task-server 的客户端：一切跑项目代码的任务都经它交给服务。任务只由主 agent 与人手交；子 agent 只用 status、log 看结局，submit、wait、cancel、clean 由钩子在执行前拒（共用约束「子 agent 不交任务」）。提交时不选机器、不给内存、不给 GPU 参数。

  task-server/task submit [--cwd <目录>] -- <命令…>   排进队、当场打任务号（stdout 一行「TASK_SERVER submit task=<号> session=<会话号> gpu=<0|1>」），退 0；
                                                    工作目录不给取此刻的目录。调用方环境里的变量照 task_server_lib.py 文件头「环境变量」分三种：白名单的带进去，
                                                    会话自带的不带，别的当场拒并点名（退 3）。命令自己套了内存包装或派发器的拒、给的编译目录指到仓里的拒（退 3）。
                                                    要分片的（task_server_lib.py 文件头「分片」）照样一条 submit，服务拆、合，stdout 那一行另带 sharded=<入口>；
                                                    派不到第二台的三种（工作目录或命令里有多机配置 NFS_SHARED_ROOTS 外的路径，/tmp 下的同样算；交给命令的共享根不在共享根下；
                                                    带判定库而登记表第三列还没写 prune-server）服务当场拒（task_server.py 文件头 ②「提交时拒」）：打那一句与出路、退 3，任务不跑
  task-server/task wait <号>                        阻塞到结局：逐次尝试一行（分片的逐个子任务），末行「TASK_SERVER_RESULT task=<号> type=<错误类型> exit=<码> attempts=<次数> log=<日志路径>」，
                                                    分片的另接 shards=<片数>，有一步没成再接 shard=<片号>/<片数> 或 step=plan|merge；memory-cap-at-maximum 再接
                                                    host=<本机|第二台> reached=<上限> next=<改什么再重投>（task_server_lib.py 文件头「撞顶到两台最大」）；
                                                    第二台在同一棵共享的树里跑（task_server_lib.py 文件头「挑机器」），写出的文件就在本机那棵树与共享根下，末行不另报位置；
                                                    末行之前打一行「TASK_SERVER_REASON task=<号> type=<错误类型> <要素>… why=<原因> next=<出路>」（task_server_lib.py 文件头
                                                    「错误类型」表后的「打回的理由」：每种类型带哪几样要素在 REASON_ELEMENTS，值照 shlex 引）；
                                                    退出码就是任务的退出码（错误类型表的右列）。agent 用 run_in_background 起它，任务完成时它退出、harness 叫醒 agent。
                                                    在跑的那一次疑似卡住（task_server.py 文件头 ①「疑似卡住」：CPU 满窗口几乎不涨，服务不停它）：打一行
                                                    「TASK_SERVER_SUSPECT task=<号> attempt=<第几次> host=<本机|第二台> window=<秒> cores=<平均核数> log=<日志> why=<依据>」、
                                                    退 231（SUSPECT_EXIT，错误类型表里没用过的码），不打 TASK_SERVER_RESULT；任务照跑，提交方自己查，再起 wait <号> 接着等（同一段只报一次）
                                                    要处置的提醒（task_server.py 文件头 ①「要处置的提醒」：排队过久、跑到记录用时的很多倍、换卡重排、清场没收尾、分片父任务推不动、
                                                    改主工作区的命令没正常结束（可能写了一半，只报有结局的），六种之一）：打一行
                                                    「TASK_SERVER_ATTENTION task=<号> [part=<子任务号>] type=needs-attention kind=<种类> tier=<档> basis=<依据的数> why=<原因> next=<出路>」（值照 shlex 引）、
                                                    退 230（ATTENTION_EXIT，错误类型表里没用过的码），不打 TASK_SERVER_RESULT；任务照旧在排或在跑，服务没动它，提交方按 next= 处置，再起 wait <号> 接着等
                                                    （同一条任务同一种提醒、同一档只叫一次，档跨过下一档才再叫）；任务已有结局的（换卡重排跑成、改主工作区的命令没正常结束）
                                                    这一行打在 TASK_SERVER_REASON 之前，退码仍是任务的。
                                                    服务健康不归 wait：python3 task-server/control watch 盯，主 agent 用 run_in_background 起它，退出即处置
                                                    服务断线（重启）自己重连，不误报结局；结局交给提交它的会话时服务记成已取
  task-server/task status [<号>] [--json]            不给号：这个会话在排、在跑与完成了没人取的任务（排着的带预计用时）；给号：那个任务（排着的写预计用时，后面一句说明这个数是照命令、
                                                    照点到的项还是没有记录，照服务回复里的 estimate_basis）与它每一次尝试的记录
                                                    （机器、上限、卡、线程数、退出码、类型、用时、内存峰值、核数、编译目录、日志），分片的连同各子任务；
                                                    排着的任务在等什么另打「在等：…」；服务暂停着（python3 task-server/control pause）写「在等：服务暂停中（原因：…）」，提交照收、排着不起；
                                                    有了结局的另打 wait 那一行 TASK_SERVER_REASON（点到 /tmp 下的在提交时就拒，task_server.py 文件头 ②「提交时拒」①）
  task-server/task cancel <号>                      只许提交它的会话取消：在队里的当场取消；在跑的服务停它的单元、回读停了才退 0
  task-server/task log <号> [--attempt <第几次>] [--all]  打那一次尝试（默认最后一次）的日志：默认最后 LOG_TAIL_LINES 行，--all 整份
  task-server/task clean <号>                       只许提交它的会话、有了结局才删：这条任务留下的编译目录（删完回读不在），打删了几份；
                                                    没删干净退 5，逐份写明哪个编译目录、为什么没删成（服务的 remove_run_build_directory 交回的原因），还没有结局的另说一句、同样退 5

退出码（wait 之外）：0 成了；2 用法错，或只在自证里认的变量设在了别处；3 服务或客户端拒了（环境变量、套了包装、不是你的会话、工作目录不对）；
  4 没有这个任务；5 取消没回读到停了；231 是 wait 报疑似卡住（任务照跑）；230 是 wait 报要处置的提醒（任务照旧在排或在跑）；78 运行条件不满足（fastapi、uvicorn 不在、多机配置 multi-host.env 不在、服务不通，出路写在 stderr），命令一行没跑，不退回直接执行。
wait 的退出码是任务的（错误类型表右列）；它自己的 2、4、78 与任务退出码可能撞上，末行的 type= 分得开（没打末行就是 wait 自己的退出码）。
弄坏开关读在 task_server_lib.py 的 broken（开关表在那份文件头）：fallback-run-when-unreachable、exit-code-dropped、wait-gives-up-on-disconnect、in-repository-target-accepted、
maximum-line-vague、log-tail-unbounded、log-all-ignored、log-attempt-ignored、log-missing-exit-zero、reason-line-omitted、clean-failure-unexplained、estimate-basis-sentence-fixed。
"""
import os
import sys

sys.dont_write_bytecode = True
SCRIPT_DIRECTORY = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, SCRIPT_DIRECTORY)
import task_server_lib as lib  # noqa: E402

import json  # noqa: E402
import shlex  # noqa: E402
import time  # noqa: E402

REFUSED_EXIT = 3
NO_SUCH_TASK_EXIT = 4
CANCEL_UNCONFIRMED_EXIT = 5
CLEAN_LEFT_EXIT = 5
WAIT_SERVER_SECONDS = 20.0
FAST_WAIT_SERVER_SECONDS = 1.0
RECONNECT_SECONDS = 2.0
FAST_RECONNECT_SECONDS = 0.2
STARTUP_RETRY_SECONDS = 60.0
FAST_STARTUP_RETRY_SECONDS = 2.0
RECONNECT_REPORT_SECONDS = 60.0
LOG_TAIL_LINES = 200
HOST_NAMES = lib.HOST_NAMES
ROLE_NAMES = {"plan": "计划", "merge": "合并"}


def fail(line, next_step, code):
    print(f"  ✗ {line}", file=sys.stderr)
    print(f"  → 怎么办：{next_step}", file=sys.stderr)
    sys.exit(code)


def usage(line):
    fail(line, "写成 task-server/task submit [--cwd <目录>] -- <命令…> | wait <号> | status [<号>] [--json] | cancel <号> | log <号> [--attempt <第几次>] [--all]",
         lib.USAGE_EXIT)


def prepare():
    """必须依赖与多机配置（task_server_lib.py 文件头「必须依赖」）：缺一样退 78。"""
    try:
        lib.require_modules()
        return lib.read_configuration()
    except lib.Unavailable as error:
        lib.report_unavailable_and_exit(error, "task-server/task 跑不了")


def call_or_exit(configuration, method, path, body=None, timeout=30.0):
    try:
        return lib.call_server(configuration.socket, method, path, body, timeout)
    except lib.ServerUnreachable as error:
        lib.report_unavailable_and_exit(lib.unreachable_error(configuration, str(error)), "task-server/task 跑不了")


def task_number(text):
    if not text.isdigit() or int(text) < 1:
        usage(f"任务号要是正整数，收到的是「{text}」")
    return int(text)


size_text = lib.size_text
LOG_REASON_BYTES = 65536   # 打回的理由取日志最后这么多字节（与 task_server.py 的 LOG_TAIL_BYTES 同一个数）


def attempt_line(attempt, prefix=""):
    cores = attempt.get("cores")
    gpu = attempt.get("gpu_memory_peak")
    pinned = "（钉值）" if attempt.get("prediction") == lib.PINNED_HISTORY else ""
    gap_fill = f"（插空起的：{attempt['gap_fill']}）" if attempt.get("gap_fill") else ""   # 封组时插空起的那一次（task_server.py 的 Alternation.gap_fill）
    return (f"  · {prefix}第 {attempt.get('number')} 次{gap_fill}：{HOST_NAMES.get(attempt.get('host'), attempt.get('host'))}、上限 {attempt.get('memory_cap_text')}{pinned}"
            f"、卡 {attempt.get('card') or '无'}、线程 {attempt.get('threads') or '没设'}、状态 {attempt.get('state')}、退 {attempt.get('exit_code')}"
            f"（{attempt.get('outcome') or '还没结局'}）、用时 {attempt.get('seconds')} 秒、内存峰值 {size_text(attempt.get('memory_peak'))}"
            f"、平均在用核数 {cores if cores is not None else '没量到'}、显存峰值 {f'{gpu} MiB' if gpu else '无'}"
            f"、编译目录 {attempt.get('build_directory') or '无'}、单元 {attempt.get('unit') or '无'}、日志 {attempt.get('log')}"
            f"{'' if attempt.get('valid', True) else '（这一行校验不过）'}")


def progress_line(progress):
    """在跑的那一次（服务的 running_progress）：已跑多久、记录用时、日志多久没涨、到此刻平均在用核数；远超记录用时与核数过少只提示，服务不停。"""
    elapsed, estimate, quiet, cores = (progress.get(name) for name in ("elapsed_seconds", "estimated_seconds", "log_quiet_seconds", "cores"))
    notes = []
    if isinstance(estimate, (int, float)) and isinstance(elapsed, (int, float)) and elapsed > 2 * estimate:
        notes.append("已超过记录用时的两倍")
    threads = progress.get("threads")
    if isinstance(cores, (int, float)) and isinstance(threads, int) and isinstance(elapsed, (int, float)) and elapsed >= 600 and cores < threads / 4:
        notes.append(f"在用核数不到线程数 {threads} 的四分之一")
    suspect = progress.get("suspect") or {}
    return (f"    在跑：已跑 {elapsed:.0f} 秒（记录用时 {estimate_text(estimate)}）、日志 {quiet_text(quiet)}没涨"
            f"{'（CPU 在涨：在算，不停）' if progress.get('computing_quietly') else ''}"
            f"（日志与 CPU 都满 {progress.get('stall_seconds', 600):.0f} 秒不涨服务才停）、到此刻平均在用 {cores if cores is not None else '没量到'} 核"
            + (f"；{'、'.join(notes)}" if notes else "")
            + (f"\n    疑似卡住（第 {suspect.get('segment')} 段，服务不停它）：{suspect.get('why')}；自己查 task log，还在算就接着等" if suspect else ""))


def suspect_line(task_id, suspect):
    """wait 报疑似卡住的那一行（文件头 wait 那一段）。"""
    return (f"{lib.SUSPECT_MARK} task={task_id} attempt={suspect.get('attempt')} host={HOST_NAMES.get(suspect.get('host'), suspect.get('host') or '本机')} "
            f"window={suspect.get('window_seconds')} cores={suspect.get('cores')} log={suspect.get('log') or '无'} why={suspect.get('why')}")


def attention_line(task_id, item):
    """wait 报要处置的提醒的那一行（文件头 wait 那一段）：值照 shlex 引（同 TASK_SERVER_REASON，shlex.split 拆得回）；part= 只在提醒说的是分片的子任务时写它的任务号。"""
    part = f" part={item.get('task')}" if item.get("task") not in (None, task_id) else ""
    values = [(name, item.get(name)) for name in ("basis", "why", "next")]
    return (f"{lib.ATTENTION_MARK} task={task_id}{part} type={lib.ATTENTION_TYPE} kind={item.get('kind')} tier={item.get('tier')} "
            + " ".join(f"{name}={shlex.quote(str(value))}" for name, value in values))


def quiet_text(seconds):
    return f"{seconds:.0f} 秒" if isinstance(seconds, (int, float)) else "多久（还没量）"


def child_prefix(child_task):
    role = child_task.get("role")
    if role == "shard":
        return f"第 {child_task.get('shard_index')}/{child_task.get('shard_count')} 片（子任务 {child_task.get('id')}）"
    return f"{ROLE_NAMES.get(role, role)}（子任务 {child_task.get('id')}）"


def every_attempt(reply):
    """[(前缀, 尝试)]：普通任务是它自己的；分片的父任务是各子任务的，按子任务号。"""
    if reply.get("children"):
        return [(child_prefix(child["task"]), attempt) for child in reply["children"] for attempt in child.get("attempts", [])]
    return [("", attempt) for attempt in reply.get("attempts", [])]


def estimate_text(seconds):
    return f"{seconds:.0f} 秒" if isinstance(seconds, (int, float)) else "没有记录"


def estimate_sentence(reply):
    """预计用时后面的说明：服务在回复里交的 estimate_basis 是哪种算法（按命令、按项、没有），就打 lib.ESTIMATE_BASIS_SENTENCES 里那一种的一句；
    服务没交 estimate_basis 的（或认不得的值）不打。弄坏开关 estimate-basis-sentence-fixed 下不看它，一律打按命令那一句（改前的样子）。"""
    if lib.broken("estimate-basis-sentence-fixed"):
        return lib.ESTIMATE_BASIS_SENTENCES[lib.ESTIMATE_BASIS_COMMAND]
    return lib.ESTIMATE_BASIS_SENTENCES.get(reply.get("estimate_basis"), "")


def outcome_attempts(reply):
    """结局所在的那几次尝试：分片的有一步没成的是那一步的子任务的，别的是全部（末行的 log= 与打回的理由取同一份）。"""
    failed = reply["task"].get("failed_step") or {}
    attempts = [attempt for _, attempt in every_attempt(reply)]
    if failed and reply.get("children"):
        attempts = next((child.get("attempts", []) for child in reply["children"] if child["task"].get("id") == failed.get("task")), attempts)
    return attempts


def reason_line(reply):
    """末行之前那一行 TASK_SERVER_REASON（文件头 wait 那一段；task_server_lib.py 的 reason_line）：日志取结局那一次的最后 LOG_REASON_BYTES 字节。"""
    attempts = outcome_attempts(reply)
    log_text = ""
    if attempts and attempts[-1].get("log"):
        try:
            with open(attempts[-1]["log"], "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - LOG_REASON_BYTES))
                log_text = handle.read().decode("utf-8", "replace")
        except OSError:
            log_text = ""
    return lib.reason_line(reply["task"], attempts, log_text)


def result_line(reply):
    """末行（文件头 wait 那一段）。"""
    task = reply["task"]
    pairs = every_attempt(reply)
    failed = task.get("failed_step") or {}
    log_attempts = outcome_attempts(reply)
    log = log_attempts[-1].get("log", "") if log_attempts else ""
    line = (f"{lib.RESULT_MARK} task={task.get('id')} type={task.get('outcome')} exit={task.get('exit_code')} attempts={len(pairs)} "
            f"log={log or '无（一次都没起）'}")
    if task.get("sharded_entry"):
        line += f" shards={task.get('shard_count', 0)}"
    if failed.get("role") == "shard":
        line += f" shard={failed.get('index')}/{failed.get('count')}"
    elif failed.get("role") in ("plan", "merge"):
        line += f" step={failed['role']}"
    build = next((attempt.get("build_directory") for _, attempt in reversed(pairs) if attempt.get("build_directory") and not attempt.get("build_directory_removed")), "")
    if build:   # 编译目录留给提交它的 agent：用完 task-server/task clean <号> 删（task_server_lib.py 文件头「编译目录」）
        line += f" build={build}"
    if task.get("outcome") == "memory-cap-at-maximum" and not lib.broken("maximum-line-vague"):
        host = failed.get("maximum_host") or task.get("maximum_host", "")
        cap_text = failed.get("maximum_cap_text") or task.get("maximum_cap_text", "")
        line += f" host={HOST_NAMES.get(host, host or '本机')} reached={cap_text or '?'} next={lib.maximum_next_step(host, cap_text or '?')}"
    return line


def submit(arguments):
    cwd = os.getcwd()
    if arguments[:1] == ["--cwd"]:
        if len(arguments) < 2:
            usage("--cwd 后面没给目录")
        cwd = os.path.abspath(arguments[1])
        arguments = arguments[2:]
    if arguments[:1] != ["--"] or len(arguments) < 2:
        usage("submit 要写成 submit [--cwd <目录>] -- <命令…>")
    command = arguments[1:]
    if not os.path.isdir(cwd):
        fail(f"工作目录 {cwd} 不在", "--cwd 给一个在的目录", REFUSED_EXIT)
    configuration = prepare()
    carried, refused = lib.split_environment(dict(os.environ))
    if refused:
        for line in lib.environment_refusal_lines(refused):
            print(line, file=sys.stderr)
        sys.exit(REFUSED_EXIT)
    nested = lib.nested_dispatch(command)
    if nested:
        fail(f"命令自己套了一层：{nested}", "去掉那一层再提交：task-server/task submit -- <里面那条命令…>；挑机器、定上限、分卡都由服务做", REFUSED_EXIT)
    target = lib.target_directory_refusal(carried, command, cwd)
    if target:
        fail(target, "去掉它再提交：服务给每一次尝试一个仓外的编译目录、跑完删（task_server_lib.py 文件头「编译目录」）；真要自己的，给仓外的路径", REFUSED_EXIT)
    try:
        status, reply = lib.call_server(configuration.socket, "POST", "/tasks", {"command": command, "cwd": cwd, "environment": carried})
    except lib.ServerUnreachable as error:
        if lib.broken("fallback-run-when-unreachable"):
            os.chdir(cwd)
            os.execvp(command[0], command)
        lib.report_unavailable_and_exit(lib.unreachable_error(configuration, str(error)), "task-server/task 跑不了")
    if status == 400:
        detail = reply.get("detail")
        if isinstance(detail, dict) and detail.get("refused"):
            for line in lib.environment_refusal_lines([tuple(pair) for pair in detail["refused"]]):
                print(line, file=sys.stderr)
            sys.exit(REFUSED_EXIT)
        if isinstance(detail, dict) and isinstance(detail.get("placement"), dict):   # 派不到第二台的三种（task_server.py 文件头 ②「提交时拒」）
            fail(detail["placement"].get("problem") or str(detail), detail["placement"].get("next_step") or "照上面那句改了再提交", REFUSED_EXIT)
        fail(f"服务拒了这一条：{detail}", "照上面那句改了再提交", REFUSED_EXIT)
    if status != 200:
        fail(f"服务回 HTTP {status}：{reply.get('detail', reply)}", "看服务的日志：journalctl --user -u singlefs-task-server.service -n 100", 1)
    sharded = reply.get("sharded") or ""
    print(f"{lib.SUBMIT_MARK} task={reply['id']} session={reply.get('session') or '无（人手）'} gpu={1 if reply.get('gpu') else 0}"
          f"{' sharded=' + sharded if sharded else ''}")
    print(f"  · 任务 {reply['id']} 排进队了{('（要卡：' + reply['gpu_reason'] + '）') if reply.get('gpu') else ''}"
          f"{'（服务按分片跑：先排计划，再按计划拆片、合并）' if sharded else ''}；等结局：task-server/task wait {reply['id']}（放后台起，完成时退出）")
    return 0


def wait(arguments):
    if len(arguments) != 1:
        usage("wait 要写成 wait <号>")
    task_id = task_number(arguments[0])
    configuration = prepare()
    speedy = lib.fast()
    server_seconds = FAST_WAIT_SERVER_SECONDS if speedy else WAIT_SERVER_SECONDS
    reconnect_seconds = FAST_RECONNECT_SECONDS if speedy else RECONNECT_SECONDS
    startup_deadline = time.monotonic() + (FAST_STARTUP_RETRY_SECONDS if speedy else STARTUP_RETRY_SECONDS)
    connected_once = False
    reported_at = None
    unreachable_since = None
    while True:
        try:
            status, reply = lib.call_server(configuration.socket, "GET", f"/tasks/{task_id}/wait?timeout={server_seconds}", timeout=server_seconds + 30)
        except lib.ServerUnreachable as error:
            # 服务连不上：短暂断线（重启）照重连；连续连不上满 STARTUP_RETRY_SECONDS 就退出报错点名「task-server 没起」、给起法，不悄悄一直等、不自己拉起
            #（用户：「不是开启自启动，而是派任务失败后，检测如果没有启动就报错提醒」「调任务失败后 health没有响应时候 提醒」）；任务的结局不因这次退出而改，服务起来再 wait
            unreachable_since = unreachable_since or time.monotonic()
            gave_up = time.monotonic() - unreachable_since > (FAST_STARTUP_RETRY_SECONDS if speedy else STARTUP_RETRY_SECONDS)
            if lib.broken("wait-gives-up-on-disconnect") or gave_up or (not connected_once and time.monotonic() > startup_deadline):
                lib.report_unavailable_and_exit(lib.unreachable_error(configuration, str(error)), f"task-server/task wait {task_id}")
            if reported_at is None or time.monotonic() - reported_at >= RECONNECT_REPORT_SECONDS:
                print(f"  · task-server 连不上（{error}），每 {reconnect_seconds} 秒重连一次；任务 {task_id} 的结局不因断线而改，接着等", file=sys.stderr, flush=True)
                reported_at = time.monotonic()
            time.sleep(reconnect_seconds)
            continue
        connected_once = True
        unreachable_since = None
        if status == 404:
            fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", NO_SUCH_TASK_EXIT)
        if status != 200:
            print(f"  · task-server 回 HTTP {status}（{reply.get('detail', reply)}），{reconnect_seconds} 秒后再问", file=sys.stderr, flush=True)
            time.sleep(reconnect_seconds)
            continue
        if not reply.get("finished"):
            if reply.get("suspect"):   # 疑似卡住（task_server.py 文件头 ①「疑似卡住」）：任务照跑，报一行、退 SUSPECT_EXIT
                print(suspect_line(task_id, reply["suspect"]), flush=True)
                print(f"  → 怎么办：任务 {task_id} 照跑、服务不停它；看 task-server/task log {task_id} 与 task-server/task status {task_id} 自己查，"
                      f"还在算就再起 task-server/task wait {task_id} 接着等，真卡住了 task-server/task cancel {task_id}", file=sys.stderr, flush=True)
                return lib.SUSPECT_EXIT
            if reply.get("attention"):   # 要处置的提醒（task_server.py 文件头 ①「要处置的提醒」）：任务照旧在排或在跑，报一行、退 ATTENTION_EXIT
                for item in reply["attention"]:
                    print(attention_line(task_id, item), flush=True)
                print(f"  → 怎么办：任务 {task_id} 照旧在{'排' if reply.get('state') == 'queued' else '跑'}、服务没动它；照上面 next= 那一句处置，"
                      f"处置完或不用处置就再起 task-server/task wait {task_id} 接着等（同一种同一档不再叫，档跨过下一档才再叫）", file=sys.stderr, flush=True)
                return lib.ATTENTION_EXIT
            continue
        task = reply["task"]
        for prefix, attempt in every_attempt(reply):
            print(attempt_line(attempt, prefix))
        if not reply.get("valid", True):
            print(f"  ✗ 任务 {task_id} 的记录校验不过（库被改过），结局记 record-tampered")
            print("  → 怎么办：查是谁直接写了库；任务照 task-server/task submit 重新提交")
        if task.get("note"):
            print(f"  · {task['note']}")
        for item in reply.get("attention") or []:   # 结局有了还没报的提醒（换卡重排跑成的）：打在理由行之前，退码仍是任务的
            print(attention_line(task_id, item), flush=True)
        if not lib.broken("reason-line-omitted"):
            print(reason_line(reply), flush=True)
        print(result_line(reply), flush=True)
        if lib.broken("exit-code-dropped"):
            return 0
        code = task.get("exit_code")
        return code if isinstance(code, int) and 0 <= code < 256 else 1


def status(arguments):
    as_json = "--json" in arguments
    rest = [argument for argument in arguments if argument != "--json"]
    if len(rest) > 1:
        usage("status 要写成 status [<号>] [--json]")
    configuration = prepare()
    if rest:
        task_id = task_number(rest[0])
        code, reply = call_or_exit(configuration, "GET", f"/tasks/{task_id}")
        if code == 404:
            fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", NO_SUCH_TASK_EXIT)
        if code != 200:
            fail(f"服务回 HTTP {code}：{reply.get('detail', reply)}", "看服务的日志：journalctl --user -u singlefs-task-server.service -n 100", 1)
        if as_json:
            print(json.dumps(reply, ensure_ascii=False, sort_keys=True))
            return 0
        task = reply["task"]
        print(f"任务 {task_id}：{task.get('state')}{'、结局 ' + str(task.get('outcome')) + '、退 ' + str(task.get('exit_code')) if task.get('state') == 'finished' else ''}"
              f"、会话 {task.get('session') or '无（人手）'}、{'要卡' if task.get('gpu') else '不要卡'}、命令 {shlex.join(task.get('command') or [])[:300]}"
              f"{'' if reply.get('valid', True) else '（记录校验不过）'}")
        if "estimated_seconds" in reply:
            print(f"  · 预计用时 {estimate_text(reply.get('estimated_seconds'))}{estimate_sentence(reply)}")
        pinned = reply.get("pinned_cap") or {}
        if pinned.get("pinned"):
            print(f"  · 内存上限是钉值：取多机配置 {pinned.get('source')} 里派到的那一台那一项（此刻 {lib.pinned_caps_text(pinned)}），学到的峰值不顶掉它；"
                  "撞了上限不放大，到顶记 memory-cap-at-maximum")
        if reply.get("waiting_for"):
            print(f"  · 在等：{reply['waiting_for']}")
        if task.get("sharded_entry"):
            print(f"  · 分片：{task.get('sharded_entry')}，此刻在{ {'plan': '计划', 'shards': '跑各片', 'merge': '合并'}.get(task.get('phase'), task.get('phase') or '?') }，"
                  f"片数 {task.get('shard_count', 0)}")
        if task.get("note"):
            print(f"  · {task['note']}")
        for prefix, attempt in every_attempt(reply):
            print(attempt_line(attempt, prefix))
            if attempt.get("progress"):
                print(progress_line(attempt["progress"]))
        if task.get("state") == "finished":
            print(reason_line(reply))
        return 0
    code, reply = call_or_exit(configuration, "GET", "/sessions/self")
    if code != 200:
        fail(f"服务回 HTTP {code}：{reply.get('detail', reply)}", "看服务的日志：journalctl --user -u singlefs-task-server.service -n 100", 1)
    if as_json:
        print(json.dumps(reply, ensure_ascii=False, sort_keys=True))
        return 0
    print(f"会话 {reply.get('session') or '无（人手）'}：{len(reply.get('tasks', []))} 个任务在排、在跑或完成了没人取")
    for item in reply.get("tasks", []):
        if item.get("unclaimed"):
            tail = f"完成了没人取：{item.get('outcome')}、退 {item.get('exit_code')}（task-server/task wait {item['id']} 取）"
        elif item.get("state") in ("queued", "sharded"):
            tail = f"{item.get('state')}{'（' + item['phase'] + '）' if item.get('phase') else ''}、预计用时 {estimate_text(item.get('estimated_seconds'))}"
            if item.get("waiting_for"):
                tail += f"、在等：{item['waiting_for'][:160]}"
        else:
            tail = item.get("state")
        print(f"  · 任务 {item['id']}：{tail}；{item.get('command')}")
    return 0


def clean(arguments):
    if len(arguments) != 1:
        usage("clean 要写成 clean <号>")
    task_id = task_number(arguments[0])
    configuration = prepare()
    code, reply = call_or_exit(configuration, "POST", f"/tasks/{task_id}/clean", {}, timeout=300.0)
    if code == 404:
        fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", NO_SUCH_TASK_EXIT)
    if code == 403:
        fail(f"服务拒了这次删除：{reply.get('detail')}", "只有提交它的那个会话能删它的编译目录", REFUSED_EXIT)
    detail = reply.get("detail", reply)
    if code == 409 and isinstance(detail, dict) and not lib.broken("clean-failure-unexplained"):   # 没删成的逐份写明是哪一份、为什么（服务照删法交回的原因）
        for item in detail.get("removed", []):
            print(f"  · 删了编译目录 {item['path']}")
        for item in detail.get("left", []):
            print(f"  ✗ 没删成{item.get('kind') or '编译目录'} {item['path']}：{item.get('why')}", file=sys.stderr)   # gate-lint:detail
        fail(f"任务 {task_id} 没删干净：删了 {len(detail.get('removed', []))} 份、没删成 {len(detail.get('left', []))} 份（逐份在上面）",
             f"照没删成的那一句处理（停掉开着它的进程）之后再 task-server/task clean {task_id}", CLEAN_LEFT_EXIT)
    if code == 409 and not isinstance(detail, dict):
        fail(f"服务没删：{detail}", f"等 task-server/task wait {task_id} 拿到结局再 clean", CLEAN_LEFT_EXIT)
    if code != 200:
        fail(f"编译目录没删干净（HTTP {code}：{detail.get('text', detail) if isinstance(detail, dict) else detail}）",
             f"照上面那句处理之后再 task-server/task clean {task_id}", CLEAN_LEFT_EXIT)
    removed = reply.get("removed", [])
    for item in removed:
        print(f"  · 删了 {item['path']}（{lib.mebibytes_text(item.get('bytes', 0))}）")
    print(f"  ✓ 任务 {task_id} 的编译目录删了 {len(removed)} 份，共 {lib.mebibytes_text(sum(item.get('bytes', 0) for item in removed))}")
    return 0


def cancel(arguments):
    if len(arguments) != 1:
        usage("cancel 要写成 cancel <号>")
    task_id = task_number(arguments[0])
    configuration = prepare()
    code, reply = call_or_exit(configuration, "POST", f"/tasks/{task_id}/cancel", {}, timeout=300.0)
    if code == 404:
        fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", NO_SUCH_TASK_EXIT)
    if code == 403:
        fail(f"服务拒了这次取消：{reply.get('detail')}", "只有提交它的那个会话能取消它；要停别的会话的任务，给那个会话发消息", REFUSED_EXIT)
    if code != 200 or not reply.get("stopped"):
        fail(f"取消没回读到停了（HTTP {code}：{reply.get('detail', reply)}）", f"task-server/task status {task_id} 看单元的状态；还在跑就再 cancel 一次", CANCEL_UNCONFIRMED_EXIT)
    print(f"  ✓ 任务 {task_id} 取消了：{reply.get('detail')}")
    return 0


def log(arguments):
    show_all = "--all" in arguments and not lib.broken("log-all-ignored")
    rest = [argument for argument in arguments if argument != "--all"]
    number = None
    if "--attempt" in rest:
        position = rest.index("--attempt")
        if position + 1 >= len(rest) or not rest[position + 1].isdigit():
            usage("--attempt 后面要给第几次（正整数）")
        number = None if lib.broken("log-attempt-ignored") else int(rest[position + 1])
        rest = rest[:position] + rest[position + 2:]
    if len(rest) != 1:
        usage("log 要写成 log <号> [--attempt <第几次>] [--all]")
    task_id = task_number(rest[0])
    configuration = prepare()
    missing_exit = 0 if lib.broken("log-missing-exit-zero") else NO_SUCH_TASK_EXIT
    code, reply = call_or_exit(configuration, "GET", f"/tasks/{task_id}")
    if code == 404:
        fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", missing_exit)
    attempts = [attempt for _, attempt in every_attempt(reply)] if code == 200 else []   # 分片的父任务：各子任务的尝试，按子任务号排
    chosen = [attempt for attempt in attempts if number is None or attempt.get("number") == number]
    if not chosen:
        fail(f"任务 {task_id} 没有{'第 ' + str(number) + ' 次' if number else '任何一次'}尝试", f"task-server/task status {task_id} 看起过几次", missing_exit)
    path = chosen[-1].get("log", "")
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            lines = handle.read().splitlines()
    except OSError as error:
        fail(f"日志 {path} 读不了（{error}）", "看状态目录在不在、权限对不对", 1)
    shown = lines if show_all or lib.broken("log-tail-unbounded") else lines[-LOG_TAIL_LINES:]
    print(f"== 任务 {task_id} 第 {chosen[-1].get('number')} 次尝试的日志 {path}（共 {len(lines)} 行，下面是{'整份' if show_all or len(shown) == len(lines) else f'最后 {len(shown)} 行'}）")
    for line in shown:
        print(line)
    return 0


def main(arguments):
    lib.refuse_selftest_variables_or_continue()
    commands = {"submit": submit, "wait": wait, "status": status, "cancel": cancel, "log": log, "clean": clean}
    if not arguments or arguments[0] not in commands:
        usage(f"认不出子命令「{arguments[0] if arguments else ''}」")
    return commands[arguments[0]](arguments[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
