def queue_position_text(found):
    """status 里全局排位那一句（服务交的 queue_position：position、queued、aged_ahead）；没有交空串。"""
    if not isinstance(found, dict) or not found.get("position"):
        return ""
    ahead = int(found["position"]) - 1
    aged = int(found.get("aged_ahead") or 0)
    return (f"排第 {found['position']}（全部会话在排共 {found.get('queued')} 条，前面 {ahead} 条"
            + (f"，其中 {aged} 条已排满两小时、起来之前挡住后面全部" if aged else "") + "）")


def fail(line, next_step, code):
    print(f"  ✗ {line}", file=sys.stderr)
    print(f"  → 怎么办：{next_step}", file=sys.stderr)
    sys.exit(code)


def usage(line):
    fail(line, "写成 task-server/task submit [--cwd <目录>] [--manual] [--full-gate] [--whole-package-confirmed <确认文件>] -- <命令…> | "
               "confirm <号> --items <N> --tasks <M> | confirm <号> --why '<为什么要跑这么久、范围为什么是这些>' | wait <号> | status [<号>] [--json] | cancel <号> | "
               "log <号> [--attempt <第几次>] [--all] | clean <号> | promote <号>",
         lib.USAGE_EXIT)


def prepare():
    """必须依赖与多机配置（task_server_lib.py 文件头「必须依赖」）：缺一样退 78。"""
    try:
        lib.require_modules()
        return lib.read_configuration()
    except lib.Unavailable as error:
        lib.report_unavailable_and_exit(error, "task-server/task 跑不了")


def call_or_exit(configuration, method, path, body=None, timeout=30.0):
    try:
        return lib.call_server(configuration.socket, method, path, body, timeout)
    except lib.ServerUnreachable as error:
        lib.report_unavailable_and_exit(lib.unreachable_error(configuration, str(error)), "task-server/task 跑不了")


def task_number(text):
    if not text.isdigit() or int(text) < 1:
        usage(f"任务号要是正整数，收到的是「{text}」")
    return int(text)


size_text = lib.size_text


def attempt_line(attempt, prefix=""):
    cores = attempt.get("cores")
    pinned = "（钉值）" if attempt.get("prediction") == lib.PINNED_HISTORY else ""
    small_slot = "（靠要核数少的名额起的）" if attempt.get("cpu_small_slot") and not lib.broken("cpu-small-slot-status-hidden") else ""   # CPU 闸超线靠名额起的那一次（task_server.py 的 cpu_small_slot_note）
    return (f"  · {prefix}第 {attempt.get('number')} 次{small_slot}：{HOST_NAMES.get(attempt.get('host'), attempt.get('host'))}、上限 {attempt.get('memory_cap_text')}{pinned}"
            f"、线程 {attempt.get('threads') or '没设'}、状态 {attempt.get('state')}、退 {attempt.get('exit_code')}"
            f"（{attempt.get('outcome') or '还没结局'}）、用时 {attempt.get('seconds')} 秒、内存峰值 {size_text(attempt.get('memory_peak'))}"
            f"、平均在用核数 {cores if cores is not None else '没量到'}"
            f"、编译目录 {attempt.get('build_directory') or '无'}、单元 {attempt.get('unit') or '无'}、日志 {attempt.get('log')}"
            f"{'' if attempt.get('valid', True) else '（这一行校验不过）'}")


def progress_line(progress):
    """在跑的那一次（服务的 running_progress）：已跑多久、日志多久没涨、到此刻平均在用核数；核数过少只提示，服务不停。"""
    elapsed, quiet, cores = (progress.get(name) for name in ("elapsed_seconds", "log_quiet_seconds", "cores"))
    notes = []
    threads, idle_line, idle_after = (progress.get(name) for name in ("threads", "idle_core_line", "idle_core_after_seconds"))
    if isinstance(cores, (int, float)) and isinstance(idle_line, int) and isinstance(elapsed, (int, float)) and isinstance(idle_after, (int, float)) and elapsed >= idle_after and cores < idle_line:
        notes.append(f"在用核数不到 {idle_line} 核（给 {threads} 线程）")
    suspect = progress.get("suspect") or {}
    return (f"    在跑：已跑 {elapsed:.0f} 秒、日志 {quiet_text(quiet)}没涨"
            f"{'（CPU 在涨：在算，不停）' if progress.get('computing_quietly') else ''}"
            f"（日志与 CPU 都满 {progress.get('stall_seconds', 600):.0f} 秒不涨服务才停）、到此刻平均在用 {cores if cores is not None else '没量到'} 核"
            + (f"；{'、'.join(notes)}" if notes else "")
            + (f"\n    疑似卡住（第 {suspect.get('segment')} 段，服务不停它）：{suspect.get('why')}；自己查 task log，还在算就接着等" if suspect else ""))


def quiet_text(seconds):
    return f"{seconds:.0f} 秒" if isinstance(seconds, (int, float)) else "多久（还没量）"




def submit(arguments):
    cwd = os.getcwd()
    whole_package = ""   # 整包确认文件（task_server.py 文件头 ②「提交时拒」⑥）：照原样交给服务，形式由服务判
    manual = False   # 人手交（异常表 manual-from-session、sessionless-unmarked）：不读收件地址，服务判这一条确实没有会话
    full_gate = False   # 全量门禁标识（异常表 full-gate-not-commit-entry）：只认提交时的门禁，跑过两小时不提醒；认不认由服务判
    while arguments[:1] in (["--cwd"], ["--manual"], ["--full-gate"], ["--whole-package-confirmed"]):
        flag = arguments[0]
        if flag == "--manual":
            manual = True
            arguments = arguments[1:]
            continue
        if flag == "--full-gate":
            full_gate = True
            arguments = arguments[1:]
            continue
        if len(arguments) < 2:
            usage(f"{flag} 后面没给值")
        if flag == "--cwd":
            cwd = os.path.abspath(arguments[1])
        else:
            whole_package = arguments[1]
        arguments = arguments[2:]
    if arguments[:1] != ["--"] or len(arguments) < 2:
        usage("submit 要写成 submit [--cwd <目录>] [--manual] [--full-gate] [--whole-package-confirmed <确认文件>] -- <命令…>")
    command = arguments[1:]
    if not os.path.isdir(cwd):
        fail(f"工作目录 {cwd} 不在", "--cwd 给一个在的目录", REFUSED_EXIT)
    configuration = prepare()
    inbox = {} if manual else session_inbox()
    if not inbox and not manual and not lib.broken("inbox-missing-accepted"):   # 读不到会话的收件地址（异常表 inbox-missing）：当场拒，任务不交
        fail(f"读不到会话的收件地址（环境里没有 {lib.INBOX_SOCKET_VARIABLE} 与 {lib.INBOX_TOKEN_VARIABLE}）：出事服务没处发消息，这一条不交",
             lib.anomaly_advice("inbox-missing", ""), REFUSED_EXIT)
    carried, refused = lib.split_environment(dict(os.environ))
    if refused:
        for line in lib.environment_refusal_lines(refused):
            print(line, file=sys.stderr)
        sys.exit(REFUSED_EXIT)
    nested = lib.nested_dispatch(command)
    if nested:
        fail(f"命令自己套了一层：{nested}", "去掉那一层再提交：task-server/task submit -- <里面那条命令…>；挑机器、定上限都由服务做，卡归 GPU 批处理验证服务", REFUSED_EXIT)
    target = lib.target_directory_refusal(carried, command, cwd)
    if target:
        fail(target, "去掉它再提交：会编的命令服务按树给仓外的编译目录（同一棵树在同一台上接着用它那一组，树删了服务才跟着删；task_server_lib.py 文件头「编译目录」）；真要自己的，给仓外的路径", REFUSED_EXIT)
    try:
        status, reply = lib.call_server(configuration.socket, "POST", "/tasks",
                                        {"command": command, "cwd": cwd, "environment": carried, "inbox": inbox,
                                         "whole_package_confirmed": whole_package, "manual": manual, "full_gate": full_gate})
    except lib.ServerUnreachable as error:
        if lib.broken("fallback-run-when-unreachable"):
            os.chdir(cwd)
            os.execvp(command[0], command)
        lib.report_unavailable_and_exit(lib.unreachable_error(configuration, str(error)), "task-server/task 跑不了")
    if status == 400:
        detail = reply.get("detail")
        if isinstance(detail, dict) and detail.get("refused"):
            for line in lib.environment_refusal_lines([tuple(pair) for pair in detail["refused"]]):
                print(line, file=sys.stderr)
            sys.exit(REFUSED_EXIT)
        if isinstance(detail, dict) and isinstance(detail.get("placement"), dict):   # 提交时拒的五种（task_server.py 文件头 ②「提交时拒」）
            fail(detail["placement"].get("problem") or str(detail), detail["placement"].get("next_step") or "照上面那句改了再提交", REFUSED_EXIT)
        fail(f"服务拒了这一条：{detail}", "照上面那句改了再提交", REFUSED_EXIT)
    if status != 200:
        fail(f"服务回 HTTP {status}：{reply.get('detail', reply)}", "看服务的日志：journalctl --user -u singlefs-task-server.service -n 100", 1)
    for line in reply.get("warnings") or []:   # 提交时警告（task_server.py 文件头 ②「提交时警告」）：照收照跑，警告打到标准错误
        print(line, file=sys.stderr, flush=True)
    sharded = reply.get("sharded") or ""
    print(f"{lib.SUBMIT_MARK} task={reply['id']} session={reply.get('session') or '无（人手）'}"
          f"{' sharded=' + sharded if sharded else ''} state={reply.get('state')}")
    tail = (f"人手交的没有会话可推，结局用 task-server/task wait {reply['id']} 取" if manual else
            f"结局、要处置的提醒与服务健康由服务直接发消息给这个会话，不必为了被叫醒起 wait；要取结局照样 task-server/task wait {reply['id']}")
    what = "（服务按分片跑：先排计划，再按计划拆片、合并）" if sharded else ""
    confirmation = reply.get("confirmation")
    if reply.get("state") == lib.AWAITING_CONFIRMATION_STATE and isinstance(confirmation, dict):   # 交任务的二次确认（task_server.py 文件头 ⑦）
        print_confirmation(reply["id"], confirmation, reply.get("confirm_timeout_seconds") or 0)
        print(f"  · 任务 {reply['id']} 待确认{what}：确认之后照提交时刻排进队；{tail}")
        return 0
    if reply.get("direct_queue"):   # 没判成长任务、不用确认（task_server.py 文件头 ⑦「只有长任务要确认」）：打一行为什么
        print(f"{lib.DIRECT_QUEUE_MARK}{reply['direct_queue']}")
    print(f"  · 任务 {reply['id']} 排进队了{what}；{tail}")
    return 0


def print_confirmation(task_id, confirmation, timeout_seconds):
    """确认单（服务回的 lines）照原样打到标准输出，末尾接 CONFIRM_NEEDED_MARK 那一行与确认的写法（数是服务算的）。"""
    for line in confirmation.get("lines") or []:
        print(line)
    items, tasks = confirmation.get("items", 0), confirmation.get("tasks", 0)
    print(lib.confirm_needed_line(task_id, items, tasks, timeout_seconds))
    print(f"  → 核对上面的范围、项数与在排在跑的那几条之后确认：{lib.confirm_command(task_id, items, tasks)}；不对的 task-server/task cancel {task_id}、改了重交", flush=True)


def confirm_long_run(task_id, why):
    """confirm <号> --why：确认这条任务确是要跑过两小时（文件头那一行；字数、会话、在不在跑与满没满界都由服务判）。"""
    configuration = prepare()
    code, reply = call_or_exit(configuration, "POST", f"/tasks/{task_id}/long-run-confirm", {"why": why})
    detail = reply.get("detail", reply)
    if code == 404:
        fail(f"没有任务 {task_id}", "task-server/task status 看这个会话的任务号", NO_SUCH_TASK_EXIT)
    if code == 403:
        fail(f"服务拒了这次确认：{detail}", "只有提交它的那个会话能确认它", REFUSED_EXIT)
    if code != 200:
        fail(f"服务没收这次确认（HTTP {code}：{detail}）", f"照上面那句改；task-server/task status {task_id} 看它此刻的状态", REFUSED_EXIT)
    print(f"  ✓ {detail}（状态 {reply.get('state')}）")
    return 0


