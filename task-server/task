NO_SUCH_TASK_EXIT = 4
CANCEL_UNCONFIRMED_EXIT = 5
CLEAN_LEFT_EXIT = 5
WAIT_SERVER_SECONDS = 20.0
FAST_WAIT_SERVER_SECONDS = 1.0
RECONNECT_SECONDS = 2.0
FAST_RECONNECT_SECONDS = 0.2
