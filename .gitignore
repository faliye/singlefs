/target/
# 任意层级的 cargo 产物（工作区建立之前在子目录编过，会留下陈旧的一份）
target/
*.img
*.qcow2
/.claude/singlefs-ai-sop/

# research/ 入库（2026-08-29 用户定案）：实验代码、单测、变异脚本、原始产物都要进仓，
# 因为决策正文把它们当依据引用——只在一台机器上的证据对第二个人不是证据。
# 只有构建产物除外，它由上面那条 `target/` 兜住（research/target 有 315 MB）。
/research/target/

.env

# 本机个人权限规则（含本机路径），不进仓
.claude/settings.local.json

# Python 字节码（门禁的 lib-*.py 被 import 时留下）
__pycache__/
