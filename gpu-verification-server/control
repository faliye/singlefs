    expect(problems, code == RUN_CONDITION_EXIT and "1111" in error and FAKE_MAIN_PROCESS in error,
           f"serving 指着旧进程号时 check 该退 {RUN_CONDITION_EXIT}、点名两个进程号，退了 {code}：{error.strip()}")
    return problems


def cell_stop_reads_back_stopped_unit(base, switches):
    problems = []
    for scenario in ("clean", "process-left", "restarted", "not-installed"):
        world = SelftestWorld(base, f"stop-{scenario}", gpu_configuration(LOCAL_ADDRESS), switches,
                              installed=scenario != "not-installed", unit_state="inactive" if scenario == "not-installed" else "active")
        if scenario == "process-left":
            world.write("fake/stop-leaves-process", "")
        if scenario == "restarted":
            world.write("fake/restarted-after-stop", "")
        code, output, error = world.run(["stop"])
        stopped = f"--user stop {UNIT_NAME}" in world.systemctl_calls()
        if scenario == "clean":
            expect(problems, code == 0 and stopped and "没被拉起" in output, f"stop 该 systemctl stop、退 0、说没被拉起，退了 {code}：{output.strip()[-300:]} {error.strip()}")
        elif scenario == "not-installed":
            expect(problems, code == 0 and not stopped and "没装" in output, f"没装时 stop 该退 0、说没装、不起 systemctl stop，退了 {code}：{output.strip()} {error.strip()}")
        else:
            expect(problems, code == READBACK_FAILED_EXIT, f"{scenario}：stop 该退 {READBACK_FAILED_EXIT}，退了 {code}：{output.strip()[-200:]} {error.strip()}")
    return problems


def cell_start_quiesces_the_named_cards_before_starting(base, switches):
    """清场过了才起（第二台的单元在跑：只看这一台点名的卡）；清场没过不起、退 78、出路点名清场日志（start 与 install 各一回）；单元在跑的不清场。"""
    problems = []
    passing = SelftestWorld(base, "quiesce-passes", gpu_configuration(LOCAL_ADDRESS, REMOTE_ADDRESS), switches, installed=True)
    passing.write("fake/peer-unit-state", "active\n")
    code, output, error = passing.run(["start"])
    calls = passing.quiesce_calls()
    expect(problems, code == 0 and started_here(passing), f"清场过了 start 该起单元、退 0，退了 {code}：{' '.join((output + error).split())[-300:]}")
    expect(problems, len(calls) == 1 and calls[0]["arguments"] == ["--", "true"] and not calls[0]["started_before"],
           f"起单元之前该清一次场（gpu-quiesce-run.sh -- true，那时还没 systemctl start）：{calls}")
    if calls:
        expect(problems, calls[0]["cards"] == f"{LOCAL_ADDRESS}:0:8G" and calls[0]["admitted"] == QUIESCE_ADMISSION_VALUE
               and calls[0]["configuration"] == os.path.join(passing.root, "multi-host.env"),
               f"清场该只看这一台点名的卡（{QUIESCE_CARDS_VARIABLE}={LOCAL_ADDRESS}:0:8G）、带准入标记与这一次的多机配置：{calls[0]}")
    for subcommand in ("start", "install"):
        world = SelftestWorld(base, f"quiesce-fails-{subcommand}", gpu_configuration(LOCAL_ADDRESS), switches, installed=subcommand == "start")
        world.write("fake/quiesce-exit", f"{RUN_CONDITION_EXIT}\n")
        arguments = ["start"] if subcommand == "start" else ["install", "--binary", os.path.join(world.root, "build", "gpu-verification-server")]
        code, output, error = world.run(arguments)
        said = " ".join(error.split())   # 压成一行：control 的 stderr 有「  ✗ 」起头的行，原样嵌进来会被读成别的格
        expect(problems, code == RUN_CONDITION_EXIT and not started_here(world) and os.path.join(world.root, FAKE_QUIESCE_LOG) in said and "假清场的出路" in said,
               f"清场没过时 {subcommand} 该不起单元、退 {RUN_CONDITION_EXIT}、出路点名清场日志并转打清场脚本的出路，退了 {code}，"
               f"systemctl {world.systemctl_calls()}：{said[-400:]}")
    running = SelftestWorld(base, "quiesce-running", gpu_configuration(LOCAL_ADDRESS), switches, installed=True, unit_state="active")
    running.write("fake/main-process", f"{FAKE_MAIN_PROCESS}\n")
    running.write(f"state/{SERVING_FILE_NAME}", f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS} oldest_pending_wait_limit_milliseconds=500 intake=none\n")
    code, _, error = running.run(["start"])
    expect(problems, code == 0 and not running.quiesce_calls(),
           f"单元在跑时 start 该退 0、不清场（卡在它手里），退了 {code}，清场 {running.quiesce_calls()}：{' '.join(error.split())[-300:]}")
    return problems


def cell_start_quiesces_once_on_this_host_before_any_unit_starts(base, switches):
    """两台都点名了卡：发起的这一台只清一次场，在这一台 systemctl start 与转去第二台的 start 之前，罩住要起的那几台的卡（在跑的那一台的卡不进）；
    两台都在跑不清场。第二台在不在跑经 fake-ssh 起 control unit-state 问。"""
    problems = []
    local_card, remote_card = f"{LOCAL_ADDRESS}:0:8G", f"{REMOTE_ADDRESS}:0:8G"
    for scenario, here_running, peer_running, expected_cards in (("both-stopped", False, False, f"{local_card} {remote_card}"),
                                                                  ("peer-stopped", True, False, remote_card),
                                                                  ("both-running", True, True, None)):
        world = SelftestWorld(base, f"quiesce-once-{scenario}", gpu_configuration(LOCAL_ADDRESS, REMOTE_ADDRESS), switches, installed=True,
                              unit_state="active" if here_running else "inactive")
        if here_running:
            world.write("fake/main-process", f"{FAKE_MAIN_PROCESS}\n")
            world.write(f"state/{SERVING_FILE_NAME}", f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS} oldest_pending_wait_limit_milliseconds=500 intake=none\n")
        world.write("fake/peer-unit-state", "active\n" if peer_running else "inactive\n")
        code, output, error = world.run(["start"])
        said = " ".join((output + error).split())[-300:]   # 压成一行：control 的 stderr 有「  ✗ 」起头的行
        calls = world.quiesce_calls()
        expect(problems, code == 0 and len(forwarded_calls(world, "start")) == 1,
               f"{scenario}：start 该退 0、转去第二台的 start 一次，退了 {code}、ssh {world.ssh_calls()}：{said}")
        expect(problems, any(remote_words(call)[-1:] == ["unit-state"] for call in world.ssh_calls()),
               f"{scenario}：清场之前该经 ssh 问第二台的单元在不在跑（control unit-state），ssh 收到 {world.ssh_calls()}")
        if expected_cards is None:
            expect(problems, not calls, f"{scenario}：两台都在跑不该清场，清场脚本收到 {calls}")
            continue
        expect(problems, len(calls) == 1, f"{scenario}：清场该只起一次（只在发起的这一台），起了 {len(calls)} 次：{calls}")
        if not calls:
            continue
        started_by_ssh = [remote for remote in calls[0]["ssh_remote_before"] if forwarded_subcommand_of(remote) in ("start", "install")]
        expect(problems, not calls[0]["started_before"] and not started_by_ssh,
               f"{scenario}：清场该在起任何一台的单元之前（那时这一台没 systemctl start、也没转去第二台起），这一台起过：{calls[0]['started_before']}，"
               f"转去起过：{started_by_ssh}")
        expect(problems, calls[0]["cards"] == expected_cards, f"{scenario}：清场该罩住要起的那几台的卡（{QUIESCE_CARDS_VARIABLE}={expected_cards}），交的是 {calls[0]['cards']}")
    return problems


def cell_install_stops_then_quiesces_then_starts(base, switches):
    """两台的单元都在跑，install --binary 换版（文件头「install 换版：先停、再清场、再起」）：先停这一台（systemctl stop）与第二台
    （经 ssh 起 control stop），再清一次场、罩住两台点名的全部卡，清场过了这一台才 start 新版、第二台才转 install；
    清场没过（假清场退 78）新版一台都没装，停掉的两台照旧二进制起回来（这一台 stop 之后又 start，第二台 stop 之后转去 start）、退 78、说起回来了。"""
    problems = []
    stop_call, start_call = f"--user stop {UNIT_NAME}", f"--user start {UNIT_NAME}"
    both_cards = f"{LOCAL_ADDRESS}:0:8G {REMOTE_ADDRESS}:0:8G"
    for scenario in ("quiesce-passes", "quiesce-fails"):
        world = SelftestWorld(base, f"install-order-{scenario}", gpu_configuration(LOCAL_ADDRESS, REMOTE_ADDRESS), switches, installed=True,
                              unit_state="active")
        world.write("fake/main-process", f"{FAKE_MAIN_PROCESS}\n")
        world.write(f"state/{SERVING_FILE_NAME}", f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS} oldest_pending_wait_limit_milliseconds=500 intake=none\n")
        world.write("fake/peer-unit-state", "active\n")
        source = world.write("build/gpu-verification-server", FAKE_BINARY + "# 这一次新编的\n", executable=True)
        if scenario == "quiesce-fails":
            world.write("fake/quiesce-exit", f"{RUN_CONDITION_EXIT}\n")
        code, output, error = world.run(["install", "--binary", source])
        said = " ".join((output + error).split())   # 压成一行：control 的 stderr 有「  ✗ 」起头的行
        calls, quiesces = world.systemctl_calls(), world.quiesce_calls()
        here_restarted = stop_call in calls and start_call in calls[calls.index(stop_call):]
        peer_steps = [step for step in (forwarded_subcommand_of(call[-1]) for call in world.ssh_calls()) if step != "unit-state"]
        expect(problems, len(quiesces) == 1, f"{scenario}：该清一次场，清场脚本收到 {quiesces}")
        if quiesces:
            steps_before = [step for step in (forwarded_subcommand_of(remote) for remote in quiesces[0]["ssh_remote_before"]) if step != "unit-state"]
            expect(problems, quiesces[0]["stopped_before"] and steps_before == ["stop"] and not quiesces[0]["started_before"],
                   f"{scenario}：清场那时在跑的两台该都停过（这一台 systemctl stop、第二台转去 stop）、还没起，这一台停过：{quiesces[0]['stopped_before']}，"
                   f"转去第二台的：{steps_before}")
            expect(problems, quiesces[0]["cards"] == both_cards,
                   f"{scenario}：停了之后清场该罩住两台点名的全部卡（{QUIESCE_CARDS_VARIABLE}={both_cards}），交的是 {quiesces[0]['cards']}")
        installed = os.path.join(world.root, "bin", BINARY_NAME)
        if scenario == "quiesce-passes":
            expect(problems, code == 0 and here_restarted and peer_steps == ["stop", "install"],
                   f"{scenario}：该退 0、这一台 stop 之后 start、第二台先转 stop 再转 install，退了 {code}，systemctl {calls}，转去第二台 {peer_steps}：{said[-300:]}")
            expect(problems, file_sha256(installed) == file_sha256(source), f"{scenario}：装好的二进制该与 --binary 给的逐字节相同")
            continue
        expect(problems, code == RUN_CONDITION_EXIT and here_restarted and peer_steps == ["stop", "start"] and "起回来" in said,
               f"{scenario}：清场没过时停掉的两台该照旧二进制起回来（这一台 stop 之后 start、第二台先转 stop 再转 start、不转 install）、退 {RUN_CONDITION_EXIT}、"
               f"说起回来，退了 {code}，systemctl {calls}，转去第二台 {peer_steps}：{said[-300:]}")
        expect(problems, file_sha256(installed) != file_sha256(source), f"{scenario}：清场没过时这一台装着的该还是换版之前的二进制")
        expect(problems, os.path.join(world.root, FAKE_QUIESCE_LOG) in said and "假清场的出路" in said,
               f"{scenario}：出路该点名清场日志、转打清场脚本的出路：{said[-400:]}")
    return problems


def cell_check_refuses_unit_without_cargo(base, switches):
    """单元在跑、serving 对得上，而单元环境里没有 CARGO、或 CARGO 指的文件这台没有：check 退 78、点名 CARGO 与出路（装好的单元带它时 check 退 0，
    check-refuses-when-gpu-on-and-service-down 那一格核）。"""
    problems = []
    for scenario in ("no-cargo", "cargo-missing-on-this-host"):
        world = SelftestWorld(base, f"check-{scenario}", gpu_configuration(LOCAL_ADDRESS), switches, installed=True, unit_state="active")
        world.write("fake/main-process", f"{FAKE_MAIN_PROCESS}\n")
        world.write(f"state/{SERVING_FILE_NAME}", f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS} oldest_pending_wait_limit_milliseconds=500 intake=none\n")
        missing = os.path.join(world.root, "nowhere", "cargo")
        cargo_line = "" if scenario == "no-cargo" else f"Environment={UNIT_CARGO_VARIABLE}={missing}\n"
        world.write(f"systemd/{UNIT_NAME}", f"[Service]\n{cargo_line}RestartSec=3\n")
        code, output, error = world.run(["check"])
        said = " ".join((output + error).split())   # 压成一行：check 的 stderr 有「  ✗ 」起头的行
        named = f"{UNIT_CARGO_VARIABLE}={missing}" if scenario != "no-cargo" else f"没有 {UNIT_CARGO_VARIABLE}"
        expect(problems, code == RUN_CONDITION_EXIT and named in said and CARGO_DIRECTORY_KEY in said and "control install" in said,
               f"{scenario}：check 该退 {RUN_CONDITION_EXIT}、点名「{named}」、出路写 {CARGO_DIRECTORY_KEY} 与重装，退了 {code}：{said[-400:]}")
    return problems


def serving_line_prefixes_of_the_source():
    """src/serving_from_the_library.rs 里卡坏与接住 Out of Memory 两行的开头：(卡坏, 接住, None)；读不到回 (None, None, 原因)。"""
    try:
        with open(SERVING_FROM_THE_LIBRARY_SOURCE, encoding="utf-8") as handle:
            source = handle.read()
    except OSError as error:
        return None, None, f"读不了 {SERVING_FROM_THE_LIBRARY_SOURCE}（{type(error).__name__}: {error}）"
    failed = re.search(r'pub const CARD_FAILED_LINE_PREFIX: &str = "([^"]+)";', source)
    caught = re.search(r'pub const OUT_OF_MEMORY_CAUGHT_LINE_PREFIX: &str = "([^"]+)";', source)
    if not failed or not caught:
        return None, None, f"{SERVING_FROM_THE_LIBRARY_SOURCE} 里找不到 CARD_FAILED_LINE_PREFIX 或 OUT_OF_MEMORY_CAUGHT_LINE_PREFIX 的定义"
    return failed.group(1), caught.group(1), None


def block_not_judgeable_prefix_of_the_source():
    """src/serving_from_the_library.rs 里判不了那一行的开头：(开头, None)；读不到回 (None, 原因)。"""
    try:
        with open(SERVING_FROM_THE_LIBRARY_SOURCE, encoding="utf-8") as handle:
            source = handle.read()
    except OSError as error:
        return None, f"读不了 {SERVING_FROM_THE_LIBRARY_SOURCE}（{type(error).__name__}: {error}）"
    found = re.search(r'pub const BLOCK_NOT_JUDGEABLE_LINE_PREFIX: &str = "([^"]+)";', source)
    if not found:
        return None, f"{SERVING_FROM_THE_LIBRARY_SOURCE} 里找不到 BLOCK_NOT_JUDGEABLE_LINE_PREFIX 的定义"
    return found.group(1), None


SELFTEST_BLOCK_NOT_JUDGEABLE_LINE = (f'{BLOCK_NOT_JUDGEABLE_LINE_PREFIX} family=image-judgement stream=0a0b0c0d0e0f1011 block=12 card=0 '
                                     'why=out-of-memory-on-an-emptied-card claim=released reason="wgpu error: Out of Memory"')
SELFTEST_CARD_FAILED_LINE = (f'{CARD_FAILED_LINE_PREFIX} card=1 nvidia_smi_index=7 name="Selftest Card" pci=0000:65:00.0 device_lost=yes '
                             'reason="wgpu error: device lost"')
SELFTEST_OUT_OF_MEMORY_CAUGHT_LINE = (f'{OUT_OF_MEMORY_CAUGHT_LINE_PREFIX} card=0 judges_dropped=3 blocks_put_back=1 blocks_refused=0 '
                                      'facts_jobs_put_back=0 facts_jobs_refused=0 put_back=ab/1 refused=- reason="wgpu error: Out of Memory"')


def card_failure_world(base, label, switches, entries, configuration=None):
    """卡坏那几格的自证根：装好、在跑（主进程号 4242），fake/journal 写 entries（每条一个 JSON）。"""
    world = SelftestWorld(base, label, configuration or gpu_configuration(LOCAL_ADDRESS), switches, installed=True, unit_state="active")
    world.write("fake/main-process", f"{FAKE_MAIN_PROCESS}\n")
    world.write(f"state/{SERVING_FILE_NAME}", f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS} oldest_pending_wait_limit_milliseconds=500 intake=none\n")
    world.write("fake/journal", "".join(json.dumps(entry) + "\n" for entry in entries))
    return world


def cell_check_reports_card_failure_of_this_process(base, switches):
    """此刻的进程打了卡坏行：check 退 1、点名那张卡（序号、卡名、PCI）与「请用户重置」的出路；只有接住 Out of Memory 行、只有旧进程打过卡坏行、
    一行都没有：退 0。读的是这一个进程（journalctl 收到 _PID=<主进程号>）。两行的开头从 src/serving_from_the_library.rs 读来核。"""
    failed_prefix, caught_prefix, unreadable = serving_line_prefixes_of_the_source()
    if failed_prefix is None:
        return [unreadable]
    problems = []
    expect(problems, (failed_prefix, caught_prefix) == (CARD_FAILED_LINE_PREFIX, OUT_OF_MEMORY_CAUGHT_LINE_PREFIX),
           f"control 认的开头（{CARD_FAILED_LINE_PREFIX}、{OUT_OF_MEMORY_CAUGHT_LINE_PREFIX}）与服务打的（{failed_prefix}、{caught_prefix}）不同")
    serving = {"MESSAGE": f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS}", "_PID": FAKE_MAIN_PROCESS}
    journals = {"no-failure": [serving],
                "out-of-memory-caught-only": [serving, {"MESSAGE": SELFTEST_OUT_OF_MEMORY_CAUGHT_LINE, "_PID": FAKE_MAIN_PROCESS}],
                "this-process": [serving, {"MESSAGE": SELFTEST_CARD_FAILED_LINE, "_PID": FAKE_MAIN_PROCESS}],
                "earlier-process": [{"MESSAGE": SELFTEST_CARD_FAILED_LINE, "_PID": "1111"}, serving]}
    for scenario, entries in journals.items():
        world = card_failure_world(base, f"card-failure-{scenario}", switches, entries)
        code, output, error = world.run(["check"])
        said = " ".join((output + error).split())
        if scenario == "this-process":
            expect(problems, code == CARD_FAILED_EXIT and "卡 1" in said and "nvidia-smi 序号 7" in said and "Selftest Card" in said
                   and "PCI 0000:65:00.0" in said and "设备丢了：yes" in said and "wgpu error: device lost" in said and "重置" in said
                   and "control stop" in said and "control start" in said,
                   f"此刻的进程打了卡坏行时 check 该退 {CARD_FAILED_EXIT}、点名那张卡与重置的出路，退了 {code}：{said[-500:]}")
        else:
            expect(problems, code == 0, f"{scenario}：check 该退 0，退了 {code}：{said[-300:]}")
        reads = world.journalctl_calls()
        expect(problems, any(f"_PID={FAKE_MAIN_PROCESS}" in call and "-b" in call.split() for call in reads),
               f"{scenario}：check 该读这一次开机里主进程 {FAKE_MAIN_PROCESS} 的日志，journalctl 收到 {reads}")
    return problems


def cell_cards_failed_reads_every_host(base, switches):
    """两台都点名了卡：这一台读自己的卡坏行与判不了的行，第二台经 fake-ssh 起 control cards-failed（转来的标记）读它那一台的、照它的地址打；
    第二台连不上记 unreachable，另打一行没读成；只有接住 Out of Memory 行的不打；都退 0。没开 GPU 退 0、只打 why=gpu-off。"""
    problems = []
    peer_lines = (f"{CARDS_FAILED_READ_PREFIX} host={THIS_HOST_LABEL} state=read lines=2\n"
                  f"{FAILED_CARD_OF_A_HOST_PREFIX} host={THIS_HOST_LABEL} process=5151 {SELFTEST_CARD_FAILED_LINE}\n"
                  f"{BLOCK_NOT_JUDGEABLE_OF_A_HOST_PREFIX} host={THIS_HOST_LABEL} process=5151 {SELFTEST_BLOCK_NOT_JUDGEABLE_LINE}\n")
    serving = {"MESSAGE": f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS}", "_PID": FAKE_MAIN_PROCESS}
    here_entries = [serving, {"MESSAGE": SELFTEST_CARD_FAILED_LINE, "_PID": FAKE_MAIN_PROCESS},
                    {"MESSAGE": SELFTEST_OUT_OF_MEMORY_CAUGHT_LINE, "_PID": FAKE_MAIN_PROCESS},
                    {"MESSAGE": SELFTEST_BLOCK_NOT_JUDGEABLE_LINE, "_PID": FAKE_MAIN_PROCESS}]
    here_lines = [f"{CARDS_FAILED_READ_PREFIX} host={THIS_HOST_LABEL} state=read lines=2",
                  f"{FAILED_CARD_OF_A_HOST_PREFIX} host={THIS_HOST_LABEL} process={FAKE_MAIN_PROCESS} {SELFTEST_CARD_FAILED_LINE}",
                  f"{BLOCK_NOT_JUDGEABLE_OF_A_HOST_PREFIX} host={THIS_HOST_LABEL} process={FAKE_MAIN_PROCESS} {SELFTEST_BLOCK_NOT_JUDGEABLE_LINE}"]
    for scenario, ssh_exit, expected_lines in (
            ("both-read", 0, here_lines + [f"{CARDS_FAILED_READ_PREFIX} host={REMOTE_ADDRESS} state=read lines=2",
                                           f"{FAILED_CARD_OF_A_HOST_PREFIX} host={REMOTE_ADDRESS} process=5151 {SELFTEST_CARD_FAILED_LINE}",
                                           f"{BLOCK_NOT_JUDGEABLE_OF_A_HOST_PREFIX} host={REMOTE_ADDRESS} process=5151 {SELFTEST_BLOCK_NOT_JUDGEABLE_LINE}"]),
            ("peer-unreachable", SSH_FAILURE_EXIT, here_lines + [f"{CARDS_FAILED_READ_PREFIX} host={REMOTE_ADDRESS} state={CARDS_FAILED_UNREACHABLE} lines=0",
                                                                 f"{CARDS_FAILED_UNREAD_PREFIX} host={REMOTE_ADDRESS} state={CARDS_FAILED_UNREACHABLE}"])):
        world = card_failure_world(base, f"cards-failed-{scenario}", switches, here_entries, configuration=gpu_configuration(LOCAL_ADDRESS, REMOTE_ADDRESS))
        world.write("fake/ssh-exit", f"{ssh_exit}\n")
        world.write("fake/peer-cards-failed", peer_lines)
        code, output, error = world.run(["cards-failed"])
        expect(problems, code == 0 and output.splitlines() == expected_lines,
               f"{scenario}：cards-failed 该退 0、标准输出恰好是 {expected_lines}，退了 {code}、打了 {output.splitlines()}：{error.strip()[-300:]}")
        calls = forwarded_calls(world, "cards-failed")
        expect(problems, len(calls) == 1 and remote_words(calls[0]) == expected_remote_words(["cards-failed"]),
               f"{scenario}：该经 ssh 起一次 {expected_remote_words(['cards-failed'])}，ssh 收到 {world.ssh_calls()}")
    world = card_failure_world(base, "cards-failed-gpu-off", switches, here_entries, configuration=gpu_configuration(LOCAL_ADDRESS, gpu="0"))
    code, output, error = world.run(["cards-failed"])
    expect(problems, code == 0 and output.splitlines() == [f"{CARDS_FAILED_READ_PREFIX} why=gpu-off"] and not world.ssh_calls() and not world.journalctl_calls(),
           f"没开 GPU：cards-failed 该退 0、只打 why=gpu-off、不读日志不连第二台，退了 {code}、打了 {output.splitlines()}")
    return problems


def cell_check_reports_block_not_judgeable_of_this_process(base, switches):
    """此刻的进程打了判不了的行（文件头「判不了」）：check 退 1、点名那一族那一块、哪张卡、为什么与「放给另一台、不要重置卡」的出路；
    只有旧进程打过判不了的行：退 0。那一行的开头从 src/serving_from_the_library.rs 读来核。"""
    prefix, unreadable = block_not_judgeable_prefix_of_the_source()
    if prefix is None:
        return [unreadable]
    problems = []
    expect(problems, prefix == BLOCK_NOT_JUDGEABLE_LINE_PREFIX,
           f"control 认的开头（{BLOCK_NOT_JUDGEABLE_LINE_PREFIX}）与服务打的（{prefix}）不同")
    serving = {"MESSAGE": f"{SERVING_LINE_PREFIX} pid={FAKE_MAIN_PROCESS}", "_PID": FAKE_MAIN_PROCESS}
    journals = {"this-process": [serving, {"MESSAGE": SELFTEST_BLOCK_NOT_JUDGEABLE_LINE, "_PID": FAKE_MAIN_PROCESS}],
                "earlier-process": [{"MESSAGE": SELFTEST_BLOCK_NOT_JUDGEABLE_LINE, "_PID": "1111"}, serving]}
    for scenario, entries in journals.items():
        world = card_failure_world(base, f"block-not-judgeable-{scenario}", switches, entries)
        code, output, error = world.run(["check"])
        said = " ".join((output + error).split())
        if scenario == "this-process":
            expect(problems, code == CARD_FAILED_EXIT and "image-judgement" in said and "0a0b0c0d0e0f1011" in said and "块 12" in said
                   and "卡 0" in said and "out-of-memory-on-an-emptied-card" in said and "另一台" in said and "不要重置卡" in said,
                   f"此刻的进程打了判不了的行时 check 该退 {CARD_FAILED_EXIT}、点名那一块与出路，退了 {code}：{said[-500:]}")
        else:
            expect(problems, code == 0, f"{scenario}：check 该退 0，退了 {code}：{said[-300:]}")
    return problems


# 装好的假二进制（lease 那几格）：参数、环境里借的一方与格里给的记号逐次记进 fake/binary-calls.log，标准输出、标准错误各打一行，退 fake/binary-exit
FAKE_LEASE_BINARY = """#!{python}
import json, os, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
with open(os.path.join(root, "fake", "binary-calls.log"), "a", encoding="utf-8") as handle:
    handle.write(json.dumps({{"arguments": sys.argv[1:], "borrower": os.environ.get({borrower!r}), "marker": os.environ.get({marker!r})}}) + "\\n")
print({output!r} + " ".join(sys.argv[1:]), flush=True)
print({error!r}, file=sys.stderr, flush=True)
with open(os.path.join(root, "fake", "binary-exit"), encoding="utf-8") as handle:
    sys.exit(int(handle.read().strip()))
"""
FAKE_LEASE_BINARY_OUTPUT = "binary standard output "
FAKE_LEASE_BINARY_ERROR = "binary standard error"
FAKE_LEASE_BINARY_EXIT = 37
LEASE_SELFTEST_MARKER_VARIABLE = "GPU_VERIFICATION_SERVER_CONTROL_SELFTEST_MARKER"
LEASE_SELFTEST_BORROWER = "4242:987654"
LEASE_SELFTEST_CARD_STRING = f"{LOCAL_ADDRESS}:0:8G {LOCAL_ADDRESS}:1:4G"


def lease_world(base, label, switches, installed=True):
    """lease 那几格的自证根：两台都点名了卡；installed 时装的是记调用的假二进制。"""
    world = SelftestWorld(base, label, gpu_configuration(LOCAL_ADDRESS, REMOTE_ADDRESS), switches, installed=installed)
    if installed:
        world.write(f"bin/{BINARY_NAME}", FAKE_LEASE_BINARY.format(python=sys.executable, borrower=LEASE_BORROWER_VARIABLE, marker=LEASE_SELFTEST_MARKER_VARIABLE,
                                                                   output=FAKE_LEASE_BINARY_OUTPUT, error=FAKE_LEASE_BINARY_ERROR), executable=True)
        world.write("fake/binary-exit", f"{FAKE_LEASE_BINARY_EXIT}\n")
    return world


def lease_binary_calls(world):
    return [json.loads(line) for line in world.lines_of("fake/binary-calls.log") if line.strip()]


def cell_lease_passes_through_to_the_binary_of_this_host(base, switches):
    world = lease_world(base, "lease-through", switches)
    environment = {LEASE_BORROWER_VARIABLE: LEASE_SELFTEST_BORROWER, LEASE_SELFTEST_MARKER_VARIABLE: "kept"}
    problems = []
    for arguments in (["take"], ["return", LEASE_SELFTEST_CARD_STRING]):
        code, output, error = world.run([LEASE_SUBCOMMAND, *arguments], extra=environment)
        expect(problems, code == FAKE_LEASE_BINARY_EXIT, f"lease {arguments[0]} 该退二进制的 {FAKE_LEASE_BINARY_EXIT}，退了 {code}：{error.strip()}")
        expected_output = FAKE_LEASE_BINARY_OUTPUT + " ".join([LEASE_SUBCOMMAND, *arguments]) + "\n"
        expect(problems, output == expected_output, f"lease {arguments[0]} 的标准输出该是二进制打的原样「{expected_output.strip()}」，是「{output.strip()}」")
        expect(problems, error == FAKE_LEASE_BINARY_ERROR + "\n", f"lease {arguments[0]} 的标准错误该是二进制打的原样，是「{error.strip()}」")
    expected_calls = [{"arguments": [LEASE_SUBCOMMAND, *arguments], "borrower": LEASE_SELFTEST_BORROWER, "marker": "kept"}
                      for arguments in (["take"], ["return", LEASE_SELFTEST_CARD_STRING])]
    expect(problems, lease_binary_calls(world) == expected_calls, f"二进制该收到原样的参数与环境 {expected_calls}，收到 {lease_binary_calls(world)}")
    expect(problems, not world.ssh_calls(), f"lease 不转去第二台，fake-ssh 收到了 {world.ssh_calls()}")
    expect(problems, not world.systemctl_calls() and not world.quiesce_calls(), "lease 不碰单元、不清场")
    return problems


def cell_lease_without_the_installed_binary_refused_with_the_install_howto(base, switches):
    world = lease_world(base, "lease-not-installed", switches, installed=False)
    problems = []
    for arguments in (["take"], ["return", LEASE_SELFTEST_CARD_STRING]):
        code, _, error = world.run([LEASE_SUBCOMMAND, *arguments], extra={LEASE_BORROWER_VARIABLE: LEASE_SELFTEST_BORROWER})
        expect(problems, code == RUN_CONDITION_EXIT and "control install --binary" in error,
               f"没装时 lease {arguments[0]} 该退 {RUN_CONDITION_EXIT}、出路写装法，退了 {code}：{error.strip()}")
    expect(problems, not world.ssh_calls(), f"lease 不转去第二台，fake-ssh 收到了 {world.ssh_calls()}")
    return problems


def cell_lease_forms_other_than_take_return_and_list_refused(base, switches):
    world = lease_world(base, "lease-forms", switches)
    problems = []
    for arguments in ([], ["renew"], ["take", "extra"], ["return"], ["return", LEASE_SELFTEST_CARD_STRING, LEASE_SELFTEST_CARD_STRING],
                      ["return", "", ""], ["list", "extra"], ["borrow"]):
        code, _, error = world.run([LEASE_SUBCOMMAND, *arguments], extra={LEASE_BORROWER_VARIABLE: LEASE_SELFTEST_BORROWER})
        expect(problems, code == USAGE_EXIT, f"lease {' '.join(arguments)} 该退 {USAGE_EXIT}，退了 {code}：{error.strip()}")
    expect(problems, not lease_binary_calls(world), f"认不出的写法不该转给二进制，它收到 {lease_binary_calls(world)}")
    return problems


def cell_lease_return_passes_an_empty_card_string_through(base, switches):
    world = lease_world(base, "lease-empty-card-string", switches)
    card_strings = ("", " ")
    problems = []
    for card_string in card_strings:
        code, _, error = world.run([LEASE_SUBCOMMAND, "return", card_string], extra={LEASE_BORROWER_VARIABLE: LEASE_SELFTEST_BORROWER})
        expect(problems, code == FAKE_LEASE_BINARY_EXIT, f"lease return {card_string!r} 该退二进制的 {FAKE_LEASE_BINARY_EXIT}，退了 {code}：{error.strip()}")
        expect(problems, error == FAKE_LEASE_BINARY_ERROR + "\n", f"lease return {card_string!r} 的标准错误该是二进制打的原样，是「{error.strip()}」")
    expected_arguments = [[LEASE_SUBCOMMAND, "return", card_string] for card_string in card_strings]
    received_arguments = [call["arguments"] for call in lease_binary_calls(world)]
    expect(problems, received_arguments == expected_arguments,
           f"二进制该收到原样的参数（卡串那一项是空串、只有空白的串）{expected_arguments}，收到 {received_arguments}")
    return problems


def cell_lease_list_passes_through_to_the_binary_of_this_host(base, switches):
    """lease list 不带借的一方的变量也原样转给这一台的二进制：退出码、标准输出、标准错误都是二进制的，二进制收到的参数是 lease list、环境里没有借的一方。"""
    world = lease_world(base, "lease-list", switches)
    problems = []
    code, output, error = world.run([LEASE_SUBCOMMAND, "list"], extra={LEASE_SELFTEST_MARKER_VARIABLE: "kept"}, dropped=(LEASE_BORROWER_VARIABLE,))
    expect(problems, code == FAKE_LEASE_BINARY_EXIT, f"lease list 该退二进制的 {FAKE_LEASE_BINARY_EXIT}，退了 {code}：{error.strip()}")
    expected_output = FAKE_LEASE_BINARY_OUTPUT + f"{LEASE_SUBCOMMAND} list\n"
    expect(problems, output == expected_output, f"lease list 的标准输出该是二进制打的原样「{expected_output.strip()}」，是「{output.strip()}」")
    expect(problems, error == FAKE_LEASE_BINARY_ERROR + "\n", f"lease list 的标准错误该是二进制打的原样，是「{error.strip()}」")
    expected_calls = [{"arguments": [LEASE_SUBCOMMAND, "list"], "borrower": None, "marker": "kept"}]
    expect(problems, lease_binary_calls(world) == expected_calls, f"二进制该收到原样的参数与环境 {expected_calls}，收到 {lease_binary_calls(world)}")
    expect(problems, not world.ssh_calls(), f"lease list 不转去第二台，fake-ssh 收到了 {world.ssh_calls()}")
    return problems


SELFTEST_CELLS = {
    "gpu-off-start-and-check-do-nothing": cell_gpu_off_start_and_check_do_nothing,
