    "start-reads-back-serving-pid": cell_start_reads_back_serving_pid,
    "check-refuses-when-gpu-on-and-service-down": cell_check_refuses_when_gpu_on_and_service_down,
    "check-refuses-stale-serving-file": cell_check_refuses_stale_serving_file,
    "stop-reads-back-stopped-unit": cell_stop_reads_back_stopped_unit,
    "start-quiesces-the-named-cards-before-starting": cell_start_quiesces_the_named_cards_before_starting,
    "start-quiesces-once-on-this-host-before-any-unit-starts": cell_start_quiesces_once_on_this_host_before_any_unit_starts,
    "install-stops-then-quiesces-then-starts": cell_install_stops_then_quiesces_then_starts,
    "check-refuses-unit-without-cargo": cell_check_refuses_unit_without_cargo,
    "lease-passes-through-to-the-binary-of-this-host": cell_lease_passes_through_to_the_binary_of_this_host,
    "lease-without-the-installed-binary-refused-with-the-install-howto": cell_lease_without_the_installed_binary_refused_with_the_install_howto,
    "lease-forms-other-than-take-return-and-list-refused": cell_lease_forms_other_than_take_return_and_list_refused,
    "lease-list-passes-through-to-the-binary-of-this-host": cell_lease_list_passes_through_to_the_binary_of_this_host,
    "lease-return-passes-an-empty-card-string-through": cell_lease_return_passes_an_empty_card_string_through,
    "check-reports-card-failure-of-this-process": cell_check_reports_card_failure_of_this_process,
    "cards-failed-reads-every-host": cell_cards_failed_reads_every_host,
    "check-reports-block-not-judgeable-of-this-process": cell_check_reports_block_not_judgeable_of_this_process,
}


def selftest():
    switches = [item.strip() for item in os.environ.get(CONTROL_BREAK_VARIABLE, "").split(",") if item.strip()]
    unknown = [item for item in switches if item not in SELFTEST_SWITCH_CELLS]
    if unknown:
        return fail(f"{CONTROL_BREAK_VARIABLE} 里认不出 {'、'.join(unknown)}", f"认得的：{'、'.join(SELFTEST_SWITCH_CELLS)}（文件头「自证」）", USAGE_EXIT)
    dangling = sorted({cell for cells in SELFTEST_SWITCH_CELLS.values() for cell in cells} - set(SELFTEST_CELLS))
    if dangling:
        return fail(f"开关表点名的格 {'、'.join(dangling)} 不在格表里", "改 SELFTEST_SWITCH_CELLS 与 SELFTEST_CELLS 对上", READBACK_FAILED_EXIT)
    heavy_threads = load_module_by_path("heavy_threads", HEAVY_THREADS)
    try:
        parallelism = heavy_threads.default_heavy_threads()
    except heavy_threads.HeavyThreadDefaultError as error:
        return fail(f"取不了每台默认重活线程数：{error}", error.howto, READBACK_FAILED_EXIT)
    base = os.path.realpath(tempfile.mkdtemp(prefix="gpu-verification-server-control-selftest-"))
    results = {}
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=parallelism) as pool:
            futures = {name: pool.submit(function, base, [item for item in switches if name in SELFTEST_SWITCH_CELLS[item]])
                       for name, function in SELFTEST_CELLS.items()}
            for name, future in futures.items():
                try:
                    results[name] = future.result()
                except Exception as error:   # 一格自己崩了算红，不吃掉
                    results[name] = [f"这一格自己崩了：{type(error).__name__}: {error}"]
    finally:
        shutil.rmtree(base, ignore_errors=True)
    failed = [name for name in SELFTEST_CELLS if results.get(name) != []]
    for name in SELFTEST_CELLS:
        if name in failed:
            print(f"  ✗ {name}：{'；'.join(results.get(name) or ['没有结果'])}", flush=True)   # gate-lint:detail
        else:
            say(f"  ✓ {name}")
    say(f"{SELFTEST_SUMMARY_PREFIX} cells={len(SELFTEST_CELLS)} failed={len(failed)} 并行 {parallelism} 路 break={','.join(switches) or '-'}")
    return 1 if failed or len(results) != len(SELFTEST_CELLS) else 0


def main(arguments):
    if arguments == ["--selftest"]:
        return selftest()
    if os.environ.get(CONTROL_BREAK_VARIABLE) and not os.environ.get(SELFTEST_ROOT_VARIABLE):
        return fail(f"{CONTROL_BREAK_VARIABLE} 只在自证里认（设了 {SELFTEST_ROOT_VARIABLE} 时，或 --selftest）", f"不设 {CONTROL_BREAK_VARIABLE} 再跑", USAGE_EXIT)
    if arguments == ["unit-state"]:
        return unit_state_here()
    if arguments[:1] == ["cards-failed"]:
        return cards_failed(arguments[1:])
    if arguments[:1] == [LEASE_SUBCOMMAND]:
        return lease(arguments[1:])
    parsed = parse_arguments(arguments)
    if parsed is None:
        return fail(f"认不出「{' '.join(arguments)}」",
                    "写成 python3 gpu-verification-server/control install [--dry-run] [--binary <编好的 gpu-verification-server>] | start | stop | check | unit-state"
                    " | cards-failed | lease take | lease return <卡串，可以是空串> | lease list | --selftest",
                    USAGE_EXIT)
    subcommand, here_step, forwarded_arguments = parsed
    if os.environ.get(FORWARDED_VARIABLE) and not control_broken("forwarded-call-forwards-again"):
        return here_step()
    return run_on_the_hosts(subcommand, here_step, forwarded_arguments)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
