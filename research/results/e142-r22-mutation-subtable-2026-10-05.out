## 附录：check_anchors.py 全文与输出（206 行锚点逐条恰好命中一次）
# 逐条核变异表：原文（\n 还原成换行）在源码里恰好命中一次。用法：check_anchors.py <源文件> <变异表>
import sys
src = open(sys.argv[1], encoding="utf-8").read()
bad = 0; rows = 0
for number, line in enumerate(open(sys.argv[2], encoding="utf-8").read().split("\n"), 1):
    if not line.strip():
        continue
    rows += 1
    parts = line.split("\t")
    if len(parts) != 3:
        print("行", number, "不是三段", len(parts)); bad += 1; continue
    anchor = parts[1].replace("\\n", "\n")
    count = src.count(anchor)
    if count != 1:
        print("行", number, parts[0], "命中", count); bad += 1
print("rows", rows, "bad", bad)
rows 206 bad 0
