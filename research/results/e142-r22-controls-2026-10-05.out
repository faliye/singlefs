#!/usr/bin/env bash
# E142 第 22 次重跑步 ③(10)：第五节 5.2 的阳性对照与第七节 7.2 复算。仓根起跑。输出全文进 research/results/e142-r22-controls-2026-10-05.out。
cd /home/fy5090/code/singlefs
D=/tmp/claude-1000/e142-r22-run
R=research/results
M=$R/e142-new-pool-file-creation-dry-run-r22-main-2026-10-05.out
N=$R/e142-new-pool-file-creation-dry-run-r22-arm-n21r-2026-10-05.out
echo "## PC-e 字段表分得出一格（命令 grep -n 'name=layout_field_positive_control' \$M）"; grep -n 'name=layout_field_positive_control' $M
echo; echo "## P2 装置自己的翻位对照（命令 grep -n 'name=positive_control_p2' \$M）"; grep -n 'name=positive_control_p2' $M | cut -c1-260
echo; echo "## PC-f22 逐区域比对分得出标签 6（N21R 对今天的 crates/）"
grep -n 'name=impl_bytes_equal_summary' $N
echo "N21R 里 accounting_root 的 impl_bytes_equal 行："; grep 'name=impl_bytes_equal ' $N | grep 'region=accounting_root' | sed -E 's/.* region=([^ ]+) device=([0-9]+) offset=([0-9]+).*(equal=[a-z]+).*first_diff_offset=([^ ]+) mismatch_bytes=([^ ]+).*/\1 device=\2 offset=\3 \4 first_diff=\5 mismatch_bytes=\6/'
echo "crates/ 一侧的标签 6（label6_anchor.py --decode N21R 产物，research/results/e142-r22-anchor-label6-2026-10-05.out）："; grep 'DECODE side=crates' $R/e142-r22-anchor-label6-2026-10-05.out | head -2 | cut -c1-250
echo; echo "## PC-g 独立比对分得出一个字节（合成文件 = N21R 产物的拷贝，设备 1、偏移 4096、长 4096 那份窗口系统配置槽区域内偏移 6 的字节异或 0x01；脚本 make_pcg.py sha256 $(sha256sum $D/make_pcg.py | cut -d' ' -f1)）"
echo "合成文件 sha256 $(sha256sum $D/pc-g-synthetic.out | cut -d' ' -f1)"
echo "old-new (合成, N21R)：$(grep name=old_new_independent_summary $D/indep-pcg-synth.out)"
echo "old-new (N21R, N21R)：$(grep name=old_new_independent_summary $D/indep-pcg-same.out)"
echo; echo "## PC-h1 / PC-h2 / B1 B1b（back_chain_487.py sha256 $(sha256sum $D/back_chain_487.py | cut -d' ' -f1)；N21R 输入的那次在 $R/e142-r22-anchor-b1-2026-10-05.out）"
echo "不带输入："; python3 $D/back_chain_487.py
echo "弄坏开关 BACK_CHAIN_487_BREAK=1 的第一行："; BACK_CHAIN_487_BREAK=1 python3 $D/back_chain_487.py | head -1
echo; echo "## PC-h3 锚点 B1 的输入对得上条款"
echo "实例表指针两条位置条目的设备与槽号（步 ①(4) 带输入那次）："; grep -E 'instance_table_pointer loc' $R/e142-r22-anchor-b1-2026-10-05.out
echo "fsid 对 t1 数据单元："; python3 $D/fsid_vs_data_unit.py $N
echo; echo "## 7.2 B1 / B1b 复算：输入取自这一次主产物（controls_from_product.py 取 t13 [463,471) 与 t14 [170,256)，另列 B2–B11 在产物里的读数）"
python3 $D/controls_from_product.py $M
echo; echo "## 7.2 B2–B11 独立复算（offsets_487.py，sha256 $(sha256sum $D/offsets_487.py | cut -d' ' -f1)，登记里记的 936bbf57…）"; python3 $D/offsets_487.py
echo; echo "## PC-i 旧值残留检查分得出旧值（命令七 residual_old_values.sh sha256 $(sha256sum $D/residual_old_values.sh | cut -d' ' -f1)；命令六）"
echo "命令七 HEAD 版装置与变异表（git show HEAD: 抽到草稿仓树，装置 sha256 $(sha256sum $D/headtree/research/e7-index-bench/src/bin/e142_new_pool_file_creation_dry_run.rs | cut -d' ' -f1)）：$(bash $D/residual_old_values.sh $D/headtree | tail -1)"
echo "命令七 N21R 那一份装置与变异表（git show :<路径> 取暂存区版本，装置 sha256 $(sha256sum $D/frozen_n21r/research/e7-index-bench/src/bin/e142_new_pool_file_creation_dry_run.rs | cut -d' ' -f1)）：$(bash $D/residual_old_values.sh $D/frozen_n21r | tail -1)"
echo "命令七 冻结的 N22 装置与变异表（仓根）：$(bash $D/residual_old_values.sh /home/fy5090/code/singlefs | tail -1)"
echo "命令六 N21R 那一份装置（四个计数，各应为 1）："
A=$D/frozen_n21r/research/e7-index-bench/src/bin/e142_new_pool_file_creation_dry_run.rs
for pattern in 'STATISTIC_COMMITTED_RESERVATION_BYTES, TREE_IDENTIFIER_NONE, 0)' 'for statistic in \[STATISTIC_UNRECLAIMABLE_BYTES, STATISTIC_PENDING_DELETE_BYTES, STATISTIC_COMMITTED_RESERVATION_BYTES\]' '准入不等式要的四项 day-1 各写一行 0' '三项 0（读不到行是坏账'; do printf '%s => ' "$pattern"; grep -c "$pattern" $A; done
echo; echo "## 附录：本文件用到的脚本 sha256"
sha256sum $D/make_pcg.py $D/back_chain_487.py $D/offsets_487.py $D/controls_from_product.py $D/fsid_vs_data_unit.py $D/residual_old_values.sh $D/controls22.sh
echo; echo "### fsid_vs_data_unit.py"; cat $D/fsid_vs_data_unit.py; echo "### controls_from_product.py"; cat $D/controls_from_product.py
## 附录：make_pcg.py 全文
# PC-g 合成文件：N19R 产物的拷贝，只把第一行 name=done 之前、device=1 offset=4096 length=4096 的那一行 name=device_region_bytes 的
# hexadecimal 里第 6 个字节（偏移 6）异或 0x01，其余行原样。用法：python3 make_pcg.py <N19R 产物> <输出路径>
import sys
src = open(sys.argv[1], encoding='utf-8').read().split('\n')
out = []
done = 0
changed = 0
for ln in src:
    if ln.startswith('E7RESULT name=done'):
        done += 1
    if done == 0 and ln.startswith('E7RESULT name=device_region_bytes ') and ' device=1 ' in ln and ' offset=4096 ' in ln and ' length=4096 ' in ln:
        i = ln.index('hexadecimal=') + len('hexadecimal=')
        b = bytearray(bytes.fromhex(ln[i:]))
        b[6] ^= 0x01
        ln = ln[:i] + bytes(b).hex()
        changed += 1
    out.append(ln)
open(sys.argv[2], 'w', encoding='utf-8').write('\n'.join(out))
print('changed lines', changed)
