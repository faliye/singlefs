### fsid_vs_data_unit.py
# PC-h3 的第二半：N21R 产物 t1 数据单元（设备 0、偏移 822149120、长度 32768）偏移 83 起 8 字节，与 t13 [463,471) 的 fsid 比。用法：fsid_vs_data_unit.py <产物>
import sys
found = {}
for raw in open(sys.argv[1], encoding="utf-8"):
    line = raw.rstrip("\n")
    if "name=done" in line: break
    if " name=device_region_bytes " in line and " region=" in line:
        f = dict(t.split("=", 1) for t in line.split() if "=" in t)
        found[(int(f["device"]), int(f["offset"]), int(f["length"]))] = bytes.fromhex(f["hexadecimal"])
data_unit = found[(0, 822149120, 32768)]; t13 = found[(0, 16785408, 4096)]
print("t1 数据单元 [83,91) =", data_unit[83:91].hex(), " t13 [463,471) =", t13[463:471].hex(), " 相同:", data_unit[83:91] == t13[463:471])
### controls_from_product.py
import sys,struct,subprocess
P=sys.argv[1]
lines=open(P,encoding='utf-8').read().split('\n')
def parse(line):
    return dict(t.split('=',1) for t in line.split() if '=' in t)
model={};crates={};done=0
for ln in lines:
    if ln.startswith('E7RESULT name=done'): done+=1; continue
    if ln.startswith('E7RESULT name=device_region_bytes '):
        d=parse(ln); key=(int(d['device']),int(d['offset']),int(d['length']))
        (model if done==0 else crates)[key]=bytes.fromhex(d['hexadecimal'])
def crc32c(data):
    crc=0xFFFFFFFF
    for byte in data:
        crc^=byte
        for _ in range(8):
            crc=(crc>>1)^(0x82F63B78 if crc&1 else 0)
    return crc^0xFFFFFFFF
t12=model[(0,823328768,16384)]
print('B2 from product t12: entry_count',struct.unpack_from('<H',t12,98)[0],'declared_length',struct.unpack_from('<H',t12,8)[0],'tree_id_of_node',struct.unpack_from('<Q',t12,42)[0])
ids=[struct.unpack_from('<Q',t12,131+200*i)[0] for i in range(11)]
print('B3 from product t12 tree ids',ids,'first8 hex',t12[131:139].hex(),'last entry first8 hex',t12[131+2000:131+2008].hex())
t14=model[(0,1052672,512)]
print('B3 from product t14 watermark LE hex',t14[122:130].hex())
t13=model[(0,16785408,4096)]
print('B5/B6 from product t13: watermark@271',struct.unpack_from('<Q',t13,271)[0],'F@279',struct.unpack_from('<Q',t13,279)[0],'unmount@459',struct.unpack_from('<I',t13,459)[0],'fsid@463',t13[463:471].hex(),'mac@471 all zero',all(b==0 for b in t13[471:487]),'first named entry@487 slot',int.from_bytes(t13[491:497],'little'))
print('B10 t13 instance pointer == t14 root[170:256]:',t13[287:373]==t14[170:256],' loc slots',int.from_bytes(t13[341:347],'little'),int.from_bytes(t13[355:361],'little'))
w1=model[(0,16777216,4096)] if (0,16777216,4096) in model else None
print('journal ring offsets present in window product:',[k for k in model if k[1] in (16777216,16781312,16785408)])
print('B11 offsets present:',sorted(k for k in model if k[1] in (822149120,4194304,7340032,1052672,16785408)))
# B1 recompute: w4/w1 are not in the 29-write window; recompute t13 back chain from its own record is not possible (needs w4 header); use anchors
fsid=t13[463:471]; ptr=t14[170:256]
print('inputs for back_chain_487.py: fsid',fsid.hex(),'itp',ptr.hex())
out=subprocess.run(['python3','/tmp/claude-1000/e142-r22-run/back_chain_487.py','--fsid-hex',fsid.hex(),'--instance-table-pointer-hex',ptr.hex()],capture_output=True,text=True).stdout
print(out)

