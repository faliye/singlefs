### diff_regions.py
import sys,re
P=sys.argv[1]
lines=open(P,encoding='utf-8').read().split('\n')
def parse(line):
    d={}
    for tok in line.split():
        if '=' in tok:
            k,v=tok.split('=',1); d[k]=v
    return d
model=[];crates=[]
seen_done=0
for ln in lines:
    if ln.startswith('E7RESULT name=done'):
        seen_done+=1; continue
    if ln.startswith('E7RESULT name=device_region_bytes '):
        (model if seen_done==0 else crates).append(parse(ln))
print(len(model),len(crates))
cmap={(c['device'],c['offset'],c['length']):c for c in crates}
for m in model:
    c=cmap[(m['device'],m['offset'],m['length'])]
    a=bytes.fromhex(m['hexadecimal']); b=bytes.fromhex(c['hexadecimal'])
    assert len(a)==len(b)
    diffs=[i for i in range(len(a)) if a[i]!=b[i]]
    if not diffs: continue
    # group ranges
    ranges=[];s=diffs[0];p=diffs[0]
    for i in diffs[1:]:
        if i!=p+1: ranges.append((s,p)); s=i
        p=i
    ranges.append((s,p))
    print(m['region'],'dev',m['device'],'off',m['offset'],'len',m['length'],'ndiff',len(diffs),'ranges',ranges)
    for (s,e) in ranges[:12]:
        print('   [%d,%d] model=%s crates=%s'%(s,e,a[s:e+1].hex(),b[s:e+1].hex()))
### acct2.py
import sys,struct
P=sys.argv[1]
lines=open(P,encoding='utf-8').read().split('\n')
def parse(line):
    d={}
    for tok in line.split():
        if '=' in tok:
            k,v=tok.split('=',1); d[k]=v
    return d
sides=[[],[]];done=0
for ln in lines:
    if ln.startswith('E7RESULT name=done'): done+=1; continue
    if ln.startswith('E7RESULT name=device_region_bytes ') and ' offset=823296000 ' in ln and ' device=0 ' in ln:
        sides[0 if done==0 else 1].append(parse(ln))
for label,s in zip(('model','crates'),sides):
    b=bytes.fromhex(s[0]['hexadecimal'])
    cnt=struct.unpack_from('<H',b,126)[0]
    print(label,'count',cnt)
    for i in range(cnt):
        o=159+34*i
        stat,tree,dev,gen=struct.unpack_from('<HQIQ',b,o)
        val,seq=struct.unpack_from('<QI',b,o+22)
        print('  ',i,'stat',stat,'tree',tree,'dev',hex(dev),'gen',gen,'value',val,'seq',seq)
### group_diff.py
import sys,re,hashlib,collections
HEX=re.compile(r"hexadecimal=([0-9a-fA-F]*)")
def norm(line):
    return HEX.sub(lambda m:"hexadecimal_sha256="+hashlib.sha256(m.group(1).encode('ascii')).hexdigest(),line)
def device_side(path, rename):
    out=[]
    for raw in open(path,encoding='utf-8'):
        line=raw.rstrip('\n')
        if line.startswith('E7INPUT '): continue
        if 'name=done' in line: break
        if rename: line=line.replace('name=header311_','name=journal_header_')
        if ('name=impl_bytes_equal ' in line or 'name=impl_bytes_unmatched' in line or 'name=impl_bytes_equal_summary' in line
            or ('name=window_segments ' in line and 'side=crates' in line) or 'name=window_segments_summary' in line):
            continue
        out.append(norm(line))
    return out
def name_of(line):
    m=re.search(r' name=([^ ]+)',line); return m.group(1) if m else '?'
old=device_side(sys.argv[1],True); new=device_side(sys.argv[2],False)
go=collections.defaultdict(list); gn=collections.defaultdict(list)
for l in old: go[name_of(l)].append(l)
for l in new: gn[name_of(l)].append(l)
rows=[]
for g in sorted(set(go)|set(gn)):
    co=collections.Counter(go[g]); cn=collections.Counter(gn[g])
    removed=sum((co-cn).values()); added=sum((cn-co).values())
    rows.append((g,len(go[g]),len(gn[g]),removed,added))
print('lines old',len(old),'new',len(new))
print('group | old_lines | new_lines | removed | added')
for r in rows:
    if r[3] or r[4] or r[1]!=r[2]: print(' | '.join(map(str,r)))
print('groups with zero diff:',sum(1 for r in rows if not r[3] and not r[4] and r[1]==r[2]),'of',len(rows))
### flips.py
import sys,collections,re
def load(path):
    rows=collections.defaultdict(list)
    for raw in open(path,encoding='utf-8'):
        line=raw.rstrip('\n')
        if line.startswith('E7INPUT '): continue
        if 'name=done' in line: break
        f=dict(t.split('=',1) for t in line.split() if '=' in t)
        n=f.get('name','')
        if n=='verdict' or n=='verdict_layer0' or n.startswith('positive_control') or n.startswith('self_check'):
            rows[n].append(f)
    return rows
a=load(sys.argv[1]); b=load(sys.argv[2])
total=0; flips=[]
for n in sorted(set(a)|set(b)):
    ra=a.get(n,[]); rb=b.get(n,[])
    if len(ra)!=len(rb): flips.append((n,'row count',len(ra),len(rb)))
    for i,(x,y) in enumerate(zip(ra,rb)):
        for k,v in x.items():
            if v in ('true','false','not_run') or (n=='verdict'):
                total+=1
                if y.get(k)!=v: flips.append((n,i,k,v,y.get(k)))
print('named groups compared:',sorted(set(a)|set(b)))
print('boolean/verdict fields compared:',total,' changed:',len(flips))
for f in flips: print(f)
### verdict_fields.py
import sys
def verdict(path):
    for ln in open(path,encoding='utf-8'):
        if 'name=verdict ' in ln:
            return dict(t.split('=',1) for t in ln.split() if '=' in t)
r19=verdict(sys.argv[1]); n19=verdict(sys.argv[2]); n21=verdict(sys.argv[3])
for k in n19:
    flag=''
    if r19.get(k)!=n19.get(k): flag+=' [上一次主产物 != N19R]'
    if n19.get(k)!=n21.get(k): flag+=' [N19R != N21]'
    print(f'{k:36s} 上一次={r19.get(k)} N19R={n19.get(k)} N21={n21.get(k)}{flag}')
### norm.py
# E142 r21 归一化（r19 登记 R37 的规则）：删 E7INPUT 开头的行；hexadecimal=<hex> 换成 hexadecimal_sha256=<sha256 of ASCII hex text>；其余逐字、次序不动。
# 用法：norm.py <产物> [--device-side]   --device-side：只取第一行 name=done 之前、并剔掉 Q142.56 那六种读导出的行。
import hashlib, re, sys
path = sys.argv[1]
device_side = "--device-side" in sys.argv[2:]
HEX = re.compile(r"hexadecimal=([0-9a-fA-F]*)")
def normalize(line):
    return HEX.sub(lambda m: "hexadecimal_sha256=" + hashlib.sha256(m.group(1).encode("ascii")).hexdigest(), line)
def dropped(line):
    return ("name=impl_bytes_equal " in line or "name=impl_bytes_unmatched" in line or "name=impl_bytes_equal_summary" in line
            or ("name=window_segments " in line and "side=crates" in line) or "name=window_segments_summary" in line or "name=done" in line)
with open(path, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.rstrip("\n")
        if line.startswith("E7INPUT "):
            continue
        if device_side:
            if "name=done" in line:
                break
            if dropped(line):
                continue
        print(normalize(line))
