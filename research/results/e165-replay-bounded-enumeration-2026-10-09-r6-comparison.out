self_proof # 判别力自证（登记第八节），在草稿目录副本上做
self_proof ## Y4 用在 r3 8 线程对 r3 4 线程：必须报 0 行不同、判不满足「恰 2 对 2」
self_proof $ diff run-r3-t8.result run-r3-t4.result | grep -c "^[<>]"
self_proof 0
self_proof ## Y4 用在 r2 对删掉 name=config 一行的 r3 副本：必须判不满足
self_proof $ diff run-r2-t8.result selfproof/r3-without-config.result | grep -c "^[<>]"; sed 换档名 run-r2-t8.result | cmp - selfproof/r3-without-config.result
self_proof 3
self_proof - selfproof/r3-without-config.result differ: byte 15, line 1
self_proof cmp-exit=1
self_proof ## Y1a 删掉 name=control criterion=J7b 两行：提取命令必须报少了 J7b
self_proof deleted_lines=2
self_proof 16d15
self_proof < J7b
self_proof diff-exit=1
self_proof ## Y1a 再删掉 name=control criterion=J6Qn 七行：必须报少了 J6Qn
self_proof deleted_lines=7
self_proof 12d11
self_proof < J6Qn
self_proof 16d14
self_proof < J7b
self_proof diff-exit=1
