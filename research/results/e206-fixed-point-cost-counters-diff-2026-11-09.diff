+                calls: vec![0; cells],
+                steps: vec![0; cells],
+                scale: vec![0; cells],
+                steps_to_the_hit: vec![0; cells],
+                scale_to_the_hit: vec![0; cells],
+                nanos: vec![0; cells],
+                queries: vec![0; cells],
+                query_levels: vec![0; cells],
+                segment_nanos: [0; SEGMENTS],
+                deltas: Vec::new(),
+                rounds: 0,
