+            + self.records.len()
+            + self.cluster_segments.len()
+            + self.reclaimed.len()
+            + self.root_ring.as_ref().map_or(0, RootRingOccupancy::e203_elements)
+    }
+
+    #[must_use]
+    pub fn e203_cluster_segments_opened(&self) -> usize {
+        self.cluster_segments.len()
+    }
