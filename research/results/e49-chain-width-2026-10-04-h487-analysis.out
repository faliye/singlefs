# E49 第 2 次重跑（头 311 → 487）：从产物 e49-chain-width-2026-10-04-h487.out 里数 Q49.5 与 B9 的命令与原样输出（2026-10-04）
# 命令：bash <下面这份脚本> e49-chain-width-2026-10-04-h487.out（在 research/results/ 下跑）
# ---- 脚本全文 ----
#!/usr/bin/env bash
# E49 第 2 次重跑：从产物里数 Q49.5（base mod 8 分组）、B9（读法乙分岔的 base）、扫描行条数
N=$1
echo "读法甲扫描行条数: $(grep -c 'name=base_sweep reading=甲' $N)；base 最小与最大: $(grep 'name=base_sweep reading=甲' $N | sed -E 's/.* base=([0-9]+) .*/\1/' | sort -un | sed -n '1p;$p' | tr '\n' ' ')"
echo "读法乙扫描行条数: $(grep -c 'name=base_sweep reading=乙' $N)；base 最小与最大: $(grep 'name=base_sweep reading=乙' $N | sed -E 's/.* base=([0-9]+) .*/\1/' | sort -un | sed -n '1p;$p' | tr '\n' ' ')"
echo "--- Q49.5：读法甲按 base mod 8 分组，每个 base 的四格 (512:2v4 512:4v8 4096:2v4 4096:4v8) 分岔数"
grep 'name=base_sweep reading=甲' $N | sed -E 's/.* base=([0-9]+) unit=([0-9]+) div_2v4=([0-9]+) first_2v4=[^ ]+ div_4v8=([0-9]+) .*/\1 \2 \3 \4/' | awk '{b=$1; u=$2; a[b,u]=$3" "$4; bs[b]=1} END{for (b in bs){ print b%8, a[b,512]" "a[b,4096], b}}' | sort -n | awk '{sig=$2" "$3" "$4" "$5; g=$1; if (!((g,sig) in seen)) {seen[g,sig]=1; groups[g]++; gs[g]=gs[g]" ["sig"]"} n[g]++} END{for(g=0;g<8;g++) print "base mod 8 = "g"：base 个数 "n[g]"，该组内不同签名 "groups[g]" 种"gs[g]}'
echo "--- B9：读法乙 2v4 分岔的 base"
grep 'name=base_sweep reading=乙' $N | awk '{for(i=1;i<=NF;i++){split($i,kv,"="); v[kv[1]]=kv[2]} if (v["div_2v4"]>0) print v["base"]}' | tr '\n' ' '; echo
echo "--- B9：读法乙 4v8 分岔的 base"
grep 'name=base_sweep reading=乙' $N | awk '{for(i=1;i<=NF;i++){split($i,kv,"="); v[kv[1]]=kv[2]} if (v["div_4v8"]>0) print v["base"]}' | tr '\n' ' '; echo
# ---- 原样输出 ----
读法甲扫描行条数: 48；base 最小与最大: 472 495 
读法乙扫描行条数: 81；base 最小与最大: 440 520 
