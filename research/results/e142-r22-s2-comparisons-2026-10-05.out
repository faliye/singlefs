```
#!/usr/bin/env bash
# E142 第 22 次重跑第二段步 ⑨：Q142.97–Q142.102、PC-k 的比对。仓根起跑。
# 输出全文进 research/results/e142-r22-s2-comparisons-2026-10-05.out（脚本全文在本文件末尾「附录」）。
cd /home/fy5090/code/singlefs
D=/tmp/claude-1000/e142-r22-run
S2=/tmp/claude-1000/e142-r22-run2
R=research/results
S=$R/e142-new-pool-file-creation-dry-run-r22-s2-main-2026-10-05.out
M1=$R/e142-new-pool-file-creation-dry-run-r22-main-2026-10-05.out
DUMP=$R/e142-r22-p8g-crates-dump-2026-10-05.out
echo "# 第二段产物 $S  sha256 $(sha256sum $S | cut -d' ' -f1)  行数 $(wc -l < $S)"
echo "# 第一段主产物 $M1  sha256 $(sha256sum $M1 | cut -d' ' -f1)  行数 $(wc -l < $M1)"
echo "# P8G 导出 $DUMP  sha256 $(sha256sum $DUMP | cut -d' ' -f1)  行数 $(wc -l < $DUMP)"
echo
echo "## PC-k（命令五）：p8g_region_compare.py --selftest，再 P8G_COMPARE_BREAK=1"
python3 $D/p8g_region_compare.py --selftest
P8G_COMPARE_BREAK=1 python3 $D/p8g_region_compare.py --selftest
echo "脚本 sha256：$(sha256sum $D/p8g_region_compare.py $D/label6_anchor.py | cut -c1-64 | tr '\n' ' ')"
echo
echo "## V22e 产物缺行：第二段产物里 p8g_ 各类行的条数（一条命令）"
grep -o '^E7RESULT name=p8g_[a-z0-9_]*' $S | sort | uniq -c | sed 's/E7RESULT //'
echo "命令 grep -c '^E7RESULT name=p8g_device_region_bytes ' \$S：$(grep -c '^E7RESULT name=p8g_device_region_bytes ' $S)；p8g_layout_field 恰 174：$(grep -c '^E7RESULT name=p8g_layout_field ' $S)；p8g_layout_field_summary：$(grep -c '^E7RESULT name=p8g_layout_field_summary ' $S)；p8g_accounting：$(grep -c '^E7RESULT name=p8g_accounting ' $S)；p8g_verdict：$(grep -c '^E7RESULT name=p8g_verdict ' $S)；p8g_control_main_point：$(grep -c '^E7RESULT name=p8g_control_main_point ' $S)"
echo "第一段同类行（主点）：device_region_bytes $(grep -c '^E7RESULT name=device_region_bytes ' $M1)（装置 29 + 导出 29）；layout_field $(grep -c '^E7RESULT name=layout_field ' $M1)"
echo
echo "## Q142.97 P8G 对 crates/（R68）：python3 p8g_region_compare.py \$S \$DUMP"
python3 $D/p8g_region_compare.py $S $DUMP
echo
echo "## Q142.98 P8G 字段表（R69、R72）"
grep -n 'name=p8g_layout_field_summary' $S
echo "命令 grep '^E7RESULT name=p8g_layout_field ' \$S | grep -c 'equal=false'：$(grep '^E7RESULT name=p8g_layout_field ' $S | grep -c 'equal=false')"
echo "P8G 与主点 174 行 (id, record_or_unit, field, expected, actual) 逐行比（python3，一条命令）："
python3 - "$S" <<'PYEOF'
import sys
def rows(prefix):
    out = []
    for line in open(sys.argv[1], encoding="utf-8"):
        if line.startswith(f"E7RESULT name={prefix} "):
            fields = {}
            for token in line.rstrip("\n").split(" "):
                if "=" in token:
                    key, value = token.split("=", 1)
                    fields.setdefault(key, value)
            out.append((fields["id"], fields["record_or_unit"], fields["field"], fields["expected"], fields["actual"], fields["equal"]))
    return out
main_rows, p8g_rows = rows("layout_field"), rows("p8g_layout_field")
print("main_rows", len(main_rows), "p8g_rows", len(p8g_rows))
print("键 (id, record_or_unit, field) 次序与内容相同:", [r[:3] for r in main_rows] == [r[:3] for r in p8g_rows])
print("expected 列逐行相同（R72 同一份字面）:", [r[3] for r in main_rows] == [r[3] for r in p8g_rows])
print("actual 列逐行相同:", [r[4] for r in main_rows] == [r[4] for r in p8g_rows])
differing = [(m[:3], m[4], p[4]) for m, p in zip(main_rows, p8g_rows) if m[4] != p[4]]
print("actual 不同的行数:", len(differing))
for entry in differing:
    print("  ", entry)
PYEOF
echo
echo "## Q142.99 P8G 判决：p8g_verdict 12 个字段与同一份产物 name=verdict 里同名字段、与第一段主产物 name=verdict 里同名字段逐个比"
python3 - "$S" "$M1" <<'PYEOF'
import sys
def fields_of(path, name):
    for line in open(path, encoding="utf-8"):
        if line.startswith(f"E7RESULT name={name} "):
            return dict(token.split("=", 1) for token in line.split() if "=" in token)
    raise SystemExit(f"{path} 里没有 name={name}")
p8g = fields_of(sys.argv[1], "p8g_verdict")
own = fields_of(sys.argv[1], "verdict")
first = fields_of(sys.argv[2], "verdict")
names = [key for key in p8g if key != "name"]
print("p8g_verdict 字段数", len(names))
differ = 0
for name in names:
    flag = "" if p8g[name] == own[name] == first[name] else "  <== 不同"
    differ += flag != ""
    print(f"{name}: p8g_verdict={p8g[name]} 同产物 verdict={own[name]} 第一段 verdict={first[name]}{flag}")
print("不同的字段数", differ)
print("另：同产物 name=verdict 与第一段 name=verdict 全行是否逐字相同:", own == first)
PYEOF
grep -n 'name=p8g_control_main_point' $S
echo
echo "## Q142.100 P8G 记账的绝对值"
grep -n 'name=p8g_accounting' $S
echo "label6_anchor.py（不带输入）A5 行："
python3 $D/label6_anchor.py | grep '^A5'
echo "label6_anchor.py --decode \$S p8g_device_region_bytes（装置 P8G 一侧；DECODE 的 side=model 行）："
python3 $D/label6_anchor.py --decode $S p8g_device_region_bytes | grep DECODE
echo "label6_anchor.py --decode \$DUMP（crates P8G 导出一侧；side=crates 行）："
python3 $D/label6_anchor.py --decode $DUMP | grep DECODE
echo
echo "## 附：P8G 与主点（同一份第二段产物里）装置一侧 29 个窗口写变了哪几个（一条命令）"
python3 - "$S" <<'PYEOF'
import sys
def regions(name):
    found = {}
    for line in open(sys.argv[1], encoding="utf-8"):
        if line.startswith(f"E7RESULT name={name} "):
            fields = dict(token.split("=", 1) for token in line.split() if "=" in token)
            found[(int(fields["device"]), int(fields["offset"]), int(fields["length"]))] = (fields["region"], fields["sha256"])
    return found
main_regions, p8g_regions = regions("device_region_bytes"), regions("p8g_device_region_bytes")
print("主点区域数", len(main_regions), "P8G 区域数", len(p8g_regions), "键集合相同", sorted(main_regions) == sorted(p8g_regions))
changed = [(key, main_regions[key][0]) for key in sorted(main_regions) if key in p8g_regions and main_regions[key][1] != p8g_regions[key][1]]
print("变了的区域数", len(changed))
for key, region in changed:
    print("  ", key, region)
a6 = {(0, 823296000, 16384), (1, 823296000, 16384), (0, 823312384, 16384), (1, 823312384, 16384), (0, 823328768, 16384), (1, 823328768, 16384), (0, 16785408, 4096), (1, 16785408, 4096), (0, 1052672, 512)}
print("变了的恰是 A6 九个:", {key for key, _ in changed} == a6)
PYEOF
echo
echo "## Q142.101 主点没动：第一段主产物 → 第二段产物（先删掉 name=p8g_ 打头的行）的归一化 diff（norm22.py）"
grep -v '^E7RESULT name=p8g_' $S > $S2/s2-without-p8g.txt
echo "删掉的行数 $(( $(wc -l < $S) - $(wc -l < $S2/s2-without-p8g.txt) ))（命令 grep -c '^E7RESULT name=p8g_' \$S：$(grep -c '^E7RESULT name=p8g_' $S)）"
python3 $D/norm22.py $M1 --check-e2; python3 $D/norm22.py $S2/s2-without-p8g.txt --check-e2
python3 $D/norm22.py $M1 > $S2/q101-m1.norm; python3 $D/norm22.py $S2/s2-without-p8g.txt > $S2/q101-s2.norm
echo "第一段主产物归一化 $(wc -l < $S2/q101-m1.norm) 行，第二段（删 p8g_ 后）归一化 $(wc -l < $S2/q101-s2.norm) 行"
diff $S2/q101-m1.norm $S2/q101-s2.norm > $S2/q101.diff; echo "diff 退出码 $?，输出 $(wc -l < $S2/q101.diff) 行"
head -c 1500 $S2/q101.diff
echo "（再做一条最强的：不归一化，只去掉 E7INPUT 行与 name=p8g_ 行，比两份装置一侧 stdout 到第一个 name=done 之前）"
grep -v '^E7INPUT ' $S2/s2-without-p8g.txt | awk '/name=done/{exit} {print}' > $S2/q101-s2.raw
grep -v '^E7INPUT ' $M1 | awk '/name=done/{exit} {print}' > $S2/q101-m1.raw
cmp $S2/q101-m1.raw $S2/q101-s2.raw && echo "未归一化逐字节相同（$(wc -l < $S2/q101-s2.raw) 行）"
echo
echo "## 导出一侧：第二段产物最后 39 行（不带参数的导出）与第一段主产物最后 39 行逐字节相同"
tail -n 39 $S | cmp - <(tail -n 39 $M1) && echo "相同"
echo
echo "## Q142.102 第二段指纹：命令 python3 research/scripts/admission.py experiment <仓根> E142 的输出（步 ⑦ 落盘后立即跑，原样存 $S2/q102.out）"
cat $S2/q102.out | cut -c1-400
echo
echo "## V22c crates 快照 A2、B2、C2 两两 cmp"
cmp $R/e142-r22-s2-crates-sha256-a2-2026-10-05.txt $R/e142-r22-s2-crates-sha256-b2-2026-10-05.txt && echo "A2 == B2（sha256 清单）"
cmp $R/e142-r22-s2-crates-sha256-b2-2026-10-05.txt $R/e142-r22-s2-crates-sha256-c2-2026-10-05.txt && echo "B2 == C2（sha256 清单）"
cmp $R/e142-r22-s2-crates-status-a2-2026-10-05.txt $R/e142-r22-s2-crates-status-b2-2026-10-05.txt && echo "A2 == B2（git status）"
cmp $R/e142-r22-s2-crates-status-b2-2026-10-05.txt $R/e142-r22-s2-crates-status-c2-2026-10-05.txt && echo "B2 == C2（git status）"
echo
echo "## 判决行全部点名（命令 grep -n 'name=verdict\\|name=p8g_verdict'）"
grep -n 'name=verdict\|name=p8g_verdict' $S | cut -c1-900
```
```python
import sys
def regions(name):
    found = {}
    for line in open(sys.argv[1], encoding="utf-8"):
        if line.startswith(f"E7RESULT name={name} "):
            fields = dict(token.split("=", 1) for token in line.split() if "=" in token)
            if "region" not in fields:
                continue  # 第二段产物末尾那 29 行是 crates/ 导出（不带 region=），只取装置一侧
            found[(int(fields["device"]), int(fields["offset"]), int(fields["length"]))] = (fields["region"], fields["sha256"])
    return found
main_regions, p8g_regions = regions("device_region_bytes"), regions("p8g_device_region_bytes")
print("主点区域数", len(main_regions), "P8G 区域数", len(p8g_regions), "键集合相同", sorted(main_regions) == sorted(p8g_regions))
changed = [(key, main_regions[key][0]) for key in sorted(main_regions) if key in p8g_regions and main_regions[key][1] != p8g_regions[key][1]]
print("变了的区域数", len(changed))
for key, region in changed:
    print("  ", key, region)
a6 = {(0, 823296000, 16384), (1, 823296000, 16384), (0, 823312384, 16384), (1, 823312384, 16384), (0, 823328768, 16384), (1, 823328768, 16384), (0, 16785408, 4096), (1, 16785408, 4096), (0, 1052672, 512)}
print("变了的恰是 A6 九个:", {key for key, _ in changed} == a6)
```
