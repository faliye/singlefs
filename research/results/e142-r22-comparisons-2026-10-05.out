echo "crates 钉值（步 ③-6 现读，命令 sed -n 80p crates/singlefs-harness/tests/new_pool_file_creation_publish.rs）："; sed -n 80p crates/singlefs-harness/tests/new_pool_file_creation_publish.rs
echo "7.2 B1 / B1b（步 ①(4) 带输入跑 back_chain_487.py，research/results/e142-r22-anchor-b1-2026-10-05.out）："; grep -E '^B1b |^B1 ' $R/e142-r22-anchor-b1-2026-10-05.out
echo
