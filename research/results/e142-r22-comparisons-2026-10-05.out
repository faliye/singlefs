### norm22.py（sha256 18d4d49afa3859b6e1402886ba56b3575dc031558773baa329bc0c5514f2c164）
# E142 r22 归一化（R71：第 19 次登记 R37 的归一化 + 六种剔除行种 + E1/E2/E3）。
# 用法：norm22.py <产物> [--check-e2]
#   默认：输出归一化后、第一行 name=done 之前、剔除之后的行（E7INPUT 行删掉；hexadecimal=<hex> 换成 hexadecimal_sha256=<sha256(hex 文本 ASCII)>）
#   剔除行种：impl_bytes_equal、impl_bytes_unmatched、impl_bytes_equal_summary、window_segments side=crates、window_segments_summary、name=done（第一行之后不看）、
#   E1 = name=self_check_text_numbers 整行，E2 = name=self_check_text_number_unclassified 各行，E3 = name=verdict 里的 text_numbers_all_classified 一个字段
#   --check-e2：只打 E2 的条件：E2 的 row= 是否都含 name=impl_bytes_equal（打 e2_rows=N e2_all_from_impl_bytes_equal=True/False）
import hashlib, re, sys
path = sys.argv[1]
check = "--check-e2" in sys.argv[2:]
HEX = re.compile(r"hexadecimal=([0-9a-fA-F]*)")
def normalize(line):
    return HEX.sub(lambda m: "hexadecimal_sha256=" + hashlib.sha256(m.group(1).encode("ascii")).hexdigest(), line)
lines = []
for raw in open(path, encoding="utf-8"):
    line = raw.rstrip("\n")
    if line.startswith("E7INPUT "):
        continue
    if "name=done" in line:
        break
    lines.append(line)
e2 = [l for l in lines if " name=self_check_text_number_unclassified " in l]
def row_of(l):
    m = re.search(r" row=(\S+)", l)
    return m.group(1) if m else ""
condition = all("name=impl_bytes_equal" in row_of(l) for l in e2)
if check:
    print("e2_rows=%d e2_all_from_impl_bytes_equal=%s" % (len(e2), condition))
    sys.exit(0)
for line in lines:
    if (" name=impl_bytes_equal " in line or " name=impl_bytes_unmatched" in line or " name=impl_bytes_equal_summary" in line
            or (" name=window_segments " in line and "side=crates" in line) or " name=window_segments_summary" in line):
        continue
    if condition and (" name=self_check_text_numbers " in line or " name=self_check_text_number_unclassified " in line):
        continue
    if condition and " name=verdict " in line:
        line = re.sub(r" text_numbers_all_classified=\S+", "", line)
    print(normalize(line))
### group_diff22.py（sha256 38c868fbe34c3e2af0a51c6cca798417f08ceeb762af0f2b12d39457278bc10b）
# Q142.90：N21R → N22 的归一化分组 diff（R71 的归一化与剔除，用 norm22.py 的同一份规则）。
# 用法：group_diff22.py <旧产物> <新产物> [--show-group <组名>]   打：每组 旧行数 新行数 删 加；零差异组数；--show-group 打那一组的变了的行（截 400 字）
import subprocess, sys, re, collections
def lines_of(path):
    return subprocess.run(["python3", "/tmp/claude-1000/e142-r22-run/norm22.py", path], capture_output=True, text=True, check=True).stdout.split("\n")[:-1]
def group_name(line):
    match = re.search(r" name=([^ ]+)", line)
    return match.group(1) if match else "?"
old = lines_of(sys.argv[1]); new = lines_of(sys.argv[2])
grouped_old = collections.defaultdict(list); grouped_new = collections.defaultdict(list)
for line in old: grouped_old[group_name(line)].append(line)
for line in new: grouped_new[group_name(line)].append(line)
rows = []
for group in sorted(set(grouped_old) | set(grouped_new)):
    counter_old = collections.Counter(grouped_old[group]); counter_new = collections.Counter(grouped_new[group])
    rows.append((group, len(grouped_old[group]), len(grouped_new[group]), sum((counter_old - counter_new).values()), sum((counter_new - counter_old).values())))
print("lines old", len(old), "new", len(new), "groups", len(rows))
print("group | old_lines | new_lines | removed | added")
for row in rows:
    if row[3] or row[4] or row[1] != row[2]:
        print(" | ".join(map(str, row)))
print("groups with zero diff:", sum(1 for row in rows if not row[3] and not row[4] and row[1] == row[2]), "of", len(rows))
if "--show-group" in sys.argv:
    group = sys.argv[sys.argv.index("--show-group") + 1]
    counter_old = collections.Counter(grouped_old[group]); counter_new = collections.Counter(grouped_new[group])
    for line in (counter_old - counter_new): print("- " + line[:400])
    for line in (counter_new - counter_old): print("+ " + line[:400])
### flips22.py（sha256 b58f6f190aba529582c35fe4eec973557c205b27d77e58e4f93989134f15dd56）
# Q142.95：判决字段逐个比（R71）。用法：flips22.py <甲产物> <乙产物>
# 字段集：name=verdict 每个 键=值、name=verdict_layer0、name=positive_control_*、name=self_check_* 各行里取值 true/false/not_run 的字段（not_run 是比 R71 多收的一类，只会更严）、
# name=width 每行 expected 是否等于 actual（一个布尔）。第一行 name=done 之前。剔除清单 E1–E3 在各自的条件成立时剔除（条件：该产物里每一行 E2 的 row= 都含 name=impl_bytes_equal）。
import re, sys, collections
def load(path):
    lines = []
    for raw in open(path, encoding="utf-8"):
        line = raw.rstrip("\n")
        if line.startswith("E7INPUT "): continue
        if "name=done" in line: break
        lines.append(line)
    e2 = [l for l in lines if " name=self_check_text_number_unclassified " in l]
    condition = all("name=impl_bytes_equal" in (re.search(r" row=(\S+)", l).group(1) if re.search(r" row=(\S+)", l) else "") for l in e2)
    fields = collections.OrderedDict()
    seen = collections.Counter()
    for line in lines:
        tokens = dict(t.split("=", 1) for t in line.split() if "=" in t)
        name = tokens.get("name", "")
        if condition and name in ("self_check_text_numbers", "self_check_text_number_unclassified"):
            continue
        index = seen[name]; seen[name] += 1
        if name == "width":
            fields[("width", index, tokens.get("structure", str(index)))] = str(tokens.get("expected") == tokens.get("actual"))
        elif name in ("verdict", "verdict_layer0") or name.startswith("positive_control") or name.startswith("self_check"):
            for key, value in tokens.items():
                if key == "name": continue
                if value in ("true", "false", "not_run"):
                    if condition and name == "verdict" and key == "text_numbers_all_classified": continue
                    fields[(name, index, key)] = value
    return fields, condition, len(e2)
a, ca, ea = load(sys.argv[1]); b, cb, eb = load(sys.argv[2])
print("甲 E2 行数", ea, "剔除条件", ca, "；乙 E2 行数", eb, "剔除条件", cb)
print("字段数 甲", len(a), "乙", len(b))
only_a = [k for k in a if k not in b]; only_b = [k for k in b if k not in a]
changed = [(k, a[k], b[k]) for k in a if k in b and a[k] != b[k]]
print("只在甲:", only_a); print("只在乙:", only_b); print("值变了:", len(changed))
for k, x, y in changed: print("  ", k, x, "->", y)
width_rows = [k for k in b if k[0] == "width"]
print("width 行数(乙)", len(width_rows), "expected==actual 的", sum(1 for k in width_rows if b[k] == "True"))
### a6_check.py（sha256 4f6eb2bc2ed7341d09c3d84007476771d9925eac007f0588ad319bddfa78c78d）
# Q142.89 的集合核对：独立 bin 输出里 changed=true 的（设备，偏移，长度）恰好等于登记 7.2 A6 的九个
import sys
A6 = {(0, 823296000, 16384), (1, 823296000, 16384), (0, 823312384, 16384), (1, 823312384, 16384), (0, 823328768, 16384), (1, 823328768, 16384),
      (0, 16785408, 4096), (1, 16785408, 4096), (0, 1052672, 512)}
changed = set()
for raw in open(sys.argv[1], encoding="utf-8"):
    if " name=old_new_independent " in raw and " changed=true " in raw:
        f = dict(t.split("=", 1) for t in raw.split() if "=" in t)
        changed.add((int(f["device"]), int(f["offset"]), int(f["length"])))
print("changed regions", len(changed), "A6", len(A6), "equal_sets", changed == A6)
print("changed - A6:", sorted(changed - A6), " A6 - changed:", sorted(A6 - changed))
