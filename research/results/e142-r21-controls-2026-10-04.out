## 附录：PC-g 合成文件的生成脚本 make_pcg.py（输出 sha256 与上面那份相同，已核）
# PC-g 合成文件：N19R 产物的拷贝，只把第一行 name=done 之前、device=1 offset=4096 length=4096 的那一行 name=device_region_bytes 的
# hexadecimal 里第 6 个字节（偏移 6）异或 0x01，其余行原样。用法：python3 make_pcg.py <N19R 产物> <输出路径>
import sys
src = open(sys.argv[1], encoding='utf-8').read().split('\n')
out = []
done = 0
changed = 0
for ln in src:
    if ln.startswith('E7RESULT name=done'):
        done += 1
    if done == 0 and ln.startswith('E7RESULT name=device_region_bytes ') and ' device=1 ' in ln and ' offset=4096 ' in ln and ' length=4096 ' in ln:
        i = ln.index('hexadecimal=') + len('hexadecimal=')
        b = bytearray(bytes.fromhex(ln[i:]))
        b[6] ^= 0x01
        ln = ln[:i] + bytes(b).hex()
        changed += 1
    out.append(ln)
open(sys.argv[2], 'w', encoding='utf-8').write('\n'.join(out))
print('changed lines', changed)
