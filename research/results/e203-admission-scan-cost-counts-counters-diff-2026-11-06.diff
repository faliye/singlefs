+
+    /// 一段里一行的读数。
+    #[derive(Clone, Debug)]
+    pub struct RowReading {
+        pub segment: &'static str,
+        pub row: &'static str,
+        pub calls: u64,
+        pub steps: u64,
+        pub scale: u64,
+        pub exclusive_nanos: u64,
+        /// 按身份建的索引上这一行归口到的查询次数，与每次查询的 ⌈log₂(索引项数 + 1)⌉ 之和（登记第五节 s19、s23、s36 的“查询次数 × lg”）。
+        pub queries: u64,
+        pub query_levels: u64,
+    }
+    /// 一条差量读数：哪一段、第几轮（固定点）、名字、值。
+    #[derive(Clone, Debug)]
+    pub struct DeltaReading {
+        pub segment: &'static str,
+        pub round: u32,
+        pub key: &'static str,
+        pub value: u64,
+    }
+    /// 一次发布准入之前读到的全部。
+    #[derive(Clone, Debug, Default)]
+    pub struct PublishRecord {
+        /// 经调用方进门（有调用方段）；抬 F 预演直接进 `prepare_the_version_publish` 的是 false。
+        pub had_caller_segment: bool,
+        pub rows: Vec<RowReading>,
+        /// 每段的段挂钟纳秒（计数构建里为空）。
+        pub segment_nanos: Vec<(&'static str, u64)>,
+        pub deltas: Vec<DeltaReading>,
+        /// 固定点走了几轮。
+        pub rounds: u32,
+    }
+
+    struct Open {
+        had_caller_segment: bool,
+        calls: Vec<u64>,
+        steps: Vec<u64>,
+        scale: Vec<u64>,
+        nanos: Vec<u64>,
+        queries: Vec<u64>,
+        query_levels: Vec<u64>,
+        segment_nanos: [u64; SEGMENTS],
+        deltas: Vec<DeltaReading>,
+        rounds: u32,
+    }
+    impl Open {
+        fn new(had_caller_segment: bool) -> Self {
+            let cells = SEGMENTS * ROW_COUNT;
+            Self {
+                had_caller_segment,
+                calls: vec![0; cells],
+                steps: vec![0; cells],
+                scale: vec![0; cells],
+                nanos: vec![0; cells],
+                queries: vec![0; cells],
+                query_levels: vec![0; cells],
+                segment_nanos: [0; SEGMENTS],
+                deltas: Vec::new(),
+                rounds: 0,
+            }
+        }
+        fn into_record(self) -> PublishRecord {
+            let mut rows = Vec::new();
+            for (segment_index, segment) in ALL_SEGMENTS.iter().enumerate() {
+                for (row_index, row) in ALL_ROWS.iter().enumerate() {
+                    let cell = segment_index * ROW_COUNT + row_index;
+                    if self.calls[cell] + self.steps[cell] + self.scale[cell] + self.nanos[cell] + self.queries[cell] > 0 {
+                        rows.push(RowReading {
+                            segment: segment.tag(),
+                            row: row.name(),
+                            calls: self.calls[cell],
+                            steps: self.steps[cell],
+                            scale: self.scale[cell],
+                            exclusive_nanos: self.nanos[cell],
+                            queries: self.queries[cell],
+                            query_levels: self.query_levels[cell],
+                        });
+                    }
+                }
+            }
+            let segment_nanos = ALL_SEGMENTS
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| self.segment_nanos[*index] > 0)
+                .map(|(index, segment)| (segment.tag(), self.segment_nanos[index]))
+                .collect();
+            PublishRecord {
+                had_caller_segment: self.had_caller_segment,
+                rows,
+                segment_nanos,
+                deltas: self.deltas,
+                rounds: self.rounds,
+            }
+        }
+    }
+
+    struct Thread {
+        segment: Segment,
+        round: u32,
+        open: Option<Open>,
+        finished: Vec<PublishRecord>,
+        attribution: Vec<Row>,
+    }
+    thread_local! {
+        static THREAD: RefCell<Thread> = const {
+            RefCell::new(Thread {
+                segment: Segment::Outside,
+                round: 0,
+                open: None,
+                finished: Vec::new(),
+                attribution: Vec::new(),
+            })
+        };
+    }
+
+    /// 换段。离开 `Outside` 开一条记录（从调用方段进门的记 `had_caller_segment`），回到 `Outside` 收一条。
+    pub fn segment(next: Segment) {
+        THREAD.with(|cell| {
+            let thread = &mut *cell.borrow_mut();
+            if next == Segment::Outside {
+                if let Some(open) = thread.open.take() {
+                    thread.finished.push(open.into_record());
+                }
+            } else if thread.segment == Segment::Outside {
+                thread.open = Some(Open::new(next == Segment::CallerBeforeTheJudgement));
+            }
+            thread.segment = next;
+            thread.round = 0;
+        });
+    }
+
+    /// 固定点每轮开头记一次。
+    pub fn round_begin() {
+        THREAD.with(|cell| {
+            let thread = &mut *cell.borrow_mut();
+            thread.round += 1;
+            let round = thread.round;
+            if let Some(open) = thread.open.as_mut() {
+                open.rounds = open.rounds.max(round);
+            }
+        });
+    }
+
+    /// 交回到此刻收好的记录并清空；没收完的那条不交。
+    #[must_use]
+    pub fn take_finished() -> Vec<PublishRecord> {
+        THREAD.with(|cell| std::mem::take(&mut cell.borrow_mut().finished))
+    }
+
+    /// 归口：在它活着的这一段里，不属于某一行函数的步（码 2 规划、按身份建索引）记到哪一行。
+    pub struct AttributionGuard;
+    #[must_use]
+    pub fn attribute(row: Row) -> AttributionGuard {
+        THREAD.with(|cell| cell.borrow_mut().attribution.push(row));
+        AttributionGuard
+    }
+    impl Drop for AttributionGuard {
+        fn drop(&mut self) {
+            THREAD.with(|cell| {
+                cell.borrow_mut().attribution.pop();
+            });
+        }
+    }
+    fn attributed_row() -> Row {
+        THREAD.with(|cell| cell.borrow().attribution.last().copied()).unwrap_or(Row::UnlistedIndexOrPlanWork)
+    }
+
+    fn with_open(change: impl FnOnce(&mut Open, usize, u32)) {
+        THREAD.with(|cell| {
+            let thread = &mut *cell.borrow_mut();
+            let segment = thread.segment as usize;
+            let round = thread.round;
+            if let Some(open) = thread.open.as_mut() {
+                change(open, segment, round);
+            }
+        });
+    }
+    /// 这一行在当前段里被调了一次。
+    pub fn call(row: Row) {
+        with_open(|open, segment, _| open.calls[segment * ROW_COUNT + row as usize] += 1);
+    }
+    /// 这一行在当前段里走了一步。
+    pub fn step(row: Row) {
+        steps(row, 1);
+    }
+    /// 这一行在当前段里走了 `count` 步。
+    pub fn steps(row: Row, count: usize) {
+        with_open(|open, segment, _| {
+            open.steps[segment * ROW_COUNT + row as usize] += u64::try_from(count).expect("步数装得进 u64");
+        });
+    }
+    /// 归口给当前挂着的行（没有挂着的记到清单外那一行）。
+    pub fn call_attributed() {
+        call(attributed_row());
+    }
+    pub fn steps_attributed(count: usize) {
+        steps(attributed_row(), count);
+    }
+    /// 站点自己另读的循环长度（与走过的步独立，供登记第七节 ③2 对账）。
+    pub fn scale(row: Row, count: usize) {
+        with_open(|open, segment, _| {
+            open.scale[segment * ROW_COUNT + row as usize] += u64::try_from(count).expect("长度装得进 u64");
+        });
+    }
+    /// 按身份建的索引上归口行的一次查询：索引有 `index_entries` 项，折半查至多 ⌈log₂(项数 + 1)⌉ 层。
+    pub fn query_attributed(index_entries: u64) {
+        let row = attributed_row();
+        with_open(|open, segment, _| {
+            let cell = segment * ROW_COUNT + row as usize;
+            open.queries[cell] += 1;
+            open.query_levels[cell] += u64::from(u64::BITS - index_entries.leading_zeros());
+        });
+    }
+    /// 线性 `contains` 走过的步：走到找到的那一个或走完（`Vec::contains` 同序），记在 `row` 上。
+    pub fn contains_counted<Item: PartialEq>(row: Row, haystack: &[Item], needle: &Item) -> bool {
+        let walked = haystack.iter().position(|candidate| candidate == needle);
+        steps(row, walked.map_or(haystack.len(), |index| index + 1));
+        walked.is_some()
+    }
+    /// 只在归口行正是 `row` 时记一条差量读数。
+    pub fn delta_if_attributed(row: Row, key: &'static str, value: usize) {
+        if attributed_row() == row {
+            delta(key, value);
+        }
+    }
+    /// 一条差量读数（B8 的输入），记在当前段当前轮。
+    pub fn delta(key: &'static str, value: usize) {
+        let value = u64::try_from(value).expect("读数装得进 u64");
+        THREAD.with(|cell| {
+            let thread = &mut *cell.borrow_mut();
+            let (segment, round) = (thread.segment.tag(), thread.round);
+            if let Some(open) = thread.open.as_mut() {
+                open.deltas.push(DeltaReading { segment, round, key, value });
+            }
+        });
+    }
+
