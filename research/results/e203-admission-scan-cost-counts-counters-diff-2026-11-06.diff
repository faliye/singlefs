+        Row::EmptySegmentLinearScan,
+        Row::FallbackSlotLinearScan,
+        Row::RecordsOfEachLeaf,
+        Row::AccountingEntriesOfThisPublish,
+        Row::InstanceTableChain,
+        Row::UnitsOfAPublishToLand,
+        Row::MappedUnitsWholeTable,
+        Row::UnlistedIndexOrPlanWork,
+    ];
+    impl Row {
+        #[must_use]
+        pub fn name(self) -> &'static str {
