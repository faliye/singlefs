+pub fn attack_layer0_plan_hash(
+    base: &MemoryPool,
+    writes: &[RetainedWrite],
+    segments: &[Vec<usize>],
+    judged_root_index: usize,
+    versions: &[PublishedVersion],
+    expand: &dyn Fn(usize, &[usize]) -> bool,
+    parallelism: Layer0Parallelism,
+    slicing_independent_of_worker_threads: bool,
+    has_observer: bool,
+    shard: Option<Layer0ShardOfShards>,
+) -> (String, u64, usize) {
+    let tearable = TearableInPlaceOverwrites::of(base, writes);
+    let writes_with_torn_images = WritesWithTornImages::of(base, writes, segments, &tearable);
+    let plan = Layer0StatePlan::new(
+        writes,
+        segments,
+        &|segment_index, segment| expansion_of_the_yes_or_no_choice(expand(segment_index, segment)),
+        &tearable,
+        &writes_with_torn_images,
+    );
+    let slicing = if slicing_independent_of_worker_threads {
+        Layer0Parallelism {
+            slice_length: Layer0SliceLength::StatesPerSlice(states_per_slice_independent_of_worker_threads(plan.state_count)),
+            ..parallelism
+        }
+    } else {
+        parallelism
+    };
+    let slices = state_slices(plan.state_count, &slicing);
+    (
+        layer0_plan_hash(base, writes_with_torn_images.writes.as_slice(), &plan, judged_root_index, versions, &slices, has_observer, shard),
