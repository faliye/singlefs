+fn c860_class(verdict: &InvariantVerdict) -> String {
+    match verdict {
+        InvariantVerdict::Holds => "成立".to_string(),
+        InvariantVerdict::Violated(detail) => {
+            let shortened: String = detail.chars().take(260).collect();
+            format!("违例：{shortened}")
+        }
+        InvariantVerdict::NotApplicable(reason) => format!("不适用：{reason}"),
+        InvariantVerdict::PartiallyJudged(_) => "部分没判".to_string(),
+    }
