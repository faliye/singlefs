+/// 最新根中央映射叶里 key 为 `mapping_key` 的条目，第一条位置条目的槽号挪两槽，重封、补校验和（M5 必红世界那一造法）。
+fn c860_move_the_first_location_of_the_mapping_entry_keyed(image: &mut MemoryPool, mapping_key: &[u8]) {
+    let key_width = 27usize;
+    let entry_width = 55usize;
+    let leaf_slot = the_slot_of(&newest_root(image).mapping_root);
+    let mut leaf = unit_bytes_at(image, leaf_slot, node_bytes());
+    assert_eq!(leaf[50], 0, "中央映射树只有一层");
+    let entries_start = 115 + 2 * key_width;
+    let entry_count = usize::from(u16::from_le_bytes(
+        leaf[82 + 2 * key_width..84 + 2 * key_width].try_into().expect("2 字节"),
+    ));
+    let entry_start = (0..entry_count)
+        .map(|index| entries_start + index * entry_width)
+        .find(|start| leaf[*start..*start + key_width] == *mapping_key)
+        .expect("中央映射里有这把 key");
+    let slot_field_start = entry_start + key_width + 4;
+    let mut slot_bytes = [0u8; 8];
+    slot_bytes[..6].copy_from_slice(&leaf[slot_field_start..slot_field_start + 6]);
+    let moved_slot = u64::from_le_bytes(slot_bytes) + 4096;
+    leaf[slot_field_start..slot_field_start + 6].copy_from_slice(&moved_slot.to_le_bytes()[..6]);
+    let header_end = 86 + 2 * key_width;
+    let payload_checksum = crc32_castagnoli(&leaf[header_end..]);
+    leaf[76 + 2 * key_width..80 + 2 * key_width].copy_from_slice(&payload_checksum.to_le_bytes());
+    seal_header_checksum(&mut leaf, header_end);
+    replace_the_unit_and_propagate_its_checksum(image, leaf_slot, &leaf);
+}
