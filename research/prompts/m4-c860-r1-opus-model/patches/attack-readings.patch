+        &mut current,
+        singlefs_core::unlink::UnlinkBatchSize::OneExtentLowerLeaf,
+        common_deletion_in_progress::INSTANCE_OF_THE_PUBLISHES,
+    )
+    .expect("续做到队列空");
+    pool.output = current;
+}
