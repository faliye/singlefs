+fn c860_judge(name: &str, image: &MemoryPool) {
+    set_the_c860_reading_of_this_thread(0);
+    let every_verdict = check_pool_image(image);
+    let violated: Vec<&str> = every_verdict
+        .iter()
+        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+        .map(|(invariant, _)| *invariant)
+        .collect();
+    println!("C860_OTHER {name} violated={violated:?}");
+    for (label, reading) in C860_READINGS {
+        set_the_c860_reading_of_this_thread(reading);
+        let verdict = verdict_of_the_scan_rebuild(image);
+        println!("C860_ROW {name} {label} {}", c860_class(&verdict));
