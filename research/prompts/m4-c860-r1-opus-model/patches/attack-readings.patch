+        common_deletion_in_progress::change_the_first_tombstone_of_the_newest_root(&mut image, |tombstone| {
+            common_deletion_in_progress::set_tombstone_field(tombstone, 0, 2);
+            common_deletion_in_progress::set_tombstone_field(
+                tombstone,
+                common_deletion_in_progress::TOMBSTONE_RECORD_OBJECT_BIRTH_OFFSET,
+                birth_of_inode_two,
+            );
+        });
+        c860_judge("坏·删一半时多一条墓碑指活文件inode2", &image);
+    }
+    {
+        let pool = common_deletion_in_progress::pool_with_inode_three_unlinked_and_the_root_ring_turned_over("c860-bad-tombstone-live-first-file");
+        let birth_of_the_first_file = c860_birth_of(&pool, 1);
+        let mut image = pool.memory_pool();
+        common_deletion_in_progress::append_a_copy_of_the_first_tombstone_of_the_newest_root(&mut image);
+        common_deletion_in_progress::change_the_first_tombstone_of_the_newest_root(&mut image, |tombstone| {
+            common_deletion_in_progress::set_tombstone_field(tombstone, 0, 1);
+            common_deletion_in_progress::set_tombstone_field(
+                tombstone,
+                common_deletion_in_progress::TOMBSTONE_RECORD_OBJECT_BIRTH_OFFSET,
+                birth_of_the_first_file,
+            );
+        });
+        c860_judge("坏·删完3之后多一条墓碑指带数据的活文件inode1", &image);
+    }
+    {
+        let mut image = common_deletion_in_progress::image_after_the_intent_of_a_three_unit_file("c860-bad-tombstone-birth");
+        common_deletion_in_progress::change_the_first_tombstone_of_the_newest_root(&mut image, |tombstone| {
+            let birth = common_deletion_in_progress::tombstone_field(tombstone, common_deletion_in_progress::TOMBSTONE_RECORD_OBJECT_BIRTH_OFFSET);
+            common_deletion_in_progress::set_tombstone_field(tombstone, common_deletion_in_progress::TOMBSTONE_RECORD_OBJECT_BIRTH_OFFSET, birth + 1);
+        });
+        c860_judge("坏·意图之后墓碑出生代加一", &image);
+    }
+    {
+        let mut image = common_deletion_in_progress::image_after_the_intent_of_a_three_unit_file("c860-bad-tombstone-death");
+        common_deletion_in_progress::change_the_first_tombstone_of_the_newest_root(&mut image, |tombstone| {
+            common_deletion_in_progress::set_tombstone_field(tombstone, common_deletion_in_progress::TOMBSTONE_RECORD_DEATH_TXG_OFFSET, 1 << 40);
+        });
+        c860_judge("坏·意图之后墓碑死亡txg改到谱系外", &image);
+    }
+    }
+    {
+        let pool = c860_pool_with_the_first_file_half_deleted_beside_inode_two("c860-bad-record-dropped");
+        let mut image = pool.memory_pool();
+        common_deletion_in_progress::drop_the_record_of_the_first_file_and_keep_its_data_units(&mut image);
+        c860_judge("坏·删一半时删除中记录丢了单元还在", &image);
+    }
+    {
+        let mut image = common_deletion_in_progress::image_after_the_intent_of_a_three_unit_file("c860-bad-nlink-back");
+        common_deletion_in_progress::set_the_nlink_of_the_queued_first_file_back_to_one(&mut image);
+        c860_judge("坏·意图之后删除中记录nlink改回1", &image);
+    }
+    {
+        let pool = c860_pool_with_the_first_file_half_deleted_beside_inode_two("c860-bad-m5-must-red");
+        let first_data_pointer_of_inode_two = pool
+            .output
+            .file_other_than_the_first(InodeNumber(2))
+            .expect("inode 2 带数据单元")
+            .data_pointers[0];
+        let mut image = pool.memory_pool();
+        c860_move_the_first_location_of_the_mapping_entry_keyed(
+            &mut image,
+            &singlefs_core::records::mapping_key_for_data(
+                first_data_pointer_of_inode_two.head,
+                first_data_pointer_of_inode_two.write_order,
+            ),
+        );
+        c860_judge("坏·M5必红世界（删一半时inode2映射落点挪槽）", &image);
+    }
+}
