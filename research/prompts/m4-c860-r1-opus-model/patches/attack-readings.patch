+fn c860_weights_named(name: &str) -> &'static GenerationWeights {
+    match name {
+        "BROAD" => &GenerationWeights::BROAD,
+        "DELETING_FILES_OF_SEVERAL_LOWER_LEAVES" => &GenerationWeights::DELETING_FILES_OF_SEVERAL_LOWER_LEAVES,
+        "REUSE_AFTER_RAISING_THE_FLOOR" => &GenerationWeights::REUSE_AFTER_RAISING_THE_FLOOR,
+        "ROLLBACK_AFTER_RAISING_THE_FLOOR" => &GenerationWeights::ROLLBACK_AFTER_RAISING_THE_FLOOR,
+        "LEAVING_ORPHANS_FOR_THE_INSTANCE_TABLE_SWEEP" => &GenerationWeights::LEAVING_ORPHANS_FOR_THE_INSTANCE_TABLE_SWEEP,
+        "SNAPSHOT_OPERATIONS" => &GenerationWeights::SNAPSHOT_OPERATIONS,
+        "COMPACTION_WHILE_MOUNTED_WITH_ROLLBACK" => &GenerationWeights::COMPACTION_WHILE_MOUNTED_WITH_ROLLBACK,
+        "WRITES_BY_INODE_NUMBER" => &GenerationWeights::WRITES_BY_INODE_NUMBER,
+        "TRUNCATION" => &GenerationWeights::TRUNCATION,
+        other => panic!("没有比重 {other}"),
+    }
+}
+
+/// 环境变量 C860_BATCHES = 「比重:首个种子:种子数,…」，C860_STEPS = 每段步数，C860_THREADS = 工作线程数。
+/// 每个状态四种读法各判一次 I-1.13，按读法数成立 / 违例 / 不适用，四种读法判得不一样的状态逐条打印。
+#[test]
+#[ignore = "攻方副本 m4-c860-r1：随机历史上四种读法各判 I-1.13"]
+fn c860_attack_readings_over_random_histories() {
+    let batches_text = std::env::var("C860_BATCHES").expect("C860_BATCHES");
+    let steps: usize = std::env::var("C860_STEPS").expect("C860_STEPS").parse().expect("步数");
+    let worker_threads: usize = std::env::var("C860_THREADS").expect("C860_THREADS").parse().expect("线程");
+    let mut histories: Vec<(String, HistorySeed, &'static GenerationWeights)> = Vec::new();
+    for batch in batches_text.split(',') {
+        let fields: Vec<&str> = batch.split(':').collect();
+        let first_seed: u64 = fields[1].parse().expect("种子");
+        let seed_count: u64 = fields[2].parse().expect("种子数");
+        for seed in first_seed..first_seed + seed_count {
+            histories.push((fields[0].to_string(), HistorySeed(seed), c860_weights_named(fields[0])));
+        }
+    }
+    let execution = HistoryExecution {
+        per_step_checker: PerStepChecker::Skipped,
+        device_width: HistoryDeviceWidth::UnitAreaOf384Slots,
+        space_admission: SpaceAdmission::JudgedByTheFormula,
+    };
+    let next_history = Mutex::new(0usize);
+    let tally: Mutex<BTreeMap<(String, String), u64>> = Mutex::new(BTreeMap::new());
+    let disagreements: Mutex<Vec<String>> = Mutex::new(Vec::new());
+    let states_with_an_object_being_deleted: Mutex<u64> = Mutex::new(0);
+    std::thread::scope(|scope| {
+        for _ in 0..worker_threads {
+            scope.spawn(|| loop {
+                let history_index = {
+                    let mut next = next_history.lock().expect("锁");
+                    if *next >= histories.len() {
+                        break;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let (weights_name, seed, weights) = &histories[history_index];
+                let history = generate_history_with_weights(*seed, steps, weights);
+                let _history_run = execute_history_with(
+                    &history,
+                    execution,
+                    &SharedStream::new(),
+                    &mut |observation| {
+                        let mut classes: Vec<String> = Vec::new();
+                        singlefs_checker::walk::set_the_c860_reading_of_this_thread(0);
+                        let _ = verdict_of_the_scan_rebuild(observation.image);
+                        let being_deleted_here = singlefs_checker::walk::c860_objects_being_deleted_at_the_last_judgement_of_this_thread();
+                        singlefs_checker::walk::set_the_c860_reading_of_this_thread(99);
+                        for (_, reading) in C860_READINGS {
+                            set_the_c860_reading_of_this_thread(reading);
+                            classes.push(verdict_class_of(&verdict_of_the_scan_rebuild(observation.image)));
+                        }
+                        set_the_c860_reading_of_this_thread(0);
+                        let mut tally = tally.lock().expect("锁");
+                        for ((label, _), class) in C860_READINGS.iter().zip(classes.iter()) {
+                            *tally.entry(((*label).to_string(), class.clone())).or_insert(0) += 1;
+                        }
+                        drop(tally);
+                        if classes.iter().any(|class| *class != classes[0]) {
+                            disagreements.lock().expect("锁").push(format!(
+                                "{weights_name} 种子 {} {:?} {:?}：{:?}",
+                                seed.0,
+                                observation.position,
+                                observation.operation.map(|operation| operation.kind()),
+                                classes
+                            ));
+                        }
+                        if being_deleted_here > 0 {
+                            *states_with_an_object_being_deleted.lock().expect("锁") += 1;
+                        }
+                    },
+                );
+            });
+        }
+    });
+    let tally = tally.into_inner().expect("锁");
+    for ((label, class), count) in &tally {
+        println!("C860_RANDOM_TALLY {label} {count} {class}");
+    }
+    let disagreements = disagreements.into_inner().expect("锁");
+    for line in &disagreements {
+        println!("C860_RANDOM_DISAGREEMENT {line}");
+    }
+    let states: u64 = tally.iter().filter(|((label, _), _)| label == "甲").map(|(_, count)| *count).sum();
+    println!(
+        "C860_RANDOM_SUMMARY histories={} steps={steps} states={states} states_with_an_object_being_deleted={} disagreements={}",
+        histories.len(),
+        states_with_an_object_being_deleted.into_inner().expect("锁"),
+        disagreements.len()
+    );
+}
