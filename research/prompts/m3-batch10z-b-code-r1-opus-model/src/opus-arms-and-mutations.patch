+    let mut known = ring_slots_known_to_hold_a_root_by(allocator);
+    if opus_arm().contains("slot") {
+        if let Some(occupancy) = allocator.root_ring_occupancy() {
+            for (ring_slot, _) in occupancy.opus_abandoned_root_slots() {
+                known.remove(&ring_slot);
+            }
+        }
+    }
+    known
