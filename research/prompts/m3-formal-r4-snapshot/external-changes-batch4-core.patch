diff --git a/crates/singlefs-harness/tests/journal_ring_geometry_fields_are_recomputed_when_choosing_the_system_configuration.rs b/crates/singlefs-harness/tests/journal_ring_geometry_fields_are_recomputed_when_choosing_the_system_configuration.rs
