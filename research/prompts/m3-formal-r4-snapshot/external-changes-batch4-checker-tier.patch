+/// 只起一次可写挂载（取号、写行、暖机，不接发布）的结局。
+#[derive(Debug)]
+pub enum WritableMountAlone {
+    Mounted {
+        instance: InstanceGeneration,
+        pool_after: MemoryPool,
+    },
+    Refused {
+        member: String,
+        reason: ObservedRefusalReason,
+    },
+}
