// 攻方腿（Opus，m2-step3-code-r1）在副本上加进
// crates/singlefs-harness/tests/second_transaction_step_zero_layer0.rs 的两段。插在
// 「/// 靶向的阳性对照」那条注释之前；另外 Prepared 加一个字段
//   /// 倒数第二条根槽写的下标：它之后的写都属于最后一次发布。
//   last_but_one_root_index: usize,
// prepare() 的返回里填 last_but_one_root_index: root_indexes[root_indexes.len() - 2],

/// 攻方腿（副本）：同一批对照搬到到 C 的脚本上，逐格打印它红不红。
#[test]
fn opus_attack_controls_moved_to_the_third_publish_script() {
    let prepared = prepare("layer0-c-controls", Script::ThroughThirdPublish);
    let all = vec![true; prepared.writes.len()];
    let is_last_publish = |index: usize| index > prepared.last_but_one_root_index;
    let kinds_of_last = |kind: StepKind| -> Vec<usize> {
        prepared
            .writes
            .iter()
            .enumerate()
            .filter(|(index, write)| is_last_publish(*index) && write.kind == kind)
            .map(|(index, _)| index)
            .collect()
    };
    let last_units = kinds_of_last(StepKind::UnitWrite);
    let last_records = kinds_of_last(StepKind::JournalRecord);
    println!("C 的单元写 {} 条、记录写 {} 条", last_units.len(), last_records.len());
    let evaluate = |persisted: Vec<bool>| {
        let mut tally = Layer0Tally::default();
        let report = evaluate_state_for_versions(
            &prepared.base,
            &prepared.writes,
            persisted,
            prepared.judged_root_index,
            &prepared.versions,
            &mut tally,
        );
        (report, tally)
    };
    let (report1, tally1) = evaluate(all.clone());
    println!("① 全持久：effective={:?} violations={} outcome_is_file={}", report1.effective_root, tally1.violations, matches!(report1.outcome, RecoveryOutcome::FileRead{..}));
    let mut root_without_units = all.clone();
    for index in &last_units { root_without_units[*index] = false; }
    let (_, tally2) = evaluate(root_without_units);
    println!("② 根持久 + C 的单元一份都不在：violations={} ignored={} claimed_missing_unit={} first={:?}", tally2.violations, tally2.ignored_violations, tally2.record_claimed_state_missing_unit, tally2.first_violation);
    let mut root_missing = all.clone();
    root_missing[prepared.judged_root_index] = false;
    let (report3, tally3) = evaluate(root_missing);
    println!("③ C 的根槽不在、记录与单元都在：effective={:?} prefix_applied={} journal_differing={} violations={}", report3.effective_root, report3.journal.prefix_applied, tally3.journal_differing_states, tally3.violations);
    let mut root_without_records = all.clone();
    for index in &last_records { root_without_records[*index] = false; }
    let (_, tally4) = evaluate(root_without_records);
    println!("④ 根持久 + C 的两份记录都不在：violations={} root_without_record={}", tally4.violations, tally4.record_root_without_record);
    let mut nothing_of_last = all;
    for (write_index, persisted) in nothing_of_last.iter_mut().enumerate() {
        if is_last_publish(write_index) { *persisted = false; }
    }
    let (report5, tally5) = evaluate(nothing_of_last);
    println!("⑤ C 一个字节都不在：effective={:?} violations={} outcome={:?}", report5.effective_root, tally5.violations, matches!(report5.outcome, RecoveryOutcome::FileRead{..}));
}

/// 攻方腿（副本）X8-B：写行那次发布的五个角色逐对缺席，别的全落盘 —— oracle / checker / 记录核对器谁说话。
#[test]
fn opus_attack_instance_table_unit_missing_but_every_root_persisted() {
    let prepared = prepare("layer0-c-itmissing", Script::ThroughThirdPublish);
    let root_indexes: Vec<usize> = prepared
        .writes
        .iter()
        .enumerate()
        .filter(|(_, write)| write.kind == StepKind::RootRecordFua)
        .map(|(index, _)| index)
        .collect();
    let row_publish_units: Vec<usize> = prepared
        .writes
        .iter()
        .enumerate()
        .filter(|(index, write)| {
            *index > root_indexes[3] && *index < root_indexes[4] && write.kind == StepKind::UnitWrite
        })
        .map(|(index, _)| index)
        .collect();
    println!("写行发布的单元写下标 {row_publish_units:?}");
    for pair in 0..5usize {
        let mut persisted = vec![true; prepared.writes.len()];
        for index in &row_publish_units[pair * 2..pair * 2 + 2] {
            persisted[*index] = false;
        }
        let mut tally = Layer0Tally::default();
        let report = evaluate_state_for_versions(
            &prepared.base,
            &prepared.writes,
            persisted,
            prepared.judged_root_index,
            &prepared.versions,
            &mut tally,
        );
        let violated: Vec<(&str, u64)> = tally
            .checker_violated_states
            .iter()
            .map(|(name, count)| (*name, *count))
            .collect();
        println!(
            "X8-B 第 {pair} 对单元写缺席：outcome_is_file={} violations={} ignored={} claimed_missing={} checker={violated:?}",
            matches!(report.outcome, RecoveryOutcome::FileRead { .. }),
            tally.violations,
            tally.ignored_violations,
            tally.record_claimed_state_missing_unit
        );
    }
}
