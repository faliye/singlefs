diff --git a/crates/singlefs-verification/tests/make_filesystem_refuses_a_physical_block_size_parameter_other_than_the_probed_one_before_any_write.rs b/crates/singlefs-verification/tests/make_filesystem_refuses_a_physical_block_size_parameter_other_than_the_probed_one_before_any_write.rs
new file mode 100644
index 000000000..99e1e3b3c
--- /dev/null
+++ b/crates/singlefs-verification/tests/make_filesystem_refuses_a_physical_block_size_parameter_other_than_the_probed_one_before_any_write.rs
@@ -0,0 +1,162 @@
+//! mkfs 逐盘探测 `physical_block_size`，调用方参数里的那个与任一块盘的探测值不同就拒、一个字节不写
+//! （D22（单元原子性怎么合成） 已定项 2 根槽宽一格「调用方给的 `physical_block_size` 与 mkfs 时探测到的不同就拒绝 mkfs」；C1040）。
+//! 照参数写出的池，挂载逐盘比探测值都会拒（D12（目标介质） 已定项 4），所以拒在 mkfs 这一步、盘上不留半份格式。
+//! 两块盘都探测 4096、参数 512 的一条；只有盘 1 探测 4096 的一条（判的是每一块盘，不只盘 0）；参数与探测都是 4096 的阳性对照一条。
+
+use singlefs_core::address::{DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::make_filesystem::{
+    make_filesystem, MakeFilesystemError, MakeFilesystemParameters,
+};
+use singlefs_core::root_ring::RootRingSlotsPerRegion;
+use singlefs_core::system_configuration::SystemImmutableSizes;
+use singlefs_format::{
+    JOURNAL_RING_DEFAULT_BYTES, JOURNAL_RING_START_SLOT, ROOT_RING_BASE_SLOT, SLOT_BYTES,
+};
+use singlefs_verification::memory_pool::{SparseBlockDevice, SparseDevice};
+use singlefs_verification::{RecordingBlockDevice, SharedStream};
+
+const DEVICE_BYTES: u64 = 4 << 30;
+const FILESYSTEM_IDENTIFIER: [u8; 16] = *b"singlefs-pbsmkfs";
+/// 盘上预先写的花样：mkfs 头几步会清零的三处（系统配置槽 0、根环基址、journal 环起点）各一段，清零与写都改得掉它。
+const PATTERN_BYTE: u8 = 0xA5;
+const PATTERN_BYTES: usize = 4096;
+
+/// 参数只差 `physical_block_size`：io_min 不声明，槽距 4096，根槽宽 512 与 4096 都过几何那几判。
+fn parameters_declaring(physical_block_size: u32) -> MakeFilesystemParameters {
+    MakeFilesystemParameters {
+        filesystem_identifier: FILESYSTEM_IDENTIFIER,
+        region_devices: [DeviceIdentity(0), DeviceIdentity(1), DeviceIdentity(0)],
+        geometry: SystemImmutableSizes {
+            physical_block_size,
+            minimum_input_output_bytes: 0,
+            fixed_structure_slot_spacing: SystemImmutableSizes::slot_spacing_for(0),
+            journal_ring_bytes: JOURNAL_RING_DEFAULT_BYTES,
+            root_ring_slots_per_region: RootRingSlotsPerRegion::AT_MAKE_FILESYSTEM,
+        },
+    }
+}
+
+/// 两块带花样的内存盘，盘 0、盘 1 各自探测到 `probed_physical_block_sizes` 里的那个块宽，外面包录制器、录进同一条流。
+/// 交回包好的盘与包之前两块盘的镜像（比「逐字节不变」用）。
+fn patterned_recorded_devices(
+    probed_physical_block_sizes: [u32; 2],
+    stream: &SharedStream,
+) -> (
+    Vec<(DeviceIdentity, RecordingBlockDevice<SparseBlockDevice>)>,
+    Vec<SparseDevice>,
+) {
+    let mut images_before = Vec::new();
+    let devices: Vec<(DeviceIdentity, RecordingBlockDevice<SparseBlockDevice>)> =
+        [DeviceIdentity(0), DeviceIdentity(1)]
+            .into_iter()
+            .zip(probed_physical_block_sizes)
+            .map(|(identity, probed_physical_block_size)| {
+                let mut device = SparseBlockDevice::new(
+                    DEVICE_BYTES,
+                    PhysicalBlockSizeInBytes(probed_physical_block_size),
+                );
+                for offset in [
+                    0,
+                    ROOT_RING_BASE_SLOT * SLOT_BYTES,
+                    JOURNAL_RING_START_SLOT * SLOT_BYTES,
+                ] {
+                    device
+                        .image
+                        .write(DeviceOffsetInBytes(offset), &[PATTERN_BYTE; PATTERN_BYTES]);
+                }
+                images_before.push(device.image.clone());
+                (
+                    identity,
+                    RecordingBlockDevice::with_shared_stream(identity, device, stream.clone()),
+                )
+            })
+            .collect();
+    (devices, images_before)
+}
+
+/// 在任何写之前拒：录制流一步都没有（写、写零、屏障都没发），两块盘与 mkfs 之前逐字节相同。
+fn assert_nothing_was_written(
+    stream: &SharedStream,
+    devices: &[(DeviceIdentity, RecordingBlockDevice<SparseBlockDevice>)],
+    images_before: &[SparseDevice],
+    scenario_named: &str,
+) {
+    assert_eq!(
+        stream.operations().len(),
+        0,
+        "{scenario_named}：录制流里一步都没有"
+    );
+    for ((identity, device), before) in devices.iter().zip(images_before) {
+        assert!(
+            device.wrapped_device().image == *before,
+            "{scenario_named}：盘 {identity:?} 与 mkfs 之前逐字节相同"
+        );
+    }
+}
+
+/// 参数 512、两块盘都探测 4096：拒成参数与探测不同，点名盘 0（按盘表次序第一块不等的），带探测值 4096 与参数 512；一个字节不写。
+#[test]
+fn a_physical_block_size_parameter_of_512_on_devices_probing_4096_is_refused_before_any_write() {
+    let stream = SharedStream::retaining_contents();
+    let (mut devices, images_before) = patterned_recorded_devices([4096, 4096], &stream);
+    let result = make_filesystem(&parameters_declaring(512), &mut devices);
+    assert!(
+        matches!(
+            &result,
+            Err(
+                MakeFilesystemError::PhysicalBlockSizeParameterDiffersFromTheProbedValue {
+                    device: DeviceIdentity(0),
+                    probed_physical_block_size: PhysicalBlockSizeInBytes(4096),
+                    physical_block_size_in_the_parameters: 512,
+                }
+            )
+        ),
+        "参数 512、两块盘探测 4096：该拒成参数与探测不同、点名盘 0，实际 {:?}",
+        result.as_ref().err()
+    );
+    assert_nothing_was_written(&stream, &devices, &images_before, "参数 512、探测 4096");
+}
+
+/// 参数 512、盘 0 探测 512、盘 1 探测 4096：判的是每一块盘，拒成参数与探测不同、点名盘 1；一个字节不写。
+#[test]
+fn a_physical_block_size_parameter_matching_only_device_zero_is_refused_naming_device_one_before_any_write(
+) {
+    let stream = SharedStream::retaining_contents();
+    let (mut devices, images_before) = patterned_recorded_devices([512, 4096], &stream);
+    let result = make_filesystem(&parameters_declaring(512), &mut devices);
+    assert!(
+        matches!(
+            &result,
+            Err(
+                MakeFilesystemError::PhysicalBlockSizeParameterDiffersFromTheProbedValue {
+                    device: DeviceIdentity(1),
+                    probed_physical_block_size: PhysicalBlockSizeInBytes(4096),
+                    physical_block_size_in_the_parameters: 512,
+                }
+            )
+        ),
+        "参数 512、盘 0 探测 512、盘 1 探测 4096：该拒成参数与探测不同、点名盘 1，实际 {:?}",
+        result.as_ref().err()
+    );
+    assert_nothing_was_written(
+        &stream,
+        &devices,
+        &images_before,
+        "参数 512、盘 1 探测 4096",
+    );
+}
+
+/// 对照：参数与两块盘的探测值都是 4096，mkfs 照收。钉住「拒」只落在参数与探测不同的盘上。
+#[test]
+fn a_physical_block_size_parameter_equal_to_the_probed_value_on_every_device_still_makes_a_filesystem(
+) {
+    let stream = SharedStream::retaining_contents();
+    let (mut devices, _) = patterned_recorded_devices([4096, 4096], &stream);
+    let result = make_filesystem(&parameters_declaring(4096), &mut devices);
+    assert!(
+        result.is_ok(),
+        "参数与两块盘的探测值都是 4096：{:?}",
+        result.as_ref().err()
+    );
+}
diff --git a/crates/singlefs-verification/tests/memory_pool_scan_candidates_do_not_take_the_geometry_of_a_slot_zero_carrying_a_refused_unit_geometry_field.rs b/crates/singlefs-verification/tests/memory_pool_scan_candidates_do_not_take_the_geometry_of_a_slot_zero_carrying_a_refused_unit_geometry_field.rs
new file mode 100644
index 000000000..14dc0c683
--- /dev/null
+++ b/crates/singlefs-verification/tests/memory_pool_scan_candidates_do_not_take_the_geometry_of_a_slot_zero_carrying_a_refused_unit_geometry_field.rs
@@ -0,0 +1,111 @@
+//! 内存池交给池级 checker 的扫描候选按盘上系统配置槽 0 自述的几何划（`memory_pool` 的 `recorded_geometry_in_the_slot_zero_read_through`）：
+//! 槽 0 的单元几何四格（单元大小 305、落点粒度 309、位置条目宽 313、扩展点声明值 N 321；D21（权威态与派生态的分界） 已定项 16、
+//! 已定项 8，C1041）有一格不是第一版的值时，这一槽与 core 择系统配置、池级 checker 读槽一样不算数，候选退到罩住任何合法几何的那一档。
+//! 看得出来的是 journal 扫描候选：认槽 0 时只罩自述的环（mkfs 清过的环里一个写过的扇区都没有，候选为空）；不认时从环起点罩到盘尾，
+//! 单元区里 mkfs 写的实例表与树表落进来、候选不空。偏移与改成的值用例自己写死，不从实现里取。
+
+use singlefs_checker::image::ImageReader;
+use singlefs_core::address::{DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::checksum::wide_checksum_with_field_zeroed;
+use singlefs_core::make_filesystem::{make_filesystem, MakeFilesystemParameters};
+use singlefs_core::root_ring::RootRingSlotsPerRegion;
+use singlefs_core::system_configuration::{
+    SystemImmutableSizes, SYSTEM_CONFIGURATION_CHECKSUM_OFFSET,
+};
+use singlefs_format::{JOURNAL_RING_DEFAULT_BYTES, SYSTEM_CONFIGURATION_SLOT_BYTES};
+use singlefs_verification::memory_pool::{MemoryPool, SparseBlockDevice};
+
+const DEVICE_BYTES: u64 = 4 << 30;
+const PHYSICAL_BLOCK_SIZE: u32 = 512;
+
+/// mkfs 之后两块盘的镜像，按盘放进一个内存池（与崩溃点重放的基线池同一个类型）。
+fn memory_pool_after_make_filesystem() -> MemoryPool {
+    let parameters = MakeFilesystemParameters {
+        filesystem_identifier: *b"singlefs-scangeo",
+        region_devices: [DeviceIdentity(0), DeviceIdentity(1), DeviceIdentity(0)],
+        geometry: SystemImmutableSizes {
+            physical_block_size: PHYSICAL_BLOCK_SIZE,
+            minimum_input_output_bytes: 0,
+            fixed_structure_slot_spacing: SystemImmutableSizes::slot_spacing_for(0),
+            journal_ring_bytes: JOURNAL_RING_DEFAULT_BYTES,
+            root_ring_slots_per_region: RootRingSlotsPerRegion::AT_MAKE_FILESYSTEM,
+        },
+    };
+    let mut devices: Vec<(DeviceIdentity, SparseBlockDevice)> = (0..2u32)
+        .map(|device_number| {
+            (
+                DeviceIdentity(device_number),
+                SparseBlockDevice::new(DEVICE_BYTES, PhysicalBlockSizeInBytes(PHYSICAL_BLOCK_SIZE)),
+            )
+        })
+        .collect();
+    make_filesystem(&parameters, &mut devices).expect("mkfs 收这一份几何");
+    MemoryPool {
+        devices: devices
+            .into_iter()
+            .map(|(identity, device)| (identity, device.image))
+            .collect(),
+        device_size_in_bytes: DEVICE_BYTES,
+    }
+}
+
+/// 内存池盘 0 的系统配置槽 0 里 `offset_in_the_slot` 起的 4 字节改成 `rewritten_value`（小端）、整槽校验和重封。
+fn rewrite_a_field_of_slot_zero_on_device_zero(
+    pool: &mut MemoryPool,
+    offset_in_the_slot: usize,
+    rewritten_value: u32,
+) {
+    let slot_bytes = usize::try_from(SYSTEM_CONFIGURATION_SLOT_BYTES).expect("4096");
+    let device_zero = pool
+        .devices
+        .get_mut(&DeviceIdentity(0))
+        .expect("池里有盘 0");
+    let mut slot = device_zero.read(DeviceOffsetInBytes(0), slot_bytes);
+    slot[offset_in_the_slot..offset_in_the_slot + 4]
+        .copy_from_slice(&rewritten_value.to_le_bytes());
+    let digest =
+        wide_checksum_with_field_zeroed(&slot, slot_bytes, SYSTEM_CONFIGURATION_CHECKSUM_OFFSET);
+    slot[SYSTEM_CONFIGURATION_CHECKSUM_OFFSET..SYSTEM_CONFIGURATION_CHECKSUM_OFFSET + 32]
+        .copy_from_slice(&digest);
+    device_zero.write(DeviceOffsetInBytes(0), &slot);
+}
+
+/// 槽 0 四格都是第一版的值时 journal 候选为空（阳性对照）；四格各改一个值（各在池的一份拷贝上），这块盘的 journal 候选都不空，
+/// 拷贝的槽 0 照样过 magic、整槽校验和、incompat 那几关。
+#[test]
+fn journal_scan_candidates_reach_past_the_recorded_ring_when_slot_zero_carries_a_unit_geometry_field_other_than_the_first_version_value(
+) {
+    let pool = memory_pool_after_make_filesystem();
+    assert_eq!(
+        ImageReader::candidate_journal_slots(&pool, 0),
+        Some(Vec::new()),
+        "槽 0 四格都是第一版的值：journal 候选只罩自述的环，mkfs 清过的环里一个写过的扇区都没有（阳性对照）"
+    );
+    let slot_bytes = usize::try_from(SYSTEM_CONFIGURATION_SLOT_BYTES).expect("4096");
+    for (field_offset, rewritten_value, field_named) in [
+        (305, 65_536, "单元大小"),
+        (309, 4096, "落点粒度"),
+        (313, 15, "位置条目宽"),
+        (321, 1, "扩展点声明值 N"),
+    ] {
+        let mut rewritten_pool = pool.clone();
+        rewrite_a_field_of_slot_zero_on_device_zero(
+            &mut rewritten_pool,
+            field_offset,
+            rewritten_value,
+        );
+        let slot =
+            rewritten_pool.devices[&DeviceIdentity(0)].read(DeviceOffsetInBytes(0), slot_bytes);
+        assert!(
+            singlefs_checker::check_system_configuration_slot(&slot).is_ok(),
+            "{field_named} 写成 {rewritten_value}、重封之后 magic、整槽校验和、incompat 那几关照样过：不认它的只能是四格那一判"
+        );
+        let candidates =
+            ImageReader::candidate_journal_slots(&rewritten_pool, 0).expect("池里有盘 0");
+        assert!(
+            !candidates.is_empty(),
+            "{field_named} 写成 {rewritten_value} 的槽 0 不算数：journal 候选从环起点罩到盘尾、单元区里 mkfs 写的单元落进来，而候选为空"
+        );
+    }
+}
diff --git a/crates/singlefs-verification/tests/system_configuration_unit_geometry_fields_are_refused_by_core_and_the_pool_checker.rs b/crates/singlefs-verification/tests/system_configuration_unit_geometry_fields_are_refused_by_core_and_the_pool_checker.rs
new file mode 100644
index 000000000..1dbd4016e
--- /dev/null
+++ b/crates/singlefs-verification/tests/system_configuration_unit_geometry_fields_are_refused_by_core_and_the_pool_checker.rs
@@ -0,0 +1,250 @@
+//! 系统配置几何段的单元几何四格（D21（权威态与派生态的分界） 已定项 16「单元几何在挂载时求值一次」、已定项 8「N 住系统配置，第一版 N = 0」；C1041）：
+//! 单元大小（偏移 305）、落点粒度（309）、位置条目宽（313）各等于格式常量，扩展点声明值 N（321）等于 0。任一格改一个值、整槽校验和重封，
+//! core 择系统配置与可写挂载都整池拒成同一个成员、盘上逐字节不变；池级 checker 把每块盘每个槽读成「带这一版读者不收的值」、拒在同一格，
+//! I-7.13（系统配置池级字段在读者收的范围里） 判红。四格各一条用例。
+//! 偏移、常量与改成的值用例自己写死，不从实现里取：取了的话，实现把字段写到别处去这几条也跟着走。
+
+use singlefs_checker::image::{
+    judge_system_configuration_values_the_reader_accepts, system_configuration_slot_readings,
+    ImageReader, Judgements, RefusedSystemConfigurationValue, SystemConfigurationSlotReading,
+    UnitGeometryFieldThatDisagrees, SYSTEM_CONFIGURATION_CARRIES_ONLY_VALUES_THE_READER_ACCEPTS,
+};
+use singlefs_core::address::{DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_core::block_device::{BlockDevice, PhysicalBlockSizeInBytes, WriteDurability};
+use singlefs_core::checksum::wide_checksum_with_field_zeroed;
+use singlefs_core::make_filesystem::{make_filesystem, MakeFilesystemParameters};
+use singlefs_core::mount::{mount_writable, MountError};
+use singlefs_core::recovery::{
+    choose_system_configuration, RecoveryFailure,
+    SystemConfigurationValueOutsideWhatThisReaderAccepts,
+};
+use singlefs_core::root_ring::RootRingSlotsPerRegion;
+use singlefs_core::system_configuration::{
+    SystemImmutableSizes, SYSTEM_CONFIGURATION_CHECKSUM_OFFSET,
+};
+use singlefs_format::{JOURNAL_RING_DEFAULT_BYTES, SYSTEM_CONFIGURATION_SLOT_BYTES};
+use singlefs_verification::memory_pool::SparseBlockDevice;
+
+const IMAGE_BYTES: u64 = 4 << 30;
+const PHYSICAL_BLOCK_SIZE: u32 = 512;
+/// 系统配置槽 1 的偏移：io_min 不声明时固定结构槽距是 4096。
+const SLOT_ONE_OFFSET: u64 = 4096;
+/// 系统配置字段表（`.claude/kb/layout/01-first-txn.md` 一）：单元大小 305、落点粒度 309、位置条目宽 313、扩展点声明值 N 321，各 4 字节。
+const UNIT_BYTES_OFFSET_IN_THE_SLOT: usize = 305;
+const SLOT_GRANULARITY_BYTES_OFFSET_IN_THE_SLOT: usize = 309;
+const LOCATION_ENTRY_BYTES_OFFSET_IN_THE_SLOT: usize = 313;
+const EXTENSION_POINT_DECLARED_BYTES_OFFSET_IN_THE_SLOT: usize = 321;
+
+fn parameters() -> MakeFilesystemParameters {
+    MakeFilesystemParameters {
+        filesystem_identifier: *b"singlefs-unitgeo",
+        region_devices: [DeviceIdentity(0), DeviceIdentity(1), DeviceIdentity(0)],
+        geometry: SystemImmutableSizes {
+            physical_block_size: PHYSICAL_BLOCK_SIZE,
+            minimum_input_output_bytes: 0,
+            fixed_structure_slot_spacing: SystemImmutableSizes::slot_spacing_for(0),
+            journal_ring_bytes: JOURNAL_RING_DEFAULT_BYTES,
+            root_ring_slots_per_region: RootRingSlotsPerRegion::AT_MAKE_FILESYSTEM,
+        },
+    }
+}
+
+/// mkfs 之后把两块盘四个系统配置槽里 `offset_in_the_slot` 起的 4 字节改成 `rewritten_value`（小端）、整槽校验和重封：
+/// 改出来的槽 magic、校验和、incompat 三关照样过，拒它的只能是读者收不收那几判。
+fn pool_with_every_system_configuration_slot_carrying(
+    offset_in_the_slot: usize,
+    rewritten_value: u32,
+) -> Vec<(DeviceIdentity, SparseBlockDevice)> {
+    let mut devices: Vec<(DeviceIdentity, SparseBlockDevice)> = (0..2u32)
+        .map(|device_number| {
+            (
+                DeviceIdentity(device_number),
+                SparseBlockDevice::new(IMAGE_BYTES, PhysicalBlockSizeInBytes(PHYSICAL_BLOCK_SIZE)),
+            )
+        })
+        .collect();
+    make_filesystem(&parameters(), &mut devices).expect("mkfs 收这一份几何");
+    let slot_bytes = usize::try_from(SYSTEM_CONFIGURATION_SLOT_BYTES).expect("4096");
+    for (_, device) in &mut devices {
+        for offset in [0, SLOT_ONE_OFFSET] {
+            let mut slot = vec![0u8; slot_bytes];
+            device
+                .read_at(DeviceOffsetInBytes(offset), &mut slot)
+                .expect("系统配置槽在盘内");
+            slot[offset_in_the_slot..offset_in_the_slot + 4]
+                .copy_from_slice(&rewritten_value.to_le_bytes());
+            let digest = wide_checksum_with_field_zeroed(
+                &slot,
+                slot_bytes,
+                SYSTEM_CONFIGURATION_CHECKSUM_OFFSET,
+            );
+            slot[SYSTEM_CONFIGURATION_CHECKSUM_OFFSET..SYSTEM_CONFIGURATION_CHECKSUM_OFFSET + 32]
+                .copy_from_slice(&digest);
+            device
+                .write_at(DeviceOffsetInBytes(offset), &slot, WriteDurability::Plain)
+                .expect("改完的槽写得回去");
+        }
+    }
+    devices
+}
+
+/// 池级 checker 按字节读这几块盘：只给系统配置那几判用，扫描方向的候选一个都不给。
+struct DevicesReadByThePoolChecker<'pool>(&'pool [(DeviceIdentity, SparseBlockDevice)]);
+
+impl ImageReader for DevicesReadByThePoolChecker<'_> {
+    fn devices(&self) -> Vec<u32> {
+        self.0.iter().map(|(identity, _)| identity.0).collect()
+    }
+    fn device_bytes(&self, device: u32) -> Option<u64> {
+        self.0
+            .iter()
+            .find(|(identity, _)| identity.0 == device)
+            .map(|(_, sparse)| sparse.size_in_bytes())
+    }
+    fn read(&self, device: u32, offset: u64, length: usize) -> Option<Vec<u8>> {
+        let (_, sparse) = self.0.iter().find(|(identity, _)| identity.0 == device)?;
+        let mut bytes = vec![0u8; length];
+        sparse
+            .read_at(DeviceOffsetInBytes(offset), &mut bytes)
+            .ok()?;
+        Some(bytes)
+    }
+    fn candidate_unit_slots(&self, _device: u32) -> Option<Vec<u64>> {
+        Some(Vec::new())
+    }
+    fn candidate_journal_slots(&self, _device: u32) -> Option<Vec<u64>> {
+        Some(Vec::new())
+    }
+}
+
+/// 两块盘前 16 MiB（系统配置两槽 + 整条根环 + 一段余量）的字节：拒绝挂载那一格拿它比「盘上逐字节不变」。
+fn front_of_every_device(devices: &[(DeviceIdentity, SparseBlockDevice)]) -> Vec<Vec<u8>> {
+    devices
+        .iter()
+        .map(|(_, device)| {
+            let mut front = vec![0u8; 16 << 20];
+            device
+                .read_at(DeviceOffsetInBytes(0), &mut front)
+                .expect("前 16 MiB 在盘内");
+            front
+        })
+        .collect()
+}
+
+/// 四个槽的某一格改成 `rewritten_value` 之后：core 择系统配置与可写挂载都整池拒成 `expected_by_core`、可写挂载之后盘上逐字节不变；
+/// 池级 checker 把两块盘四个槽都读成拒在 `expected_by_the_pool_checker` 那一格的不收之值，I-7.13 判红。
+fn assert_core_and_the_pool_checker_refuse_the_field_rewritten_at(
+    offset_in_the_slot: usize,
+    rewritten_value: u32,
+    expected_by_core: SystemConfigurationValueOutsideWhatThisReaderAccepts,
+    expected_by_the_pool_checker: UnitGeometryFieldThatDisagrees,
+) {
+    let mut devices =
+        pool_with_every_system_configuration_slot_carrying(offset_in_the_slot, rewritten_value);
+    let chosen = choose_system_configuration(&devices);
+    assert!(
+        matches!(
+            &chosen,
+            Err(RecoveryFailure::SystemConfigurationValueRefused { value: refused_value, .. }) if *refused_value == expected_by_core
+        ),
+        "core 择系统配置要整池拒成 {expected_by_core:?}，实际是 {chosen:?}"
+    );
+    let before = front_of_every_device(&devices);
+    let mounted = mount_writable(&parameters(), &mut devices);
+    assert!(
+        matches!(
+            &mounted,
+            Err(MountError::Recovery(RecoveryFailure::SystemConfigurationValueRefused { value: refused_value, .. })) if *refused_value == expected_by_core
+        ),
+        "可写挂载要整池拒成 {expected_by_core:?}，实际是 {:?}",
+        mounted.err()
+    );
+    assert_eq!(
+        front_of_every_device(&devices),
+        before,
+        "拒绝挂载在任何写之前：盘上逐字节不变"
+    );
+    let readings = system_configuration_slot_readings(&DevicesReadByThePoolChecker(&devices));
+    assert_eq!(readings.len(), 2, "两块盘各两槽");
+    for (device, slots) in &readings {
+        for (slot_index, slot) in slots.iter().enumerate() {
+            assert_eq!(
+                slot,
+                &SystemConfigurationSlotReading::CarriesAValueThisReaderRefuses {
+                    offset_in_bytes: if slot_index == 0 { 0 } else { SLOT_ONE_OFFSET },
+                    refused: RefusedSystemConfigurationValue::UnitGeometryFieldDisagrees(
+                        expected_by_the_pool_checker
+                    ),
+                },
+                "池级 checker：盘 {device} 槽 {slot_index} 拒在与 core 对得上的那一格"
+            );
+        }
+    }
+    let mut judgements = Judgements::default();
+    assert!(
+        judge_system_configuration_values_the_reader_accepts(&readings, &mut judgements),
+        "池级 checker 交回「有带越界值的槽」：整池不作保"
+    );
+    assert!(
+        judgements
+            .first_violation_of(SYSTEM_CONFIGURATION_CARRIES_ONLY_VALUES_THE_READER_ACCEPTS)
+            .is_some(),
+        "I-7.13 判红"
+    );
+}
+
+/// 单元大小写成 65536（格式常量 32768 的两倍）。
+#[test]
+fn a_unit_size_other_than_the_format_constant_is_refused_by_core_and_the_pool_checker() {
+    assert_core_and_the_pool_checker_refuse_the_field_rewritten_at(
+        UNIT_BYTES_OFFSET_IN_THE_SLOT,
+        65536,
+        SystemConfigurationValueOutsideWhatThisReaderAccepts::UnitBytesNotTheFormatConstant {
+            recorded_unit_bytes: 65536,
+            format_unit_bytes: 32768,
+        },
+        UnitGeometryFieldThatDisagrees::UnitBytesNotTheFormatConstant,
+    );
+}
+
+/// 落点粒度写成 4096（格式常量 16384 之外）。
+#[test]
+fn a_slot_granularity_other_than_the_format_constant_is_refused_by_core_and_the_pool_checker() {
+    assert_core_and_the_pool_checker_refuse_the_field_rewritten_at(
+        SLOT_GRANULARITY_BYTES_OFFSET_IN_THE_SLOT,
+        4096,
+        SystemConfigurationValueOutsideWhatThisReaderAccepts::SlotGranularityBytesNotTheFormatConstant {
+            recorded_slot_granularity_bytes: 4096,
+            format_slot_granularity_bytes: 16384,
+        },
+        UnitGeometryFieldThatDisagrees::SlotGranularityBytesNotTheFormatConstant,
+    );
+}
+
+/// 位置条目宽写成 15（格式常量 14 加一）。
+#[test]
+fn a_location_entry_width_other_than_the_format_constant_is_refused_by_core_and_the_pool_checker() {
+    assert_core_and_the_pool_checker_refuse_the_field_rewritten_at(
+        LOCATION_ENTRY_BYTES_OFFSET_IN_THE_SLOT,
+        15,
+        SystemConfigurationValueOutsideWhatThisReaderAccepts::LocationEntryBytesNotTheFormatConstant {
+            recorded_location_entry_bytes: 15,
+            format_location_entry_bytes: 14,
+        },
+        UnitGeometryFieldThatDisagrees::LocationEntryBytesNotTheFormatConstant,
+    );
+}
+
+/// 扩展点声明值 N 写成 1（第一版只收 0）。
+#[test]
+fn a_non_zero_extension_point_size_is_refused_by_core_and_the_pool_checker() {
+    assert_core_and_the_pool_checker_refuse_the_field_rewritten_at(
+        EXTENSION_POINT_DECLARED_BYTES_OFFSET_IN_THE_SLOT,
+        1,
+        SystemConfigurationValueOutsideWhatThisReaderAccepts::ExtensionPointDeclaredBytesNotTheFirstVersionValue {
+            recorded_extension_point_declared_bytes: 1,
+            first_version_extension_point_declared_bytes: 0,
+        },
+        UnitGeometryFieldThatDisagrees::ExtensionPointDeclaredBytesNotTheFirstVersionValue,
+    );
+}
