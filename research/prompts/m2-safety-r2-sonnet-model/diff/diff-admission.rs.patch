+/// S4 二轮候选 A4（只供三方论证）：挂载准入需求恒 0，只判「挂载期承诺量本身放不放得下」——
+/// 不理会已分配、不可回收、defer 待释放、被抛弃根独占量与三项全池承诺量（`S4Candidate` 的文档注释）。
+/// 不走 `admit_on_every_device_for_candidate`：这条读法只对「需求恒 0」的挂载安全，
+/// 若被同一个开关带进发布路径（需求非零）会放行几乎一切，所以单独成一个函数，调用方（`mount::establish_instance`）
+/// 只在候选是 `A4` 时才调它，且只在挂载入口调。
+///
+/// # Errors
+/// `AdmissionRefusedOnSomeDevices`：至少一块盘「容量 − 挂载期承诺量」为负，交回不够的每一块（`demand` 字段填 0，
+/// 因为这条候选不算需求）。
+pub fn mount_admission_a4_switch_reserve_only(
+    reading: &AdmissionReading,
+) -> Result<(), AdmissionRefusedOnSomeDevices> {
+    let short_devices: Vec<DeviceShortOfDemand> = reading
+        .per_device
+        .iter()
+        .filter_map(|terms| {
+            let available = i128::from(terms.capacity.0) - i128::from(terms.mount_time_commitment.0);
+            (available < 0).then_some(DeviceShortOfDemand {
+                device: terms.device,
+                available: AvailableBytesOnOneDevice(available),
+                demand: BytesOnOneDevice(0),
+            })
+        })
+        .collect();
+    if short_devices.is_empty() {
+        Ok(())
+    } else {
+        Err(AdmissionRefusedOnSomeDevices { short_devices })
+    }
+}
