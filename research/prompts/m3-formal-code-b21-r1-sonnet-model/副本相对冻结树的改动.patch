+#[test]
+fn b21_probe_torn_both_slots_witness() {
+    let (_healthy, crash_image) =
+        crash_image_where_both_system_configuration_slots_of_device_zero_are_torn();
+    let sc = singlefs_core::recovery::choose_system_configuration(&crash_image).expect("盘 1 的槽仍可选");
+    let fields = read_recovery_fields(&crash_image, ComparedVersion::TheRecoveredVersion);
+    let selected = fields.report.effective_root;
+    let records = singlefs_core::recovery::scan_journal(&crash_image, &sc);
+    let last = records.values()
+        .filter(|r| Some((r.instance, r.checkpoint_txg)) == selected && r.place_in_publish == singlefs_core::journal::JournalRecordPlaceInPublish::LastRecordOfThePublish)
+        .map(|r| r.counter).max();
+    let max_counter = records.values().map(|r| r.counter).max();
+    println!("PROBE2 chosen_slot_journal_tail={} selected={:?} last_record_counter_of_selected={:?} max_counter_in_ring={:?}", sc.quantities.journal_tail, selected, last, max_counter);
