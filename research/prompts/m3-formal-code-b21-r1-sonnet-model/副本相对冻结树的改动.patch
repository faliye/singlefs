+/// 第 21 批 K1 探针：每张坏镜像与干净镜像逐区比；输出判红清单与改动落点。
+#[test]
+fn b21_probe_bad_images() {
+    let clean = build_pool("b21-probe").memory_pool();
+    let drop_kind = std::env::var("B21_DROP").unwrap_or("none".into());
+    let list = known_bad_images_of_pointer_journal_and_generation_fields();
+    println!("PROBE drop={drop_kind} total_images={}", list.len());
+    for (image_index, (invariant, mutation)) in list.into_iter().enumerate() {
+        let mut image = clean.clone();
+        mutation(&mut image);
+        let verdicts = check_pool_image(&image);
+        let violated = violated_invariants(&verdicts);
+        let detail = verdicts.iter().find_map(|(n, v)| match v { InvariantVerdict::Violated(d) if *n == "I-9.27" => Some(d.clone()), _ => None });
+        // 单元区内每个登记单元的差异
+        let mut diffs: Vec<String> = Vec::new();
+        for (slot, length) in UNITS {
+            for device in DEVICES {
+                let a = read(&clean, device, slot * SLOT, length);
+                let b = read(&image, device, slot * SLOT, length);
+                let offs: Vec<usize> = (0..length).filter(|i| a[*i] != b[*i]).collect();
+                if !offs.is_empty() {
+                    let desc = if slot == TREE_TABLE {
+                        let mut parts = Vec::new();
+                        for o in &offs {
+                            if *o >= 131 && (*o - 131) / 200 < 11 {
+                                let e = (*o - 131) / 200; let f = (*o - 131) % 200;
+                                parts.push(format!("e{e}+{f}"));
+                            } else { parts.push(format!("hdr+{o}")); }
+                        }
+                        parts.join(",")
+                    } else { format!("{} bytes", offs.len()) };
+                    diffs.push(format!("slot {slot} dev {device}: {desc}"));
+                }
+            }
+        }
+        let mut other = 0usize;
+        for (device, offset) in root_slots() {
+            if read(&clean, device, offset, 512) != read(&image, device, offset, 512) { other += 1; }
+        }
+        println!("PROBE img={image_index} inv={invariant} violated={violated:?} i927_detail={detail:?} root_slots_changed={other}");
+        for d in diffs { println!("PROBE   diff {d}"); }
+    }
+}
