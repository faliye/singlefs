+    /// 这一版里没有这个角色的单元（同 [`TransactionOutput::unit`]）。
+    #[must_use]
+    pub fn unit(&self, identity: TransactionUnit) -> &'table PublishedUnit {
+        self.first_entry_of(&identity)
+            .expect(EVERY_ROLE_LOOKED_UP_HAS_A_UNIT_IN_THE_VERSION)
+    }
+}
