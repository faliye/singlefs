+                instance,
+                checkpoint_txg,
+                ..
+            } => format!("instance{}_txg{}", instance.0, checkpoint_txg.0),
+            Layer0PublishOfState::AfterTheLastRoot => "after_the_last_root".to_string(),
+            Layer0PublishOfState::EveryWritePersisted => "every_write_persisted".to_string(),
+        }
