+        instance: InstanceGeneration,
+        checkpoint_txg: CheckpointTxg,
+    },
+    /// 写表里最后一次根槽写之后的段（最后那次发布的系统配置槽轮换）：后面没有根槽写可归。
+    AfterTheLastRoot,
+    /// 每一段都整段持久的那一个状态（闭式 1 + Σ(2^|段| − 1) 里的那个 1）。
+    EveryWritePersisted,
+}
