+            || self.text_of(after_call + 5) != "="
+            || self.text_of(after_call + 6) != ">"
+            || self.text_of(after_call + 7) != self.text_of(after_call + 3)
+            || self.text_of(after_call + 8) != ","
+            || self.text_of(after_call + 9) != "Err"
+            || self.text_of(after_call + 10) != "("
