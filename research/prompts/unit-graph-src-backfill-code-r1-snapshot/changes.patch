+        2
+    } else {
+        1
+    };
+    let Some(let_position) = name_position.checked_sub(let_distance) else {
+        return false;
+    };
+    let Some(before_the_let) = let_position.checked_sub(1) else {
+        return false;
+    };
+    text_at(let_position) == "let"
+        && matches!(text_at(before_the_let), "{" | "}" | ";")
