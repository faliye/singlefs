+/// 收到 `use` 为止；`use_keyword` 是 `use` 的位置。
+fn use_path_leading_to<'source>(
+    source: &'source str,
+    tokens: &[Token],
+    use_keyword: usize,
+    path_start: usize,
+) -> Vec<&'source str> {
