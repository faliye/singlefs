+//! m3-birth-floor-r1 攻方原型：一段历史（起点之后的全部操作）录下的写流，按层 0 的切段与全量展开（每段任意真子集，原地覆写取三态）
+//! 枚举崩溃状态，每个状态跑层 0 的整套判定（两种 journal 政策的恢复、两份 oracle、池级 checker、记录核对器），再判诞生代号下界三种写法；
+//! BF_MOUNT=1 时再把这个崩溃镜像可写挂载一次（恢复、写行、暖机），挂载之后的镜像上再判一遍池级 checker 与三种写法。
+//! 每段跑之前用 `closed_form_state_count` 与带撕裂第三态的状态数算全量，超过 BF_MAX_STATES（默认 1_000_000）的那段不跑、只报数。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::birth_floor_judgements;
+use singlefs_checker_tier::crash::{full_expansion, judge_layer0_state_range, layer0_state_count_with_torn_in_place_overwrites};
+use singlefs_core::address::{CheckpointTxg, InstanceGeneration};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::mount::mount_writable;
+use singlefs_harness::memory_pool::{closed_form_state_count, writes_and_segments_with_stream_indexes, MemoryPool, PublishedVersion, SparseBlockDevice};
+use singlefs_harness::segments::StepKind;
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    states_red: u64,
+    first: Option<String>,
+}
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+/// 一段历史：名字、起点前缀（只跑一次、不枚举）、枚举崩溃状态的后缀。
+type History = (String, &'static str, Vec<Op>);
+
+fn prefix_ops(prefix: &str) -> Vec<Op> {
+    match prefix {
+        "A" => vec![],
+        "ow3" => vec![ow(1), ow(2), ow(3)],
+        "ni300-ow-ni1" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }],
+        "sw3-ow-sw2" => vec![Op::SequentialWrite { units: 3, seed: 1 }, ow(2), Op::SequentialWrite { units: 2, seed: 3 }],
+        "sw3-ni240-ow-ni5" => vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }],
+        "sw3-ow-sw2/rb2" => vec![Op::SequentialWrite { units: 3, seed: 1 }, ow(2), Op::SequentialWrite { units: 2, seed: 3 }, Op::RollBack { index: 2 }],
+        "sw3-ni240-ow-ni5/rb2-ni2" => vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }, Op::RollBack { index: 2 }, Op::NewInodes { count: 2 }],
+        "ni300-ow-ni1/rbcrash2-remount" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, Op::RollBackCrashBeforeRoot { index: 2 }, Op::Remount],
+        "ow3/rb2-remount" => vec![ow(1), ow(2), ow(3), Op::RollBack { index: 2 }, Op::Remount],
+        "ni300-ow-ni1-ow/rb3" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2), Op::RollBack { index: 3 }],
+        "sw3-ow-sw2-ow/rb3" => vec![Op::SequentialWrite { units: 3, seed: 1 }, ow(2), Op::SequentialWrite { units: 2, seed: 3 }, ow(4), Op::RollBack { index: 3 }],
+        "sw3-ni240-ow-ni5/rb3" => vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }, Op::RollBack { index: 3 }],
+        "sw3-ni240-ow-ni5/rbcrash3-remount-raise5" => vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }, Op::RollBackCrashBeforeRoot { index: 3 }, Op::Remount, Op::RaiseFloorTo { txg: 5 }],
+        "ni300-ow-ni1-ow/rbcrash3-remount-raise5" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2), Op::RollBackCrashBeforeRoot { index: 3 }, Op::Remount, Op::RaiseFloorTo { txg: 5 }],
+        "ni300-ow-ni1-ow/rb3-raise5" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2), Op::RollBack { index: 3 }, Op::RaiseFloorTo { txg: 5 }],
+        other => panic!("前缀 {other} 不认得"),
+    }
+}
+
+fn histories(set: &str) -> Vec<History> {
+    let mut out: Vec<History> = Vec::new();
+    match set {
+        "probe" => {
+            for prefix in ["ow3", "ni300-ow-ni1"] {
+                for (name, suffix) in [
+                    ("ow", vec![ow(9)]),
+                    ("ni1", vec![Op::NewInodes { count: 1 }]),
+                    ("sw1", vec![Op::SequentialWrite { units: 1, seed: 9 }]),
+                    ("rb2", vec![Op::RollBack { index: 2 }]),
+                    ("raise1", vec![Op::RaiseFloorBy { steps: 1 }]),
+                    ("remount", vec![Op::Remount]),
+                    ("rb2-raise2", vec![Op::RollBack { index: 2 }, Op::RaiseFloorBy { steps: 2 }]),
+                ] {
+                    out.push((format!("{prefix}/{name}"), prefix, suffix));
+                }
+            }
+        }
+        "run1" => {
+            for prefix in ["ni300-ow-ni1-ow/rb3", "sw3-ow-sw2-ow/rb3", "sw3-ni240-ow-ni5/rb3"] {
+                out.push((format!("{prefix}/[raiseTo5]"), prefix, vec![Op::RaiseFloorTo { txg: 5 }]));
+            }
+            out.push(("ni300-ow-ni1-ow/rbcrash3-remount-raise5/[rb1]".into(), "ni300-ow-ni1-ow/rbcrash3-remount-raise5", vec![Op::RollBack { index: 1 }]));
+        }
+        "x" => {
+            for prefix in ["ni300-ow-ni1-ow/rb3", "sw3-ow-sw2-ow/rb3", "sw3-ni240-ow-ni5/rb3"] {
+                out.push((format!("{prefix}/[raiseTo5]"), prefix, vec![Op::RaiseFloorTo { txg: 5 }]));
+                out.push((format!("{prefix}/[ni2,raiseTo5]"), prefix, vec![Op::NewInodes { count: 2 }, Op::RaiseFloorTo { txg: 5 }]));
+            }
+            for prefix in ["sw3-ni240-ow-ni5/rbcrash3-remount-raise5", "ni300-ow-ni1-ow/rbcrash3-remount-raise5", "ni300-ow-ni1-ow/rb3-raise5"] {
+                out.push((format!("{prefix}/[remount]"), prefix, vec![Op::Remount]));
+                out.push((format!("{prefix}/[rb0]"), prefix, vec![Op::RollBack { index: 0 }]));
+                out.push((format!("{prefix}/[rb1]"), prefix, vec![Op::RollBack { index: 1 }]));
+            }
+        }
+        "main" => {
+            out.push(("ni300-ow-ni1/[rb2,raise2]".into(), "ni300-ow-ni1", vec![Op::RollBack { index: 2 }, Op::RaiseFloorBy { steps: 2 }]));
+            for steps in 1..=4u64 {
+                out.push((format!("sw3-ow-sw2/rb2/[raise{steps}]"), "sw3-ow-sw2/rb2", vec![Op::RaiseFloorBy { steps }]));
+                out.push((format!("sw3-ni240-ow-ni5/rb2-ni2/[raise{steps}]"), "sw3-ni240-ow-ni5/rb2-ni2", vec![Op::RaiseFloorBy { steps }]));
+                out.push((format!("ni300-ow-ni1/rbcrash2-remount/[raise{steps}]"), "ni300-ow-ni1/rbcrash2-remount", vec![Op::RaiseFloorBy { steps }]));
+                out.push((format!("ow3/rb2-remount/[raise{steps}]"), "ow3/rb2-remount", vec![Op::RaiseFloorBy { steps }]));
+            }
+        }
+        "core" => {
+            for prefix in ["ow3", "ni300-ow-ni1", "sw3-ow-sw2", "sw3-ni240-ow-ni5"] {
+                for index in 1..=3usize {
+                    for (name, suffix) in [
+                        ("raise1", vec![Op::RaiseFloorBy { steps: 1 }]),
+                        ("raise2", vec![Op::RaiseFloorBy { steps: 2 }]),
+                        ("raise3", vec![Op::RaiseFloorBy { steps: 3 }]),
+                        ("remount-raise3", vec![Op::Remount, Op::RaiseFloorBy { steps: 3 }]),
+                        ("raise2-remount", vec![Op::RaiseFloorBy { steps: 2 }, Op::Remount]),
+                        ("rb0-raise2", vec![Op::RollBack { index: 0 }, Op::RaiseFloorBy { steps: 2 }]),
+                    ] {
+                        let mut ops = vec![Op::RollBack { index }];
+                        ops.extend(suffix);
+                        out.push((format!("{prefix}/rb{index}/{name}"), prefix, ops));
+                    }
+                }
+            }
+        }
+        other => panic!("BF_SET={other} 不认得"),
+    }
+    out
+}
+
+fn mounted_image_of(base: &MemoryPool, image: &singlefs_harness::memory_pool::CrashImage<'_>, parameters: &singlefs_core::make_filesystem::MakeFilesystemParameters) -> Option<MemoryPool> {
+    let mut devices: Vec<(singlefs_core::address::DeviceIdentity, SparseBlockDevice)> = base
+        .devices
+        .iter()
+        .map(|(identity, sparse)| {
+            let mut device = SparseBlockDevice::new(base.device_size_in_bytes, PhysicalBlockSizeInBytes(512));
+            device.image = sparse.clone();
+            for (write, is_persisted) in image.writes.iter().zip(&image.persisted) {
+                if *is_persisted && write.device == *identity {
+                    write.contents.apply_to(&mut device.image, write.offset);
+                }
+            }
+            (*identity, device)
+        })
+        .collect();
+    let mounted = mount_writable(parameters, &mut devices).ok();
+    mounted.map(|_| MemoryPool {
+        devices: devices.iter().map(|(identity, device)| (*identity, device.image.clone())).collect(),
+        device_size_in_bytes: base.device_size_in_bytes,
+    })
+}
+
+#[test]
+fn birth_floor_variants_over_layer0_crash_states() {
+    let set = std::env::var("BF_SET").unwrap_or_else(|_| "core".to_string());
+    let only: Option<String> = std::env::var("BF_ONLY").ok();
+    let count_only = std::env::var("BF_COUNT_ONLY").is_ok();
+    let mount_after = std::env::var("BF_MOUNT").is_ok_and(|value| value == "1");
+    let max_states: u64 = std::env::var("BF_MAX_STATES").ok().and_then(|v| v.parse().ok()).unwrap_or(1_000_000);
+    let threads: usize = std::env::var("SINGLEFS_THREAD_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(1).max(1);
+    let start = Driver::after_first_file();
+    let mut grand_total_states = 0u64;
+    let mut starts: BTreeMap<&'static str, Driver> = BTreeMap::new();
+    for (name, prefix, ops) in histories(&set) {
+        if only.as_ref().is_some_and(|only| !name.contains(only.as_str())) {
+            continue;
+        }
+        let started = std::time::Instant::now();
+        let prefix_start = starts.entry(prefix).or_insert_with(|| {
+            let mut driver = start.fork();
+            for op in prefix_ops(prefix) {
+                assert!(matches!(driver.apply(op), Outcome::Applied), "起点前缀 {prefix} 的 {op:?} 被拒");
+            }
+            driver
+        });
+        let mut driver = prefix_start.fork();
+        let base = driver.image();
+        let mut outcomes = Vec::new();
+        for op in &ops {
+            let outcome = driver.apply(*op);
+            outcomes.push(format!("{op:?}:{}", match outcome { Outcome::Applied => "ok".to_string(), Outcome::Refused(reason) => format!("REFUSED {}", reason.chars().take(80).collect::<String>()) }));
+        }
+        let operations = driver.retained_operations();
+        let (writes, segments, _) = writes_and_segments_with_stream_indexes(&operations, &driver.geometry());
+        let closed = closed_form_state_count(&segments);
+        let torn = layer0_state_count_with_torn_in_place_overwrites(&base, &writes, &segments, &full_expansion);
+        let largest_segment = segments.iter().map(Vec::len).max().unwrap_or(0);
+        println!("BF_HISTORY name={name} ops={} writes={} segments={} largest_segment={largest_segment} closed_form_states={closed} layer0_states={torn} outcomes={outcomes:?}", ops.len(), writes.len(), segments.len());
+        if count_only {
+            continue;
+        }
+        if torn > max_states {
+            println!("BF_SKIPPED name={name} layer0_states={torn} > {max_states}");
+            continue;
+        }
+        let judged_root_index = writes
+            .iter()
+            .rposition(|write| write.kind == StepKind::RootRecordFua)
+            .expect("历史里至少一次根槽写");
+        let versions: Vec<PublishedVersion> = driver
+            .contents
+            .iter()
+            .map(|((instance, txg), content)| PublishedVersion {
+                instance: InstanceGeneration(u32::try_from(*instance).expect("实例号")),
+                checkpoint_txg: CheckpointTxg(*txg),
+                content: content.clone(),
+            })
+            .collect();
+        let parameters = driver.parameters.clone();
+        let aggregate: Mutex<BTreeMap<String, Aggregate>> = Mutex::new(BTreeMap::new());
+        // 只为估时：BF_STATE_LIMIT 截前 N 个状态（正式跑不设）。
+        let judged_states = std::env::var("BF_STATE_LIMIT").ok().and_then(|v| v.parse::<u64>().ok()).map_or(torn, |limit| limit.min(torn));
+        let chunk = judged_states.div_ceil(threads as u64);
+        std::thread::scope(|scope| {
+            for thread in 0..threads as u64 {
+                let mut range = (thread * chunk).min(judged_states)..((thread + 1) * chunk).min(judged_states);
+                // 只为看终态：BF_LAST_ONLY 只判全部持久那一个状态（正式跑不设）。
+                if std::env::var("BF_LAST_ONLY").is_ok() {
+                    range = if thread == 0 { torn - 1..torn } else { 0..0 };
+                }
+                let (base, writes, segments, versions, aggregate, parameters, name) = (&base, &writes, &segments, &versions, &aggregate, &parameters, &name);
+                scope.spawn(move || {
+                    let mut local: BTreeMap<String, Aggregate> = BTreeMap::new();
+                    let mut note = |key: String, evaluated: u64, violations: u64, first: Option<String>| {
+                        let entry = local.entry(key).or_default();
+                        entry.evaluated += evaluated;
+                        entry.violations += violations;
+                        entry.states_red += u64::from(violations > 0);
+                        if entry.first.is_none() && (violations > 0 || first.as_ref().is_some_and(|text| !text.is_empty())) {
+                            entry.first = first;
+                        }
+                    };
+                    let _ = judge_layer0_state_range(base, writes, segments, judged_root_index, versions, &full_expansion, range, &mut |ordinal, image, judgement| {
+                        let red = judgement.red_items();
+                        note("layer0-red-states".to_string(), 1, u64::from(!red.is_empty()), (!red.is_empty()).then(|| format!("{name} state={ordinal} {red:?}")));
+                        let skip_birth_floor = std::env::var("BF_NO_BF").is_ok();
+                        for (key, tally) in if skip_birth_floor { BTreeMap::new() } else { birth_floor_judgements(image) } {
+                            note(format!("crash:{key}"), tally.evaluated, tally.violations, tally.first_violation.map(|text| format!("{name} state={ordinal} :: {text}")));
+                        }
+                        if mount_after {
+                            match mounted_image_of(base, image, parameters) {
+                                Some(mounted) => {
+                                    let violated: Vec<&str> = check_pool_image(&mounted)
+                                        .into_iter()
+                                        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+                                        .map(|(invariant, _)| invariant)
+                                        .collect();
+                                    note("mounted:pool-checker-red".to_string(), 1, u64::from(!violated.is_empty()), (!violated.is_empty()).then(|| format!("{name} state={ordinal} {violated:?}")));
+                                    for (key, tally) in birth_floor_judgements(&mounted) {
+                                        note(format!("mounted:{key}"), tally.evaluated, tally.violations, tally.first_violation.map(|text| format!("{name} state={ordinal} :: {text}")));
+                                    }
+                                }
+                                None => note("mounted:mount-refused".to_string(), 1, 0, Some(format!("{name} state={ordinal}"))),
+                            }
+                        }
+                    });
+                    let mut aggregate = aggregate.lock().expect("锁");
+                    for (key, entry) in local {
+                        let total = aggregate.entry(key).or_default();
+                        total.evaluated += entry.evaluated;
+                        total.violations += entry.violations;
+                        total.states_red += entry.states_red;
+                        if total.first.is_none() {
+                            total.first = entry.first;
+                        }
+                    }
+                });
+            }
+        });
+        grand_total_states += judged_states;
+        println!("BF_DONE name={name} states={judged_states} of={torn} seconds={:.1}", started.elapsed().as_secs_f64());
+        for (key, entry) in aggregate.into_inner().expect("锁") {
+            println!(
+                "BF name={name} :: {key} evaluated={} violations={} states_red={} first={}",
+                entry.evaluated,
+                entry.violations,
+                entry.states_red,
+                entry.first.unwrap_or_else(|| "-".to_string())
+            );
+        }
+    }
+    println!("BF_TOTAL states_judged={grand_total_states}");
+}
diff -ruN '--exclude=target' m3-batch4-freeze/tree/crates/singlefs-checker/src/walk/proto_b.rs m3-birth-floor-r1-opus/tree/crates/singlefs-checker/src/walk/proto_b.rs
--- m3-batch4-freeze/tree/crates/singlefs-checker/src/walk/proto_b.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r1-opus/tree/crates/singlefs-checker/src/walk/proto_b.rs	2026-10-01 19:05:06.634655943 +0000
@@ -0,0 +1,1071 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：正文 B1–B6 与底稿主表各行的候选措辞各写成一个只读谓词，
+//! 不进 `IMPLEMENTED_INVARIANTS`、不改 `check_pool_image`。每个谓词名字前缀是格名（B2-all、B3-lower……）。
+use super::*;
+
+/// 一个谓词在一个镜像上的结果：评估次数、违例次数、第一处违例。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ProtoTally {
+    pub evaluated: u64,
+    pub violations: u64,
+    pub first_violation: Option<String>,
+}
+
+#[derive(Default)]
+struct Proto {
+    by_name: BTreeMap<&'static str, ProtoTally>,
+}
+
+impl Proto {
+    fn judge(&mut self, name: &'static str, holds: bool, detail: impl FnOnce() -> String) {
+        let entry = self.by_name.entry(name).or_default();
+        entry.evaluated += 1;
+        if !holds {
+            entry.violations += 1;
+            if entry.first_violation.is_none() {
+                entry.first_violation = Some(detail());
+            }
+        }
+    }
+}
+
+fn root_segment_of(record: &[u8]) -> Vec<u8> {
+    let mut segment = Vec::with_capacity(188);
+    segment.extend_from_slice(&record[36..122]);
+    segment.extend_from_slice(&record[256..342]);
+    segment.extend_from_slice(&record[122..130]);
+    segment.extend_from_slice(&record[130..138]);
+    segment
+}
+
+fn full_records_of_device(
+    reader: &dyn ImageReader,
+    geometry: &PoolGeometry,
+    device: u32,
+    filesystem_identifier_low: u64,
+) -> BTreeMap<u64, crate::JournalRecordView> {
+    let record_bytes = usize::try_from(JOURNAL_RECORD_BYTES).expect("4096");
+    let slots: Vec<u64> = (0..geometry.journal_ring_bytes / JOURNAL_RECORD_BYTES).collect();
+    let mut records = BTreeMap::new();
+    for slot in slots {
+        let offset = geometry.journal_ring_start_slot * SLOT_BYTES + slot * JOURNAL_RECORD_BYTES;
+        let Some(bytes) = reader.read(device, offset, record_bytes) else {
+            continue;
+        };
+        if let Ok(record) = check_journal_record(&bytes, filesystem_identifier_low) {
+            records.insert(record.counter, record);
+        }
+    }
+    records
+}
+
+/// 候选集（照 `check_pool_image` 的算法另写一份，只读）：最新根无条件在内；别的按最新根的实例表判不抛弃且 txg ≥ F 生效值。
+fn candidate_indexes_of(
+    reader: &dyn ImageReader,
+    geometry: &PoolGeometry,
+    roots: &[(u64, u64, crate::RootView)],
+    newest_index: usize,
+) -> Vec<usize> {
+    let rows = instance_table_rows_of_root_without_judging(reader, &roots[newest_index].2.record_bytes)
+        .unwrap_or_default();
+    let abandoned = |root: &crate::RootView| abandoned_by_instance_table_rows(&rows, root);
+    let mut newest_on_device: BTreeMap<u32, &crate::RootView> = BTreeMap::new();
+    for (region, _, root) in roots {
+        if abandoned(root) {
+            continue;
+        }
+        let device = geometry.region_devices[usize::try_from(*region).expect("区域")];
+        let slot = newest_on_device.entry(device).or_insert(root);
+        if (root.checkpoint_txg, root.instance) > (slot.checkpoint_txg, slot.instance) {
+            *slot = root;
+        }
+    }
+    let abandoned_floor = roots
+        .iter()
+        .filter(|(_, _, root)| abandoned(root))
+        .map(|(_, _, root)| root.rollback_floor)
+        .max()
+        .unwrap_or(0);
+    let floor = verified_system_configuration_slots(reader)
+        .into_iter()
+        .flat_map(|(_, slots)| slots.into_iter().map(|(view, _)| view))
+        .filter(|view| view.filesystem_identifier == geometry.filesystem_identifier)
+        .map(|view| view.rollback_floor)
+        .fold(
+            newest_on_device
+                .values()
+                .map(|root| root.rollback_floor)
+                .max()
+                .unwrap_or(0)
+                .max(abandoned_floor),
+            u64::max,
+        );
+    roots
+        .iter()
+        .enumerate()
+        .filter(|(index, (_, _, root))| {
+            *index == newest_index || (!abandoned(root) && root.checkpoint_txg >= floor)
+        })
+        .map(|(index, _)| index)
+        .collect()
+}
+
+fn unit_bytes_of_class(class: u8) -> usize {
+    match class {
+        2 => node_bytes(),
+        _ => data_unit_bytes(),
+    }
+}
+
+/// 交回每个谓词的结果（名字 → 次数与第一处违例）。
+#[must_use]
+pub fn proto_judgements(reader: &dyn ImageReader) -> BTreeMap<&'static str, ProtoTally> {
+    let mut proto = Proto::default();
+    let chosen: Vec<_> = chosen_system_configurations(reader)
+        .into_iter()
+        .filter_map(|(device, chosen)| chosen.map(|(view, geometry)| (device, view, geometry)))
+        .collect();
+    let Some((_, _, geometry)) = chosen.first().cloned() else {
+        return proto.by_name;
+    };
+    let fsid_low = u64::from_le_bytes(geometry.filesystem_identifier[..8].try_into().expect("8"));
+    judge_b6_system_configuration(reader, &geometry, &mut proto);
+    let roots = valid_roots(reader, &geometry);
+    judge_b6_root_positions(&roots, &geometry, &mut proto);
+    let journal: Vec<(u32, BTreeMap<u64, crate::JournalRecordView>)> = reader
+        .devices()
+        .into_iter()
+        .map(|device| (device, full_records_of_device(reader, &geometry, device, fsid_low)))
+        .collect();
+    judge_b6_journal_txg(&journal, &mut proto);
+    judge_b2(&journal, &roots, &mut proto);
+    judge_b3_named(reader, &journal, &mut proto);
+    if roots.is_empty() {
+        return proto.by_name;
+    }
+    let newest_index = roots
+        .iter()
+        .enumerate()
+        .max_by_key(|(_, (_, _, root))| (root.checkpoint_txg, root.instance))
+        .map(|(index, _)| index)
+        .expect("非空");
+    let candidates = candidate_indexes_of(reader, &geometry, &roots, newest_index);
+    let mut cache = IndexNodeCache::new();
+    judge_b3_birth(reader, &roots, &candidates, &mut cache, &mut proto);
+    judge_b5(reader, &roots, &candidates, &mut proto);
+    judge_b4_b1(reader, &roots, &candidates, &mut cache, &mut proto);
+    proto.by_name
+}
+
+/// B6 世代号：世代号 ≥ 2 的自证过的槽 i，世代号 mod 2 == i；两槽都自证过时，两个 1 或相差恰为 1（底稿 ② 表第一行）。
+fn judge_b6_system_configuration(reader: &dyn ImageReader, geometry: &PoolGeometry, proto: &mut Proto) {
+    for (device, readings) in system_configuration_slot_readings(reader) {
+        let generations: Vec<Option<u64>> = readings
+            .iter()
+            .map(|reading| match reading {
+                crate::image::SystemConfigurationSlotReading::Usable(view, _)
+                    if view.filesystem_identifier == geometry.filesystem_identifier =>
+                {
+                    Some(view.slot_generation)
+                }
+                _ => None,
+            })
+            .collect();
+        for (slot, generation) in generations.iter().enumerate() {
+            if let Some(generation) = generation {
+                if *generation >= 2 {
+                    proto.judge("B6-sc-parity", *generation % 2 == slot as u64, || {
+                        format!("盘 {device} 槽 {slot} 世代号 {generation}")
+                    });
+                }
+            }
+        }
+        if let (Some(zero), Some(one)) = (generations[0], generations[1]) {
+            proto.judge(
+                "B6-sc-pair",
+                (zero == 1 && one == 1) || zero.abs_diff(one) == 1,
+                || format!("盘 {device} 两槽世代号 {zero} / {one}"),
+            );
+        }
+    }
+}
+
+/// B6 根记录位置：区域 = txg mod R、槽 = (txg div R) mod S；txg 0 只判槽号 0。
+fn judge_b6_root_positions(
+    roots: &[(u64, u64, crate::RootView)],
+    geometry: &PoolGeometry,
+    proto: &mut Proto,
+) {
+    for (region, slot, root) in roots {
+        let txg = root.checkpoint_txg;
+        let holds = if txg == 0 {
+            *slot == 0
+        } else {
+            *region == txg % geometry.regions
+                && *slot == (txg / geometry.regions) % geometry.slots_per_region
+        };
+        proto.judge("B6-root", holds, || {
+            format!("根 (实例 {}, txg {txg}) 住区域 {region} 槽 {slot}", root.instance)
+        });
+    }
+}
+
+/// B6 journal txg：同一块盘按计数器排，txg 不减；实例换了时严格大于前面每一条。
+fn judge_b6_journal_txg(
+    journal: &[(u32, BTreeMap<u64, crate::JournalRecordView>)],
+    proto: &mut Proto,
+) {
+    for (device, records) in journal {
+        let mut previous: Option<&crate::JournalRecordView> = None;
+        let mut highest_before: Option<u64> = None;
+        for record in records.values() {
+            if let Some(previous) = previous {
+                proto.judge("B6-jtxg-nondecreasing", record.checkpoint_txg >= previous.checkpoint_txg, || {
+                    format!(
+                        "盘 {device} 计数器 {} (实例 {}, txg {}) 之后计数器 {} (实例 {}, txg {})",
+                        previous.counter, previous.instance, previous.checkpoint_txg,
+                        record.counter, record.instance, record.checkpoint_txg
+                    )
+                });
+                if record.instance != previous.instance {
+                    let highest = highest_before.unwrap_or(0);
+                    proto.judge("B6-jtxg-new-instance", record.checkpoint_txg > highest, || {
+                        format!(
+                            "盘 {device} 计数器 {} (实例 {}, txg {}) 换实例，前面最大 txg {highest}",
+                            record.counter, record.instance, record.checkpoint_txg
+                        )
+                    });
+                }
+            }
+            highest_before = Some(highest_before.map_or(record.checkpoint_txg, |h| h.max(record.checkpoint_txg)));
+            previous = Some(record);
+        }
+    }
+}
+
+fn describe_segment_difference(record_segment: &[u8], root_segment: &[u8]) -> String {
+    let names = [(0, 86, "树表指针"), (86, 172, "映射根"), (172, 180, "水位"), (180, 188, "F")];
+    names
+        .iter()
+        .filter(|(start, end, _)| record_segment[*start..*end] != root_segment[*start..*end])
+        .map(|(_, _, name)| *name)
+        .collect::<Vec<_>>()
+        .join("、")
+}
+
+/// B2：同 (实例, txg) 配对的根与记录，新根段四字段逐字节相等；B2-max 只比这一块盘上那一组计数器最大的那条，
+/// B2-all 比那一组每一条，B2-last 只比带末条标志的那条。
+fn judge_b2(
+    journal: &[(u32, BTreeMap<u64, crate::JournalRecordView>)],
+    roots: &[(u64, u64, crate::RootView)],
+    proto: &mut Proto,
+) {
+    for (device, records) in journal {
+        let mut groups: BTreeMap<(u32, u64), Vec<&crate::JournalRecordView>> = BTreeMap::new();
+        for record in records.values() {
+            groups.entry((record.instance, record.checkpoint_txg)).or_default().push(record);
+        }
+        for ((instance, txg), group) in &groups {
+            for (_, _, root) in roots
+                .iter()
+                .filter(|(_, _, root)| root.instance == *instance && root.checkpoint_txg == *txg)
+            {
+                let segment = root_segment_of(&root.record_bytes);
+                let highest = group.iter().max_by_key(|record| record.counter).expect("非空");
+                proto.judge("B2-max", highest.new_root_segment == segment, || {
+                    format!(
+                        "盘 {device} (实例 {instance}, txg {txg}) 计数器 {} 的新根段与根不等：{}",
+                        highest.counter,
+                        describe_segment_difference(&highest.new_root_segment, &segment)
+                    )
+                });
+                for record in group {
+                    proto.judge("B2-all", record.new_root_segment == segment, || {
+                        format!(
+                            "盘 {device} (实例 {instance}, txg {txg}) 计数器 {} 的新根段与根不等：{}",
+                            record.counter,
+                            describe_segment_difference(&record.new_root_segment, &segment)
+                        )
+                    });
+                    if record.record_flags_byte & 1 == 1 {
+                        proto.judge("B2-last", record.new_root_segment == segment, || {
+                            format!("盘 {device} (实例 {instance}, txg {txg}) 末条 {}", record.counter)
+                        });
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// B3 点名项：位置条目指的那一份整单元校验和相符时，类标签、诞生代号、写序实例、尾段、出生树（码 1 / 码 3）与点名项逐字段相等。
+fn judge_b3_named(
+    reader: &dyn ImageReader,
+    journal: &[(u32, BTreeMap<u64, crate::JournalRecordView>)],
+    proto: &mut Proto,
+) {
+    for (device, records) in journal {
+        for record in records.values() {
+            for (index, named) in record.named.iter().enumerate() {
+                for (location_device, location_slot, checksum) in named.locations {
+                    let Some(unit) = reader.read(
+                        location_device,
+                        location_slot * SLOT_BYTES,
+                        unit_bytes_of_class(named.unit_class),
+                    ) else {
+                        continue;
+                    };
+                    if crc32_castagnoli_table(&unit) != checksum {
+                        proto.judge("B3-named-skipped", true, String::new);
+                        continue;
+                    }
+                    let Some(identity) = birth_identity_in_the_header(&unit) else {
+                        proto.judge("B3-named", false, || {
+                            format!("盘 {device} 计数器 {} 点名项 {index}：头类标签 {} 不在 1/2/3", record.counter, unit[6])
+                        });
+                        continue;
+                    };
+                    let key_instance = u32::from_le_bytes(named.key_tail[0..4].try_into().expect("4"));
+                    let key_tail = match identity.tail {
+                        TailOfTheBirthIdentity::TransactionNumber(_) => read_six_byte_unsigned(&named.key_tail, 4),
+                        TailOfTheBirthIdentity::BirthSequence(_) => u64::from(read_u32(&named.key_tail, 4)),
+                    };
+                    let birth_tree_holds = match unit[6] {
+                        2 => true,
+                        _ => read_u64(&unit, 43) == named.birth_tree,
+                    };
+                    let holds = unit[6] == named.unit_class
+                        && identity.write_order.birth_txg() == named.birth_txg
+                        && identity.write_order.instance() == key_instance
+                        && identity.tail.birth_identity_tail_number() == key_tail
+                        && birth_tree_holds;
+                    proto.judge("B3-named", holds, || {
+                        format!(
+                            "盘 {device} 计数器 {} (实例 {}, txg {}) 点名项 {index}：点名 (类 {}, 树 {}, txg {}, 实例 {key_instance}, 尾 {key_tail})，头 (类 {}, txg {}, 实例 {}, 尾 {})",
+                            record.counter, record.instance, record.checkpoint_txg,
+                            named.unit_class, named.birth_tree, named.birth_txg,
+                            unit[6], identity.write_order.birth_txg(), identity.write_order.instance(),
+                            identity.tail.birth_identity_tail_number()
+                        )
+                    });
+                }
+            }
+        }
+    }
+}
+
+/// 一条根的树表里 inode 树那一条的根指针（读不出、没有、全零都交 `None`）。
+fn inode_tree_root_pointer_of(
+    reader: &dyn ImageReader,
+    record: &[u8],
+    cache: &mut IndexNodeCache,
+) -> Option<PointerView> {
+    let tree_table_pointer = parse_node_pointer(&record[36..122]);
+    if tree_table_pointer.all_zero {
+        return None;
+    }
+    let tree_table = read_index_node_without_judging(reader, &tree_table_pointer, cache)?;
+    tree_table
+        .entries
+        .iter()
+        .filter(|entry| entry.len() >= tree_table_entry_bytes() && read_u16(entry, 10) == TREE_KIND_INODE)
+        .map(|entry| parse_node_pointer(&entry[14..100]))
+        .find(|pointer| !pointer.all_zero)
+}
+
+/// B3 诞生代号：候选集里引用落点 p 的根中 txg 最小的 R_first，R_prev 为候选集里 txg 严格小于 R_first 的根中最大的那条；
+/// birth ≤ R_first.txg（B3-upper），R_prev 存在且引用集合数得全时 birth > R_prev.txg（B3-lower）。
+fn judge_b3_birth(
+    reader: &dyn ImageReader,
+    roots: &[(u64, u64, crate::RootView)],
+    candidates: &[usize],
+    cache: &mut IndexNodeCache,
+    proto: &mut Proto,
+) {
+    let mut scanned_with_inode_root: Vec<(u64, u32, RootReferences, Option<PointerView>)> = candidates
+        .iter()
+        .map(|index| {
+            let root = &roots[*index].2;
+            (
+                root.checkpoint_txg,
+                root.instance,
+                references_of_root(reader, &root.record_bytes, ReferenceScanDepth::EveryReferencedPlacement, cache),
+                inode_tree_root_pointer_of(reader, &root.record_bytes, cache),
+            )
+        })
+        .collect();
+    scanned_with_inode_root.sort_by_key(|(txg, instance, _, _)| (*txg, *instance));
+    let inode_roots: Vec<Option<PointerView>> =
+        scanned_with_inode_root.iter().map(|(_, _, _, pointer)| pointer.clone()).collect();
+    let scanned: Vec<(u64, u32, RootReferences)> = scanned_with_inode_root
+        .into_iter()
+        .map(|(txg, instance, references, _)| (txg, instance, references))
+        .collect();
+    let placements: BTreeSet<(u32, u64)> = scanned
+        .iter()
+        .flat_map(|(_, _, references)| references.placements.iter().copied())
+        .collect();
+    for placement in placements {
+        let Some(header) = reader.read(placement.0, placement.1 * SLOT_BYTES, UNIT_HEADER_SCAN_BYTES) else {
+            continue;
+        };
+        let Some(birth) = birth_txg_in_a_usable_unit_header(&header) else {
+            continue;
+        };
+        let first = scanned
+            .iter()
+            .find(|(_, _, references)| references.placements.contains(&placement))
+            .map(|(txg, instance, _)| (*txg, *instance))
+            .expect("并集里的落点至少一条根引用");
+        proto.judge("B3-upper", birth <= first.0, || {
+            format!("盘 {} 槽 {} 诞生代号 {birth} > R_first (实例 {}, txg {})", placement.0, placement.1, first.1, first.0)
+        });
+        let previous = scanned.iter().rev().find(|(txg, _, _)| *txg < first.0);
+        if let Some((previous_txg, previous_instance, previous_references)) = previous {
+            if previous_references.is_complete {
+                // 攻方自己提的收严 V1（只在这份模型上量过、被攻过零轮）：R_first 的 inode 树根指针出生 txg ≤ R_prev.txg
+                // 且那个根落点 R_prev 不引用（R_first 整棵用户可见树是从候选集外的一版继承来的：回退根，或接在它后面的写行根）时，下界不判。
+                let first_position = scanned
+                    .iter()
+                    .position(|(txg, instance, _)| (*txg, *instance) == first)
+                    .expect("R_first 在 scanned 里");
+                let inherits = inode_roots[first_position].as_ref().is_some_and(|pointer| {
+                    pointer.birth_txg <= *previous_txg
+                        && !previous_references
+                            .placements
+                            .contains(&(pointer.locations[0].device, pointer.locations[0].slot))
+                });
+                if inherits {
+                    proto.judge("B3-lower-v1-exempted", true, String::new);
+                } else {
+                    proto.judge("B3-lower-v1", birth > *previous_txg, || {
+                        format!(
+                            "盘 {} 槽 {} 类 {} 诞生代号 {birth} ≤ R_prev (实例 {previous_instance}, txg {previous_txg})，R_first (实例 {}, txg {})",
+                            placement.0, placement.1, header[6], first.1, first.0
+                        )
+                    });
+                }
+                proto.judge("B3-lower", birth > *previous_txg, || {
+                    format!(
+                        "盘 {} 槽 {} 类 {} 诞生代号 {birth} ≤ R_prev (实例 {previous_instance}, txg {previous_txg})，R_first (实例 {}, txg {})",
+                        placement.0, placement.1, header[6], first.1, first.0
+                    )
+                });
+            } else {
+                proto.judge("B3-lower-skipped-incomplete", true, String::new);
+            }
+        }
+    }
+}
+
+/// B5：(a) 候选集里任一根 R 指着的实例表每一行 T < R.txg（B5a；B5a-all-roots 换成根环里全部自证过的根）；
+/// (b) 同一实例的行在候选集两张表里 T、W 相同。
+fn judge_b5(
+    reader: &dyn ImageReader,
+    roots: &[(u64, u64, crate::RootView)],
+    candidates: &[usize],
+    proto: &mut Proto,
+) {
+    let mut rows_by_instance: BTreeMap<u32, Vec<(u64, u64, u64, u32)>> = BTreeMap::new();
+    for (index, (_, _, root)) in roots.iter().enumerate() {
+        let Some(rows) = instance_table_rows_of_root_without_judging(reader, &root.record_bytes) else {
+            continue;
+        };
+        let is_candidate = candidates.contains(&index);
+        for row in &rows {
+            proto.judge("B5a-all-roots", row.published_checkpoint_txg < root.checkpoint_txg, || {
+                format!(
+                    "根 (实例 {}, txg {}) 的实例表行 (实例 {}, T {}, W {})",
+                    root.instance, root.checkpoint_txg, row.instance, row.published_checkpoint_txg,
+                    row.applied_transaction_high_water_mark
+                )
+            });
+            if is_candidate {
+                proto.judge("B5a", row.published_checkpoint_txg < root.checkpoint_txg, || {
+                    format!(
+                        "候选根 (实例 {}, txg {}) 的实例表行 (实例 {}, T {}, W {})",
+                        root.instance, root.checkpoint_txg, row.instance, row.published_checkpoint_txg,
+                        row.applied_transaction_high_water_mark
+                    )
+                });
+                rows_by_instance.entry(row.instance).or_default().push((
+                    row.published_checkpoint_txg,
+                    row.applied_transaction_high_water_mark,
+                    root.checkpoint_txg,
+                    root.instance,
+                ));
+            }
+        }
+    }
+    for (instance, sightings) in rows_by_instance {
+        let (first_t, first_w, _, _) = sightings[0];
+        for (t, w, root_txg, root_instance) in &sightings {
+            proto.judge("B5b", *t == first_t && *w == first_w, || {
+                format!(
+                    "实例 {instance} 的行：根 (实例 {}, txg {}) 记 (T {first_t}, W {first_w})，根 (实例 {root_instance}, txg {root_txg}) 记 (T {t}, W {w})",
+                    sightings[0].3, sightings[0].2
+                )
+            });
+        }
+    }
+}
+
+fn accounting_rows_below(
+    reader: &dyn ImageReader,
+    cache: &mut IndexNodeCache,
+    node: &crate::IndexNodeView,
+    rows: &mut Vec<Vec<u8>>,
+) -> bool {
+    if node.level == 0 {
+        rows.extend(node.entries.iter().cloned());
+        return true;
+    }
+    let key_width = KEY_SCHEMA_ACCOUNTING.width();
+    let mut complete = true;
+    for entry in &node.entries {
+        let child_pointer = parse_node_pointer(&entry[key_width..key_width + node_pointer_bytes()]);
+        match read_index_node_without_judging(reader, &child_pointer, cache) {
+            Some(child) => complete &= accounting_rows_below(reader, cache, &child, rows),
+            None => complete = false,
+        }
+    }
+    complete
+}
+
+fn inode_leaf_pointers_below(
+    reader: &dyn ImageReader,
+    cache: &mut IndexNodeCache,
+    node: &crate::IndexNodeView,
+    leaves: &mut Vec<PointerView>,
+) {
+    for entry in &node.entries {
+        let child_pointer = parse_node_pointer(&entry[34..120]);
+        match InodeInternalEntryType::of(read_u16(entry, 16)) {
+            InodeInternalEntryType::LeafContainer => leaves.push(child_pointer),
+            InodeInternalEntryType::InternalNode => {
+                if let Some(child) = read_index_node_without_judging(reader, &child_pointer, cache) {
+                    inode_leaf_pointers_below(reader, cache, &child, leaves);
+                }
+            }
+            InodeInternalEntryType::Unregistered(_) => {}
+        }
+    }
+}
+
+/// B4（previous_snapshot_txg、记账代、inode 改动计数）与 B1（实例表指针的出生身份、数据指针与树根指针的出生树）。
+fn judge_b4_b1(
+    reader: &dyn ImageReader,
+    roots: &[(u64, u64, crate::RootView)],
+    candidates: &[usize],
+    cache: &mut IndexNodeCache,
+    proto: &mut Proto,
+) {
+    for index in candidates {
+        let root = &roots[*index].2;
+        let txg = root.checkpoint_txg;
+        let record = &root.record_bytes;
+        // B1 实例表指针。
+        let instance_table_pointer = parse_node_pointer(&record[170..256]);
+        if !instance_table_pointer.all_zero {
+            if let Some(unit) = read_unit_without_judging(reader, &instance_table_pointer, data_unit_bytes()) {
+                if let Some(identity) = birth_identity_in_the_header(&unit) {
+                    proto.judge(
+                        "B1-instance-table-pointer-identity",
+                        identity.write_order.birth_txg() == instance_table_pointer.birth_txg
+                            && identity.write_order.instance() == instance_table_pointer.instance
+                            && identity.tail.birth_identity_tail_number() == instance_table_pointer.tail,
+                        || format!(
+                            "根 (实例 {}, txg {txg}) 实例表指针 (txg {}, 实例 {}, 尾 {}) 头 (txg {}, 实例 {}, 尾 {})",
+                            root.instance, instance_table_pointer.birth_txg, instance_table_pointer.instance,
+                            instance_table_pointer.tail, identity.write_order.birth_txg(),
+                            identity.write_order.instance(), identity.tail.birth_identity_tail_number()
+                        ),
+                    );
+                    proto.judge("B1-instance-table-pointer-birth-tree", read_u64(&unit, 43) == instance_table_pointer.birth_tree, || {
+                        format!("根 (实例 {}, txg {txg}) 实例表指针出生树 {} 头 {}", root.instance, instance_table_pointer.birth_tree, read_u64(&unit, 43))
+                    });
+                }
+            }
+        }
+        let tree_table_pointer = parse_node_pointer(&record[36..122]);
+        if tree_table_pointer.all_zero {
+            continue;
+        }
+        let Some(tree_table) = read_index_node_without_judging(reader, &tree_table_pointer, cache) else {
+            continue;
+        };
+        proto.judge("B1-tree-table-pointer-birth-tree-vs-tree-id", tree_table.tree_identifier == tree_table_pointer.birth_tree, || {
+            format!("根 (实例 {}, txg {txg}) 树表指针出生树 {} 头树 ID {}", root.instance, tree_table_pointer.birth_tree, tree_table.tree_identifier)
+        });
+        for entry in &tree_table.entries {
+            if entry.len() < tree_table_entry_bytes() {
+                continue;
+            }
+            let tree = read_u64(entry, 0);
+            let kind = read_u16(entry, 10);
+            let previous_snapshot_txg = read_u64(entry, 100);
+            let holds = if kind == TREE_KIND_INODE {
+                previous_snapshot_txg == 0 || previous_snapshot_txg <= txg
+            } else {
+                previous_snapshot_txg == 0
+            };
+            proto.judge("B4-previous-snapshot-txg", holds, || {
+                format!("根 (实例 {}, txg {txg}) 树 {tree} 种类 {kind} previous_snapshot_txg {previous_snapshot_txg}", root.instance)
+            });
+            let tree_root = parse_node_pointer(&entry[14..100]);
+            if tree_root.all_zero {
+                continue;
+            }
+            let Some(node) = read_index_node_without_judging(reader, &tree_root, cache) else {
+                continue;
+            };
+            proto.judge("B1-tree-root-pointer-birth-tree-vs-tree-id", node.tree_identifier == tree_root.birth_tree, || {
+                format!("根 (实例 {}, txg {txg}) 树 {tree} 根指针出生树 {} 头树 ID {}", root.instance, tree_root.birth_tree, node.tree_identifier)
+            });
+            match kind {
+                TREE_KIND_ACCOUNTING => {
+                    let mut rows = Vec::new();
+                    accounting_rows_below(reader, cache, &node, &mut rows);
+                    for row in rows {
+                        let generation = read_u64(&row, 14);
+                        proto.judge("B4-accounting-generation", generation == txg, || {
+                            format!("根 (实例 {}, txg {txg}) 记账行代段 {generation}（统计量 {}，设备 {}）", root.instance, read_u16(&row, 0), read_u32(&row, 10))
+                        });
+                    }
+                }
+                TREE_KIND_INODE => {
+                    let mut leaves = Vec::new();
+                    if node.level > 0 {
+                        inode_leaf_pointers_below(reader, cache, &node, &mut leaves);
+                    }
+                    for leaf in leaves {
+                        let Some(unit) = read_unit_without_judging(reader, &leaf, data_unit_bytes()) else {
+                            continue;
+                        };
+                        let Ok(view) = packed_unit_view(&unit) else {
+                            continue;
+                        };
+                        let container_birth = read_u64(&unit, 73);
+                        for inode_record in &view.records {
+                            if inode_record.len() < 96 {
+                                continue;
+                            }
+                            let inode = read_u64(inode_record, 0);
+                            let object_birth = read_u64(inode_record, 8);
+                            let change = read_u64(inode_record, 88);
+                            proto.judge("B4-change-count-upper", change <= container_birth, || {
+                                format!("根 txg {txg} inode {inode} 改动计数 {change} > 容器诞生代号 {container_birth}")
+                            });
+                            proto.judge("B4-change-count-lower", object_birth <= change, || {
+                                format!("根 txg {txg} inode {inode} 对象出生代 {object_birth} > 改动计数 {change}")
+                            });
+                        }
+                    }
+                }
+                TREE_KIND_EXTENT => {
+                    if let Some((_, data_pointers)) = extent_tree_without_judging(reader, &tree_root, cache) {
+                        for data_pointer in data_pointers {
+                            if data_pointer.all_zero {
+                                continue;
+                            }
+                            let Some(unit) = read_unit_without_judging(reader, &data_pointer, data_unit_bytes()) else {
+                                continue;
+                            };
+                            proto.judge("B1-data-pointer-birth-tree", read_u64(&unit, 43) == data_pointer.birth_tree, || {
+                                format!("根 txg {txg} 数据指针出生树 {} 头 {}", data_pointer.birth_tree, read_u64(&unit, 43))
+                            });
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
