@@ -0,0 +1,147 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：B3 下界（I-3.5 ② 按回退候选集判）在管理员回退的合法历史上误红，两段写死的历史。
+//! 用户决定的那几步（回退到第几条、抬 F 抬到哪、之后写几次）另一条用例放开扫。
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::proto_b::proto_judgements;
+use singlefs_harness::history::{
+    execute_history_observing, ContentChoice, ContentLength, FloorTargetChoice, GeneratedHistory,
+    HistoryEnding, HistoryOperation, HistorySeed, HistoryStartingPoint, RollbackTargetChoice,
+};
+use singlefs_harness::SharedStream;
+
+thread_local! {
+    static V1_RED_STEPS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+fn overwrite(seed: u64) -> HistoryOperation {
+    HistoryOperation::PublishOverwrite(ContentChoice {
+        length: ContentLength::InsideOneDataUnit { selector: 1000 + seed },
+        fill_seed: seed,
+    })
+}
+
+/// 跑一段写死的历史，逐步打印：这一步之后池级 checker 红了哪几条、B3-lower 判了几次红几次、第一处红。交回 B3-lower 红的步数。
+fn run(label: &str, operations: Vec<HistoryOperation>, print: bool) -> (usize, bool) {
+    let history = GeneratedHistory {
+        seed: HistorySeed(0),
+        starting_point: HistoryStartingPoint::AfterFirstFile,
+        operations,
+    };
+    let stream = SharedStream::new();
+    let mut step = 0usize;
+    let mut red_steps = 0usize;
+    let mut v1_red_steps = 0usize;
+    let run = execute_history_observing(&history, &stream, &mut |observation| {
+        let violated: Vec<&str> = check_pool_image(observation.image)
+            .into_iter()
+            .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+            .map(|(name, _)| name)
+            .collect();
+        let proto = proto_judgements(observation.image);
+        let lower = proto.get("B3-lower").cloned().unwrap_or_default();
+        let v1 = proto.get("B3-lower-v1").cloned().unwrap_or_default();
+        let v1_exempted = proto.get("B3-lower-v1-exempted").cloned().unwrap_or_default();
+        if lower.violations > 0 {
+            red_steps += 1;
+        }
+        if v1.violations > 0 {
+            v1_red_steps += 1;
+        }
+        if print {
+            println!(
+                "PROTO_B3 {label} step={step} op={:?} checker_violated={violated:?} b3_lower_evaluated={} b3_lower_red={} v1_evaluated={} v1_red={} v1_exempted={} first={}",
+                observation.operation.map(|operation| operation.kind()),
+                lower.evaluated,
+                lower.violations,
+                v1.evaluated,
+                v1.violations,
+                v1_exempted.evaluated,
+                lower.first_violation.unwrap_or_else(|| "-".to_string())
+            );
+        }
+        step += 1;
+    });
+    let completed = matches!(run.ending, HistoryEnding::Completed);
+    if print {
+        println!("PROTO_B3 {label} completed={completed} steps_observed={step} b3_lower_red_steps={red_steps} v1_red_steps={v1_red_steps}");
+    }
+    V1_RED_STEPS.with(|cell| cell.set(cell.get() + v1_red_steps));
+    (red_steps, completed)
+}
+
+#[test]
+fn proto_b3_rollback_then_raise_the_floor_above_the_rollback_target() {
+    // A（txg 3）→ 覆盖写四次（4–7）→ 回退到从新到旧第 4 条（txg 4）→ 抬 F 到 0 + 5 = 5。
+    run(
+        "raise",
+        vec![
+            overwrite(1),
+            overwrite(2),
+            overwrite(3),
+            overwrite(4),
+            HistoryOperation::RollBackWhileMounted(RollbackTargetChoice::RingRoot { index_from_newest: 3 }),
+            HistoryOperation::RaiseRollbackFloor(FloorTargetChoice { steps_above_current_floor: 5 }),
+        ],
+        true,
+    );
+}
+
+#[test]
+fn proto_b3_rollback_then_the_target_turns_out_of_the_root_ring() {
+    // A（txg 3）→ 覆盖写两次（4、5）→ 回退到 txg 4（从新到旧第 2 条）→ 再覆盖写到 txg 4 那条根轮出根环（R × S = 24）。
+    let mut operations = vec![
+        overwrite(1),
+        overwrite(2),
+        HistoryOperation::RollBackWhileMounted(RollbackTargetChoice::RingRoot { index_from_newest: 1 }),
+    ];
+    for seed in 10..34 {
+        operations.push(overwrite(seed));
+    }
+    run("turn", operations, true);
+}
+
+/// 放开用户决定的那几步：前缀固定为 A 之后覆盖写 k 次（k ∈ {2, 4}），回退目标取根环从新到旧第 i 条（i ∈ 0..=5），
+/// 之后要么抬 F（steps ∈ {0, 2, 4, 6, 8}），要么不抬、再覆盖写 w 次（w ∈ {0, 3}）。数每一格 B3-lower 红没红。
+#[test]
+fn proto_b3_sweep_the_user_steps() {
+    let mut cells = 0usize;
+    let mut red_cells = 0usize;
+    let mut incomplete = 0usize;
+    for k in [2u64, 4] {
+        for index in 0..=5u64 {
+            let prefix: Vec<HistoryOperation> = (1..=k)
+                .map(overwrite)
+                .chain(std::iter::once(HistoryOperation::RollBackWhileMounted(
+                    RollbackTargetChoice::RingRoot { index_from_newest: index },
+                )))
+                .collect();
+            let mut tails: Vec<(String, Vec<HistoryOperation>)> = Vec::new();
+            for steps in [0u64, 2, 4, 6, 8] {
+                tails.push((
+                    format!("raise{steps}"),
+                    vec![HistoryOperation::RaiseRollbackFloor(FloorTargetChoice { steps_above_current_floor: steps })],
+                ));
+            }
+            for writes in [0u64, 3] {
+                tails.push((format!("write{writes}"), (100..100 + writes).map(overwrite).collect()));
+            }
+            for (tail_name, tail) in tails {
+                let mut operations = prefix.clone();
+                operations.extend(tail);
+                let (red_steps, completed) = run("sweep", operations, false);
+                cells += 1;
+                if !completed {
+                    incomplete += 1;
+                }
+                if red_steps > 0 {
+                    red_cells += 1;
+                    println!("PROTO_B3_SWEEP red k={k} rollback_index={index} tail={tail_name} red_steps={red_steps} completed={completed}");
+                }
+            }
+        }
+    }
+    println!(
+        "PROTO_B3_SWEEP cells={cells} red_cells={red_cells} not_completed={incomplete} v1_red_steps_over_all_cells={}",
+        V1_RED_STEPS.with(std::cell::Cell::get)
+    );
+}
diff -ruN '--exclude=target' m3-batch4-freeze/tree/crates/singlefs-harness/tests/inv_b_proto_histories.rs m3-birth-floor-r1-opus/tree/crates/singlefs-harness/tests/inv_b_proto_histories.rs
--- m3-batch4-freeze/tree/crates/singlefs-harness/tests/inv_b_proto_histories.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r1-opus/tree/crates/singlefs-harness/tests/inv_b_proto_histories.rs	2026-10-01 16:47:03.107390550 +0000
@@ -0,0 +1,158 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：随机历史每一步之后的镜像上跑 `proto_b` 的候选措辞谓词，数每个谓词判了几次、红了几次、
+//! 第一处红在哪段历史的哪一步。历史照 `singlefs_harness::history` 的生成器与执行器，比重与种子区间从环境变量取。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use singlefs_checker::walk::proto_b::proto_judgements;
+use singlefs_harness::history::{
+    execute_history_observing, generate_history_with_weights, GenerationWeights, HistoryEnding,
+    HistorySeed,
+};
+use singlefs_harness::SharedStream;
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    images_with_violation: u64,
+    first: Option<String>,
+}
+
+fn env_u64(name: &str, default: u64) -> u64 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn weights_named(name: &str) -> &'static GenerationWeights {
+    match name {
+        "broad" => &GenerationWeights::BROAD,
+        "reuse" => &GenerationWeights::REUSE_AFTER_RAISING_THE_FLOOR,
+        "rollback" => &GenerationWeights::ROLLBACK_AFTER_RAISING_THE_FLOOR,
+        "wall" => &GenerationWeights::TOWARD_THE_ALLOCATION_RECORD_WALL,
+        other => panic!("比重名 {other} 不认得"),
+    }
+}
+
+#[test]
+fn proto_predicates_over_random_histories() {
+    let first_seed = env_u64("PROTO_FIRST_SEED", 1_000_000);
+    let seeds = env_u64("PROTO_SEEDS", 4);
+    let operations = usize::try_from(env_u64("PROTO_OPERATIONS", 30)).expect("步数");
+    let weights_name = std::env::var("PROTO_WEIGHTS").unwrap_or_else(|_| "broad".to_string());
+    let weights = weights_named(&weights_name);
+    let threads = env_u64("SINGLEFS_THREAD_CAP", 1).max(1);
+    let started = std::time::Instant::now();
+    let aggregate: Mutex<BTreeMap<&'static str, Aggregate>> = Mutex::new(BTreeMap::new());
+    let endings: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+    let images = Mutex::new(0u64);
+    let next = Mutex::new(first_seed);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let seed = {
+                    let mut next = next.lock().expect("锁");
+                    if *next >= first_seed + seeds {
+                        return;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let history = generate_history_with_weights(HistorySeed(seed), operations, weights);
+                let stream = SharedStream::new();
+                let mut step = 0usize;
+                let mut local: BTreeMap<&'static str, Aggregate> = BTreeMap::new();
+                let mut local_images = 0u64;
+                let run = execute_history_observing(&history, &stream, &mut |observation| {
+                    local_images += 1;
+                    let kinds: String = history.operations[..step.min(history.operations.len())]
+                        .iter()
+                        .map(|operation| format!("{:?}", operation.kind()))
+                        .collect::<Vec<_>>()
+                        .join(">");
+                    // B7：同一张镜像上 I-3.9 在今天的守卫与收窄的守卫下各判一次，数判定不同的镜像与收窄之后判红的镜像。
+                    {
+                        use singlefs_checker::image::InvariantVerdict;
+                        use singlefs_checker::walk::proto_b::{set_i39_guard, I39Guard};
+                        let verdict_under = |guard: I39Guard| {
+                            set_i39_guard(guard);
+                            singlefs_checker::walk::check_pool_image(observation.image)
+                                .into_iter()
+                                .find(|(name, _)| *name == "I-3.9")
+                                .map(|(_, verdict)| verdict)
+                                .expect("I-3.9 在清单里")
+                        };
+                        let today = verdict_under(I39Guard::Today);
+                        let narrowed = verdict_under(I39Guard::Narrowed);
+                        let mut note = |name: &'static str, red: bool| {
+                            let entry = local.entry(name).or_default();
+                            entry.evaluated += 1;
+                            if red {
+                                entry.violations += 1;
+                                entry.images_with_violation += 1;
+                                if entry.first.is_none() {
+                                    entry.first = Some(format!("seed={seed} step={step} today={today:?} narrowed={narrowed:?}"));
+                                }
+                            }
+                        };
+                        note("B7-narrowed-differs-from-today", today != narrowed);
+                        note("B7-narrowed-violated", matches!(narrowed, InvariantVerdict::Violated(_)));
+                        note(
+                            "B7-today-not-applicable-for-an-incomplete-root",
+                            matches!(&today, InvariantVerdict::NotApplicable(reason) if reason.contains("走不完")),
+                        );
+                    }
+                    for (name, tally) in proto_judgements(observation.image) {
+                        let entry = local.entry(name).or_default();
+                        entry.evaluated += tally.evaluated;
+                        entry.violations += tally.violations;
+                        if tally.violations > 0 {
+                            entry.images_with_violation += 1;
+                            if entry.first.is_none() {
+                                entry.first = Some(format!(
+                                    "seed={seed} step={step} start={:?} ops=[{kinds}] :: {}",
+                                    history.starting_point,
+                                    tally.first_violation.clone().unwrap_or_default()
+                                ));
+                            }
+                        }
+                    }
+                    step += 1;
+                });
+                let ending = match &run.ending {
+                    HistoryEnding::NewFinding { .. } => "new_finding".to_string(),
+                    HistoryEnding::KnownRed { .. } => "known_red".to_string(),
+                    HistoryEnding::Completed => "completed".to_string(),
+                    #[allow(unreachable_patterns)]
+                    _ => "other".to_string(),
+                };
+                *endings.lock().expect("锁").entry(ending).or_insert(0) += 1;
+                *images.lock().expect("锁") += local_images;
+                let mut aggregate = aggregate.lock().expect("锁");
+                for (name, local_entry) in local {
+                    let entry = aggregate.entry(name).or_default();
+                    entry.evaluated += local_entry.evaluated;
+                    entry.violations += local_entry.violations;
+                    entry.images_with_violation += local_entry.images_with_violation;
+                    if entry.first.is_none() {
+                        entry.first = local_entry.first;
+                    }
+                }
+            });
+        }
+    });
+    let aggregate = aggregate.into_inner().expect("锁");
+    println!(
+        "PROTO_RUN weights={weights_name} first_seed={first_seed} seeds={seeds} operations={operations} images={} endings={:?} seconds={:.1}",
+        images.into_inner().expect("锁"),
+        endings.into_inner().expect("锁"),
+        started.elapsed().as_secs_f64()
+    );
+    for (name, entry) in aggregate {
+        println!(
+            "PROTO name={name} evaluated={} violations={} images_red={} first={}",
+            entry.evaluated,
+            entry.violations,
+            entry.images_with_violation,
+            entry.first.unwrap_or_else(|| "-".to_string())
+        );
+    }
+}
