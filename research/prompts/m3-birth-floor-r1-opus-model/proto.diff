+// ───── 攻方原型（m3-inv-b-r1，只在副本上）：B7 组合坏镜像与对照格 ─────
+
+use singlefs_checker::walk::proto_b::{set_i39_guard, I39Guard};
+
+fn proto_b7_report(label: &str, image: &MemoryPool) {
+    for guard in [I39Guard::Today, I39Guard::Narrowed, I39Guard::Unguarded] {
+        set_i39_guard(guard);
+        let verdicts = check_pool_image(image);
+        let i39 = verdicts
+            .iter()
+            .find(|(name, _)| *name == "I-3.9")
+            .map(|(_, verdict)| verdict.clone())
+            .expect("I-3.9 在清单里");
+        println!(
+            "PROTO_B7 image={label} guard={guard:?} i39={i39:?} violated={:?}",
+            violated_invariants(&verdicts)
+        );
+    }
+    set_i39_guard(I39Guard::Narrowed);
+}
+
+/// 翻一个单元两份各一个载荷字节，不重封、不补引用链：位置条目校验和对不上，只读不判那一遍读不出它。
+fn proto_flip_both_copies(image: &mut MemoryPool, slot: u64, length: usize) {
+    for device in DEVICES {
+        let mut bytes = read(image, device, slot * SLOT, length);
+        bytes[length - 100] ^= 0xff;
+        write(image, device, slot * SLOT, &bytes);
+    }
+}
+
+#[test]
+fn proto_b7_combined_bad_image_after_the_overwrite() {
+    let clean = image_after_the_overwrite("proto-b7-combined");
+    proto_b7_report("clean", &clean);
+    let mut released_only = clean.clone();
+    assert_eq!(
+        mutate_allocation_leaves(
+            &mut released_only,
+            &UNITS_AFTER_OVERWRITE,
+            ALLOCATION_LEAVES_AFTER_OVERWRITE,
+            |bytes| rewrite_released_generations(bytes, 4, 3),
+        ),
+        24
+    );
+    proto_b7_report("release-4-to-3-only", &released_only);
+    let mut unreadable_only = clean.clone();
+    proto_flip_both_copies(&mut unreadable_only, ALLOCATION_LEAVES[0], 16384);
+    proto_b7_report("A-leaf-50245-unreadable-only", &unreadable_only);
+    let mut combined = released_only.clone();
+    proto_flip_both_copies(&mut combined, ALLOCATION_LEAVES[0], 16384);
+    proto_b7_report("combined", &combined);
+    let mut combined_both_leaves = released_only.clone();
+    proto_flip_both_copies(&mut combined_both_leaves, ALLOCATION_LEAVES[0], 16384);
+    proto_flip_both_copies(&mut combined_both_leaves, ALLOCATION_LEAVES[1], 16384);
+    proto_b7_report("combined-both-A-leaves", &combined_both_leaves);
+}
