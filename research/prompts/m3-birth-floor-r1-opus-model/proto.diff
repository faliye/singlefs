+++ m3-birth-floor-r1-opus/tree/crates/singlefs-harness/tests/inv_b_proto_multi_record_crash.rs	2026-10-01 16:47:03.107429680 +0000
@@ -0,0 +1,311 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：一次发布切成多条记录（产品路径：顺序写 N ≥ 2 个数据单元，一个数据单元一条记录）时，
+//! 崩溃状态与它之后的可写挂载、再发布的镜像上跑 `proto_b` 的候选措辞谓词。
+//!
+//! 历史：mkfs → 取号 1 → 暖机 → A（第一个文件，jsn 3，txg 3）→ 顺序写两个数据单元的 B（jsn 4、5，txg 4）→ 顺序写三个数据单元的 C
+//! （jsn 6、7、8，txg 5）。前缀固定到 B 做完；C 那次发布的写按 `writes_and_segments`（与层 0 同一条切段规则）切段，
+//! 每段之前的段全持久，段内整写子集逐个枚举（段内写数 ≤ `PROTO_SUBSET_LIMIT` 的段全枚举；更大的段只取全持久那一个状态，数写在输出里）。
+//! 每个状态四张镜像：崩溃镜像、可写挂载之后、再覆盖写一次之后、再顺序写两个数据单元之后。盘是内存稀疏盘。
+mod common;
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use common::{crash_state_devices, file_content, geometry, memory_pool_of_sparse_devices, parameters, FIXED_WRITE_TIME_SECONDS, IMAGE_BYTES};
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::{proto_judgements, set_i39_guard, I39Guard};
+use singlefs_core::address::{DeviceIdentity, InstanceGeneration};
+use singlefs_core::allocator::{DeviceFreeMap, Placement, PoolAllocator};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::make_filesystem::{make_filesystem, INSTANCE_TABLE_SLOT, TREE_TABLE_GENESIS_SLOT};
+use singlefs_core::mount::mount_writable;
+use singlefs_core::transaction::{
+    acquire_instance, publish_first_file, publish_overwrite, publish_sequential_write, warm_up, FirstFile,
+    PoolVersion, PoolWriter,
+};
+use singlefs_core::unit::data_unit_payload_capacity;
+use singlefs_harness::memory_pool::{closed_form_state_count, writes_and_segments, MemoryPool, SparseBlockDevice};
+use singlefs_harness::{RecordingBlockDevice, SharedStream};
+
+const DISKS: [DeviceIdentity; 2] = [DeviceIdentity(0), DeviceIdentity(1)];
+
+fn content_needing(data_units: usize, seed: usize) -> Vec<u8> {
+    let payload_capacity = data_unit_payload_capacity();
+    (0..(data_units - 1) * payload_capacity + payload_capacity / 2)
+        .map(|index| u8::try_from((index * 13 + seed * 5 + 3) % 251).expect("小于 256"))
+        .collect()
+}
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    images_red: u64,
+    first: Option<String>,
+}
+
+fn env_usize(name: &str, default: usize) -> usize {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn judge(image: &MemoryPool, label: &str, aggregate: &mut BTreeMap<String, Aggregate>) {
+    if std::env::var("PROTO_DUMP").is_ok_and(|wanted| label.contains(&wanted)) {
+        println!("PROTO_MR_DUMP {label} journal={:?}", singlefs_checker::walk::proto_b::journal_summary(image));
+    }
+    set_i39_guard(I39Guard::Today);
+    let verdicts = check_pool_image(image);
+    let violated: Vec<&str> = verdicts
+        .iter()
+        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+        .map(|(name, _)| *name)
+        .collect();
+    let entry = aggregate.entry("checker-any-violated".to_string()).or_default();
+    entry.evaluated += 1;
+    if !violated.is_empty() {
+        entry.violations += 1;
+        entry.images_red += 1;
+        if entry.first.is_none() {
+            entry.first = Some(format!("{label} :: {violated:?}"));
+        }
+    }
+    for (name, tally) in proto_judgements(image) {
+        let entry = aggregate.entry(name.to_string()).or_default();
+        entry.evaluated += tally.evaluated;
+        entry.violations += tally.violations;
+        if tally.violations > 0 {
+            entry.images_red += 1;
+            if entry.first.is_none() {
+                entry.first = Some(format!("{label} :: {}", tally.first_violation.unwrap_or_default()));
+            }
+        }
+    }
+}
+
+#[test]
+fn proto_predicates_over_crash_states_of_a_multi_record_publish() {
+    let subset_limit = env_usize("PROTO_SUBSET_LIMIT", 10);
+    let threads = env_usize("SINGLEFS_THREAD_CAP", 1).max(1);
+    let started = std::time::Instant::now();
+    let stream = SharedStream::retaining_contents();
+    let mut devices: Vec<(DeviceIdentity, RecordingBlockDevice<SparseBlockDevice>)> = DISKS
+        .iter()
+        .map(|identity| {
+            (
+                *identity,
+                RecordingBlockDevice::with_shared_stream(
+                    *identity,
+                    SparseBlockDevice::new(IMAGE_BYTES, PhysicalBlockSizeInBytes(512)),
+                    stream.clone(),
+                ),
+            )
+        })
+        .collect();
+    let publish_parameters = parameters();
+    let genesis = make_filesystem(&publish_parameters, &mut devices).expect("mkfs");
+    let mut allocator = PoolAllocator::new(
+        DISKS.iter().map(|device| DeviceFreeMap::new(*device, IMAGE_BYTES)).collect(),
+    );
+    allocator.mark_format_time_units(
+        Placement { slot: INSTANCE_TABLE_SLOT, span: 2 },
+        Placement { slot: TREE_TABLE_GENESIS_SLOT, span: 1 },
+    );
+    let operations_before_the_third;
+    {
+        let mut writer = PoolWriter::new(&publish_parameters, devices.as_mut_slice());
+        let instance = acquire_instance(&mut writer).expect("取号");
+        let warmed = warm_up(&mut writer, &genesis.root, instance).expect("暖机");
+        let content = file_content();
+        let first = publish_first_file(
+            &mut writer,
+            &mut allocator,
+            warmed.roots.last().expect("暖机两代根"),
+            FirstFile { content: &content, write_time_seconds: FIXED_WRITE_TIME_SECONDS },
+            instance,
+            &warmed.last_record_bytes,
+        )
+        .expect("A");
+        let second_content = content_needing(2, 1);
+        let second = publish_sequential_write(
+            &mut writer,
+            &mut allocator,
+            &first,
+            FirstFile { content: &second_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 60 },
+            InstanceGeneration(1),
+        )
+        .expect("B");
+        operations_before_the_third = stream.retained_operations().len();
+        let third_content = content_needing(env_usize("PROTO_C_UNITS", 3), 2);
+        let third = publish_sequential_write(
+            &mut writer,
+            &mut allocator,
+            &second,
+            FirstFile { content: &third_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 120 },
+            InstanceGeneration(1),
+        )
+        .expect("C");
+        println!(
+            "PROTO_MR history B=(txg {:?}, 记录 {} 条) C=(txg {:?}, 记录 {} 条, 末条 jsn {})",
+            second.root.checkpoint_txg,
+            second.earlier_records_of_this_publish.len() + 1,
+            third.root.checkpoint_txg,
+            third.earlier_records_of_this_publish.len() + 1,
+            third.record.counter
+        );
+    }
+    let operations = stream.retained_operations();
+    let mut base = MemoryPool::with_devices(&DISKS, IMAGE_BYTES);
+    base.apply(&operations[..operations_before_the_third]);
+    let (writes, segments) = writes_and_segments(&operations[operations_before_the_third..], &geometry());
+    println!(
+        "PROTO_MR segments={} sizes={:?} closed_form_state_count={}",
+        segments.len(),
+        segments.iter().map(Vec::len).collect::<Vec<_>>(),
+        closed_form_state_count(&segments)
+    );
+    // 状态表：(段号, 段内持久掩码)。
+    let mut states: Vec<(usize, u64)> = vec![(0, 0)];
+    let mut skipped_states = 0u64;
+    for (segment_index, segment) in segments.iter().enumerate() {
+        let full = (1u64 << segment.len()) - 1;
+        if segment.len() <= subset_limit {
+            states.extend((1..=full).map(|mask| (segment_index, mask)));
+        } else {
+            states.push((segment_index, full));
+            let mut structured: Vec<u64> = Vec::new();
+            if segment.iter().all(|write| writes[*write].kind.name() == writes[segment[0]].kind.name())
+                && format!("{:?}", writes[segment[0]].kind) == "JournalRecord"
+            {
+                // 记录段太大不全枚举时的结构化取样：按每块盘上的偏移把写排成记录序（第 r 条），两盘同一个记录集合；
+                // 取：只有后 k 条、只有前 k 条、只有第一条与最后一条、缺中间一条。
+                let mut offsets: Vec<u64> = segment.iter().map(|write| writes[*write].offset.0).collect();
+                offsets.sort_unstable();
+                offsets.dedup();
+                let records = offsets.len();
+                let mask_of = |kept: &dyn Fn(usize) -> bool| -> u64 {
+                    segment
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, write)| {
+                            let order = offsets.iter().position(|offset| *offset == writes[**write].offset.0).expect("在表里");
+                            kept(order)
+                        })
+                        .fold(0u64, |mask, (bit, _)| mask | (1 << bit))
+                };
+                for k in 1..records {
+                    structured.push(mask_of(&|order| order >= records - k));
+                    structured.push(mask_of(&|order| order < k));
+                }
+                structured.push(mask_of(&|order| order == 0 || order == records - 1));
+                for missing in 1..records - 1 {
+                    structured.push(mask_of(&|order| order != missing));
+                }
+                structured.sort_unstable();
+                structured.dedup();
+                structured.retain(|mask| *mask != full && *mask != 0);
+            }
+            skipped_states += full - 1 - u64::try_from(structured.len()).expect("条数");
+            states.extend(structured.into_iter().map(|mask| (segment_index, mask)));
+        }
+    }
+    println!("PROTO_MR states_enumerated={} states_skipped_in_large_segments={skipped_states}", states.len());
+    let aggregate: Mutex<BTreeMap<String, Aggregate>> = Mutex::new(BTreeMap::new());
+    let mount_outcomes: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+    let next = Mutex::new(0usize);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let index = {
+                    let mut next = next.lock().expect("锁");
+                    if *next >= states.len() {
+                        return;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let (segment_index, mask) = states[index];
+                let mut persisted = vec![false; writes.len()];
+                for earlier in &segments[..segment_index] {
+                    for write in earlier {
+                        persisted[*write] = true;
+                    }
+                }
+                for (bit, write) in segments[segment_index].iter().enumerate() {
+                    if mask & (1 << bit) != 0 {
+                        persisted[*write] = true;
+                    }
+                }
+                let kinds: Vec<String> = segments[segment_index]
+                    .iter()
+                    .map(|write| format!("{}@{}", writes[*write].kind.name(), writes[*write].device.0))
+                    .collect();
+                let label = format!("seg={segment_index} kinds={kinds:?} mask={mask:b}");
+                let mut local: BTreeMap<String, Aggregate> = BTreeMap::new();
+                let crash_stream = SharedStream::new();
+                let mut crash_devices = crash_state_devices(&base, &writes, &persisted, &crash_stream);
+                judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=crash"), &mut local);
+                let outcome = match mount_writable(&parameters(), &mut crash_devices) {
+                    Err(error) => format!("refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                    Ok(mounted) => {
+                        judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=mounted"), &mut local);
+                        let mut allocator = mounted.allocator;
+                        match mounted.current {
+                            PoolVersion::WithoutFile(_) => "mounted-without-file".to_string(),
+                            PoolVersion::WithFile(current) => {
+                                let instance = current.root.instance;
+                                let overwrite_content = content_needing(1, 7);
+                                let mut writer = PoolWriter::new(&publish_parameters, crash_devices.as_mut_slice());
+                                match publish_overwrite(
+                                    &mut writer,
+                                    &mut allocator,
+                                    &current,
+                                    FirstFile { content: &overwrite_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 180 },
+                                    instance,
+                                ) {
+                                    Err(error) => format!("overwrite-refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                                    Ok(overwritten) => {
+                                        let sequential_content = content_needing(2, 9);
+                                        let sequential = publish_sequential_write(
+                                            &mut writer,
+                                            &mut allocator,
+                                            &overwritten,
+                                            FirstFile { content: &sequential_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 240 },
+                                            instance,
+                                        );
+                                        drop(writer);
+                                        // 覆盖写之后那张镜像取不到（写入口借着盘）：两次发布之后一起判，再各判不了；所以只判最后这张与挂载之后那张。
+                                        judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=after-overwrite-and-sequential"), &mut local);
+                                        match sequential {
+                                            Ok(_) => "mounted-and-published-twice".to_string(),
+                                            Err(error) => format!("sequential-refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                };
+                *mount_outcomes.lock().expect("锁").entry(outcome).or_insert(0) += 1;
+                let mut aggregate = aggregate.lock().expect("锁");
+                for (name, local_entry) in local {
+                    let entry = aggregate.entry(name).or_default();
+                    entry.evaluated += local_entry.evaluated;
+                    entry.violations += local_entry.violations;
+                    entry.images_red += local_entry.images_red;
+                    if entry.first.is_none() {
+                        entry.first = local_entry.first;
+                    }
+                }
+            });
+        }
+    });
+    println!("PROTO_MR outcomes={:?} seconds={:.1}", mount_outcomes.into_inner().expect("锁"), started.elapsed().as_secs_f64());
+    for (name, entry) in aggregate.into_inner().expect("锁") {
+        println!(
+            "PROTO_MR name={name} evaluated={} violations={} images_red={} first={}",
+            entry.evaluated,
+            entry.violations,
+            entry.images_red,
+            entry.first.unwrap_or_else(|| "-".to_string())
+        );
+    }
+}
