+// ---------------------------------------------------------------------------------------------------------------
+// m3-birth-floor-r1 攻方（只在副本上）：诞生代号下界的三种写法（原措辞、V1、V2）在两种候选集上（CS1 只取根环里的候选根；
+// CS2 再并上 `check_pool_image` 补进候选集的「由记录施加出来、根槽从没落盘的那一版」）。不进 `IMPLEMENTED_INVARIANTS`。
+// V1：R_first 的树表里 inode 树根指针出生 txg ≤ R_prev.txg 且那个落点 R_prev 不引用 ⇒ R_first 名下的落点都不判下界。
+// V2（攻方提的收严，零轮）：只免「R_first 树表里出生 txg ≤ R_prev.txg 且落点 R_prev 不引用的用户可见树根（extent 1、inode 2、
+// deleted_inodes 9）之下」的落点；R_first 自己新写的落点照原措辞判。
+// ---------------------------------------------------------------------------------------------------------------
+
+struct BirthFloorVersion {
+    txg: u64,
+    instance: u32,
+    references: RootReferences,
+    user_tree_roots: Vec<(u16, PointerView)>,
+    applied_only: bool,
+}
+
+fn user_tree_roots_of(
+    reader: &dyn ImageReader,
+    record: &[u8],
+    cache: &mut IndexNodeCache,
+) -> Vec<(u16, PointerView)> {
+    let tree_table_pointer = parse_node_pointer(&record[36..122]);
+    if tree_table_pointer.all_zero {
+        return Vec::new();
+    }
+    let Some(tree_table) = read_index_node_without_judging(reader, &tree_table_pointer, cache) else {
+        return Vec::new();
+    };
+    tree_table
+        .entries
+        .iter()
+        .filter(|entry| entry.len() >= tree_table_entry_bytes())
+        .filter_map(|entry| {
+            let kind = read_u16(entry, 10);
+            let pointer = parse_node_pointer(&entry[14..100]);
+            (matches!(kind, TREE_KIND_EXTENT | TREE_KIND_INODE | TREE_KIND_DELETED_INODES) && !pointer.all_zero)
+                .then_some((kind, pointer))
+        })
+        .collect()
+}
+
+fn placements_under_tree_root(
+    reader: &dyn ImageReader,
+    cache: &mut IndexNodeCache,
+    pointer: &PointerView,
+    kind: u16,
+) -> BTreeSet<(u32, u64)> {
+    let mut references = RootReferences {
+        placements: BTreeSet::new(),
+        tree_table_birth_txg: BTreeMap::new(),
+        tree_table_placement: None,
+        allocation_records: Vec::new(),
+        depth: ReferenceScanDepth::EveryReferencedPlacement,
+        is_complete: true,
+    };
+    references.note(pointer);
+    if let Some(node) = read_index_node_without_judging(reader, pointer, cache) {
+        collect_tree_references(reader, cache, &mut references, pointer, &node, kind);
+    }
+    references.placements
+}
+
+fn version_of_record(
+    reader: &dyn ImageReader,
+    record: &[u8],
+    txg: u64,
+    instance: u32,
+    applied_only: bool,
+    cache: &mut IndexNodeCache,
+) -> BirthFloorVersion {
+    BirthFloorVersion {
+        txg,
+        instance,
+        references: references_of_root(reader, record, ReferenceScanDepth::EveryReferencedPlacement, cache),
+        user_tree_roots: user_tree_roots_of(reader, record, cache),
+        applied_only,
+    }
+}
+
+#[derive(Default)]
+struct NamedTallies {
+    by_name: BTreeMap<String, ProtoTally>,
+}
+
+impl NamedTallies {
+    fn judge(&mut self, name: String, holds: bool, detail: impl FnOnce() -> String) {
+        let entry = self.by_name.entry(name).or_default();
+        entry.evaluated += 1;
+        if !holds {
+            entry.violations += 1;
+            if entry.first_violation.is_none() {
+                entry.first_violation = Some(detail());
+            }
+        }
+    }
+    fn count(&mut self, name: String, detail: impl FnOnce() -> String) {
+        let entry = self.by_name.entry(name).or_default();
+        entry.evaluated += 1;
+        if entry.first_violation.is_none() {
+            entry.first_violation = Some(detail());
+        }
+    }
+}
+
+fn judge_birth_floor_on(
+    reader: &dyn ImageReader,
+    versions: &mut Vec<BirthFloorVersion>,
+    cache: &mut IndexNodeCache,
+    tallies: &mut NamedTallies,
+    set: &str,
+) {
+    versions.sort_by_key(|version| (version.txg, version.instance));
+    let placements: BTreeSet<(u32, u64)> = versions
+        .iter()
+        .flat_map(|version| version.references.placements.iter().copied())
+        .collect();
+    let mut inherited_cache: BTreeMap<(usize, usize), BTreeSet<(u32, u64)>> = BTreeMap::new();
+    for placement in placements {
+        let Some(header) = reader.read(placement.0, placement.1 * SLOT_BYTES, UNIT_HEADER_SCAN_BYTES) else {
+            continue;
+        };
+        let Some(birth) = birth_txg_in_a_usable_unit_header(&header) else {
+            continue;
+        };
+        let class = header[6];
+        let first_index = versions
+            .iter()
+            .position(|version| version.references.placements.contains(&placement))
+            .expect("并集里的落点至少一版引用");
+        let first = &versions[first_index];
+        // I-3.5 ①：引用这个落点的版本在 (txg, 实例) 序上连续无洞（只为 F3 数一下，与下界的三种写法无关）。
+        let referencing: Vec<usize> = versions
+            .iter()
+            .enumerate()
+            .filter(|(_, version)| version.references.placements.contains(&placement))
+            .map(|(index, _)| index)
+            .collect();
+        let contiguous = referencing.last().copied().unwrap_or(0) + 1 - referencing.first().copied().unwrap_or(0) == referencing.len();
+        tallies.judge(format!("{set}:i35-1-contiguous"), contiguous, || {
+            let txgs: Vec<u64> = referencing.iter().map(|index| versions[*index].txg).collect();
+            format!("盘 {} 槽 {} 类 {class} 诞生代号 {birth}：引用它的版本 txg {txgs:?}", placement.0, placement.1)
+        });
+        tallies.judge(format!("{set}:upper"), birth <= first.txg, || {
+            format!("盘 {} 槽 {} 类 {class} 诞生代号 {birth} > R_first (实例 {}, txg {})", placement.0, placement.1, first.instance, first.txg)
+        });
+        let Some(previous_index) = versions.iter().rposition(|version| version.txg < first.txg) else {
+            continue;
+        };
+        let previous = &versions[previous_index];
+        if !previous.references.is_complete {
+            tallies.count(format!("{set}:skipped-incomplete"), String::new);
+            continue;
+        }
+        let lower_holds = birth > previous.txg;
+        let describe = |label: &str| {
+            format!(
+                "{label}：盘 {} 槽 {} 类 {class} 诞生代号 {birth} ≤ R_prev (实例 {}, txg {}{})，R_first (实例 {}, txg {}{})",
+                placement.0,
+                placement.1,
+                previous.instance,
+                previous.txg,
+                if previous.applied_only { "，由记录施加" } else { "" },
+                first.instance,
+                first.txg,
+                if first.applied_only { "，由记录施加" } else { "" },
+            )
+        };
+        tallies.judge(format!("{set}:lower"), lower_holds, || describe("原措辞"));
+        // 继承来的用户可见树根：出生 txg ≤ R_prev.txg 且落点 R_prev 不引用。
+        let inherited: Vec<(u16, PointerView)> = first
+            .user_tree_roots
+            .iter()
+            .filter(|(_, pointer)| {
+                pointer.birth_txg <= previous.txg
+                    && !previous
+                        .references
+                        .placements
+                        .contains(&(pointer.locations[0].device, pointer.locations[0].slot))
+            })
+            .copied()
+            .collect();
+        let v1_condition = inherited.iter().any(|(kind, _)| *kind == TREE_KIND_INODE);
+        let under_inherited = inherited_cache
+            .entry((first_index, previous_index))
+            .or_insert_with(|| {
+                inherited
+                    .iter()
+                    .flat_map(|(kind, pointer)| placements_under_tree_root(reader, cache, pointer, *kind))
+                    .collect()
+            })
+            .contains(&placement);
+        if v1_condition {
+            tallies.count(format!("{set}:v1-exempted"), String::new);
+            if lower_holds {
+                // V1 把原措辞判得出的一格免掉了：这条 R_first 自己新写的、或继承来却出生晚于 R_prev 的落点。
+                tallies.count(format!("{set}:v1-exempted-where-lower-holds"), || {
+                    format!("盘 {} 槽 {} 类 {class} 诞生代号 {birth} > R_prev txg {}，R_first txg {}，在继承来的子树下 {under_inherited}", placement.0, placement.1, previous.txg, first.txg)
+                });
+            }
+        } else {
+            tallies.judge(format!("{set}:v1"), lower_holds, || describe("V1"));
+        }
+        if under_inherited {
+            tallies.count(format!("{set}:v2-exempted"), String::new);
+        } else {
+            tallies.judge(format!("{set}:v2"), lower_holds, || describe("V2"));
+        }
+        // V3（攻方提的收严，零轮）：V2 再加一条——继承来的树根要「压得住」它下面的每个单元（下面每个落点的头里诞生代号 ≤ 树根指针的出生 txg）；
+        // 合法的回退根继承的是整棵旧树，旧树里没有比它的根更晚出生的单元。只改小一个树根的诞生代号，它的孩子比它晚，这一条就不免。
+        let under_dominating_inherited = inherited.iter().any(|(kind, pointer)| {
+            let under = placements_under_tree_root(reader, cache, pointer, *kind);
+            under.contains(&placement)
+                && under.iter().all(|(device, slot)| {
+                    reader
+                        .read(*device, slot * SLOT_BYTES, UNIT_HEADER_SCAN_BYTES)
+                        .and_then(|header| birth_txg_in_a_usable_unit_header(&header))
+                        .is_none_or(|below| below <= pointer.birth_txg)
+                })
+        });
+        if under_dominating_inherited {
+            tallies.count(format!("{set}:v3-exempted"), String::new);
+        } else {
+            tallies.judge(format!("{set}:v3"), lower_holds, || describe("V3"));
+        }
+        if !lower_holds {
+            let class_name = match (v1_condition, under_inherited) {
+                (true, true) => "red-class:v1-root-and-under-inherited",
+                (true, false) => "red-class:v1-root-not-under-inherited",
+                (false, true) => "red-class:not-v1-root-under-inherited",
+                (false, false) => "red-class:neither",
+            };
+            tallies.count(format!("{set}:{class_name}"), || describe(class_name));
+        }
+    }
+}
+
+/// 诞生代号下界的三种写法在 CS1、CS2 上各判一遍；名字是「候选集:谓词」。另交 `CS2:applied-only-versions`（这张镜像上并进来的版本数）。
+#[must_use]
+pub fn birth_floor_judgements(reader: &dyn ImageReader) -> BTreeMap<String, ProtoTally> {
+    let mut tallies = NamedTallies::default();
+    let chosen: Vec<_> = chosen_system_configurations(reader)
+        .into_iter()
+        .filter_map(|(device, chosen)| chosen.map(|(view, geometry)| (device, view, geometry)))
+        .collect();
+    let Some((_, _, geometry)) = chosen.first().cloned() else {
+        return tallies.by_name;
+    };
+    let fsid_low = u64::from_le_bytes(geometry.filesystem_identifier[..8].try_into().expect("8"));
+    let roots = valid_roots(reader, &geometry);
+    if roots.is_empty() {
+        return tallies.by_name;
+    }
+    let newest_index = roots
+        .iter()
+        .enumerate()
+        .max_by_key(|(_, (_, _, root))| (root.checkpoint_txg, root.instance))
+        .map(|(index, _)| index)
+        .expect("非空");
+    let candidates = candidate_indexes_of(reader, &geometry, &roots, newest_index);
+    let mut cache = IndexNodeCache::new();
+    let mut ring_versions: Vec<BirthFloorVersion> = candidates
+        .iter()
+        .map(|index| {
+            let root = &roots[*index].2;
+            version_of_record(reader, &root.record_bytes, root.checkpoint_txg, root.instance, false, &mut cache)
+        })
+        .collect();
+    judge_birth_floor_on(reader, &mut ring_versions, &mut cache, &mut tallies, "CS1");
+    // CS2：同 `check_pool_image` 的候选集补法（F 生效值另算一遍，与 `candidate_indexes_of` 同一份算法）。
+    let rows = instance_table_rows_of_root_without_judging(reader, &roots[newest_index].2.record_bytes)
+        .unwrap_or_default();
+    let floor = effective_floor_of(reader, &geometry, &roots, &rows);
+    let journal = scanned_journal_records_by_device(reader, &geometry, fsid_low);
+    let applied = versions_applied_only_by_records(&journal, &roots, &rows, floor);
+    if applied.is_empty() {
+        // 没有由记录施加出来的版本：CS2 与 CS1 是同一组版本，判定逐项相同，照抄一份（省一遍走读）。
+        let copied: Vec<(String, ProtoTally)> = tallies
+            .by_name
+            .iter()
+            .filter_map(|(name, tally)| name.strip_prefix("CS1:").map(|rest| (format!("CS2:{rest}"), tally.clone())))
+            .collect();
+        tallies.by_name.extend(copied);
+        return tallies.by_name;
+    }
+    let mut all_versions = ring_versions;
+    for version in &applied {
+        tallies.count("CS2:applied-only-versions".to_string(), || {
+            format!("实例 {}、txg {}", version.instance, version.checkpoint_txg)
+        });
+        let Some(base) = &version.root_record_of_the_version_it_was_applied_on else {
+            continue;
+        };
+        let mut record = base.clone();
+        record[24..28].copy_from_slice(&version.instance.to_le_bytes());
+        record[28..36].copy_from_slice(&version.checkpoint_txg.to_le_bytes());
+        record[36..122].copy_from_slice(&version.new_root_segment[NEW_ROOT_SEGMENT_TREE_TABLE_POINTER]);
+        record[256..342].copy_from_slice(&version.new_root_segment[NEW_ROOT_SEGMENT_MAPPING_ROOT_POINTER]);
+        all_versions.push(version_of_record(
+            reader,
+            &record,
+            version.checkpoint_txg,
+            version.instance,
+            true,
+            &mut cache,
+        ));
+    }
+    judge_birth_floor_on(reader, &mut all_versions, &mut cache, &mut tallies, "CS2");
+    tallies.by_name
+}
+
+fn effective_floor_of(
+    reader: &dyn ImageReader,
+    geometry: &PoolGeometry,
+    roots: &[(u64, u64, crate::RootView)],
+    rows: &[InstanceTableRow],
+) -> u64 {
+    let abandoned = |root: &crate::RootView| abandoned_by_instance_table_rows(rows, root);
+    let mut newest_on_device: BTreeMap<u32, &crate::RootView> = BTreeMap::new();
+    for (region, _, root) in roots {
+        if abandoned(root) {
+            continue;
+        }
+        let device = geometry.region_devices[usize::try_from(*region).expect("区域")];
+        let slot = newest_on_device.entry(device).or_insert(root);
+        if (root.checkpoint_txg, root.instance) > (slot.checkpoint_txg, slot.instance) {
+            *slot = root;
+        }
+    }
+    let abandoned_floor = roots
+        .iter()
+        .filter(|(_, _, root)| abandoned(root))
+        .map(|(_, _, root)| root.rollback_floor)
+        .max()
+        .unwrap_or(0);
+    verified_system_configuration_slots(reader)
+        .into_iter()
+        .flat_map(|(_, slots)| slots.into_iter().map(|(view, _)| view))
+        .filter(|view| view.filesystem_identifier == geometry.filesystem_identifier)
+        .map(|view| view.rollback_floor)
+        .fold(
+            newest_on_device
+                .values()
+                .map(|root| root.rollback_floor)
+                .max()
+                .unwrap_or(0)
+                .max(abandoned_floor),
+            u64::max,
+        )
+}
