+/// 对照格：比 L 晚的候选根走不完、而落点正藏在它读不出的节点下面。步 5 那段历史抬 F 到 11（空发布 txg 15、16 不换用户可见树），
+/// 再覆盖写一次（txg 17）释放 txg 14 那一版的用户可见单元（释放代 17，真 L = 16）；把 txg 16 那条根自己的树表两份都翻坏，
+/// 它的引用集合数不全、那几个落点藏在读不出的树表下面，算出的 L = 15、T = 16。
+#[test]
+fn proto_b7_control_a_later_incomplete_root_hides_the_placement() {
+    let mut pool = pool_before_raising_the_floor("proto-b7-control");
+    raise_the_floor(&mut pool, CheckpointTxg(11), CheckpointTxg(0));
+    let raised_txg = pool.output.root.checkpoint_txg;
+    let tree_table_of_the_last_raise = pool.output.unit(TransactionUnit::TreeTable).slot.0;
+    overwrite_and_advance(&mut pool, &content_seeded(1200, 3), InstanceGeneration(2));
+    let overwrite_txg = pool.output.root.checkpoint_txg;
+    println!(
+        "PROTO_B7 control last_raise_txg={raised_txg:?} its_tree_table_slot={tree_table_of_the_last_raise} overwrite_txg={overwrite_txg:?}"
+    );
+    let clean = pool.memory_pool();
+    proto_b7_report("control-clean", &clean);
+    let mut hidden = clean.clone();
+    proto_flip_both_copies(&mut hidden, tree_table_of_the_last_raise, 16384);
+    proto_b7_report("control-later-root-tree-table-unreadable", &hidden);
+}
