+                "crates/singlefs-background-gpu/src/nested/kernel.wgsl",
+                "crates/singlefs-background-gpu-tests/src/bin/e202_gpu_cpu_gc_comparison.rs",
+                "crates/singlefs-background-gpu-tests/tests/common_discrete_gpus_of_this_host/mod.rs",
+                "crates/singlefs-background-gpu-tests/tests/common_pairing_input_through_the_library/mod.rs",
+                "crates/singlefs-core/src/lib.rs",
+            ]
+        );
+    }
+
+    /// 场景：环境变量没给卡串，有领卡通道，领卡那一端拒了。
+    /// 预期：取卡报错，那一句点名是按需领卡没成、带上那一端的话，不当成「服务没给卡的来路」。
+    #[test]
+    fn a_failed_lease_through_the_channel_is_reported_as_the_lease_failing() {
+        let channel = lease_channel_given();
+        assert_eq!(
+            cards_handed_to_the_apparatus(None, Some(&channel), &|_channel| {
+                Err("领卡那一端拒了".to_string())
+            }),
+            Err("按需领卡没成：领卡那一端拒了".to_string())
+        );
+    }
+
+    /// 场景：对拍输入里「释放没有」那一格读回 2（录的与读的布局对不上）。
+    /// 预期：当场停下，那一句点名是哪一格、读回的是几。
+    #[test]
+    #[should_panic(expected = "释放没有只写 0 或 1，读回 2")]
+    fn a_number_written_other_than_zero_or_one_is_refused_as_a_layout_mismatch() {
+        whether_of_the_number_written(2, "释放没有");
+    }
+
+    /// [`a_disposable_library_is_set_only_after_the_pairing_through_the_one_library_returns`] 里那一段在对拍里停多久：
+    /// 设一次性库那一条线程在这么久里早就设上了（没有守卫的话），守卫在时它等满这么久。
+    const TIME_THE_TEST_STAYS_INSIDE_THE_PAIRING: Duration = Duration::from_millis(200);
+
+    /// 真卡对拍用例经全仓那一份库对拍时包在外面（`the_gpu_arm_on_a_real_card_counts_the_same_live_slots_per_segment_as_the_apparatus_on_the_small_pool`）：
+    /// 先拿 `TheOneLibraryKeptForThisProcess`，到 `pairing` 返回为止，同一个二进制里设一次性库的用例
+    /// （`the_record_stage_of_the_live_slot_pairing_takes_no_card_and_the_judge_stage_reads_back_the_apparatus_count`）等它放手。
+    /// 不拿的，那条用例设着一次性库的那一刻开库就开到那一份：它收尾停掉临时服务，这一边接着读写连不上，只录那一段录进去的输入跟着丢。
+    fn with_the_one_library_kept_for_this_process<Outcome>(
+        pairing: impl FnOnce() -> Outcome,
+    ) -> Outcome {
+        let _the_one_library = singlefs_verification::crash_library::TheOneLibraryKeptForThisProcess::keep_disposable_libraries_out();
+        pairing()
+    }
+
+    /// 场景：一条线程进了 [`with_the_one_library_kept_for_this_process`]（真卡对拍用例经全仓那一份库对拍的那一段），在里面停一会儿；
+    /// 它进去之后，另一条线程去设一次性库（同一个二进制里先录后判那条用例做的事）。
+    /// 预期：一次性库等那一段返回之后才设得上（设上的那一刻那一段已经返回）：同时跑的两条用例，真卡那一条开库开不到一次性库。
+    /// 两条线程是这个场景本身（并发下的守卫），不拆。
+    #[test]
+    fn a_disposable_library_is_set_only_after_the_pairing_through_the_one_library_returns() {
+        let disposable = singlefs_verification::crash_library::DisposableLibrary::new(
+            "e202-one-library-kept-during-the-pairing",
+        )
+        .unwrap_or_else(|refusal| panic!("{refusal}"));
+        let (entered_sender, entered_receiver) = mpsc::channel::<()>();
+        let has_the_pairing_returned = AtomicBool::new(false);
+        std::thread::scope(|scope| {
+            scope.spawn(|| {
+                with_the_one_library_kept_for_this_process(|| {
+                    entered_sender
+                        .send(())
+                        .expect("设一次性库的那一条线程在等这一声");
+                    std::thread::sleep(TIME_THE_TEST_STAYS_INSIDE_THE_PAIRING);
+                    has_the_pairing_returned.store(true, Ordering::SeqCst);
+                });
+            });
+            entered_receiver
+                .recv()
+                .expect("对拍那一段的线程进去之后才发这一声");
+            let _the_library_of_this_process = disposable.make_it_the_library_of_this_process();
+            assert!(
+                has_the_pairing_returned.load(Ordering::SeqCst),
+                "一次性库在对拍那一段还没返回时就设上了：那一段里开的库会开到这一份"
+            );
+        });
+    }
 }
diff --git a/crates/singlefs-background-gpu-tests/tests/reference_units_entries_name_functions_that_exist.rs b/crates/singlefs-background-gpu-tests/tests/reference_units_entries_name_functions_that_exist.rs
new file mode 100644
index 0000000000000000000000000000000000000000..87f9673e138a8b5711f09387f6b01e33ec15635f
--- /dev/null
+++ b/crates/singlefs-background-gpu-tests/tests/reference_units_entries_name_functions_that_exist.rs
@@ -0,0 +1,137 @@
+//! 对拍参照一侧的入口登记表（`src/reference_units_entries.rs`）逐组对构建脚本编进来的参照一侧键表（`OUT_DIR/reference_units_keys.tsv`，
+//! 表的写法在 `singlefs-unit-graph` 的 `entry_groups` 文件头）：每组都算出了键、组里登记的入口都编进来了、每个入口在组的闭包里恰好是一个 fn，
+//! 组名、入口、键各不相同。核法照 GPU 一侧那一张（`tests/pairing_conclusion_on_the_cards_is_reused_by_its_keys_and_judged_again_when_a_side_changes.rs`
+//! 的 `every_gpu_side_group_is_keyed_and_closes_over_the_kernels_of_the_product_gpu_crate`）：只读编进来的那一份，跑时不读盘上的树。
+//! 入口找不到、不唯一、在这组特性下不编进来的，构建脚本已经停下（`singlefs-unit-graph` 的 `EntryError`）；这里补的是构建脚本不停的那几种：
+//! 组拒算或没编进来、一个入口没进闭包、两组共用一个组名或一个入口（一组登记成另一组那个编得过的入口，参照改了它的键不跟着变）。
+//! 不要卡、不挂特性，`cargo test -p singlefs-background-gpu-tests --test <本目标>` 就能跑。
+#[allow(
+    dead_code,
+    reason = "这里只读参照一侧那张登记表，组的目标与收闭包时交的特性名不用"
+)]
+#[path = "../src/reference_units_entries.rs"]
+mod reference_units_entries;
+
+use std::collections::BTreeSet;
+
+/// 构建脚本写下的参照一侧键表。
+const REFERENCE_UNITS_KEYS_TEXT: &str =
+    include_str!(concat!(env!("OUT_DIR"), "/reference_units_keys.tsv"));
+
+/// 入口 fn 路径起头的包名（构建脚本只拿它找包）。
+const PACKAGE_PREFIX_OF_THE_ENTRIES: &str = "singlefs_background_gpu_tests::";
+
+/// 编进来的参照一侧键表里组 `group_name` 那几行：组那一行的结论（`keyed`、`refused`、`not-compiled`，没有这一组是空串）与键（算出了的才有），
+/// 这组特性下没编进来的入口，组成清单里 fn 的限定名。
+struct ReferenceGroupInTheCompiledTable {
+    verdict: String,
+    key_hexadecimal: Option<String>,
+    entries_not_compiled: Vec<String>,
+    qualified_names_of_the_functions: Vec<String>,
+}
+
+/// 编进来的参照一侧键表里组 `group_name` 那几行。
+fn reference_group_in_the_compiled_table(group_name: &str) -> ReferenceGroupInTheCompiledTable {
+    let mut verdict = String::new();
+    let mut key_hexadecimal = None;
+    let mut entries_not_compiled = Vec::new();
+    let mut qualified_names_of_the_functions = Vec::new();
+    for line in REFERENCE_UNITS_KEYS_TEXT.lines() {
+        let fields: Vec<&str> = line.split('\t').collect();
+        match fields.as_slice() {
+            ["group", name, "keyed", key, ..] if *name == group_name => {
+                verdict = "keyed".to_string();
+                key_hexadecimal = Some((*key).to_string());
+            }
+            ["group", name, group_verdict, ..] if *name == group_name => {
+                verdict = (*group_verdict).to_string();
+            }
+            ["not-compiled-entry", name, entry, ..] if *name == group_name => {
+                entries_not_compiled.push((*entry).to_string());
+            }
+            ["unit", name, "fn", qualified_name, ..] if *name == group_name => {
+                qualified_names_of_the_functions.push((*qualified_name).to_string());
+            }
+            _ => {}
+        }
+    }
+    ReferenceGroupInTheCompiledTable {
+        verdict,
+        key_hexadecimal,
+        entries_not_compiled,
+        qualified_names_of_the_functions,
+    }
+}
+
+/// 组成清单里的一个 fn 是不是登记的入口 `entry_path`：限定名在本包里（包名起头），去掉包名之后的模块路径与 fn 名是它的结尾
+/// （限定名里包名与模块路径之间夹着目标的标记，例 `<test 目标>`、`<bin 名>`）。
+fn is_the_function_of_the_entry(qualified_name: &str, entry_path: &str) -> bool {
+    let path_in_the_package = entry_path
+        .strip_prefix(PACKAGE_PREFIX_OF_THE_ENTRIES)
+        .expect("登记表里的入口都写成 singlefs_background_gpu_tests::<模块路径>::<fn>");
+    qualified_name.starts_with(PACKAGE_PREFIX_OF_THE_ENTRIES)
+        && qualified_name.ends_with(&format!("::{path_in_the_package}"))
+}
+
+/// 场景：读构建脚本编进来的参照一侧键表，逐组对登记表（`src/reference_units_entries.rs`）里的组。
+/// 预期：组名各不相同、两组不共用一个入口；每组都算出了键、组里登记的入口都编进来了、每个入口在这组的闭包里恰好是一个 fn；键两两不同。
+/// 判别力（`crates/mutations.tsv`）：「参照一侧登记表：两组登记同一个组名」「参照一侧登记表：一组登记成另一组的入口」两行各让这一条红。
+#[test]
+fn every_reference_group_is_keyed_and_closes_over_each_of_its_own_entries_once() {
+    let groups = reference_units_entries::REFERENCE_UNITS_ENTRY_GROUPS;
+    let group_names: BTreeSet<&str> = groups.iter().map(|group| group.group_name).collect();
+    assert_eq!(group_names.len(), groups.len(), "组名各不相同");
+    let entries: Vec<&str> = groups
+        .iter()
+        .flat_map(|group| group.entry_functions.iter().copied())
+        .collect();
+    let distinct_entries: BTreeSet<&str> = entries.iter().copied().collect();
+    assert_eq!(
+        distinct_entries.len(),
+        entries.len(),
+        "两组不共用一个入口、一组里不重复登记一个入口：{entries:#?}"
+    );
+    let groups_falling_short: Vec<String> = groups
+        .iter()
+        .filter_map(|group| {
+            let compiled = reference_group_in_the_compiled_table(group.group_name);
+            let entries_not_found_once: Vec<(&str, usize)> = group
+                .entry_functions
+                .iter()
+                .map(|entry| {
+                    (
+                        *entry,
+                        compiled
+                            .qualified_names_of_the_functions
+                            .iter()
+                            .filter(|qualified_name| is_the_function_of_the_entry(qualified_name, entry))
+                            .count(),
+                    )
+                })
+                .filter(|(_entry, functions_found)| *functions_found != 1)
+                .collect();
+            (compiled.verdict != "keyed"
+                || !compiled.entries_not_compiled.is_empty()
+                || !entries_not_found_once.is_empty())
+            .then(|| {
+                format!(
+                    "{}：结论 {:?}，没编进来的入口 {:?}，在闭包里不是恰好一个 fn 的入口（入口，找到几个）{entries_not_found_once:?}",
+                    group.group_name, compiled.verdict, compiled.entries_not_compiled
+                )
+            })
+        })
+        .collect();
+    assert!(
+        groups_falling_short.is_empty(),
+        "每组都算出了键、入口都编进来了、每个入口在闭包里恰好是一个 fn：{groups_falling_short:#?}"
+    );
+    let distinct_keys: BTreeSet<String> = groups
+        .iter()
+        .filter_map(|group| reference_group_in_the_compiled_table(group.group_name).key_hexadecimal)
+        .collect();
+    assert_eq!(
+        distinct_keys.len(),
+        groups.len(),
+        "每组一把键、两两不同：两组不落到同一把参照一侧的键上"
+    );
+}
