+/// 续跑时逐张核开的卡的那两条用卡的臂（各连同它的多判臂）。封闭集合。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ArmWhoseCardsAreRecorded {
+    /// 点名一张卡臂（交替跑与并发跑的 `gpu_one_card`）：记在 `name=one_card_arm_card` 一行。
+    TheCardWithTheLowestPciAddress,
+    /// 全部卡臂：记在 `name=every_card_arm_cards` 一行。
+    EveryCard,
+}
+
+impl ArmWhoseCardsAreRecorded {
+    /// 记这条臂开的卡的那一行的种类（`name=` 的值）。
+    const fn kind_of_the_line(self) -> &'static str {
+        match self {
+            ArmWhoseCardsAreRecorded::TheCardWithTheLowestPciAddress => "one_card_arm_card",
+            ArmWhoseCardsAreRecorded::EveryCard => "every_card_arm_cards",
+        }
+    }
+
+    /// 这条臂挂载用的后台计算：结果行 `arm=` 点到的臂用的是它，那一行就算这条臂跑出的。
+    const fn background_compute_the_arm_mounts_with(self) -> ComputeOfTheArm {
+        match self {
+            ArmWhoseCardsAreRecorded::TheCardWithTheLowestPciAddress => {
+                ComputeOfTheArm::GpuOnTheCardWithTheLowestPciAddress
+            }
+            ArmWhoseCardsAreRecorded::EveryCard => ComputeOfTheArm::GpuOnEveryCard,
+        }
+    }
+}
+
+/// 一条用卡的臂这一趟开的卡：写进产物的那一行（[`CardsRecordedForAnArm::fields_of_the_line`]），续跑时逐个字段与产物里已有的同种行比
+/// （[`cards_recorded_differing_from_the_product_being_resumed`]）。卡的身份取装置手里有的两样合起来比：PCI 地址（卡插在哪个槽上）与型号
+/// （wgpu 报的名字）。同一个地址上换了型号、同一种型号换了地址都认得出；两台在同一个地址上插着同一种型号的卡认不出（装置拿不到每张卡自己的编号）。
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct CardsRecordedForAnArm {
+    arm: ArmWhoseCardsAreRecorded,
+    /// 续跑时逐个比的字段（键、这一趟的值，值里没有空白），次序就是写进那一行的次序。
+    fields_compared_on_resume: Vec<(&'static str, String)>,
+}
+
+impl CardsRecordedForAnArm {
+    /// 那一行在 `name=` 之后的字段：档，再是逐个比的那几个字段。
+    fn fields_of_the_line(&self, tier: UnitAreaTier) -> String {
+        std::iter::once(format!("tier={}", tier.name()))
+            .chain(
+                self.fields_compared_on_resume
+                    .iter()
+                    .map(|(key, value)| format!("{key}={value}")),
+            )
+            .collect::<Vec<String>>()
+            .join(" ")
+    }
+}
