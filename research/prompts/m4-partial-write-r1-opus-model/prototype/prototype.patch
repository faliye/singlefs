+/// 读旧单元（读盘或取内存）在调用方做，原型只管发布。
+///
+/// # Errors
+/// 同 [`publish_size_change`]。
+///
+/// # Panics
+/// `unit` 不存在，或 `new_payload` 长度不等于它的声明长度。
+pub fn publish_partial_write_of_the_first_file_attack_prototype<Device: BlockDevice>(
+    pool: &mut PoolWriter<'_, Device>,
+    allocator: &mut PoolAllocator,
+    previous: &TransactionOutput,
+    unit: u64,
+    new_payload: Vec<u8>,
+    write_time_seconds: u64,
+    instance: InstanceGeneration,
+) -> Result<TransactionOutput, PublishError> {
+    let record = previous
+        .inode_leaf_containers
+        .iter()
+        .flat_map(|container| container.contents.records.iter())
+        .find(|record| record.inode == FIRST_INODE_NUMBER && record.nlink != NLINK_OF_AN_INODE_BEING_DELETED)
+        .copied()
+        .expect("第一个文件活着");
+    assert!(unit < u64::try_from(previous.data_pointers.len()).expect("单元数"), "单元存在");
+    let declared_length_in_bytes = crate::truncate::declared_length_within_a_size(DataUnitIndexInFile(unit), record.size);
+    assert_eq!(u64::try_from(new_payload.len()).expect("长度"), declared_length_in_bytes, "净荷长度等于声明长度");
+    let txg = checkpoint_txg_of_the_publish_after(previous.root.checkpoint_txg)?;
+    let record_after_the_change = InodeRecord {
+        change_count: txg.0,
+        write_time_seconds,
+        ..record
+    };
+    let step = DeletionStepOfThePublish::SizeChangeWithoutAnIntent {
+        record_after_the_change,
+        tail_data_unit_rewrite: Some(TailDataUnitRewrite {
+            unit: DataUnitIndexInFile(unit),
+            declared_length_in_bytes,
+        }),
+    };
+    PAYLOAD_OF_THE_PARTIAL_WRITE_OF_THE_ATTACK_PROTOTYPE.with(|cell| {
+        *cell.borrow_mut() = Some((unit, new_payload));
