 pub use crate::instance_table::{InstanceRow, InstanceTableRecords};
 
+/// m3-ring-r1 攻方原型：补洞挂点（只在攻方副本里有；进程级开关，一个进程只用一个挂点）。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HoleFillPoint {
+    NotFilled,
+    P1AfterAcquisition,
+    P2BeforeRowRoot,
+    P2AfterRowRoot,
+    P3AfterWarmUp,
+    /// P2 的另一种记法：补洞写仍并进写行那次的根槽段（根前），但分配器在写行那次发布取落点之前就记下补洞（门槛先抬）。
+    P2RecordedBeforeRowPublish,
+}
+static HOLE_FILL_POINT: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+pub fn set_hole_fill_point(point: HoleFillPoint) {
+    HOLE_FILL_POINT.store(point as u8, std::sync::atomic::Ordering::SeqCst);
+}
+#[must_use]
+pub fn hole_fill_point() -> HoleFillPoint {
+    match HOLE_FILL_POINT.load(std::sync::atomic::Ordering::SeqCst) {
+        0 => HoleFillPoint::NotFilled,
+        1 => HoleFillPoint::P1AfterAcquisition,
+        2 => HoleFillPoint::P2BeforeRowRoot,
+        3 => HoleFillPoint::P2AfterRowRoot,
+        4 => HoleFillPoint::P3AfterWarmUp,
+        5 => HoleFillPoint::P2RecordedBeforeRowPublish,
+        other => unreachable!("{other}"),
+    }
+}
+/// 补洞写进 slot(h) 的字节。必红世界由环境变量 HOLE_FILL_BYTES 选：`zero` 写全零槽，`chosen` 写所选根（txg h − 1）的字节，其余写 txg h 的根记录。
+fn hole_fill_bytes(hole: &RootRecord, chosen: &RootRecord, slot_bytes: usize) -> Vec<u8> {
+    match std::env::var("HOLE_FILL_BYTES").as_deref() {
+        Ok("zero") => vec![0u8; slot_bytes],
+        Ok("chosen") => chosen.to_slot(slot_bytes),
+        _ => hole.to_slot(slot_bytes),
+    }
+}
+fn write_hole_fill<Device: BlockDevice>(
+    pool: &mut PoolWriter<'_, Device>,
+    hole: &RootRecord,
+    chosen: &RootRecord,
+) -> Result<(), crate::block_device::BlockDeviceError> {
+    let bytes = hole_fill_bytes(hole, chosen, pool.root_slot_bytes());
+    pool.perform_commit_step(crate::transaction::CommitStep::WriteRootRecordForceUnitAccess {
+        checkpoint_txg: hole.checkpoint_txg,
+        root_slot: &bytes,
+    })?;
+    pool.perform_commit_step(crate::transaction::CommitStep::Barrier)
+}
