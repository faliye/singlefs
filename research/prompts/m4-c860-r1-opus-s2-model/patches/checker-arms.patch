+/// C860 探针的四种认法：甲（今天）、乙（遍历方向也有同号同出生代的记录）、丙（乙且两侧记录 nlink 都为 0）、丁（任一侧见记录与墓碑，并集）。
+pub const C860_ARMS: [&str; 4] = ["jia", "yi", "bing", "ding"];
+/// 正式判定取哪一种（下标进 [`C860_ARMS`]）。
+pub static C860_OFFICIAL_ARM: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+thread_local! {
+    static C860_PROBE: std::cell::RefCell<Option<Vec<(&'static str, bool, String)>>> = const { std::cell::RefCell::new(None) };
+}
+/// C860 探针的全进程计数（崩溃枚举判段在工作线程里调池级 checker，线程局部看不见）：键「认法 有无删除中 成立/违例」→ 调用次数，与每个违例键的第一处。
+#[allow(clippy::type_complexity, reason = "攻方副本里的探针")]
+pub static C860_GLOBAL: std::sync::Mutex<Option<(BTreeMap<String, u64>, BTreeMap<String, String>)>> =
+    std::sync::Mutex::new(None);
+/// 开始在本线程记四种认法的判定。
+pub fn c860_probe_begin() {
+    C860_PROBE.with(|probe| *probe.borrow_mut() = Some(Vec::new()));
+}
+/// 取走本线程记下的判定（I-1.13 在比表之前就报不适用的，这里是空的）。
+pub fn c860_probe_take() -> Vec<(&'static str, bool, String)> {
+    C860_PROBE.with(|probe| probe.borrow_mut().take().unwrap_or_default())
 }
 
