+#[test]
+fn c860_probe_bad_images() {
+    // C860 那张：抹掉退役记录、补回退役叶的映射条目。
+    let mut pool = pool_with_new_inodes("c860-bad-c860", NEW_INODES_FILLING_ONE_LEAF_AND_STARTING_ANOTHER);
+    let intent = unlink_to_the_end(&mut pool, THE_ONLY_INODE_OF_THE_RIGHT_LEAF);
+    let right_leaf_at_the_intent = intent.inode_leaf_containers[1].clone();
+    let mut image = pool.memory_pool();
+    erase_every_record_of_the_container(&mut image, &pool.output.retirement_containers[0].pointer);
+    c860_arms_of(&image, "bad_retirement_record_erased_only");
+    insert_the_entry_into_the_newest_mapping_leaf(
+        &mut image,
+        &build_mapping_entry(&mapping_key_for_node(UNIT_CLASS_PACKED, right_leaf_at_the_intent.pointer), right_leaf_at_the_intent.pointer.locations),
+    );
+    c860_arms_of(&image, "bad_c860_retirement_erased_and_mapping_put_back");
+    // 谱系记录抹掉（已有必红世界）。
+    let pool = pool_rolled_back_past_an_overwrite_of_the_same_length("c860-bad-lineage");
+    let mut image = pool.memory_pool();
+    erase_every_record_of_the_container(&mut image, &pool.output.lineage_containers[0].pointer);
+    c860_arms_of(&image, "bad_lineage_record_erased");
+    // 第一个文件删一半、inode 2 活着：M5 必红世界（挪 inode 2 一条映射）；多一条压着活的 inode 2 的墓碑；两样一起；墓碑的出生代改坏。
+    let pool = c860_pool_with_the_first_file_half_deleted_beside_inode_two("c860-bad-half");
+    let inode_two_pointer = pool.output.file_other_than_the_first(InodeNumber(2)).expect("inode 2").data_pointers[0];
+    let key_of_inode_two = singlefs_core::records::mapping_key_for_data(inode_two_pointer.head, inode_two_pointer.write_order);
+    let birth_of_inode_two = c860_object_birth_of(&pool.output, 2);
+    let txg = pool.output.root.checkpoint_txg.0;
+    let tombstone_pointer = pool.output.tombstone_containers.last().expect("有墓碑容器").pointer;
+    let base = pool.memory_pool();
+    let mut image = base.clone();
+    c860_move_the_first_location_of_the_mapping_entry_keyed(&mut image, &key_of_inode_two);
+    c860_arms_of(&image, "bad_m5_must_red_world_inode_two_mapping_moved");
+    let mut image = base.clone();
+    c860_append_a_record_to_the_container(&mut image, &tombstone_pointer, &c860_whole_object_tombstone(2, birth_of_inode_two, txg));
+    c860_arms_of(&image, "bad_spurious_tombstone_over_live_inode_two");
+    c860_move_the_first_location_of_the_mapping_entry_keyed(&mut image, &key_of_inode_two);
+    c860_arms_of(&image, "bad_spurious_tombstone_over_live_inode_two_and_its_mapping_moved");
+    let mut image = base.clone();
+    c860_rewrite_a_field_of_a_record(&mut image, &tombstone_pointer, 0, 8, 999_999);
+    c860_arms_of(&image, "bad_tombstone_birth_of_the_deleting_inode_rewritten");
+    let mut image = base.clone();
+    erase_every_record_of_the_container(&mut image, &tombstone_pointer);
+    c860_arms_of(&image, "bad_tombstone_container_erased_while_deleting");
+    // 删完第一个文件（inode 2、3 还在同一片叶）之后，多一条压着活的 inode 2 的墓碑。
+    let mut pool = pool_with_new_inodes("c860-bad-after-unlink", 2);
+    unlink_to_the_end(&mut pool, 1);
+    let birth = c860_object_birth_of(&pool.output, 2);
+    let txg = pool.output.root.checkpoint_txg.0;
+    let tombstone_pointer = pool.output.tombstone_containers.last().expect("有墓碑容器").pointer;
+    let mut image = pool.memory_pool();
+    c860_append_a_record_to_the_container(&mut image, &tombstone_pointer, &c860_whole_object_tombstone(2, birth, txg));
+    c860_arms_of(&image, "bad_spurious_tombstone_over_live_empty_inode_two_after_unlink");
+}
