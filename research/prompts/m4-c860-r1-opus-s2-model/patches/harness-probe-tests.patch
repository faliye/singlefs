+// ───────── C860 攻方第二次抽样的探针（只在攻方副本里）─────────
+
+/// 一张镜像上四种认法各判什么，连同池级 checker 别的违例（不变量名）。
+fn c860_arms_of(image: &MemoryPool, what: &str) {
+    singlefs_checker::walk::c860_probe_begin();
+    let verdicts = check_pool_image(image);
+    let probe = singlefs_checker::walk::c860_probe_take();
+    let official = verdicts
+        .iter()
+        .find(|(invariant, _)| *invariant == SCAN_REBUILD_AGREES_WITH_THE_WALKED_INDEX)
+        .map(|(_, verdict)| format!("{verdict:?}"))
+        .expect("I-1.13");
+    let others: Vec<&str> = verdicts
+        .iter()
+        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+        .map(|(invariant, _)| *invariant)
+        .collect();
+    println!("C860_PROBE what={what} official={official}");
+    if probe.is_empty() {
+        println!("C860_PROBE what={what} arms=no_probe（I-1.13 在比表之前已交判定）");
+    }
+    for (arm, holds, detail) in probe {
+        if arm == "meta" {
+            println!("C860_PROBE what={what} meta={detail}");
+        } else {
+            println!(
+                "C860_PROBE what={what} arm={arm} {}",
+                if holds { "holds".to_string() } else { format!("violated {detail}") }
+            );
+        }
+    }
+    println!("C860_PROBE what={what} violated_invariants={others:?}");
+}
+
+/// 往一片码 3 容器里追加一条记录：记录数、声明长度加一条，载荷 CRC 与头校验和重封，新的整单元校验和沿引用链补到根槽。
+fn c860_append_a_record_to_the_container(image: &mut MemoryPool, pointer: &NodePointer, record: &[u8]) {
+    let slot = the_slot_of(pointer);
+    let mut unit = unit_bytes_at(image, slot, data_unit_bytes());
+    let record_count = usize::from(u16::from_le_bytes(
+        unit[PACKED_RECORD_COUNT_OFFSET..PACKED_RECORD_COUNT_OFFSET + 2].try_into().expect("2"),
+    ));
+    let record_width = usize::from(u16::from_le_bytes(
+        unit[PACKED_RECORD_WIDTH_OFFSET..PACKED_RECORD_WIDTH_OFFSET + 2].try_into().expect("2"),
+    ));
+    assert_eq!(record.len(), record_width, "记录宽对得上");
+    let start = PACKED_RECORDS_OFFSET + record_count * record_width;
+    unit[start..start + record_width].copy_from_slice(record);
+    let new_count = record_count + 1;
+    unit[PACKED_RECORD_COUNT_OFFSET..PACKED_RECORD_COUNT_OFFSET + 2]
+        .copy_from_slice(&u16::try_from(new_count).expect("2").to_le_bytes());
+    unit[PACKED_DECLARED_LENGTH_OFFSET..PACKED_DECLARED_LENGTH_OFFSET + 2]
+        .copy_from_slice(&u16::try_from(new_count * record_width).expect("2").to_le_bytes());
+    let payload_checksum = crc32_castagnoli(&unit[PACKED_PLAIN_HEADER_END..]);
+    unit[PACKED_PAYLOAD_CHECKSUM_OFFSET..PACKED_PAYLOAD_CHECKSUM_OFFSET + 4]
+        .copy_from_slice(&payload_checksum.to_le_bytes());
+    seal_header_checksum(&mut unit, PACKED_PLAIN_HEADER_END);
+    replace_the_unit_and_propagate_its_checksum(image, slot, &unit);
+}
+
+/// 改一片码 3 容器里第 `index` 条记录 `offset` 起 8 字节的值，重封、补校验和。
+fn c860_rewrite_a_field_of_a_record(image: &mut MemoryPool, pointer: &NodePointer, index: usize, offset: usize, value: u64) {
+    let slot = the_slot_of(pointer);
+    let mut unit = unit_bytes_at(image, slot, data_unit_bytes());
+    let record_width = usize::from(u16::from_le_bytes(
+        unit[PACKED_RECORD_WIDTH_OFFSET..PACKED_RECORD_WIDTH_OFFSET + 2].try_into().expect("2"),
+    ));
+    let start = PACKED_RECORDS_OFFSET + index * record_width + offset;
+    unit[start..start + 8].copy_from_slice(&value.to_le_bytes());
+    let payload_checksum = crc32_castagnoli(&unit[PACKED_PLAIN_HEADER_END..]);
+    unit[PACKED_PAYLOAD_CHECKSUM_OFFSET..PACKED_PAYLOAD_CHECKSUM_OFFSET + 4]
+        .copy_from_slice(&payload_checksum.to_le_bytes());
+    seal_header_checksum(&mut unit, PACKED_PLAIN_HEADER_END);
+    replace_the_unit_and_propagate_its_checksum(image, slot, &unit);
+}
+
+fn c860_whole_object_tombstone(inode: u64, object_birth: u64, death_txg: u64) -> Vec<u8> {
+    let mut record = Vec::with_capacity(40);
+    for value in [inode, object_birth, TombstoneRecord::WHOLE_OBJECT_RANGE_START_IN_BYTES, TombstoneRecord::WHOLE_OBJECT_RANGE_END_IN_BYTES, death_txg] {
+        record.extend_from_slice(&value.to_le_bytes());
+    }
+    record
+}
+
+fn c860_object_birth_of(output: &singlefs_core::transaction::TransactionOutput, inode: u64) -> u64 {
+    output
+        .inode_leaf_containers
+        .iter()
+        .flat_map(|container| container.contents.records.iter())
+        .find(|record| record.inode == inode)
+        .map(|record| record.object_birth.0)
+        .expect("这一版有这条记录")
+}
+
+fn c860_reseal_the_index_node(bytes: &mut [u8]) {
+    let key_width = usize::from(bytes[51]);
+    let header_end = 86 + 2 * key_width;
+    let payload_checksum_offset = 76 + 2 * key_width;
+    let payload_checksum = crc32_castagnoli(&bytes[header_end..]);
+    bytes[payload_checksum_offset..payload_checksum_offset + 4].copy_from_slice(&payload_checksum.to_le_bytes());
+    seal_header_checksum(bytes, header_end);
+}
+
+/// M5 必红世界那一招：最新根的中央映射树（根兼叶）里 key 是 `mapping_key` 的那条条目，第一条位置条目的槽号挪 4096 槽。
+fn c860_move_the_first_location_of_the_mapping_entry_keyed(image: &mut MemoryPool, mapping_key: &[u8]) {
+    let key_width = 27usize;
+    let mapping_root = newest_root(image).mapping_root;
+    let leaf_slot = the_slot_of(&mapping_root);
+    let mut leaf = unit_bytes_at(image, leaf_slot, node_bytes());
+    assert_eq!(leaf[50], 0, "根就是叶");
+    let entries_start = 115 + 2 * key_width;
+    let entry_count = usize::from(u16::from_le_bytes(
+        leaf[82 + 2 * key_width..84 + 2 * key_width].try_into().expect("2"),
+    ));
+    let entry_start = (0..entry_count)
+        .map(|index| entries_start + index * 55)
+        .find(|start| leaf[*start..*start + key_width] == *mapping_key)
+        .expect("有这把 key");
+    let slot_field_start = entry_start + key_width + 4;
+    let mut slot_bytes = [0u8; 8];
+    slot_bytes[..6].copy_from_slice(&leaf[slot_field_start..slot_field_start + 6]);
+    let moved = u64::from_le_bytes(slot_bytes) + 4096;
+    leaf[slot_field_start..slot_field_start + 6].copy_from_slice(&moved.to_le_bytes()[..6]);
+    c860_reseal_the_index_node(&mut leaf);
+    replace_the_unit_and_propagate_its_checksum(image, leaf_slot, &leaf);
+}
+
+/// 第一个文件三个单元、建 inode 2 写两个单元、删第一个文件发完意图与第一批（同 scan_rebuild_agrees_with_the_walked_index.rs 那一形）。
+fn c860_pool_with_the_first_file_half_deleted_beside_inode_two(tag: &str) -> BuiltPool {
+    use common_deletion_in_progress::{
+        pool_with_a_three_unit_file, publish_new_inodes_and_advance_the_pool, publish_the_intent,
+        publish_the_next_step_in_batches_of_one, INSTANCE_OF_THE_PUBLISHES, WRITE_TIME_SECONDS_OF_THE_NEW_INODES,
+    };
+    let mut pool = pool_with_a_three_unit_file(tag);
+    publish_new_inodes_and_advance_the_pool(&mut pool, 1);
+    let capacity = u64::try_from(singlefs_core::unit::data_unit_payload_capacity()).expect("净荷");
+    let content_of_inode_two: Vec<u8> = (0..2 * capacity - 5)
+        .map(|index| u8::try_from((index * 7 + 3) % 251).expect("小于 256"))
+        .collect();
+    let publish_parameters = common::parameters();
+    let previous = pool.output.clone();
+    let written = {
+        let devices = pool.devices.as_mut().expect("镜像还开着");
+        let mut writer = singlefs_core::transaction::PoolWriter::new(&publish_parameters, devices.as_mut_slice());
+        singlefs_core::transaction::publish_sequential_write_of_an_inode(
+            &mut writer, &mut pool.allocator, &previous, InodeNumber(2), &content_of_inode_two,
+            WRITE_TIME_SECONDS_OF_THE_NEW_INODES, INSTANCE_OF_THE_PUBLISHES,
+        )
+        .expect("写 inode 2")
+    };
+    pool.output = written;
+    publish_the_intent(&mut pool);
+    publish_the_next_step_in_batches_of_one(&mut pool);
+    pool
+}
