+#[test]
+fn c860_probe_legal_images() {
+    use common_deletion_in_progress::{publish_the_intent, publish_the_next_step_in_batches_of_one, pool_with_a_three_unit_file};
+    // 合法：回退、右片删空退役、左片吸收右片（已有三条用例的镜像）。
+    c860_arms_of(&pool_rolled_back_past_an_overwrite_of_the_same_length("c860-legal-rollback").memory_pool(), "legal_rollback_past_overwrite");
+    c860_arms_of(&pool_whose_right_leaf_retired_after_the_unlink_of("c860-legal-retire", THE_ONLY_INODE_OF_THE_RIGHT_LEAF).memory_pool(), "legal_right_leaf_retired");
+    c860_arms_of(&pool_whose_right_leaf_retired_after_the_unlink_of("c860-legal-absorb", AN_INODE_WHOSE_UNLINK_ABSORBS_THE_RIGHT_LEAF).memory_pool(), "legal_left_absorbs_right");
+    // 合法：第一个文件删一半、inode 2 活着；三单元文件逐批删的每一版；删到一半回退到意图那一版、再续删到底；删完回退到删之前。
+    c860_arms_of(&c860_pool_with_the_first_file_half_deleted_beside_inode_two("c860-legal-half").memory_pool(), "legal_half_deleted_beside_inode_two");
+    let mut pool = pool_with_a_three_unit_file("c860-legal-batches");
+    let before_the_intent = pool.output.clone();
+    let intent = publish_the_intent(&mut pool);
+    c860_arms_of(&pool.memory_pool(), "legal_three_unit_file_after_intent");
+    let mut batch = 0;
+    while !pool.output.deleted_inodes.is_empty() {
+        publish_the_next_step_in_batches_of_one(&mut pool);
+        batch += 1;
+        c860_arms_of(&pool.memory_pool(), &format!("legal_three_unit_file_after_batch_{batch}"));
+    }
+    let after_the_deletion = pool.output.clone();
+    roll_back_to(&mut pool, &intent);
+    c860_arms_of(&pool.memory_pool(), "legal_rolled_back_to_the_intent_after_the_deletion");
+    let mut batch = 0;
+    while !pool.output.deleted_inodes.is_empty() {
+        publish_the_next_step_in_batches_of_one(&mut pool);
+        batch += 1;
+        c860_arms_of(&pool.memory_pool(), &format!("legal_rolled_back_to_the_intent_then_batch_{batch}"));
+    }
+    roll_back_to(&mut pool, &before_the_intent);
+    c860_arms_of(&pool.memory_pool(), "legal_rolled_back_to_before_the_intent");
+    let _ = after_the_deletion;
+    // 合法：234 条记录、unlink 234 意图那一版（右片叶只装 234 一条 nlink 0）。
+    let mut pool = pool_with_new_inodes("c860-legal-234-intent", NEW_INODES_FILLING_ONE_LEAF_AND_STARTING_ANOTHER);
+    let _ = common_deletion_in_progress::publish_the_intent_of(&mut pool, THE_ONLY_INODE_OF_THE_RIGHT_LEAF);
+    c860_arms_of(&pool.memory_pool(), "legal_intent_of_the_only_inode_of_the_right_leaf");
+}
