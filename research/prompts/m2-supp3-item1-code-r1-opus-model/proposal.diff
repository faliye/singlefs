+/// 抬 F 那一步之前的镜像上，新 F 那个 txg 的根按最新根指着的实例表是不是被抛弃的；读不出或不是抬 F 的 Ok 结局就 None。
+fn raised_floor_lands_on_abandoned_root(image: &MemoryPool, outcome: Option<&StepOutcome>) -> Option<bool> {
+    let Some(StepOutcome::Applied(AppliedEffect::RaisedFloor { new_floor, .. })) = outcome else {
+        return None;
+    };
+    let superblock = singlefs_core::recovery::choose_superblock(image).ok()?;
+    let roots = singlefs_core::recovery::readable_roots(image, &superblock.region_devices, &superblock.geometry, &superblock.filesystem_identifier);
+    let newest = singlefs_core::recovery::choose_root(image, &superblock)?;
+    let table = singlefs_core::recovery::instance_table_of_root(image, &newest)?;
+    let at_floor: Vec<bool> = roots.iter().filter(|root| root.checkpoint_txg == *new_floor).map(|root| {
+        table.rows.iter().any(|row| row.instance == root.instance && root.checkpoint_txg > row.selected_root_txg)
+    }).collect();
+    if at_floor.is_empty() { return None; }
+    Some(at_floor.iter().all(|abandoned| *abandoned))
+}
