+/// 正推腿的候选开关（只在副本里）：默认全关 = 今天的实现；harness 探针按场景拨。
+pub mod probe_counters {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static ISOLATE_CALLS: AtomicU64 = AtomicU64::new(0);
+    pub static ABANDONED_ROOTS_SEEN: AtomicU64 = AtomicU64::new(0);
+    pub static ACCOUNT_UNREADABLE: AtomicU64 = AtomicU64::new(0);
+    pub static MAPPING_RECOMPUTE_FAILED: AtomicU64 = AtomicU64::new(0);
+    pub static REFUSED: AtomicU64 = AtomicU64::new(0);
+    pub static C_HOOK_MOUNTS: AtomicU64 = AtomicU64::new(0);
+    pub static C_HOOK_MOUNTS_WITH_UNAPPLIED_RECORDS: AtomicU64 = AtomicU64::new(0);
+    pub static C_HOOK_RECORDS_ABOVE_WATER: AtomicU64 = AtomicU64::new(0);
+    pub static C_HOOK_PLACEMENTS: AtomicU64 = AtomicU64::new(0);
+    pub fn bump(counter: &AtomicU64, by: u64) {
+        counter.fetch_add(by, Ordering::SeqCst);
+    }
+    pub fn snapshot() -> [u64; 9] {
+        [
+            ISOLATE_CALLS.load(Ordering::SeqCst),
+            ABANDONED_ROOTS_SEEN.load(Ordering::SeqCst),
+            ACCOUNT_UNREADABLE.load(Ordering::SeqCst),
+            MAPPING_RECOMPUTE_FAILED.load(Ordering::SeqCst),
+            REFUSED.load(Ordering::SeqCst),
+            C_HOOK_MOUNTS.load(Ordering::SeqCst),
+            C_HOOK_MOUNTS_WITH_UNAPPLIED_RECORDS.load(Ordering::SeqCst),
+            C_HOOK_RECORDS_ABOVE_WATER.load(Ordering::SeqCst),
+            C_HOOK_PLACEMENTS.load(Ordering::SeqCst),
+        ]
+    }
+    pub const NAMES: [&str; 9] = [
+        "isolate_calls",
+        "abandoned_roots_seen",
+        "account_unreadable",
+        "mapping_recompute_failed",
+        "refused",
+        "c_hook_mounts",
+        "c_hook_mounts_with_unapplied_records",
+        "c_hook_records_above_water",
+        "c_hook_placements",
+    ];
+}
