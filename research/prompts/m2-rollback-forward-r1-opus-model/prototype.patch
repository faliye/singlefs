+/// 原型（m2-rollback-forward-r1 攻方腿副本，不是条款）：向前发布的回退各臂。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PrototypeForwardArm {
+    /// 两半都做：最新那一版分配着而 R_old 没分配的落点在回退那次发布里释放（释放代 = 回退那次的 txg）；
+    /// R_old 分配着、最新那一版里已释放的落点改回仍分配（分配代 = R_old 那条记录的分配代）。
+    Full,
+    /// 只做释放那一半，不复活（「只释放被丢掉那几代独有的块」的字面）。
+    ReleaseOnlyNoRevive,
+    /// 释放那一半按诞生代号剪枝：只释放最新那一版里分配代 > T_old 的落点（「按诞生代号剪枝走最新的树」）；复活照做。
+    BirthPrunedRelease,
+    /// 同 `Full`，但不核「R_old 分配着的落点在最新那一版的账里仍是同一个单元」（同槽同分配代）：只靠候选集（txg ≥ F_生效）挡。
+    FullWithoutProtectionCheck,
+    /// 同 `Full`，但候选集不按实例表判「仍然有效」（删掉 (i, T) 可选 ⟺ 无行或 T ≤ Ti 那一条）。
+    FullWithoutTableValidityCheck,
+}
+
+/// 原型的计数（F4 的数在它上面量）。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct PrototypeForwardCounts {
+    /// 每块盘上释放的落点数（逐盘各算一条时的一块盘）。
+    pub released_placements: u64,
+    pub released_slots: u64,
+    /// 每块盘上复活的落点数。
+    pub revived_placements: u64,
+    pub revived_slots: u64,
+    /// 精确差集里「最新那一版分配着、R_old 没分配」而分配代 ≤ T_old 的落点数：按诞生代号剪枝会漏掉的。
+    pub birth_pruned_would_miss: u64,
+    /// 最新那一版里分配代 > T_old 的落点里，非数据单元（要读的节点）的个数：按诞生代号剪枝走树要读的节点数。
+    pub birth_pruned_nodes_read: u64,
+    /// 同上，数据单元（不读、只释放）的个数。
+    pub birth_pruned_data_units: u64,
+    /// R_old 那一版分配记录树的节点数：两棵账求差要多读的节点数（最新那一版的账挂载时已整棵读进内存）。
+    pub target_allocation_record_tree_nodes: u64,
+    /// 最新那一版分配记录树的节点数。
+    pub newest_allocation_record_tree_nodes: u64,
+    /// 最新那一版里分配代 > T_old 的落点按角色族分：某一个节点读不出时剪枝走树漏掉的是它那一族（及以下）的这些。
+    pub newest_born_after_target_by_family: BTreeMap<&'static str, u64>,
+}
+
+fn prototype_family_of(role: Option<&TransactionUnit>) -> &'static str {
+    match role {
+        Some(TransactionUnit::Data(_)) => "data",
+        Some(TransactionUnit::ExtentLowerNode(_)) => "extent_lower",
+        Some(TransactionUnit::ExtentUpperNodeBelowTheRoot(_)) => "extent_upper",
+        Some(TransactionUnit::ExtentRoot) => "extent_root",
+        Some(TransactionUnit::InodeLeafContainer(_)) => "inode_leaf",
+        Some(TransactionUnit::InodeRoot) => "inode_root",
+        Some(TransactionUnit::AllocationTreeNodeBelowTheRoot(_) | TransactionUnit::AllocationTree) => "allocation_tree",
+        Some(TransactionUnit::AccountingTreeNodeBelowTheRoot(_) | TransactionUnit::AccountingTree) => "accounting_tree",
+        Some(TransactionUnit::MappingTreeNodeBelowTheRoot(_) | TransactionUnit::MappingTree) => "mapping_tree",
+        Some(TransactionUnit::TreeTable) => "tree_table",
+        Some(TransactionUnit::InstanceTable | TransactionUnit::InstanceTablePageAfterTheFirst(_)) => "instance_table",
+        None => "unknown_role",
+    }
+}
