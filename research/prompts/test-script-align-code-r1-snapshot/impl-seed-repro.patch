+    match lookup(variable) {
+        None => Ok(default),
+        Some(text) => {
+            text.parse()
+                .map_err(|_not_a_number| ReproductionEnvironmentError::Unrecognized {
+                    variable: variable.to_string(),
+                    value: text.clone(),
+                    recognized: vec!["非负整数".to_string()],
