+impl ExpandUpToWritesPerSegment {
+    /// 从 [`EXPAND_UP_TO_ENVIRONMENT_VARIABLE`] 取；没设用 `default_when_unset`。
+    ///
+    /// # Panics
+    /// 设了而认不出（不是非负整数、空串、不是 UTF-8）：写明变量名与值，不悄悄退回默认（规模变量写错照样跑完、照样退 0，
+    /// 跑的就不是要的那个规模）。
+    #[must_use]
