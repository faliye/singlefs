+        }
+    }
+
+    /// 变量的值（`None` 是没设）换成展开上限。
+    ///
+    /// # Panics
+    /// 设了而不是非负整数：消息带变量名与原值。
+    #[must_use]
+    pub fn from_value_of_the_variable(value: Option<&str>, default_when_unset: usize) -> Self {
+        match value {
+            None => Self(default_when_unset),
+            Some(text) => Self(text.trim().parse::<usize>().unwrap_or_else(|_| {
+                panic!(
+                    "{EXPAND_UP_TO_ENVIRONMENT_VARIABLE}={text:?} 认不出：要写一个非负整数（一段最多几次写就展开），不退回默认的 {default_when_unset}"
+                )
+            })),
+        }
+    }
+
+    /// 一段按这个上限怎么展开。
+    #[must_use]
+    pub fn expansion_of(self, segment: &[usize]) -> Layer0SegmentExpansion {
+        if segment.len() <= self.0 {
+            Layer0SegmentExpansion::EveryProperSubset
+        } else {
+            Layer0SegmentExpansion::NotExpanded
+        }
+    }
+
+    /// 每一段都展开到了（全域）。
+    #[must_use]
+    pub fn covers_every_segment(self, segments: &[Vec<usize>]) -> bool {
+        segments.iter().all(|segment| segment.len() <= self.0)
+    }
+}
