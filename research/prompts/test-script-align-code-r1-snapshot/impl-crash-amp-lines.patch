+        match std::env::var(EXPAND_UP_TO_ENVIRONMENT_VARIABLE) {
+            Ok(text) => Self::from_value_of_the_variable(Some(&text), default_when_unset),
+            Err(std::env::VarError::NotPresent) => Self(default_when_unset),
+            Err(std::env::VarError::NotUnicode(raw)) => panic!(
