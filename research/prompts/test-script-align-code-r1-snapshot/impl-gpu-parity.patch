+//! checker 档模块：无（只测 GPU 对拍用例共用的取卡判定 `common_gpu_adapter`，那一份不在库里）
+//! GPU 对拍用例开跑前的取卡判定（`common_gpu_adapter::decide_gpu_test_start`）分得开两种情形：Vulkan 一个适配器都没枚举出来，
+//! 报「本次未跑」；枚举出 NVIDIA 独显而一张卡都没起来（驱动不对、显存不够），判红。不挂特性：快档（不带 `--features`）里也编进来、跑得到。
+
+mod common_gpu_adapter;
+
+use common_gpu_adapter::{
+    decide_gpu_test_start, not_run_line, AdapterDeviceKind, EnumeratedAdapter, GpuTestStart,
+    NVIDIA_VENDOR_IDENTIFIER,
+};
+
+#[test]
+fn zero_adapters_is_reported_as_not_run_and_an_nvidia_adapter_whose_card_did_not_start_is_red() {
+    match decide_gpu_test_start(&[], 0) {
+        GpuTestStart::NotRunNoGpuAdapter { reason } => {
+            let line = not_run_line("some_gpu_parity_test", &reason);
+            assert!(
+                line.starts_with("NOT_RUN_NO_GPU_ADAPTER test=some_gpu_parity_test reason="),
+                "门禁按这一行的开头认「本次未跑」：{line}"
+            );
+        }
+        start @ (GpuTestStart::RunOnTheFirstUsableCard
+        | GpuTestStart::AdapterPresentButNoCardStarted { .. }) => {
+            panic!("零个适配器要报「本次未跑」，判成了 {start:?}")
+        }
+    }
+    let nvidia_discrete_gpu = EnumeratedAdapter {
+        vendor_identifier: NVIDIA_VENDOR_IDENTIFIER,
+        device_kind: AdapterDeviceKind::DiscreteGpu,
+    };
+    match decide_gpu_test_start(&[nvidia_discrete_gpu], 0) {
+        GpuTestStart::AdapterPresentButNoCardStarted { .. } => {}
+        start @ (GpuTestStart::RunOnTheFirstUsableCard
+        | GpuTestStart::NotRunNoGpuAdapter { .. }) => {
+            panic!("有 NVIDIA 独显适配器而一张卡都没起来要判红，不算「没卡」；判成了 {start:?}")
+        }
+    }
+}
