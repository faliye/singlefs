+#[cfg(test)]
+mod sonnet_k5_differential {
+    use super::*;
+    use crate::block_device::FileBackedBlockDevice;
+
+    fn lcg(state: &mut u64) -> u64 {
+        *state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        *state >> 33
+    }
+
+    fn same_error(a: &Result<(), BlockDeviceError>, b: &Result<(), BlockDeviceError>) -> bool {
+        match (a, b) {
+            (Ok(()), Ok(())) => true,
+            (Err(BlockDeviceError::OutOfRange { offset: o1, length: l1, device_size: d1 }), Err(BlockDeviceError::OutOfRange { offset: o2, length: l2, device_size: d2 })) => o1 == o2 && l1 == l2 && d1 == d2,
+            (Err(BlockDeviceError::Unaligned { offset: o1, length: l1, physical_block_size: p1 }), Err(BlockDeviceError::Unaligned { offset: o2, length: l2, physical_block_size: p2 })) => o1 == o2 && l1 == l2 && p1 == p2,
+            _ => false,
+        }
+    }
+
+    #[test]
+    fn rehearsal_device_agrees_with_the_file_backend_on_every_request() {
+        let dir = std::env::temp_dir();
+        let mut total = 0u64;
+        let mut errors = 0u64;
+        for (pbs, size, seed) in [(512u32, 64 * 1024u64, 1u64), (4096, 128 * 1024, 2), (512, 4096, 3), (4096, 4096, 4), (512, 512, 5)] {
+            let p_ref = dir.join(format!("sonnet-k5-ref-{}-{pbs}-{size}.img", std::process::id()));
+            let p_sub = dir.join(format!("sonnet-k5-sub-{}-{pbs}-{size}.img", std::process::id()));
+            let mut reference = FileBackedBlockDevice::create_image_file_exclusively(&p_ref, size, PhysicalBlockSizeInBytes(pbs)).unwrap();
+            let mut under = FileBackedBlockDevice::create_image_file_exclusively(&p_sub, size, PhysicalBlockSizeInBytes(pbs)).unwrap();
+            // 起始内容：两块盘写同样的随机字节
+            let mut st = seed;
+            let init: Vec<u8> = (0..size).map(|_| lcg(&mut st) as u8).collect();
+            reference.write_at(DeviceOffsetInBytes(0), &init, WriteDurability::Plain).unwrap();
+            under.write_at(DeviceOffsetInBytes(0), &init, WriteDurability::Plain).unwrap();
+            let mut subject = DeviceKeepingWritesInMemory::over_the_disk(&under);
+            assert_eq!(subject.probe_physical_block_size().0, pbs);
+            assert_eq!(subject.size_in_bytes(), size);
+            let pick_offset = |st: &mut u64| -> u64 {
+                match lcg(st) % 8 {
+                    0 => lcg(st) % (size + 2 * u64::from(pbs)),
+                    1 => u64::MAX - lcg(st) % 1024,
+                    2 => size,
+                    3 => size.saturating_sub(u64::from(pbs)),
+                    _ => (lcg(st) % (size / u64::from(pbs) + 1)) * u64::from(pbs),
+                }
+            };
+            let pick_len = |st: &mut u64, offset: u64| -> u64 {
+                match lcg(st) % 8 {
+                    0 => 0,
+                    1 => lcg(st) % (2 * size),
+                    2 => u64::MAX - lcg(st) % 16,
+                    3 => (size - offset.min(size)) / u64::from(pbs) * u64::from(pbs),
+                    4 => u64::from(pbs),
+                    _ => (lcg(st) % (size / u64::from(pbs) + 2)) * u64::from(pbs),
+                }
+            };
+            for _ in 0..20_000 {
+                let op = lcg(&mut st) % 3;
+                let offset = pick_offset(&mut st);
+                let mut len = pick_len(&mut st, offset);
+                total += 1;
+                match op {
+                    0 => {
+                        if len > 4 * size { len %= 4 * size; }
+                        let n = usize::try_from(len).unwrap();
+                        let mut a = vec![0xAAu8; n];
+                        let mut b = vec![0xAAu8; n];
+                        let ra = reference.read_at(DeviceOffsetInBytes(offset), &mut a);
+                        let rb = subject.read_at(DeviceOffsetInBytes(offset), &mut b);
+                        assert!(same_error(&ra, &rb), "read {offset} {len}: {ra:?} vs {rb:?}");
+                        if ra.is_ok() { assert_eq!(a, b, "read {offset} {len} content"); } else { errors += 1; }
+                    }
+                    1 => {
+                        if len > 4 * size { len %= 4 * size; }
+                        let n = usize::try_from(len).unwrap();
+                        let bytes: Vec<u8> = (0..n).map(|_| lcg(&mut st) as u8).collect();
+                        let ra = reference.write_at(DeviceOffsetInBytes(offset), &bytes, WriteDurability::Plain);
+                        let rb = subject.write_at(DeviceOffsetInBytes(offset), &bytes, WriteDurability::ForceUnitAccess);
+                        assert!(same_error(&ra, &rb), "write {offset} {len}: {ra:?} vs {rb:?}");
+                        if ra.is_err() { errors += 1; }
+                    }
+                    _ => {
+                        if len > 4 * size && len < u64::MAX - 100 { len %= 4 * size; }
+                        let ra = reference.write_zeroes_at(DeviceOffsetInBytes(offset), len);
+                        let rb = subject.write_zeroes_at(DeviceOffsetInBytes(offset), len);
+                        assert!(same_error(&ra, &rb), "zeroes {offset} {len}: {ra:?} vs {rb:?}");
+                        if ra.is_err() { errors += 1; }
+                    }
+                }
+                if lcg(&mut st) % 50 == 0 {
+                    assert!(subject.barrier().is_ok());
+                }
+            }
+            // 底下那块盘一个字节没动
+            let mut after = vec![0u8; usize::try_from(size).unwrap()];
+            under.read_at(DeviceOffsetInBytes(0), &mut after).unwrap();
+            assert_eq!(after, init, "底下那块盘被写过");
+            // 整盘读回一致
+            let mut a = vec![0u8; usize::try_from(size).unwrap()];
+            let mut b = a.clone();
+            reference.read_at(DeviceOffsetInBytes(0), &mut a).unwrap();
+            subject.read_at(DeviceOffsetInBytes(0), &mut b).unwrap();
+            assert_eq!(a, b, "整盘读回");
+            let _ = std::fs::remove_file(&p_ref);
+            let _ = std::fs::remove_file(&p_sub);
+        }
+        eprintln!("SONNET_K5 requests={total} refused={errors}");
+    }
+}
