+            Err(MountError::RollbackFloorCeilingRootRingSlotStillBadAfterOneReread { ring_slot, .. })
+                if ring_slot == session.ring_slot
+        ),
+        "知道住着根的槽重读仍读不出就拒：{refused:?}"
+    );
+    assert_eq!(
