+        unit_head_read_by_sweep(&head_bytes_at(&pool.image, forged.data_unit))
+            .is_some_and(|head| head.writer_instance == InstanceGeneration(2)),
+        "前提：那个数据单元第一个槽里还是它自己的头（没被复用）"
+    );
+    assert!(
