+        session.txg_recorded_as_unreadable_at_mount(),
+        Some(CheckpointTxg(TXG_OF_THE_VALID_ROOT_UNREADABLE_AT_MOUNT)),
+        "重读读到自证不过：照旧按能住的最大 txg 18 记着"
+    );
+    assert_eq!(
+        violations_of(&session.image_now()),
+        Vec::<String>::new(),
