+fn birth_txg_verdict(image: &MemoryPool) -> InvariantVerdict {
+    check_pool_image(image)
+        .into_iter()
+        .find(|(invariant, _)| {
+            *invariant == TREE_IDENTIFIER_BIRTH_TXG_AGREES_ACROSS_EVERY_READABLE_ROOT
+        })
+        .expect("池级 checker 的清单里有 I-9.28")
+        .1
+}
