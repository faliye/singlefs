+pub fn make_filesystem_drawing_the_filesystem_identifier<Device: BlockDevice>(
+    region_devices: [DeviceIdentity; 3],
+    geometry: SystemImmutableSizes,
+    devices: &mut [(DeviceIdentity, Device)],
