# rerun.sh 把 @REPO@ 换成攻方仓副本的路径后写成 Cargo.toml。
[package]
name = "opus-b29-crash"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
singlefs-checker = { path = "@REPO@/crates/singlefs-checker" }
singlefs-checker-tier = { path = "@REPO@/crates/singlefs-checker-tier" }
singlefs-core = { path = "@REPO@/crates/singlefs-core" }
singlefs-format = { path = "@REPO@/crates/singlefs-format" }
singlefs-harness = { path = "@REPO@/crates/singlefs-harness" }

[workspace]

[profile.release]
debug = false
