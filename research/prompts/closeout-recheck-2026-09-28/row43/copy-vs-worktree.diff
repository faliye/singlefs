+/// ROW43-PROBE（调查员副本）：环里有没有按最新根的实例表判被抛弃的根。
+#[must_use]
+pub fn row43_probe_any_ring_root_abandoned(image: &dyn PoolReader) -> Option<bool> {
+    let system_configuration = choose_system_configuration(image).ok()?;
+    let roots: Vec<RootRecord> = readable_roots(
+        image,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    );
+    let newest_root = choose_root(image, &system_configuration)?;
+    let newest_table = instance_table_of_root(image, &newest_root)?;
+    Some(roots.iter().any(|root| {
+        newest_table
+            .rows
+            .iter()
             .any(|row| row.instance == root.instance && root.checkpoint_txg > row.selected_root_txg)
     }))
 }
