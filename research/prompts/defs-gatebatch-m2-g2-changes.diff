+  local marker_path
+  if [[ "$layer0_shard_mode" == standalone ]] \
+      && marker_path="$(python3 "$admission_module" crash-case-marker-path "$tree_root" "$case_key" "$local_fingerprint")" && [[ -n "$marker_path" ]]; then
+    rm -f -- "${marker_path:?}"
+  fi
+  fail "$1" "$2"
