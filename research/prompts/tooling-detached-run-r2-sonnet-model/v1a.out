## 基线 主agent 起 start
   agent=主agent cwd=/tmp/claude-1000/tooling-detached-run-r2-sonnet/repo
   cmd: bash research/scripts/detached-run.sh start --label m -- sleep 1
   bash: rc=0  
   heavy: rc=0  
## 基线 子agent 起 start
   agent=clerk cwd=/tmp/claude-1000/tooling-detached-run-r2-sonnet/repo
   cmd: bash research/scripts/detached-run.sh start --label m -- sleep 1
   bash: rc=2  ✗ clerk 用 research/scripts/detached-run.sh 起或停脱离会话的长跑（认出的调用：research/scripts/detached-run.sh start --label m）：这个入口只给主 agent，经它起的活不在你的进程树里，你交回之后没人认领
   heavy: rc=0  
## 主agent worktree+主仓绝对路径+前缀
   agent=主agent cwd=/tmp/claude-1000/tooling-detached-run-r2-sonnet/repo
   cmd: cd /tmp/claude-1000/tooling-detached-run-r2-sonnet/wt && SINGLEFS_HEAVY_TESTS=user-request nice -n 19 bash /home/fy5090/code/singlefs/research/scripts/detached-run.sh start --label bm-local-2026-10-01 --log /tmp/bm.log -- python3 research/scripts/broad-mutation.py --home /tmp/h
   bash: rc=0  
   heavy: rc=0  
## 主agent 带日期label 无前缀 起 cargo test --all
   agent=主agent cwd=/tmp/claude-1000/tooling-detached-run-r2-sonnet/repo
   cmd: bash /home/fy5090/code/singlefs/research/scripts/detached-run.sh start --label bm-2026-10-01 -- cargo test --all
   bash: rc=0  
   heavy: rc=2  ✗ 重型测试被拒：cargo test 带 --workspace / --all（全量测试）：主 agent 跑「全量测试」要带 SINGLEFS_HEAVY_TESTS=commit 或 =user-request，这一条没带
## 主agent 带日期label =commit 起 cargo test --all
   agent=主agent cwd=/tmp/claude-1000/tooling-detached-run-r2-sonnet/repo
   cmd: SINGLEFS_HEAVY_TESTS=commit bash /home/fy5090/code/singlefs/research/scripts/detached-run.sh start --label bm-2026-10-01 -- cargo test --all
   bash: rc=0  
   heavy: rc=0  
## 主agent 无前缀 起 broad-mutation.py
