+/// 候选 (d)（unreadable-at-mount-r1）：「被抛弃根所在实例写过的槽」取自 journal 环：这个实例读得出的每条记录点名的每个单元的两条位置条目。
+/// 读不出的记录、被环绕掉的记录点名的单元不在其内。
+#[allow(
+    clippy::ptr_arg,
+    reason = "scan_journal 走 &dyn PoolReader，要一个有大小的读者：Vec 实现了它、切片不能转成 dyn"
+)]
+fn placements_named_by_the_records_of_the_instance<Device: BlockDevice>(
+    devices: &Vec<(DeviceIdentity, Device)>,
+    unit_area_start: UnitAreaStart,
+    system_configuration: &crate::system_configuration::SystemConfiguration,
+    instance: InstanceGeneration,
+) -> Vec<(DeviceIdentity, crate::address::SlotNumber, u64)> {
+    let mut seen: BTreeSet<(u32, u64)> = BTreeSet::new();
+    let mut placements = Vec::new();
+    for record in scan_journal(devices, system_configuration)
+        .values()
+        .filter(|record| record.instance == instance)
+    {
+        for named in &record.named {
+            let span_slots = match named.unit_class {
+                crate::unit::UNIT_CLASS_DATA | crate::unit::UNIT_CLASS_PACKED => 2,
+                _ => 1,
+            };
+            for location in &named.locations {
+                if placement_lies_in_the_unit_area_of_its_device(
+                    devices,
+                    unit_area_start,
+                    location.device,
+                    location.slot,
+                    span_slots,
+                )
+                .is_err()
+                {
+                    continue;
+                }
+                if seen.insert((location.device.0, location.slot.0)) {
+                    placements.push((location.device, location.slot, span_slots));
+                }
+            }
+        }
+    }
+    placements
+}
