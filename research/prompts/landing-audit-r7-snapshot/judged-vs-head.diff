+def load_pinned(path: str, expected: str, module_name: str) -> types.ModuleType:
+    """按路径载入（不改它、不写 .pyc）；sha256 不对就拒（只差登记过的搬迁也认：reuse_library 的 pinned_sha256_now）。"""
+    if reuse.pinned_sha256_now(path, expected) is None:
