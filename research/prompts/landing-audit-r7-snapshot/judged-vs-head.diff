+def fake_row_into(row_directory: str, identity: str, device_exit: int = 0, executor: bool = True) -> dict[str, str]:
+    """假驱动把一行写进行输出根下的 row-<n>/（row-result.tsv 最后写，同真驱动）。"""
+    os.makedirs(os.path.dirname(row_directory), exist_ok=True)
