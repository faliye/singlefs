+def prompt_label_paths(prompt, label):
+    """提示里「<label>：<路径>」那几行的路径（去掉反引号与句末标点，取第一个词）。"""
+    paths = []
+    for match in re.finditer(PROMPT_LABEL_LINE_START + re.escape(label) + r"[*\s]*[：:][*\s]*(\S+)", prompt, re.M):
+        value = match.group(1).strip("`'\"").rstrip("。，；：、.,;:")
+        if value:
+            paths.append(value)
+    return paths
