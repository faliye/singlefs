+# ── 读数相等（第 11.5 节「读数相等」）──
+def lines_without_the_last_column(path: str) -> bytes:
+    """impl-verdicts.tsv 去掉耗时那一列（同 Z1，segment_one_comparator.py 的同名一比）。"""
