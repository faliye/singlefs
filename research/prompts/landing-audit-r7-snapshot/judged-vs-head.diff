+def sizes(paths):
+    if not paths:
+        return {}
+    try:
+        completed = subprocess.run(["timeout", str(DU_TIMEOUT_SECONDS), "du", "-sh", "--", *paths], capture_output=True, text=True, check=False)
+    except OSError:
+        return {}
+    measured = {}
+    for line in completed.stdout.splitlines():
+        size, separator, path = line.partition("\t")
+        if separator:
+            measured[path] = size
+    return measured
