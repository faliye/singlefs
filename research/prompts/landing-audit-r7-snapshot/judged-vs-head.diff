+    def quarantine(self, entry: str) -> str:
+        os.makedirs(self.quarantine_directory, exist_ok=True)
+        destination = os.path.join(self.quarantine_directory, f"{os.path.basename(entry)}-{time.time_ns()}")
+        os.rename(entry, destination)
+        return destination
