+    hypothetical_change: str | None = None
+
+    def changed(self, line: str) -> str:
+        return f"{line.split(' ', 1)[0]} changed-{sha256_bytes(line.encode('utf-8'))[:16]}" if line.split(" ", 1)[0] == self.hypothetical_change else line
