+    return good, f"合判法的条目：退 {good_code}，产物是条目的硬链接 {linked}，记下 {states}；不合判法的：退 {red_code}"
+
+
+SELFTEST_CELLS = {"reuse-e2e": cell_reuse_end_to_end, "unit-script-fetch": cell_unit_script_fetch, "h31-refused": cell_h31_refused,
