+def parse_assignments(text: str) -> dict[str, str]:
+    """--emit-hosts 打的 KEY=<printf %q 的值> 一行一个。"""
+    values = {}
+    for line in text.splitlines():
+        if "=" not in line:
+            continue
+        key, quoted = line.split("=", 1)
+        words = shlex.split(quoted)
+        values[key] = words[0] if words else ""
+    return values
+
