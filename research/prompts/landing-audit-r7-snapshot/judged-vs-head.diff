+def files_under(repo: str, directory: str) -> list[str]:
+    found = []
+    for root, _, files in os.walk(os.path.join(repo, directory)):
+        found += [os.path.relpath(os.path.join(root, name), repo) for name in files]
+    return sorted(found)
