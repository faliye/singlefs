+# ── 运行目录
+def run_roots():
+    home = os.environ.get("SINGLEFS_CRASH_AMPLIFICATION_HOME")
+    if home:
+        return [os.path.join(home, "runs")]
+    return sorted(glob.glob(os.path.expanduser("~/.local/share/singlefs/crash-amplification*/runs")))
