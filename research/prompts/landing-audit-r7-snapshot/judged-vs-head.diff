+def downstream(units: dict[str, Unit], names: set[str]) -> set[str]:
+    """names 连同依赖它们的全部单元（传递）。"""
+    found = set(names)
+    changed = True
+    while changed:
+        changed = False
+        for unit in units.values():
+            if unit.name not in found and any(dep in found for dep in unit.deps):
+                found.add(unit.name)
+                changed = True
+    return found
+
