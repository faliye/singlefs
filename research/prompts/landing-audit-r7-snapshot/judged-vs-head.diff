+# device_step <步名> <内存上限> <装置的路径> <装置参数…>：装置一趟，结果行与计时行各落一份新产物；交回装置的退出码（250–254 是包装自己的结局，直接停）
+device_step() {
+  local name=$1 cap=$2 binary=$3; shift 3
+  local product timing code
+  product=$(product_of "$name"); timing=$(timing_of "$name")
