+def slot_wrapper_bytes(host: Host) -> int:
+    """一槽在那台 slice 账上的量：本机 6G；别的台多一层 multi-host-run.sh 的外层包装 4G。"""
+    return SLOT_DEVICE_MEMORY_BYTES + (0 if host.is_local else capacity_bytes(PEER_OUTER_MEMORY_CAP))
+
