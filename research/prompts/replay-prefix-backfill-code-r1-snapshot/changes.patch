@@ -0,0 +1,136 @@
+use singlefs_replay_prefix::gpu_gc_proofs::*;
+
+const EDGES: [u64; 9] = [
+    0,
+    1,
+    3,
+    4,
+    5,
+    u32::MAX as u64,
+    1u64 << 32,
+    u64::MAX - 3,
+    u64::MAX,
+];
+
+#[test]
+fn gpu_budget_arithmetic_matches_a_u128_reference_at_full_width() {
+    for input in EDGES {
+        let aligned = u128::from(input).max(4).div_ceil(4) * 4;
+        assert_eq!(checked_gpu_input_bytes(input), u64::try_from(aligned).ok());
+        for entries in EDGES {
+            for per_entry in EDGES {
+                for fixed in EDGES {
+                    let expected = (u128::from(entries) * u128::from(per_entry))
+                        .checked_add(aligned)
+                        .and_then(|bytes| bytes.checked_add(u128::from(fixed)))
+                        .and_then(|bytes| u64::try_from(bytes).ok());
+                    assert_eq!(
+                        checked_gpu_chunk_bytes(input, entries, per_entry, fixed),
+                        expected
+                    );
+                }
+            }
+        }
+    }
+    for limit in EDGES {
+        for held in EDGES {
+            assert_eq!(
+                remaining_gpu_memory(limit, held),
+                limit.saturating_sub(held)
+            );
+        }
+    }
+}
+
+#[test]
+fn gpu_slices_scans_and_independent_totals_match_wide_arithmetic() {
+    for total in EDGES {
+        for start in EDGES.into_iter().filter(|start| *start <= total) {
+            for capacity in EDGES.into_iter().filter(|capacity| *capacity > 0) {
+                let expected = u128::from(total).min(u128::from(start) + u128::from(capacity));
+                assert_eq!(
+                    u128::from(next_gpu_record_slice_end(start, total, capacity)),
+                    expected
+                );
+            }
+        }
+    }
+    for slot in EDGES {
+        for span in EDGES {
+            for start in EDGES {
+                for end in EDGES {
+                    for same_device in [false, true] {
+                        for released in [false, true] {
+                            let expected = same_device
+                                && !released
+                                && (start..end).contains(&slot)
+                                && u128::from(slot) + u128::from(span) <= u128::from(end);
+                            assert_eq!(
+                                gpu_record_is_in_scan_region(
+                                    same_device,
+                                    released,
+                                    slot,
+                                    span,
+                                    start,
+                                    end
+                                ),
+                                expected
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+    for walking in EDGES {
+        for searching in EDGES {
+            for next_walking in EDGES {
+                for next_searching in EDGES {
+                    let left = u64::try_from(u128::from(walking) + u128::from(next_walking)).ok();
+                    let right =
+                        u64::try_from(u128::from(searching) + u128::from(next_searching)).ok();
+                    assert_eq!(
+                        checked_live_slot_totals(walking, searching, next_walking, next_searching),
+                        left.zip(right)
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn gpu_readback_rejects_unwritten_words_and_preserves_both_halves() {
+    for value in EDGES {
+        let bytes = value.to_le_bytes();
+        let low = u32::from_le_bytes(bytes[..4].try_into().unwrap());
+        let high = u32::from_le_bytes(bytes[4..].try_into().unwrap());
+        for verdict in [0, 1, 2, u32::MAX] {
+            assert_eq!(
+                decoded_gpu_live_slots(low, high, verdict),
+                (verdict == 1).then_some(value)
+            );
+        }
+    }
+}
+
+#[test]
+fn gpu_reconciliation_matches_the_two_round_history_rule() {
+    for history in 0u32..(1 << 12) {
+        let mut previous_disagreement = false;
+        let mut counter = 0;
+        for round in 0..12 {
+            let agree = history & (1 << round) != 0;
+            let expected_cpu = !agree && previous_disagreement;
+            let step = reconcile_gpu_entry(counter, agree);
+            assert_eq!(step.confirmed, agree);
+            assert_eq!(step.ask_cpu, expected_cpu);
+            previous_disagreement = !agree && !expected_cpu;
+            assert_eq!(step.uncertain_rounds, u32::from(previous_disagreement));
+            counter = step.uncertain_rounds;
+        }
+    }
+    let invalid_old_count = reconcile_gpu_entry(u32::MAX, false);
+    assert!(invalid_old_count.ask_cpu);
+    assert_eq!(invalid_old_count.uncertain_rounds, 0);
+}
diff --git a/crates/singlefs-replay-prefix/tests/gpu_gc_capacity_matches_independent_reference.rs b/crates/singlefs-replay-prefix/tests/gpu_gc_capacity_matches_independent_reference.rs
new file mode 100644
index 000000000..37b3f549d
--- /dev/null
+++ b/crates/singlefs-replay-prefix/tests/gpu_gc_capacity_matches_independent_reference.rs
@@ -0,0 +1,214 @@
+use singlefs_replay_prefix::gpu_gc_capacity_proofs::*;
+
+const EDGES: [u64; 10] = [0, 1, 3, 4, 5, 16, 63, 1 << 32, u64::MAX - 3, u64::MAX];
+
+fn reference_fits(input: u64, entries: u64, capacity: &GpuChunkCapacity) -> bool {
+    let input_bytes = u128::from(input).max(1).div_ceil(4) * 4;
+    if input_bytes > u128::from(capacity.binding_bytes)
+        || u128::from(entries) * u128::from(capacity.entry_buffer_bytes)
+            > u128::from(capacity.binding_bytes)
+        || entries > capacity.dispatch_entries
+    {
+        return false;
+    }
+    capacity.memory_limit.is_none_or(|limit| {
+        (u128::from(entries) * u128::from(capacity.bytes_per_entry))
+            .checked_add(input_bytes)
+            .and_then(|total| total.checked_add(u128::from(capacity.fixed_bytes)))
+            .is_some_and(|total| total <= u128::from(limit))
+    })
+}
+
+#[test]
+fn chunk_admission_and_extension_match_full_width_arithmetic() {
+    for binding in EDGES {
+        for entry_bytes in EDGES {
+            for limit in [None, Some(0), Some(100), Some(u64::MAX)] {
+                let capacity = GpuChunkCapacity {
+                    fixed_bytes: 16,
+                    bytes_per_entry: 40,
+                    entry_buffer_bytes: entry_bytes,
+                    binding_bytes: binding,
+                    dispatch_entries: 3,
+                    memory_limit: limit,
+                };
+                for input in EDGES {
+                    for entries in EDGES {
+                        assert_eq!(
+                            gpu_chunk_fits(input, entries, &capacity),
+                            reference_fits(input, entries, &capacity)
+                        );
+                        for additional in [0, 1, 4, u64::MAX] {
+                            let expected =
+                                u64::try_from(u128::from(input) + u128::from(additional))
+                                    .ok()
+                                    .filter(|total| reference_fits(*total, entries, &capacity));
+                            assert_eq!(
+                                extended_gpu_chunk_input(input, additional, entries, &capacity),
+                                expected
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let unlimited = GpuChunkCapacity {
+        fixed_bytes: u64::MAX,
+        bytes_per_entry: u64::MAX,
+        entry_buffer_bytes: 0,
+        binding_bytes: 4,
+        dispatch_entries: 2,
+        memory_limit: None,
+    };
+    // 无限额仍检查每个绑定和派发，但不把虚构的有限总额加进准入条件。
+    assert!(gpu_chunk_fits(1, 2, &unlimited));
+}
+
+#[test]
+fn largest_piece_matches_exhaustive_search_and_is_maximal() {
+    for binding in 0..=40 {
+        for fixed in [0, 1, 16, 40, u64::MAX] {
+            for per_entry in [0, 1, 4, 40, u64::MAX] {
+                for entry_buffer in [0, 4, 64] {
+                    for dispatch in [0, 1] {
+                        for limit in [
+                            None,
+                            Some(0),
+                            Some(3),
+                            Some(4),
+                            Some(20),
+                            Some(100),
+                            Some(u64::MAX),
+                        ] {
+                            let capacity = GpuChunkCapacity {
+                                fixed_bytes: fixed,
+                                bytes_per_entry: per_entry,
+                                entry_buffer_bytes: entry_buffer,
+                                binding_bytes: binding,
+                                dispatch_entries: dispatch,
+                                memory_limit: limit,
+                            };
+                            let expected =
+                                (1..=binding).rfind(|input| reference_fits(*input, 1, &capacity));
+                            assert_eq!(
+                                largest_gpu_piece_input(&capacity),
+                                expected,
+                                "binding={binding} fixed={fixed} per_entry={per_entry} entry_buffer={entry_buffer} dispatch={dispatch} limit={limit:?}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let capacity = GpuChunkCapacity {
+        fixed_bytes: 0,
+        bytes_per_entry: 0,
+        entry_buffer_bytes: 0,
+        binding_bytes: u64::MAX,
+        dispatch_entries: 1,
+        memory_limit: None,
+    };
+    assert_eq!(largest_gpu_piece_input(&capacity), Some(u64::MAX - 3));
+    assert!(!gpu_chunk_fits(u64::MAX - 2, 1, &capacity));
+}
+
+#[test]
+fn holds_releases_and_waits_preserve_the_exact_ledger() {
+    for held in EDGES {
+        for bytes in EDGES {
+            for limit in [None, Some(0), Some(100), Some(u64::MAX)] {
+                for pending in [false, true] {
+                    let sum = u128::from(held) + u128::from(bytes);
+                    let expected = if pending || limit.is_some_and(|bound| sum > u128::from(bound))
+                    {
+                        None
+                    } else {
+                        u64::try_from(sum).ok()
+                    };
+                    assert_eq!(
+                        checked_gpu_memory_hold(held, bytes, pending, limit),
+                        expected
+                    );
+                    if let Some(total) = expected {
+                        assert_eq!(checked_gpu_memory_release(total, bytes), Some(held));
+                        for _ in 0..3 {
+                            assert_eq!(
+                                gpu_bytes_after_submission_wait(total, bytes, false),
+                                Some(total)
+                            );
+                        }
+                        assert_eq!(
+                            gpu_bytes_after_submission_wait(total, bytes, true),
+                            Some(held)
+                        );
+                    }
+                }
+            }
+            let release = if bytes > held {
+                None
+            } else {
+                Some(held - bytes)
+            };
+            assert_eq!(checked_gpu_memory_release(held, bytes), release);
+            assert_eq!(gpu_bytes_after_submission_wait(held, bytes, true), release);
+            assert_eq!(
+                gpu_bytes_after_submission_wait(held, bytes, false),
+                (bytes <= held).then_some(held)
+            );
+        }
+    }
+}
+
+#[test]
+fn memory_caps_never_expand_and_allocation_failure_makes_progress() {
+    for available in EDGES {
+        for previous in [None, Some(0), Some(17), Some(u64::MAX)] {
+            let actual = tightened_gpu_memory_limit(previous, available);
+            assert_eq!(actual, previous.unwrap_or(u64::MAX).min(available));
+        }
+        let mut cap = available;
+        let mut rounds = 0;
+        while cap > 0 {
+            let next = gpu_memory_cap_after_allocation_failure(cap);
+            assert_eq!(u128::from(next), u128::from(cap) / 2);
+            assert!(next < cap);
+            cap = next;
+            rounds += 1;
+        }
+        assert!(rounds <= 64);
+        assert_eq!(gpu_memory_cap_after_allocation_failure(0), 0);
+    }
+}
+
+#[test]
+fn mapping_buffers_and_dispatch_cover_their_exact_full_width_sizes() {
+    for entries in EDGES {
+        for locations in EDGES {
+            let entry = 56 * u128::from(entries.max(1));
+            let location = 16 * u128::from(locations.max(1));
+            let index = 4 * u128::from(entries.max(1));
+            let expected = u64::try_from(entry + location + index).ok().map(|total| {
+                (
+                    total,
+                    u64::try_from(entry.max(location).max(index)).unwrap(),
+                )
+            });
+            assert_eq!(
+                checked_gpu_mapping_table_bytes(entries, locations),
+                expected
+            );
+        }
+    }
+    assert_eq!(checked_gpu_mapping_table_bytes(0, 0), Some((76, 56)));
+    for entries in [0, 1, 63, 64, 65, u32::MAX - 1, u32::MAX] {
+        for per_group in [1, 2, 3, 32, 64, 256, u32::MAX] {
+            let expected = u64::from(entries).div_ceil(u64::from(per_group));
+            assert_eq!(
+                u64::from(gpu_workgroups_for_entries(entries, per_group)),
+                expected
+            );
+        }
+    }
+}
