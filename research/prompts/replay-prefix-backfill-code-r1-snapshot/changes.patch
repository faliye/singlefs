+/// G17：各后台阶段共享显存预算；已占超限时不回绕，正的新增分配必在总限内。
+#[allow(clippy::implicit_saturating_sub, reason = "被验函数体与 ensures 的分支逐字对照，不换成饱和减")]
+pub fn remaining_gpu_memory(limit: u64, held: u64) -> (remaining: u64)
