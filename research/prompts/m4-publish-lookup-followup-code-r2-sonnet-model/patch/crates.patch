+        singlefs_core_build_script::FEATURES_OF_THIS_PACKAGE_WITH_THEIR_CFG
+            .iter()
+            .map(|(feature, _)| (*feature).to_string())
+            .collect();
+    names_in_the_table.sort();
+    assert_eq!(
