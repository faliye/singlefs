+    key = (registration, product)
+    if key in seen:
+        problems.append(f"{where}：和第 {seen[key]} 行是同一条（登记出处与留存产物名都相同）：{product}")
+        continue
+    seen[key] = number
+    registered.append((number, experiment, registration, unit, unit_source, product, rerun))
+
+replay = replay_table(replay_path)
+driver_rows = 0
+none_rows = []
+for number, experiment, registration, unit, unit_source, product, rerun in registered:
+    where = f"{units_name} 第 {number} 行（{experiment}「{unit}」）"
+    if "comparison-registration-unchecked" not in broken and not os.path.isfile(registration):
+        problems.append(f"{where}：登记出处不在：{registration}")
+    if "comparison-unit-unchecked" not in broken:
+        text = source_text(unit_source)
+        if text is None:
+            problems.append(f"{where}：单元表出处不在：{unit_source}")
+        else:
+            count = text.count(unit) if "comparison-unit-substring" in broken else text.count(f'"{unit}"')
+            if count == 0:
+                problems.append(f"{where}：单元名「{unit}」在 {unit_source} 里一次都没找到（要作为带双引号的字符串字面量出现）")
+            elif count > 1 and "comparison-unit-count-loose" not in broken:
+                problems.append(f"{where}：单元名「{unit}」在 {unit_source} 里出现 {count} 次，不是恰好一次，指不到唯一一个单元")
+    if rerun.startswith(NONE_PREFIX):
+        none_rows.append((number, (registration, product)))
+        continue
+    driver_rows += 1
+    if replay is None:
+        problems.append(f"{where}：{replay_path} 里读不到复跑表（TABLE=$(cat <<'TSV' 起的那一段）")
+        continue
+    mine = [row for row in replay if row[0] == experiment and row[1] == "@" + rerun]
+    if not mine:
+        if "comparison-driver-unchecked" not in broken:
+            problems.append(f"{where}：{replay_path} 复跑表里没有 {experiment} 的驱动行 @{rerun}")
+    elif "comparison-product-unchecked" not in broken and product not in {row[2] for row in mine}:
+        problems.append(f"{where}：@{rerun} 那一行的产物名是 {'、'.join(sorted({row[2] for row in mine}))}，不是留存产物名 {product}")
+
+# 滞后表：形状、指到复跑写 none: 的行、复跑写 none: 的行都登记、只缩不涨
+lag_problems, lag_keys = [], {}
+if os.path.isfile(lag_path):
+    for number, fields in rows_of(open(lag_path, encoding="utf-8").read()):
+        where = f"{lag_name} 第 {number} 行"
+        if len(fields) != 3 or not all(field.strip() for field in fields):
+            lag_problems.append(f"{where}：不是三列（登记出处、留存产物名、没有复跑行的依据）或有一列是空的：{'<制表符>'.join(fields)[:90]}")
+            continue
+        key = (fields[0].strip(), fields[1].strip())
+        if key in lag_keys:
+            lag_problems.append(f"{where}：和第 {lag_keys[key]} 行是同一条：{key[1]}")
+            continue
+        lag_keys[key] = number
+none_keys = {key for _number, key in none_rows}
+for key, number in sorted(lag_keys.items(), key=lambda item: item[1]):
+    if key not in none_keys:
+        lag_problems.append(f"{lag_name} 第 {number} 行：{key[1]}（{key[0]}）在 {units_name} 里不是复跑写 none: 的行（没登记，或已经补了复跑行，这一行过期了）")
+if "comparison-none-lag-unchecked" not in broken:
+    for number, key in none_rows:
+        if key not in lag_keys:
+            lag_problems.append(f"{units_name} 第 {number} 行：复跑写了 none:，{lag_name} 里没有这一行（登记出处 {key[0]}，留存产物名 {key[1]}）")
+
+baseline_keys = None
+if base:
+    # 「基准里还没有这张表」与「git 取不到基准那一版」分开：后者当成没有基线，只缩不涨就静默不比了
+    listed = subprocess.run(["git", "-c", "core.quotepath=false", "ls-tree", "--name-only", base, "--", lag_path], capture_output=True, text=True)
+    shown = None
+    if listed.returncode != 0:
+        lag_problems.append(f"取不到基准 {base} 里的 {lag_path}（git ls-tree 退 {listed.returncode}：{listed.stderr.strip()[:80]}），只缩不涨没比")
+    elif listed.stdout.strip():
+        shown = subprocess.run(["git", "-c", "core.quotepath=false", "show", f"{base}:{lag_path}"], capture_output=True, text=True)
+        if shown.returncode != 0:
+            lag_problems.append(f"读不出基准 {base} 里的 {lag_path}（git show 退 {shown.returncode}：{shown.stderr.strip()[:80]}），只缩不涨没比")
+            shown = None
+    if shown is not None:
+        baseline_keys = {(fields[0].strip(), fields[1].strip()) for _number, fields in rows_of(shown.stdout) if len(fields) >= 2}
+grown = sorted(set(lag_keys) - baseline_keys) if baseline_keys is not None and "comparison-lag-growth-unchecked" not in broken else []
+
+if problems:
+    print(f"  ✗ {units_path} 里 {len(problems)} 处对不上：")                     # gate-lint:summary
+    for entry in problems:
+        print(f"     {entry}")                                                 # gate-lint:detail
+    print(f"     → 怎么办：列义在 {units_path} 文件头。登记出处写仓内现存路径；单元名照单元表里的字符串字面量逐字抄，要在单元表出处里恰好出现一次；")
+    print(f"               复跑写 scripts/experiment-apparatus/replay.sh 复跑表里的驱动名（不带 @），留存产物名照那一行第 4 列抄；确实没有复跑行的写 none:理由 并进滞后表。")
+if lag_problems:
+    print(f"  ✗ 滞后表 {lag_path} 里 {len(lag_problems)} 处对不上登记表：")        # gate-lint:summary
+    for entry in lag_problems:
+        print(f"     {entry}")                                                 # gate-lint:detail
+    print(f"     → 怎么办：复跑写 none: 的每一行在 {lag_name} 里登记一行三列（登记出处、留存产物名、依据）；那一行补了复跑行（复跑改成驱动名）就删掉滞后行。")
+if grown:
+    print(f"  ✗ 滞后表涨了：这些行基准 {base} 的滞后表里没有：")                  # gate-lint:summary
+    for key in grown:
+        print(f"     {key[1]}（{key[0]}）")                                    # gate-lint:detail
+    print("     → 怎么办：这张表只缩不涨。新登记的比对对象要在 replay.sh 复跑表里加一行驱动行并在复跑列写驱动名，不许加一行滞后把它按下去。")
+if problems or lag_problems or grown:
+    sys.exit(1)
+
+if not registered:
+    print(f"  ⊘ 本次无对象可判：{units_path} 里一行比对对象都没有")
+    sys.exit(77)
+compared = f"与基准 {base} 比没涨" if baseline_keys is not None else "基准里还没有这张表（或不是 git 仓），只缩不涨这一条没比"
+experiments = sorted({row[1] for row in registered})
+print(f"  ✓ 比对对象 {len(registered)} 行（{'、'.join(experiments)}）：登记出处都在，单元名在单元表出处里都恰好出现一次；"
+      f"复跑写驱动名的 {driver_rows} 行在 replay.sh 里都有且产物名相符；复跑写 none 的 {len(none_rows)} 行都登记在 {lag_name} 里，{compared}")
+PY
+}
+
 stage_cells_run "$ROOT"
