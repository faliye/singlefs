// ───────── 正推腿探针（草稿副本里加的，不进仓）：挂载途中二次崩溃按「写前缀」逐个落点判一遍，外加几种底盘面上的整挂载 ─────────

fn probe_bases() -> Vec<(&'static str, MemoryPool, HistoryDeviceWidth)> {
    vec![
        ("after_make_filesystem", pool_after_make_filesystem(), SMALL),
        ("after_one_mount_without_file", pool_after_one_mount_without_file(), SMALL),
        ("after_the_first_file", pool_after_the_first_file(), SMALL),
        ("left_by_an_unmount", pool_left_by_an_unmount(), SMALL),
        ("rebuilt_from_a_record_of_an_overwrite", pool_rebuilt_from_a_record_of_an_overwrite(), SMALL),
        ("mount_raises_the_floor", pool_where_the_mount_raises_the_floor(), HistoryDeviceWidth::UnitAreaOf256Slots),
        ("crashed_right_after_the_unlink_intent", pool_crashed_right_after_the_unlink_intent(), SMALL),
    ]
}

#[test]
fn probe_b26_whole_mount_and_mount_with_publish_on_every_base() {
    for (name, base, width) in probe_bases() {
        let mut scenarios = vec![("mount_alone", mount_alone_on(width, &base))];
        if name != "crashed_right_after_the_unlink_intent" {
            scenarios.push(("mount_and_one_publish", mount_and_one_publish_on(width, &base)));
        }
        for (which, scenario) in scenarios {
            let verdict = scenario.judge();
            let violated: Vec<_> = verdict.violated_fields().iter().map(|v| v.field).collect();
            println!("PROBE_WHOLE base={name} action={which} violated={violated:?}");
        }
    }
}

#[test]
fn probe_b26_second_crash_at_every_write_prefix_of_the_mount_on_every_base() {
    let mut total = 0usize;
    let mut red = 0usize;
    for (name, base, width) in probe_bases() {
        let parameters = width.parameters();
        let stream = SharedStream::retaining_contents();
        let mut devices = devices_of(&base, &parameters, &stream);
        let mounted = mount(&parameters, &mut devices);
        let operations = stream.retained_operations();
        let (writes, _segments, stream_indexes) =
            writes_and_segments_with_stream_indexes(&operations, &width.fixed_geometry());
        let floor_raises = FloorRaisesInTheMountWrites::of_the_mount_output(&mounted.output, &writes);
        let continuation =
            UserVisibleTreeRootPointersOfTheContinuation::of_the_mount_output(&mounted.output);
        let before_the_mount = read_recovery_fields(&base, ComparedVersion::TheRecoveredVersion);
        for landed_writes in 0..=writes.len() {
            let mut second_crash_image = base.clone();
            second_crash_image.apply(&operations[..stream_indexes.get(landed_writes).copied().unwrap_or(operations.len())]);
            let persisted_in_the_mount: Vec<bool> =
                (0..writes.len()).map(|i| i < landed_writes).collect();
            let scenario = JudgedScenario {
                before_the_mount: before_the_mount.clone(),
                after_the_action: read_recovery_fields(&second_crash_image, ComparedVersion::TheRecoveredVersion),
                action: MountTransparencyAction::SecondCrashInsideTheMount(
                    floor_raises.at_a_second_crash(&persisted_in_the_mount),
                ),
                continuation: continuation.clone(),
            };
            let verdict = scenario.judge();
            let violated: Vec<_> = verdict.violated_fields().iter().map(|v| v.field).collect();
            total += 1;
            if !violated.is_empty() {
                red += 1;
                println!("PROBE_SECOND base={name} landed={landed_writes}/{} kind={:?} violated={violated:?}", writes.len(), writes.get(landed_writes.saturating_sub(1)).map(|w| w.kind));
            }
        }
        println!("PROBE_SECOND_BASE_DONE base={name} writes={}", writes.len());
        drop(mounted);
    }
    println!("PROBE_SECOND_TOTAL states={total} red={red}");
}
