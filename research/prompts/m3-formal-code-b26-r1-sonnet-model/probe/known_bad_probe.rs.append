// ───────── 正推腿探针（草稿副本里加的，不进仓）─────────
#[test]
fn probe_b26_allocation_record_tree_unreadable_what_does_i_5_4_say() {
    for (label, slot) in [("root_50249", ALLOCATION_RECORD_TREE_ROOT), ("leaf_50245", 50245u64)] {
        let clean = build_pool("probe-b26-i54").memory_pool();
        let mut image = clean.clone();
        zero_both_copies_of_the_unit(&mut image, slot, 16384);
        println!("PROBE_I54 {label} clean={:?}", verdict(&clean, "I-5.4"));
        println!("PROBE_I54 {label} zeroed={:?}", verdict(&image, "I-5.4"));
        println!("PROBE_I54 {label} zeroed_violated={:?}", violated_invariants(&check_pool_image(&image)));
    }
}

#[test]
fn probe_b26_tree_table_missing_a_kind_other_than_one_to_four() {
    for (label, index, kind) in [
        ("deadlist_entry_6", DEADLIST_TREE_TABLE_ENTRY_INDEX, TREE_KIND_DEADLIST),
        ("logged_operations_entry_10", LOGGED_OPERATIONS_TREE_TABLE_ENTRY_INDEX, TREE_KIND_LOGGED_OPERATIONS),
    ] {
        let clean = build_pool("probe-b26-i916-missing-kind").memory_pool();
        let mut image = clean.clone();
        mutate_unit(
            &mut image,
            TREE_TABLE,
            |bytes| {
                let kind_offset = tree_table_entry_offset(index) + TREE_TABLE_ENTRY_KIND_OFFSET;
                assert_eq!(u16::from_le_bytes([bytes[kind_offset], bytes[kind_offset + 1]]), kind);
                remove_tree_table_entry(bytes, index);
            },
            true,
        );
        let verdicts = check_pool_image(&image);
        println!("PROBE_I916 {label} violated={:?}", violated_invariants(&verdicts));
        println!("PROBE_I916 {label} I-9.16={:?}", verdict(&image, "I-9.16"));
    }
}

#[test]
fn probe_b26_core_writable_mount_on_a_tree_table_missing_the_deadlist_entry() {
    let clean = build_pool("probe-b26-core-missing-kind").memory_pool();
    let mut image = clean.clone();
    mutate_unit(
        &mut image,
        TREE_TABLE,
        |bytes| remove_tree_table_entry(bytes, DEADLIST_TREE_TABLE_ENTRY_INDEX),
        true,
    );
    let stream = SharedStream::new();
    let mut devices = crash_state_devices(&image, &[], &[], &stream);
    let outcome = mount_writable(&parameters(), &mut devices);
    println!(
        "PROBE_CORE writable_mount_outcome={}",
        match &outcome {
            Ok(_) => "Ok".to_string(),
            Err(error) => format!("Err({error:?})"),
        }
    );
    println!("PROBE_CORE checker_violated={:?}", violated_invariants(&check_pool_image(&image)));
}
