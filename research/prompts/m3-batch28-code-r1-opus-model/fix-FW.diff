+/// 攻方 F-W（零轮）：有一份副本头里的类就是 `class`、按那一类的长度读回的整单元校验和对得上。
+fn opus_a_copy_verifies_as(reader: &dyn ImageReader, child: &PointerView, class: MappingKeyUnitClass) -> bool {
+    let Some(unit_bytes) = unit_bytes_of_the_class(class) else {
+        return false;
+    };
+    child.locations.iter().any(|location| {
+        reader
+            .read(location.device, location.slot * SLOT_BYTES, unit_bytes)
+            .is_some_and(|content| {
+                MappingKeyUnitClass::of(content[UNIT_HEADER_CLASS_TAG_OFFSET]) == class
+                    && crc32_castagnoli_table(&content) == location.checksum
+            })
+    })
+}
