== 无开关
h4 install 改名再起	detector=2	heavy=0
h4 mv 改名再起	detector=2	heavy=0
h4 cp 改名再起（旧）	detector=2	heavy=0
h7 cd 之后相对路径	detector=2	heavy=0
h5 heredoc 写出拷贝再起全量(主agent)	detector=0	heavy=2
对照 子agent list 放行	detector=0	heavy=0
