+    let remade =
+        make_filesystem(&parameters, &mut devices).expect("同一个 fsid 在用过的盘上重做 mkfs");
+    assert_eq!(remade.root.checkpoint_txg, CheckpointTxg(0));
+
+    assert_eq!(
