+/// r2 opus 副本上的试改（只在副本上）：SINGLEFS_R2_OPUS_CAPS="记账叶,记账内,映射叶,映射内" 让每个新开的写入口（含挂载里那个）用压小的容量。
+fn r2_opus_capacities_from_the_environment() -> CodeTwoTreeNodeCapacities {
+    match std::env::var("SINGLEFS_R2_OPUS_CAPS") {
+        Ok(text) => {
+            let v: Vec<usize> = text.split(',').map(|x| x.trim().parse().expect("数")).collect();
+            CodeTwoTreeNodeCapacities::CappedForTests {
+                accounting: CodeTwoTreeNodeCapacity { leaf_entries: v[0], internal_entries: v[1] },
+                central_mapping: CodeTwoTreeNodeCapacity { leaf_entries: v[2], internal_entries: v[3] },
+            }
+        }
+        Err(_) => CodeTwoTreeNodeCapacities::FromTheNodeFormat,
+    }
+}
+
+/// r2 opus 副本上的试改：SINGLEFS_R2_OPUS_NAMED=n 让每个新开的写入口一条记录只装 n 个点名项。
+fn r2_opus_named_from_the_environment() -> JournalRecordNamedEntryCapacity {
+    match std::env::var("SINGLEFS_R2_OPUS_NAMED") {
+        Ok(text) => JournalRecordNamedEntryCapacity::CappedForTests {
+            named_entries_per_record: text.trim().parse().expect("数"),
+        },
+        Err(_) => JournalRecordNamedEntryCapacity::FromTheRecordFormat,
+    }
+}
