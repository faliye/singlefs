+fn seed540096_probe_highest_journal_instance<Device: BlockDevice>(
+    pool: &PoolWriter<'_, Device>,
+) -> InstanceGeneration {
+    use crate::recovery::PoolReader;
+    let reader: &[(DeviceIdentity, Device)] = &*pool.devices;
+    let expected_filesystem_identifier =
+        crate::unit::unit_filesystem_identifier(&pool.parameters.filesystem_identifier);
+    let ring_start = DeviceOffsetInBytes(
+        singlefs_format::JOURNAL_RING_START_SLOT * singlefs_format::SLOT_BYTES,
+    );
+    let ring_bytes = pool.parameters.geometry.journal_ring_bytes;
+    let record_bytes = usize::try_from(singlefs_format::JOURNAL_RECORD_BYTES).expect("4096");
+    let mut highest = MKFS_INSTANCE_GENERATION;
+    for device in reader.device_identities() {
+        for record_index in 0..ring_bytes / singlefs_format::JOURNAL_RECORD_BYTES {
+            let offset = DeviceOffsetInBytes(
+                ring_start.0 + record_index * singlefs_format::JOURNAL_RECORD_BYTES,
+            );
+            let Some(bytes) = reader.read(device, offset, record_bytes) else {
+                continue;
+            };
+            if let Some(record) =
+                crate::journal::JournalRecord::parse(&bytes, expected_filesystem_identifier)
+            {
+                highest = highest.max(record.instance);
+            }
+        }
+    }
+    highest
+}
