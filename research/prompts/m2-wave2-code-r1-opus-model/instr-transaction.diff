+/// OPUS-PROBE（副本插桩，只读）：在分配器的拷贝上按形状逐个角色真分配一遍，交回每一次之后的分配记录条数；
+/// 某次分配不出来就在那一次交回 None 并停。释放只改写记录、不动位图，不影响落点，所以这里不做释放。
+#[must_use]
+pub fn opus_probe_exact_record_counts(
+    allocator: &PoolAllocator,
+    shapes: &[PublishShape],
+) -> Vec<Option<usize>> {
+    let mut copy = allocator.clone();
+    let mut counts = Vec::new();
+    for shape in shapes {
+        let mut ok = true;
+        for identity in shape.rewritten_roles() {
+            let placement = match identity.placement() {
+                PlacementRule::UserData => copy.allocate_user_data(CheckpointTxg(0)),
+                PlacementRule::CommitGenerated(footprint) => {
+                    copy.allocate_commit_generated(footprint, CheckpointTxg(0))
+                }
+            };
+            if placement.is_none() {
+                ok = false;
+                break;
+            }
+        }
+        if !ok {
+            counts.push(None);
+            return counts;
+        }
+        counts.push(Some(copy.records().len()));
+    }
+    counts
+}
