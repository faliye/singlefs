+fn probe_direction_of_every_violation(image: &MemoryPool, step: &str, txg: u64) {
+    let violations: Vec<(&'static str, String)> = check_pool_image(image)
+        .into_iter()
+        .filter_map(|(invariant, verdict)| match verdict {
+            InvariantVerdict::Violated(detail) => Some((invariant, detail)),
+            InvariantVerdict::Holds
+            | InvariantVerdict::NotApplicable(_)
+            | InvariantVerdict::PartiallyJudged(_) => None,
+        })
+        .collect();
+    let names: Vec<&str> = violations.iter().map(|(n, _)| *n).collect();
+    let mut diffs: Vec<i128> = Vec::new();
+    for (invariant, detail) in &violations {
+        if *invariant == "I-3.1" {
+            let (a, w) = singlefs_harness::history::allocated_and_walked_bytes(detail)
+                .expect("I-3.1 带两个数");
+            diffs.push(i128::from(a) - i128::from(w));
+        }
+    }
+    eprintln!("PROBE {step} txg {txg} violated {names:?} i31_diffs {diffs:?}");
+    assert!(
+        names.iter().all(|n| *n == "I-3.1"),
+        "PROBE-FAIL {step} txg {txg}: other invariants {names:?}"
+    );
+    assert!(
+        diffs.iter().all(|d| *d > 0),
+        "PROBE-FAIL {step} txg {txg}: I-3.1 not on the counted-more side {diffs:?}"
+    );
+}
