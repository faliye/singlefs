+/// 攻方腿 opus-s2 的测量钩子（只在草稿副本里）：在只进内存的盘上走取号之后那一串连同续做时为 1，别的时候为 0。
+pub static ATTACK_MEMORY_WALK_DEPTH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+/// 攻方腿 opus-s2 的测量钩子：进出各记一次，提前返回也记得到。
+struct AttackPhaseGuard;
+impl AttackPhaseGuard {
+    fn enter() -> Self {
+        ATTACK_MEMORY_WALK_DEPTH.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        AttackPhaseGuard
+    }
+}
+impl Drop for AttackPhaseGuard {
+    fn drop(&mut self) {
+        ATTACK_MEMORY_WALK_DEPTH.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
