+// 攻方腿 m3-formal-code-r1 的探针：真调两个核，把它们交回的东西原样交给合判推论——推论的 requires 在一处可达的调用点上成立（不空真的见证）。
+fn attack_corollary_witness() {
+    let mut slots: Vec<Option<RootChoiceKey>> = Vec::new();
+    slots.push(Some(RootChoiceKey { checkpoint_txg: PrefixKernelCheckpointTxg(3), instance: PrefixKernelInstanceGeneration(1) }));
+    slots.push(None);
+    slots.push(Some(RootChoiceKey { checkpoint_txg: PrefixKernelCheckpointTxg(3), instance: PrefixKernelInstanceGeneration(2) }));
+    let chosen = choose_root_slot(slots.as_slice());
+    match chosen {
+        Some(c) => {
+            let key = match slots[c] {
+                Some(k) => k,
+                None => { return; },
+            };
+            let records: Vec<CoreRecord<u64>> = Vec::new();
+            let bc = |i: usize| -> (r: bool) ensures r == false { false };
+            let nu = |i: usize| -> (r: bool) ensures r == true { true };
+            let replayed = replay_core(key.instance, key.checkpoint_txg, 0u64, records.as_slice(), 4usize, NamedUnitVerification::Verify, bc, nu);
+            proof {
+                corollary_recovery_replays_from_the_newest_self_verified_root(slots@, c, 0u64, records@, 4usize, NamedUnitVerification::Verify, bc, nu, replayed);
+            }
+            assert(slots@[0] is Some && slots@[2] is Some);
+            assert(c == 2);
+        },
+        None => { assert(slots@[0] is Some); assert(false); },
+    }
+}
