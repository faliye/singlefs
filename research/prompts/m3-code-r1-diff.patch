+            libc::FALLOC_FL_PUNCH_HOLE | libc::FALLOC_FL_KEEP_SIZE,
+            offset_for_the_system_call,
+            length_for_the_system_call,
+        )
+    };
+    if return_code == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
