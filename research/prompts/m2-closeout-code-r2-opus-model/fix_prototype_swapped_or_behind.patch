+/// 【攻方腿原型，m2-closeout-code-r2 Y2，只在攻方副本上】挂着之后的入口与会话在「可见」之外再核两样：
+/// 每块盘自证过的系统配置槽里的本盘设备号是不是盘表给它的身份；这块盘是不是落后于现行那一版、又缺它的单元
+/// （与可写挂载取号之前逐盘核的第二支同一判，`devices_without_the_selected_version`，只是「所选那一版」换成现行那一版）。
+/// 交回有问题的盘的身份。只读盘。
+pub(crate) fn devices_swapped_or_behind_the_current_version<Reader: PoolReader + ?Sized>(
+    reader: &Reader,
+    parameters_of_the_pool: &MakeFilesystemParameters,
+    current: &TransactionOutput,
+) -> Vec<DeviceIdentity> {
+    let spacing = u64::from(parameters_of_the_pool.geometry.fixed_structure_slot_spacing);
+    let mut flagged = Vec::new();
+    for device in reader.device_identities() {
+        let slots = verified_system_configuration_slots(reader, device, spacing, &parameters_of_the_pool.filesystem_identifier);
+        if slots.iter().any(|slot| slot.immutable.this_device != device) {
+            flagged.push(device);
+            continue;
+        }
+        let Some(newest) = slots.iter().max_by_key(|slot| slot.quantities.slot_generation) else {
+            continue;
+        };
+        let position = JournalSequenceNumber { instance_generation: newest.quantities.journal_instance, counter: newest.quantities.journal_tail };
+        let current_position = JournalSequenceNumber { instance_generation: current.record.instance, counter: current.record.counter };
+        if position >= current_position {
+            continue;
+        }
+        let missing = current
+            .units
+            .iter()
+            .filter(|unit| !unit.bytes.is_empty())
+            .any(|unit| !reader.read(device, unit.slot.to_device_offset(), unit.bytes.len()).is_some_and(|bytes| bytes == unit.bytes));
+        if missing {
+            flagged.push(device);
+        }
+    }
+    flagged
+}
