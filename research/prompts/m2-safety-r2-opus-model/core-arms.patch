+// ======================= OPUS S4 ATTACK ARMS (draft copy only, m2-safety-r2 opus leg) =======================
+/// 这一轮攻方腿自己实现的 A1–A4（只在草稿副本里）。线程局部：每个工作线程各设各的。
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct OpusArms {
+    /// A1：发布准入把这次发布自己换下、要进 defer 的槽算进需求。
+    pub a1_count_own_release: bool,
+    /// A2 的另一半：式子里删掉「− defer 待释放」（发布与挂载同一个函数，两处一起删）。
+    pub drop_defer_term: bool,
+    /// A3：删除类发布豁免准入。
+    pub a3: Option<A3Rule>,
+    /// A4：挂载准入只判「空闲够不够这次挂载自己的写」。
+    pub a4_mount_own_writes_only: bool,
+    /// 攻方腿自己的零轮改法：需求换成「这次新写的全部槽」（普通分配 + 固定点元数据），A1 那一半另加不加换下的槽照 `a1_count_own_release`。
+    pub charge_all_new_writes: bool,
+}
+
+/// A3 的「删除类」怎么认。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum A3Rule {
+    /// 这次换下的槽 ≥ 这次新写的全部槽（普通分配 + 固定点元数据），逐盘。
+    ReleasedAtLeastAllNew,
+    /// 严格大于。
+    ReleasedMoreThanAllNew,
+    /// 这次换下的槽 ≥ 这次的普通分配（需求），逐盘。
+    ReleasedAtLeastDemand,
+}
+
+/// 一次准入判定的痕迹（给驱动读）。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct OpusTrace {
+    pub path: &'static str,
+    pub available_slots: Vec<i128>,
+    pub demand_slots: u64,
+    pub released_slots: u64,
+    pub all_new_slots: u64,
+    pub exempted: bool,
+    pub admitted: bool,
+}
+
+thread_local! {
+    static OPUS_ARMS: std::cell::Cell<OpusArms> = std::cell::Cell::new(OpusArms::default());
+    static OPUS_TRACES: std::cell::RefCell<Vec<OpusTrace>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+pub fn set_opus_arms(arms: OpusArms) {
+    OPUS_ARMS.with(|cell| cell.set(arms));
+}
+#[must_use]
+pub fn opus_arms() -> OpusArms {
+    OPUS_ARMS.with(std::cell::Cell::get)
+}
+pub fn opus_push_trace(trace: OpusTrace) {
+    OPUS_TRACES.with(|traces| traces.borrow_mut().push(trace));
+}
+#[must_use]
+pub fn opus_take_traces() -> Vec<OpusTrace> {
+    OPUS_TRACES.with(|traces| std::mem::take(&mut *traces.borrow_mut()))
+}
+
+/// 读数里「defer 待释放」置 0（A2 删掉那一项）。
+#[must_use]
+pub fn opus_reading_without_defer(reading: &AdmissionReading) -> AdmissionReading {
+    AdmissionReading::new(
+        reading
+            .per_device()
+            .iter()
+            .map(|terms| DeviceAdmissionTerms {
+                deferred: BytesOnOneDevice::ZERO,
+                ..*terms
+            })
+            .collect(),
+        reading.pool_wide(),
+        reading.replicas(),
+    )
+}
+
+/// 按这一线程的臂取读数：A2 删 defer 那一项。
+#[must_use]
+pub fn opus_admission_reading_before_a_publish(
+    allocator: &PoolAllocator,
+    version_to_build_on: Option<&TransactionOutput>,
+) -> AdmissionReading {
+    let reading = admission_reading_before_a_publish(allocator, version_to_build_on);
+    if opus_arms().drop_defer_term {
+        opus_reading_without_defer(&reading)
+    } else {
+        reading
+    }
+}
+
+/// A4 的挂载判：每块盘 容量 − 已分配 − 不可回收 − 被抛弃根独占量 − 一次切换的最坏量（链重写 + R × c_max）
+/// − checkpoint 保留池 ÷ 副本数 ≥ 0。「已分配」按读法甲本来就含 defer，不另扣。交回逐盘可用（字节）。
+#[must_use]
+pub fn opus_a4_mount_available(
+    allocator: &PoolAllocator,
+    version_to_build_on: Option<&TransactionOutput>,
+) -> Vec<(DeviceIdentity, AvailableBytesOnOneDevice)> {
+    let checkpoint_cost = checkpoint_cost_of_the_version_to_build_on(version_to_build_on, allocator);
+    let replicas = ReplicaCount::of_every_device_in_the_pool(allocator);
+    let all_switches = instance_switch_reserve_on_one_device(
+        allocator.instance_rows_after_this_mounts_row_publish(),
+        checkpoint_cost,
+    );
+    let one_switch = all_switches.0 / (INSTANCE_SWITCHES_ALLOWED_PER_MOUNT + 1);
+    let reserve_share = checkpoint_reserve_pool(checkpoint_cost, replicas)
+        .share_of_one_device(replicas)
+        .0;
+    allocator
+        .devices
+        .iter()
+        .map(|device_map| {
+            let free = i128::from(device_map.unit_area_slots() * SLOT_BYTES)
+                - i128::from(device_map.allocated_slots() * SLOT_BYTES)
+                - i128::from(UNRECLAIMABLE_ON_A_DEVICE_OUTSIDE_ZONED.0)
+                - i128::from(device_map.isolated_slots() * SLOT_BYTES);
+            (
+                device_map.device,
+                AvailableBytesOnOneDevice(free - i128::from(one_switch) - i128::from(reserve_share)),
+            )
+        })
+        .collect()
+}
