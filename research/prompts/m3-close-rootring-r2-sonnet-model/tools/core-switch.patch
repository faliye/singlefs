+//! 正推腿模型用的开关（只在草稿目录的仓副本里，不是仓里的代码）：m3-close-rootring-r2 的两处改动点可开可关，同一份编译跑「今天」与「改后」。
+//! 公式核：0 关（今天），1 裸公式（第一轮用户那一支字面），2 带第 0 代例外（这一轮 C743 的形）。
+//! 同实例：真时 F2 判法在所选根的实例表读不出时，除了恰好等于见证到的那一版，也收与所选根同一个实例代号的根（这一轮 C751 的形）。
+//! 初值读环境变量 `R2_FORMULA` 与 `R2_SAME_INSTANCE`，测试里也能直接设。
+use std::sync::atomic::{AtomicU8, Ordering};
+
+static FORMULA: AtomicU8 = AtomicU8::new(255);
+static SAME_INSTANCE: AtomicU8 = AtomicU8::new(255);
+
+fn load_or_env(cell: &AtomicU8, name: &str) -> u8 {
+    let value = cell.load(Ordering::SeqCst);
+    if value != 255 {
+        return value;
+    }
+    let from_env = std::env::var(name)
+        .ok()
+        .and_then(|text| text.parse::<u8>().ok())
+        .unwrap_or(0);
+    cell.store(from_env, Ordering::SeqCst);
+    from_env
+}
+
+pub fn set_formula(mode: u8) {
+    FORMULA.store(mode, Ordering::SeqCst);
+}
+pub fn formula() -> u8 {
+    load_or_env(&FORMULA, "R2_FORMULA")
+}
+pub fn set_same_instance(on: bool) {
+    SAME_INSTANCE.store(u8::from(on), Ordering::SeqCst);
+}
+pub fn same_instance() -> bool {
+    load_or_env(&SAME_INSTANCE, "R2_SAME_INSTANCE") == 1
+}
+
+/// 读出的根（txg）住在 (region, slot) 这一槽里，公式核判不判它错位。
+pub fn is_misplaced(checkpoint_txg: u64, region: u64, slot: u64, slots_per_region: u64) -> bool {
+    match formula() {
+        0 => false,
+        1 => (checkpoint_txg % 3, (checkpoint_txg / 3) % slots_per_region) != (region, slot),
+        _ => {
+            if checkpoint_txg == 0 {
+                slot != 0
+            } else {
+                (checkpoint_txg % 3, (checkpoint_txg / 3) % slots_per_region) != (region, slot)
+            }
+        }
+    }
+}
