//! 同上一形，约束写成高阶 `where Inner: for<'a> Store<'a>`：`:` 后面是 `for`，`Store` 跟在 `>` 后面，收严二不开它。
pub trait Store<'a> {
    fn put(&self, amount: &'a u32) -> u32;
}

pub trait Source {
    fn total(&self) -> u32;
}

pub struct Base;

impl<'a> Store<'a> for Base {
    fn put(&self, amount: &'a u32) -> u32 {
        *amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<'a, Inner: Store<'a>> Store<'a> for Wrapper<Inner> {
    fn put(&self, amount: &'a u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub struct Adapter<Inner>(pub Inner);

impl<Inner> Source for Adapter<Inner>
where
    Inner: for<'a> Store<'a>,
{
    fn total(&self) -> u32 {
        self.0.put(&3)
    }
}

pub fn entry(source: &dyn Source) -> u32 {
    source.total()
}

pub fn caller() -> u32 {
    entry(&Adapter(Wrapper(Base)))
}
