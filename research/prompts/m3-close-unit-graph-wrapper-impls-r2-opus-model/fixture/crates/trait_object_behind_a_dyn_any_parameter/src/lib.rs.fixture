//! 入口签名只写 `&dyn Any`（工作区外的 trait，没有可开的 impl）；入口里 `downcast_ref` 成 `Box<dyn Store>` 再调 `put`。
//! 盒子里的 `Wrapper<Base>` 由闭包外的 `caller` 造。`dyn Store` 写在入口函数体里，不在签名里。
use std::any::Any;

pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub fn entry(thing: &dyn Any) -> u32 {
    thing
        .downcast_ref::<Box<dyn Store>>()
        .map_or(0, |store| store.put(3))
}

pub fn caller() -> u32 {
    let boxed: Box<dyn Store> = Box::new(Wrapper(Base));
    entry(&boxed)
}
