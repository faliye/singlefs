//! 入口没有参数，从 `static` 里取 `Box<dyn Store>`；放进去的 `Wrapper<Base>` 由闭包外的 `caller` 在调入口之前装好。
//! 收严二只看入口签名与入口所在 impl，`static` 里的 trait 对象不开。
use std::sync::OnceLock;

pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub static INSTALLED: OnceLock<Box<dyn Store + Send + Sync>> = OnceLock::new();

pub fn entry() -> u32 {
    INSTALLED.get().map_or(0, |store| store.put(3))
}

pub fn caller() -> u32 {
    let _ = INSTALLED.set(Box::new(Wrapper(Base)));
    entry()
}
