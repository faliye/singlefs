//! 第一轮「调用方造的值经开放的入口进来」那一形，约束写成带括号的 `Inner: (Store)`：收严二「被开进来的 impl 头上的约束照开」
//! 只认紧跟 `impl`、`dyn`、`:`、`+` 的名字，`:` 后面是 `(`，`Store` 不开。
pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub trait Source {
    fn total(&self) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub struct Adapter<Inner>(pub Inner);

impl<Inner: (Store)> Source for Adapter<Inner> {
    fn total(&self) -> u32 {
        self.0.put(3)
    }
}

pub fn entry(source: &dyn Source) -> u32 {
    source.total()
}

pub fn caller() -> u32 {
    entry(&Adapter(Wrapper(Base)))
}
