+/// 第 19 批代码轮云端攻方原型（副本上加，不入库）：把 WGSL `c_first_data_unit_slot_the_allocation_records_leave_on_a_device`
+/// 的候选法照字面转写，与 CPU 逐对扫的 `first_data_unit_slot_the_allocation_records_leave_on_a_device` 在对抗取样上逐例比。
+#[cfg(test)]
+mod b19_opus_gpu_candidate_transliteration {
+    use super::*;
+
+    fn occupied(records: &[AllocationRecordView], device: u32, slot: u64, txg: u64) -> bool {
+        records.iter().any(|record| {
+            record.device == device
+                && !(!record.is_released && record.generation >= txg)
+                && record.slot <= slot
+                && slot < record.slot + record.span_slots
+        })
+    }
+
+    fn pair_is_free(records: &[AllocationRecordView], device: u32, candidate: u64, txg: u64, open: Option<u64>) -> bool {
+        if let Some(open_first) = open {
+            if open_first <= candidate && candidate < open_first + 64 {
+                return false;
+            }
+        }
+        !occupied(records, device, candidate, txg) && !occupied(records, device, candidate + 1, txg)
+    }
+
+    fn gpu(records: &[AllocationRecordView], device: u32, txg: u64, unit_area_start: u64, open: Option<u64>) -> u64 {
+        let mut expected = unit_area_start;
+        let mut found = pair_is_free(records, device, unit_area_start, txg, open);
+        if let Some(open_first) = open {
+            let past = open_first + 64;
+            if unit_area_start <= past && (!found || past < expected) && pair_is_free(records, device, past, txg, open) {
+                expected = past;
+                found = true;
+            }
+        }
+        for record in records {
+            if record.device != device || (!record.is_released && record.generation >= txg) {
+                continue;
+            }
+            let mut past = record.slot + record.span_slots;
+            if past % 2 != 0 && std::env::var("B19_GPU_MUTANT").is_err() {
+                past += 1;
+            }
+            if unit_area_start <= past && (!found || past < expected) && pair_is_free(records, device, past, txg, open) {
+                expected = past;
+                found = true;
+            }
+        }
+        expected
+    }
+
+    #[test]
+    fn b19_opus_gpu_candidates_agree_with_the_cpu_scan_on_adversarial_samples() {
+        let mut state: u64 = 0x9E37_79B9_7F4A_7C15;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        let unit_area_start = 1024u64;
+        let txg = 10u64;
+        let cases: u64 = std::env::var("B19_GPU_CASES").ok().map_or(200_000, |text| text.parse().expect("数"));
+        let mut disagreements = 0u64;
+        let mut first = None;
+        for case in 0..cases {
+            let record_count = next() % 40;
+            let mut records = Vec::new();
+            for _ in 0..record_count {
+                let slot = unit_area_start - 8 + next() % 220;
+                let span = [0u64, 1, 1, 1, 2, 2, 2, 3, 64][usize::try_from(next() % 9).expect("小")];
+                let generation = txg - 1 + next() % 3;
+                let device = u32::from(next() % 5 == 0);
+                records.push(AllocationRecordView {
+                    device,
+                    slot,
+                    span_slots: span,
+                    generation,
+                    is_released: next() % 3 == 0,
+                });
+            }
+            let open = match next() % 4 {
+                0 => None,
+                _ => Some(unit_area_start - 64 + 64 * (next() % 5)),
+            };
+            let cpu = first_data_unit_slot_the_allocation_records_leave_on_a_device(
+                &records,
+                0,
+                txg,
+                unit_area_start,
+                open.map(|first_slot| OpenClusterSegment { first_slot }),
+            );
+            let gpu = gpu(&records, 0, txg, unit_area_start, open);
+            if cpu != gpu {
+                disagreements += 1;
+                if first.is_none() {
+                    first = Some((case, cpu, gpu, open, records.clone()));
+                }
+            }
+        }
+        println!("name=gpu-transliteration cases={cases} disagreements={disagreements} first={first:?}");
+    }
+}
