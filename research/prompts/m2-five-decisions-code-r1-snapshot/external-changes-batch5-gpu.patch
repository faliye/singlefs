+        flow.writes[..last_record].iter().any(|write| {
+            write.kind == StepKind::JournalRecord
+                && write.device == device
+                && write.bytes().is_some_and(|bytes| {
+                    u32::from_le_bytes(bytes[16..20].try_into().expect("4")) == instance
