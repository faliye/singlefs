+            ModelVersionContents::WithoutTrees
+            | ModelVersionContents::FileBeingDeleted { .. }
+            | ModelVersionContents::TreesAndNoFile { .. }
+            | ModelVersionContents::InodesWithoutTheFirstFile { .. } => None,
