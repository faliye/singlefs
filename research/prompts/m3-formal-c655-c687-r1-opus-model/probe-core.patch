+/// 攻方副本探针（m3-formal-c655-c687-r1，不进仓）：一版树表里每条条目的 (种类, 树 ID, 根指针 86 字节, 诞生 txg, 头 ID)。
+pub fn probe_tree_table_entries_of_root(
+    reader: &dyn PoolReader,
+    root: &RootRecord,
+) -> Result<Vec<(u16, u64, Vec<u8>, u64, u64)>, RecoveryFailure> {
+    let node_bytes = usize::try_from(NODE_BYTES).expect("16384");
+    let tree_table_bytes = read_unit_via_locations(reader, &root.tree_table.locations, node_bytes)?;
+    let tree_table =
+        parse_index_node(&tree_table_bytes).map_err(|_error| RecoveryFailure::UnitMalformed {
+            what: "树表单元",
+        })?;
+    let entries = tree_table_entries_each_kind_at_most_once(&tree_table.entries)?;
+    Ok(entries
+        .iter()
+        .zip(&tree_table.entries)
+        .map(|(entry, bytes)| {
+            (
+                entry.kind,
+                entry.tree.0,
+                TreeTableEntry::root_pointer_bytes(bytes).to_vec(),
+                entry.birth_txg.0,
+                entry.head_identifier,
+            )
+        })
+        .collect())
+}
