+    /// 正推腿加的（lm 轮 T5，K3-1 / K5-1 的随机操作串）：一张假卡、一台设备，随机的借、建、丢借据（等成或没等成）、设备丢了、借之前那一步、重起、放掉旧设备。
+    /// 只在「账已经知道丢了」（借之前那一步见到丢了而且列出了这张卡，或重起的 prepare 走过）与没丢的状态里断言：能借的不超过卡上真能再给的。
+    /// 输出违例条数与头几条的操作串；不 assert，由调用方读。
+    #[test]
+    fn lm_t5_random_operation_strings_never_lend_more_than_the_card_truly_has_left_once_the_ledger_knows() {
+        let mut violations = 0usize;
+        let mut checked = 0usize;
+        let mut first_violations: Vec<String> = Vec::new();
+        let mut unknown_loss_overgives = 0usize;
+        for seed in 0..4000u64 {
+            let mut state = seed.wrapping_mul(2862933555777941757).wrapping_add(3037000493);
+            let mut next = move |bound: u64| {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                (state >> 33) % bound
+            };
+            let (card, ledger) = ledger_on_a_card_under_the_ledger();
+            let mut first = ledger.book_on_the_card(0, 1).expect("空卡借得到");
+            let device0 = ledger.record_the_device_started_on_the_card(0);
+            {
+                let mut c = card.lock().expect("假卡不 panic");
+                c.device_started = true;
+                c.driver_occupied_mebibytes = 600;
+            }
+            first.take_in_the_wait_before_returning(&device0, DeviceWaitBeforeReturningTheLease::TheSubmittedWorkFinished);
+            drop(first);
+            let mut current: std::rc::Rc<DeviceStartedOnTheBooks<'_>> = std::rc::Rc::new(device0);
+            let mut old_devices: Vec<std::rc::Rc<DeviceStartedOnTheBooks<'_>>> = Vec::new();
+            let mut alive: Vec<(GpuMemoryBooking<'_>, u8, u64)> = Vec::new();
+            let mut lost = false;
+            let mut marked = false;
+            let mut kept_built: u64 = 0;
+            let mut log = String::new();
+            for _step in 0..14 {
+                let op = next(8);
+                match op {
+                    0 => {
+                        let sizes = [1_000u64, 4_000, 9_000, 15_000];
+                        let n = sizes[next(4) as usize];
+                        if let Ok(b) = ledger.book_on_the_card(0, n) {
+                            alive.push((b, 0, n));
+                            log.push_str(&format!("B{n} "));
+                        }
+                    }
+                    1 => {
+                        if !lost {
+                            if let Some(i) = (0..alive.len()).find(|i| alive[*i].1 == 0) {
+                                let n = alive[i].2;
+                                card.lock().expect("假卡不 panic").built_mebibytes += n;
+                                alive[i].1 = 1;
+                                log.push_str("C ");
+                            }
+                        }
+                    }
+                    2 | 3 => {
+                        if !alive.is_empty() {
+                            let i = next(alive.len() as u64) as usize;
+                            let (mut b, built, n) = alive.remove(i);
+                            let ok = op == 2 && !lost;
+                            let wait = if ok { DeviceWaitBeforeReturningTheLease::TheSubmittedWorkFinished } else { DeviceWaitBeforeReturningTheLease::TheWaitFailed };
+                            b.take_in_the_wait_before_returning(&current, wait);
+                            if ok {
+                                let mut c = card.lock().expect("假卡不 panic");
+                                c.built_mebibytes -= kept_built + if built == 1 { n } else { 0 };
+                                kept_built = 0;
+                            } else if built == 1 {
+                                kept_built += n;
+                            }
+                            drop(b);
+                            log.push_str(if ok { "Dok " } else { "Dfail " });
+                        }
+                    }
+                    4 => {
+                        if !lost {
+                            lost = true;
+                            marked = false;
+                            let mut c = card.lock().expect("假卡不 panic");
+                            c.left_by_a_lost_device_mebibytes += c.driver_occupied_mebibytes + c.built_mebibytes;
+                            c.built_mebibytes = 0;
+                            c.driver_occupied_mebibytes = 0;
+                            c.device_started = false;
+                            for entry in alive.iter_mut() { if entry.1 == 1 { entry.1 = 2; } }
+                            kept_built = 0;
+                            log.push_str("LOST ");
+                        }
+                    }
+                    5 => {
+                        let listed_any = !ledger.leases_kept_after_a_failed_wait_on_each_card().is_empty();
+                        let lost_now = lost;
+                        ledger.take_in_the_devices_kept_before_booking(
+                            |_p| Some(current.clone()),
+                            |_k| lost_now,
+                            |_k| false,
+                            |k| &**Box::leak(Box::new(k.clone())),
+                        );
+                        if lost && listed_any {
+                            marked = true;
+                        }
+                        log.push_str("PRE ");
+                    }
+                    6 => {
+                        if lost {
+                            let prepared = ledger.prepare_the_driver_share_before_starting_the_device(0);
