+                                log.push_str("RESTARTREFUSED ");
+                            }
+                        }
+                    }
+                    _ => {
+                        if !old_devices.is_empty() {
+                            old_devices.remove(0);
+                            if old_devices.is_empty() {
+                                card.lock().expect("假卡不 panic").left_by_a_lost_device_mebibytes = 0;
+                            }
+                            log.push_str("RELEASE ");
+                        }
+                    }
+                }
+                let unbuilt: u64 = alive.iter().filter(|(_, built, _)| *built == 0).map(|(_, _, n)| *n).sum();
+                let room = room_now(&ledger);
+                let truly = room_truly_left(&card, unbuilt);
