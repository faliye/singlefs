+const EXTERN_ENTRY: EntrySpecification = EntrySpecification {
+    entry_path: "fextern::entry_point",
+    target: "lib",
+    conditions: &[],
+};
+
+/// 场景：块前面写 `#[cfg_attr(target_os = "linux", link(name = "fakesync"))]`。预期：拒算。
