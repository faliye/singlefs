+fn restart_tree(label: &str, main_source: &str, extra_files: &[(&str, &str)]) -> FixtureTree {
+    let mut files = vec![
+        RESTART_MANIFEST,
+        (RESTART_MAIN_FILE, main_source),
+        NO_DEPENDENCY_RESOLUTION,
+    ];
+    files.extend_from_slice(extra_files);
+    FixtureTree::materialize(label, &files)
+}
