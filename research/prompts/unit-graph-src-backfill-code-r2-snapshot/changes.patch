+    // 子表头让 `workspace` 里有一张子表、非空。底下有键的节由下面逐条键值再认一遍
+    for table_header in &document.table_headers {
+        let header: Vec<&str> = table_header.iter().map(String::as_str).collect();
+        if header.first() == Some(&"package") {
