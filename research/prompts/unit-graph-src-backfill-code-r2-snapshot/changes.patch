+fn assert_refused_as_extern_function_interface(verdict: Result<String, String>) {
+    let reason = verdict.expect_err("链接时可能多出别的库，拒算");
+    assert!(
+        reason.contains("refused\textern-function-interface\tcrates/fextern/src/lib.rs:"),
