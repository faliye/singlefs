//! static 与 `Any` 那一条只开 static 单元自己词法单元里写的 `dyn Trait`：static 的类型写成别名 `Installed`，`dyn Store` 写在别名里，
//! 别名是类型单元、不在那三类位置上。放进去的 `Wrapper<Base>` 由闭包外的 `caller` 装好。
use std::sync::OnceLock;

pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub type Installed = Box<dyn Store + Send + Sync>;

pub static INSTALLED: OnceLock<Installed> = OnceLock::new();

pub fn entry() -> u32 {
    INSTALLED.get().map_or(0, |store| store.put(3))
}

pub fn caller() -> u32 {
    let _ = INSTALLED.set(Box::new(Wrapper(Base)));
    entry()
}
