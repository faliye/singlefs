//! 提到 `Any` 的单元里写的 `dyn Trait` 照开：入口收 `&dyn Any`、向下转型的目标写成别名 `Boxed`，`dyn Store` 写在别名里，
//! 入口自己的 `dyn` 只有 `Any`。盒子由闭包外的 `caller` 造。
use std::any::Any;

pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub type Boxed = Box<dyn Store>;

pub fn entry(thing: &dyn Any) -> u32 {
    thing.downcast_ref::<Boxed>().map_or(0, |store| store.put(3))
}

pub fn caller() -> u32 {
    let boxed: Boxed = Box::new(Wrapper(Base));
    entry(&boxed)
}
