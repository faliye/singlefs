//! 入口签名里的约束写成带括号的 `Thing: (Store)`：入口签名的 R-开放 只认紧跟 `impl`、`dyn`、`:`、`+` 的名字，`:` 后面是 `(`，
//! `Store` 不开（今天也是这样；今天靠 blanket 放行把 `Wrapper` 的 impl 兜进来）。值由闭包外的 `caller` 造。

pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub fn entry<Thing: (Store)>(thing: &Thing) -> u32 {
    thing.put(3)
}

pub fn caller() -> u32 {
    entry(&Wrapper(Base))
}
