+/// 攻方副本加的入口：照原样调 `unreadable_ring_slots_inside_the_window`，`unreadable` 里的槽报读错、其余报自证不过。
+#[must_use]
+pub fn proto_unreadable_ring_slots_inside_the_window(
+    unreadable: &[RootRingSlot],
+    every_slot: &[RootRingSlot],
+    window_anchor: CheckpointTxg,
+    first_txg: CheckpointTxg,
+    slots_per_region: crate::root_ring::RootRingSlotsPerRegion,
+) -> Vec<(RootRingSlot, CheckpointTxg, CheckpointTxg)> {
+    let readings: Vec<(RootRingSlot, RootRingSlotReading)> = every_slot
+        .iter()
+        .map(|slot| {
+            (
+                *slot,
+                if unreadable.contains(slot) {
+                    RootRingSlotReading::Bad(BadRootRingSlotReading::Unreadable)
+                } else {
+                    RootRingSlotReading::Bad(BadRootRingSlotReading::NotSelfVerified)
+                },
+            )
+        })
+        .collect();
+    unreadable_ring_slots_inside_the_window(&readings, window_anchor, first_txg, slots_per_region)
+        .into_iter()
+        .map(|u| (u.ring_slot, u.lowest_txg_it_can_hold, u.highest_txg_it_can_hold))
+        .collect()
+}
