+    pub last_stage: u8,
+    /// 戊：有一次失败等着做切换。
+    pub switch_pending: bool,
+}
+thread_local! {
+    pub static C381: std::cell::RefCell<C381Arm> = std::cell::RefCell::new(C381Arm::default());
+}
+pub fn c381_with<T>(body: impl FnOnce(&mut C381Arm) -> T) -> T {
+    C381.with(|cell| body(&mut cell.borrow_mut()))
+}
+#[must_use]
+pub fn c381_get() -> C381Arm {
+    C381.with(|cell| cell.borrow().clone())
+}
+pub fn c381_set_arm(arm: u8) {
+    c381_with(|state| *state = C381Arm { arm, ..C381Arm::default() });
+}
+/// 驱动做完切换或重开之后清掉「停」与「等切换」（真正的实例切换在挂载内做，重开是它的近似）。
+pub fn c381_clear_stop() {
+    c381_with(|state| {
+        state.stopped = false;
+        state.switch_pending = false;
+    });
+}
+pub fn c381_set_read_only() {
+    c381_with(|state| {
+        state.read_only = true;
+        state.stopped = true;
+    });
