+    for piece in pieces:
+        at = row.find(piece, position)
+        if at < 0:
+            return False
+        position = at + len(piece)
+    return bool(pieces)
+
+
+def reads_switch(path):
+    text = open(path, encoding="utf-8", errors="replace").read()
+    code = "\n".join(row for row in text.split("\n") if not row.lstrip().startswith("#"))
