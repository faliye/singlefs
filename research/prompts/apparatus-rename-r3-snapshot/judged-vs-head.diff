+def prefix_problem(prefix):
+    """前缀是不是相对仓根的路径前缀：是交 None，不是交一句原因。"""
+    if not prefix:
+        return "是空的"
+    if re.search(r"\s", prefix):
+        return "含空白"
+    if prefix.startswith("/") or prefix.startswith("./"):
+        return "要写相对仓根的路径，不带开头的 / 与 ./"
+    if prefix.endswith("/"):
+        return "不带结尾的 /"
+    if any(part in ("", ".", "..") for part in prefix.split("/")):
+        return "不许有空段、. 段与 .. 段"
+    return None
