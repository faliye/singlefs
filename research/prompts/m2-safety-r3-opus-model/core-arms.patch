+// ======================= OPUS R3 ARMS (draft copy only, m2-safety-r3 opus leg) =======================
+/// 这一轮攻方腿自己实现的式子两处改动（只在草稿副本里）。线程局部：每个工作线程各设各的。
+/// C283（准入不够先推空发布抬 F）不在这里：它是准入的调用方的事（本文件 `AdmissionRefusedOnSomeDevices` 的文档），在驱动里。
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct OpusR3Arms {
+    /// ND：可用(d) 去掉「− defer 待释放(d)」。
+    pub drop_defer_term: bool,
+    /// A1n：需求(d) = 这次发布重写的全部角色的 span_slots（不按 `space_budget_of_role` 过滤），不加换下的槽。
+    pub charge_all_new_writes: bool,
+    /// 攻方腿自己的零轮变体（只在这条腿的模型上量过）：发布路径的挂载期承诺量按下一次可写挂载的 rows0（这次挂载的 rows0 + 1）算，
+    /// 让发布放行时就给下一次挂载要写的那一行留出链多一片的份额；挂载路径不变。
+    pub publish_reserves_next_mount_row: bool,
+}
+
+/// 一次准入读数的痕迹（给驱动读）：哪一处算的、逐盘可用与各项（槽）、需求。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct OpusR3Trace {
+    pub site: &'static str,
+    pub available_slots: Vec<i128>,
+    pub allocated_slots: Vec<u64>,
+    pub deferred_slots: Vec<u64>,
+    pub isolated_slots: Vec<u64>,
+    pub mount_commitment_slots: u64,
+    pub checkpoint_share_slots: u64,
+    pub rows0: u64,
+    /// 今天的需求（`Demand` 那一类）。
+    pub demand_today_slots: u64,
+    /// 这次重写的全部角色。
+    pub all_new_slots: u64,
+    /// 这次换下的槽（参考）。
+    pub released_slots: u64,
+    /// 判的是哪个需求（臂取的）。
+    pub judged_demand_slots: u64,
+    pub judged: bool,
+    pub admitted: bool,
+}
+
+thread_local! {
+    static OPUS_R3_ARMS: std::cell::Cell<OpusR3Arms> = std::cell::Cell::new(OpusR3Arms { drop_defer_term: false, charge_all_new_writes: false, publish_reserves_next_mount_row: false });
+    static OPUS_R3_TRACES: std::cell::RefCell<Vec<OpusR3Trace>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+pub fn set_opus_r3_arms(arms: OpusR3Arms) {
+    OPUS_R3_ARMS.with(|cell| cell.set(arms));
+}
+#[must_use]
+pub fn opus_r3_arms() -> OpusR3Arms {
+    OPUS_R3_ARMS.with(std::cell::Cell::get)
+}
+pub fn opus_r3_push_trace(trace: OpusR3Trace) {
+    OPUS_R3_TRACES.with(|traces| traces.borrow_mut().push(trace));
+}
+#[must_use]
+pub fn opus_r3_take_traces() -> Vec<OpusR3Trace> {
+    OPUS_R3_TRACES.with(|traces| std::mem::take(&mut *traces.borrow_mut()))
+}
+
+/// 发布路径的读数：臂开了 `publish_reserves_next_mount_row` 就按 rows0 + 1 算挂载期承诺量，否则就是 [`admission_reading_before_a_publish`]。
+#[must_use]
+pub fn opus_r3_publish_reading(allocator: &PoolAllocator, version_to_build_on: Option<&TransactionOutput>) -> AdmissionReading {
+    if !opus_r3_arms().publish_reserves_next_mount_row {
+        return admission_reading_before_a_publish(allocator, version_to_build_on);
+    }
+    let checkpoint_cost = checkpoint_cost_of_the_version_to_build_on(version_to_build_on, allocator);
+    let reading = AdmissionReading::of_allocator(
+        allocator,
+        instance_switch_reserve_on_one_device(allocator.instance_rows_after_this_mounts_row_publish() + 1, checkpoint_cost),
+        PoolWideCommitments::of_the_first_version(checkpoint_reserve_pool(
+            checkpoint_cost,
+            ReplicaCount::of_every_device_in_the_pool(allocator),
+        )),
+    );
+    if opus_r3_arms().drop_defer_term {
+        opus_r3_reading_without_defer(&reading)
+    } else {
+        reading
+    }
+}
+
+/// 读数里「defer 待释放」置 0。
+#[must_use]
+pub fn opus_r3_reading_without_defer(reading: &AdmissionReading) -> AdmissionReading {
+    AdmissionReading::new(
+        reading
+            .per_device()
+            .iter()
+            .map(|terms| DeviceAdmissionTerms {
+                deferred: BytesOnOneDevice::ZERO,
+                ..*terms
+            })
+            .collect(),
+        reading.pool_wide(),
+        reading.replicas(),
     )
 }
 
+/// 一份读数的痕迹骨架（各项折成槽）。
+#[must_use]
+pub fn opus_r3_trace_of(site: &'static str, reading: &AdmissionReading, allocator: &PoolAllocator) -> OpusR3Trace {
+    let slot = i128::from(SLOT_BYTES);
+    OpusR3Trace {
+        site,
+        available_slots: reading.available_on_each_device().iter().map(|(_, a)| a.0.div_euclid(slot)).collect(),
+        allocated_slots: reading.per_device().iter().map(|t| t.allocated.0 / SLOT_BYTES).collect(),
+        deferred_slots: allocator.devices.iter().map(|d| d.deferred_slots()).collect(),
+        isolated_slots: reading.per_device().iter().map(|t| t.abandoned_root_exclusive.0 / SLOT_BYTES).collect(),
+        mount_commitment_slots: reading.per_device().first().map_or(0, |t| t.mount_time_commitment.0 / SLOT_BYTES),
+        checkpoint_share_slots: reading.pool_wide().checkpoint_reserve_pool.share_of_one_device(reading.replicas()).0 / SLOT_BYTES,
+        rows0: allocator.instance_rows_after_this_mounts_row_publish(),
+        ..OpusR3Trace::default()
+    }
+}
+// ======================= END OPUS R3 ARMS =======================
