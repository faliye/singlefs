+      echo "     → 怎么办：看登记目录的权限；旧登记没用了就自己删掉它，再起" >&2
+      exit 1
+    fi
+    echo "  · 同名的旧登记已结束，挪到 $archive 留着" >&2
+  fi
+  if ! mkdir -- "$record"; then
