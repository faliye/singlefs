+
+detached_run_list() { # 逐条列登记；DETACHED_RUN_RUNNING_COUNT、DETACHED_RUN_RUNNING_RECORDS 记下还在跑的
+  local record label unit state status now started started_date ended rc log command main_pid pid line note records=()
+  local ended_count=0 vanished_count=0 total=0
+  DETACHED_RUN_RUNNING_COUNT=0
+  DETACHED_RUN_RUNNING_RECORDS=()
