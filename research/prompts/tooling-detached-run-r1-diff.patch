+    esac
+    echo "      命令：${command:0:200}"
+    line="$(detached_run_last_line "$log")"
+    echo "      日志最后一行：${line:-（空）}"
+  done
+  echo "  ✓ detached-run.sh list：还在跑、没结束的 $DETACHED_RUN_RUNNING_COUNT 条，已结束 $ended_count 条，没留退出码 $vanished_count 条（登记 $total 条，登记目录 $detached_run_state）"
