+    if [[ -n "$rc" ]]; then
+      status=ended
+    elif [[ "$label" == *@* ]]; then
+      status=vanished
+    else
+      state="$(detached_run_unit_state "$unit")"
+      if detached_run_is_active_state "$state"; then status=running; else status=vanished; fi
+    fi
+    case "$status" in
+      running)
+        DETACHED_RUN_RUNNING_COUNT=$((DETACHED_RUN_RUNNING_COUNT + 1))
+        DETACHED_RUN_RUNNING_RECORDS+=("$record")
+        main_pid="$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)"
+        pid="$(detached_run_field "$record" pid)"
+        echo "  · 还在跑  $label  单元 $unit（$state）  主进程 ${main_pid:-?}  命令进程 ${pid:-?}  起跑 ${started_date:-?}  已跑 $(detached_run_duration $((now - started)))  日志 $(detached_run_size "$log") $log"
+        ;;
+      ended)
+        ended_count=$((ended_count + 1))
+        ended="$(detached_run_field "$record" ended)"
+        [[ "$ended" =~ ^[0-9]+$ ]] || ended="$now"
