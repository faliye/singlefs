+    echo "  ✗ 60 秒没拿到登记目录的锁（$detached_run_state/.lock），什么都没起" >&2
+    echo "     → 怎么办：有别的 detached-run.sh start 卡在里面；用 detached-run.sh list 看一眼，等它起完再起" >&2
