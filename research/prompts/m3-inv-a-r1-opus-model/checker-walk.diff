+/// m3-inv-a-r1 攻方副本：最近一次 `check_pool_image` 在 I-7.8 那一处看到的数（每个线程一份）。
+#[derive(Clone, Debug)]
+pub struct InvAWatermarkDiagnostics {
+    pub roots_max: u64,
+    pub records_max: Option<u64>,
+    pub highest_seen: u64,
+    pub b78_pairs: u64,
+    pub b78_first_violation: Option<String>,
+}
+
+thread_local! {
+    static INV_A_LAST_DIAGNOSTICS: std::cell::RefCell<Option<InvAWatermarkDiagnostics>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// m3-inv-a-r1 攻方副本：全进程累计（工作线程上的判定也算）——[走到 I-7.8 的次数, 只取根判违例, 并进记录判违例, 候选 I-7.8b 判违例,
+/// 记录里的水位高于根环里的]。线程自己把 `INV_A_SKIP_GLOBAL_COUNTS` 立起来时那个线程上的判定不计。
+static INV_A_GLOBAL_COUNTS: [std::sync::atomic::AtomicU64; 5] = [
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+];
+
+thread_local! {
+    static INV_A_SKIP_GLOBAL_COUNTS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// 这个线程上的判定计不计进全进程累计。
+pub fn inv_a_skip_global_counts_on_this_thread(skip: bool) {
+    INV_A_SKIP_GLOBAL_COUNTS.with(|cell| cell.set(skip));
+}
+
+/// 读全进程累计。
+#[must_use]
+pub fn inv_a_global_counts() -> [u64; 5] {
+    use std::sync::atomic::Ordering::Relaxed;
+    [
+        INV_A_GLOBAL_COUNTS[0].load(Relaxed),
+        INV_A_GLOBAL_COUNTS[1].load(Relaxed),
+        INV_A_GLOBAL_COUNTS[2].load(Relaxed),
+        INV_A_GLOBAL_COUNTS[3].load(Relaxed),
+        INV_A_GLOBAL_COUNTS[4].load(Relaxed),
+    ]
+}
+
+/// 取走最近一次的观测。
+#[must_use]
+pub fn inv_a_take_last_watermark_diagnostics() -> Option<InvAWatermarkDiagnostics> {
+    INV_A_LAST_DIAGNOSTICS.with(|cell| cell.borrow_mut().take())
 }
