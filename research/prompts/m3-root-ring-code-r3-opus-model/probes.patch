+/// 攻方原型（m3-root-ring-code-r3，K1，不入库）：第一个孤儿那一槽判的那一次读照读、第 n 次起读坏（抹之前那次重读落在第 2 次）。
+/// 看：清扫删不删行、那个孤儿的头还在不在、删行之后 F5 观察者看到的按删前那一行判未发布的孤儿还剩几个。
+#[test]
+fn r3_attack_a_read_failure_on_the_reread_before_erasing() {
+    for read_back in [UnreadableRangeReadBack::DeviceError, UnreadableRangeReadBack::Zeros] {
+        for nth in [2u64, 3] {
+            let pool = pool_with_a_dead_instance(None);
+            let (first_orphan, first_head) = *pool.orphans_left_on_disk.first().expect("孤儿");
+            let unreadable = SharedUnreadableRanges::new(
+                vec![UnreadableRange {
+                    device: first_orphan.device,
+                    offset_in_bytes: first_orphan.slot.to_device_offset().0,
+                    length_in_bytes: 512,
+                    failing_reads: FailingReadsOfARange::FromTheNthOnward(nth),
+                }],
+                read_back,
+            );
+            let stream = SharedStream::retaining_contents();
+            let mut devices = with_unreadable_ranges(recording_of(&pool.image, &stream), &unreadable);
+            let mounted = mount_writable_with_instance_table_sweep_configuration(
+                &parameters_of_the_ring_hole_pools(),
+                &mut devices,
+                SpaceAdmission::JudgedByTheFormula,
+                ShadowLedger::On,
+                sweeping_at_the_end_of_the_mount_on_any_row(),
+            )
+            .expect("挂载");
+            let after = image_after(&pool.image, &stream);
+            let still = unit_head_read_by_sweep(&head_bytes_at(&after, first_orphan)) == Some(first_head);
+            let left: Vec<_> = pool
+                .orphans_left_on_disk
+                .iter()
+                .filter(|(p, h)| unit_head_read_by_sweep(&head_bytes_at(&after, *p)) == Some(*h))
+                .map(|(p, _)| *p)
+                .collect();
+            let outcome = format!("{:?}", mounted.output.instance_table_sweep);
+            println!(
+                "REREAD read_back={read_back:?} nth={nth} rows_after={:?} first_orphan_head_still_there={still} orphans_left={} of {} outcome={}",
+                instances_with_a_row_on(&after),
+                left.len(),
+                pool.orphans_left_on_disk.len(),
+                outcome.chars().take(240).collect::<String>()
+            );
+        }
+    }
+}
