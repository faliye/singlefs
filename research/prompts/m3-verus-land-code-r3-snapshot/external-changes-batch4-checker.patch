+/// 根记录里实例表指针（170 起）头部出生 txg 的偏移（指针偏移 42）。
+const ROOT_RECORD_INSTANCE_TABLE_POINTER_BIRTH_TXG_OFFSET: usize =
+    ROOT_RECORD_INSTANCE_TABLE_POINTER_OFFSET + 42;
