+#[test]
+fn an_instance_table_pointer_whose_birth_txg_differs_from_the_instance_table_header_reddens_only_the_birth_identity_invariant(
+) {
+    let clean = build_pool("known-bad-instance-table-pointer-birth").memory_pool();
