+            judgements.judge(
+                TREES_OF_THE_REPLAYED_VERSION_ARE_TRAVERSABLE,
+                walk_failures.is_empty(),
+                || {
+                    format!(
+                        "所选根（实例 {}、txg {}）之上重放 {publishes} 次发布、{records} 条记录（末条计数器 {last_record_counter}）施加出的那一版走不完：{}",
+                        chosen_root.instance,
+                        chosen_root.checkpoint_txg,
+                        walk_failures.join("；")
