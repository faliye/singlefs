+/// 攻方副本探针用（m3-formal-code-b21-r1 opus）：只在崩溃注入第二截那一支的调用里生效。
+pub mod opus_probe {
+    use std::cell::Cell;
+    thread_local! {
+        pub static ARM_ACTIVE: Cell<bool> = const { Cell::new(false) };
+    }
+    #[must_use]
+    pub fn variant() -> Option<String> {
+        if ARM_ACTIVE.with(Cell::get) {
+            std::env::var("OPUS_K2A_VARIANT").ok()
+        } else {
+            None
+        }
+    }
