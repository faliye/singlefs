#!/usr/bin/env bash
# 顶替 systemctl：show-environment 照常成功（过 preflight 的运行条件）；查 ActiveState 前两次答 active，第三次起像用户级 systemd 连不上那样退 1、stdout 什么都不打
# （真实的 `env XDG_RUNTIME_DIR=/nonexistent DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent/bus systemctl --user show -p ActiveState --value x.service` 实测就是这个形态）。
case " $* " in
  *" show-environment "*) echo PATH=/usr/bin; exit 0 ;;
  *" ActiveState "*)
    n=$(cat "$SHIM_COUNT" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$SHIM_COUNT"
    if [ "$n" -le 2 ]; then echo active; exit 0; fi
    echo "Failed to connect to bus: No such file or directory" >&2; exit 1 ;;
  *" MainPID "*) echo 4242; exit 0 ;;
esac
exit 0
