+# ── 在用
+def in_use(path):
+    """有进程开着 path 里的文件（scripts/hosts/run_build_directory.py 的 open_holders，与它的 holders 同一份判法）。"""
+    return bool(module("run_build_directory").open_holders(os.path.abspath(path)))
