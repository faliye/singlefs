+HEREDOC = re.compile(r"(?<!<)<<(?!<)-?[ \t]*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")
+OPERATOR_WORD = re.compile(r"^[;&|()<>]+$")
+WRITE_HINT = re.compile(r"write_text\(|write_bytes\(|\.write\(|writelines\(|open\([^)]*[\"'][wax]b?\+?[\"']")
