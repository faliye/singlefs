+def cut_reason(last_text):
+    tail = last_text[-600:]
+    if USAGE_LIMIT_TAIL.search(tail):
+        return "用量撞顶"
+    if API_ERROR_TAIL.search(tail):
+        return "API 错"
+    return "停掉"
