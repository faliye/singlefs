+def heredoc_target(before, after):
+    """cat > 文件 <<EOF、tee [-a] 文件 <<EOF、cat <<EOF > 文件 三种写法的目标文件；认不出回 None。"""
+    for text, pattern in ((before, r"(?:>>?|\btee\b(?:\s+-\w+)*)\s*(\S+)\s*$"), (after, r"^\s*>>?\s*(\S+)")):
+        match = re.search(pattern, text)
+        if match:
+            return match.group(1).strip("'\"")
+    return None
