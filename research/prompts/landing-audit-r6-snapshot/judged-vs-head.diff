+        print("! handback-guard：找不到这个子 agent 自己的会话记录，命名检查这一条没判（放行）", file=sys.stderr)
+        return []
+    last_edit, runs_after = {}, {}
+    for name, arguments, cwd, ran, exit_code, output in tool_calls(records):
+        if name in FILE_EDITING_TOOLS and ran:
