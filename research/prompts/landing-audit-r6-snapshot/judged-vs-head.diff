+def shell_words(text):
+    """shlex 切词；引号没闭合时读到哪算哪。"""
+    lexer = shlex.shlex(text[:60000], posix=True, punctuation_chars=True)
+    lexer.whitespace_split = True
+    words = []
+    try:
+        for word in lexer:
+            words.append(word)
+    except ValueError:
+        pass
+    return words
