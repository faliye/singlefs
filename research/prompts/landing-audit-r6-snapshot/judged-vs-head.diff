+def normalize_path(path):
+    path = re.sub(r"^/home/[^/]+/", "~/", path).replace("$HOME/", "~/").replace("${HOME}/", "~/")
+    path = re.sub(r"(\.[A-Za-z0-9]{1,6})[一-鿿].*$", r"\1", path)   # 扩展名后面直接粘着的说明文字
+    return path.rstrip(".,=/")
