+PROMPTS_DIRECTORY = "research/prompts"
+LEG_OUTPUT_MENTION = re.compile(r"research/prompts/([^/\s`'\"，。；：、（）()「」<>*]+)-output\.md")   # 交回里点名的三方腿报告（不进子目录）
