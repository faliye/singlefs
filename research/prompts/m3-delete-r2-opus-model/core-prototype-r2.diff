+/// 原型：式子后三项，待删占用与已承诺预留取测试账房给的那一对。
+#[must_use]
+pub fn pool_wide_commitments_with_the_ledger_for_tests(
+    checkpoint_reserve_pool: BytesSummedOverAllReplicas,
+) -> PoolWideCommitments {
+    match LEDGER_FOR_TESTS.with(std::cell::Cell::get) {
+        Some((pending_delete, committed_reservation)) => PoolWideCommitments {
+            pending_delete: BytesSummedOverAllReplicas(pending_delete),
+            committed_reservation: BytesSummedOverAllReplicas(committed_reservation),
+            checkpoint_reserve_pool,
+        },
+        None => PoolWideCommitments::of_the_first_version(checkpoint_reserve_pool),
+    }
+}
