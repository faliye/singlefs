+#[must_use]
+pub fn process_environment_variable(variable: &str) -> Option<String> {
+    match std::env::var(variable) {
+        Ok(value) => Some(value),
+        Err(std::env::VarError::NotPresent) => None,
+        Err(std::env::VarError::NotUnicode(raw)) => panic!("{variable} 不是 UTF-8：{raw:?}"),
