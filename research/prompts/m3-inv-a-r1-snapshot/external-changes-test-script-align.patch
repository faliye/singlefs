+    let shared = TemporaryStore {
+        directory: std::env::temp_dir().join(format!(
+            "singlefs-crash-amplification-reuse-control-shared-{}",
+            std::process::id()
+        )),
+    };
+    let _ = std::fs::remove_dir_all(&shared.directory);
