+    let without_ignore =
+        layer0_state_ranges_by_segment(flow.base, flow.writes, flow.segments, flow.expansion).1;
+    let planned = plan.points.last().map_or(0, |point| point.ordinals.end);
+    without_ignore
+        .checked_sub(planned)
+        .expect("ignore 只会让段少展开，态数不会比不 ignore 时多")
