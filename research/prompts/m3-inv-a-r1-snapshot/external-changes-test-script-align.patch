+/// 一行 `CRASH_AMPLIFICATION` 的 `key=value` 字段。
+fn fields_of_the_line(line: &str) -> BTreeMap<String, String> {
+    line.split_whitespace()
+        .skip(1)
+        .filter_map(|field| field.split_once('='))
+        .map(|(key, value)| (key.to_string(), value.to_string()))
+        .collect()
+}
