+        segment_of_the_warm_up_root + 1,
+        (first_filler..first_filler + FILLER_WRITES_BEFORE_THE_PUBLISH_ROOT).collect(),
+    );
+    flow.judged_root_index += FILLER_WRITES_BEFORE_THE_PUBLISH_ROOT;
