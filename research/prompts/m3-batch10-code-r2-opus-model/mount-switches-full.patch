+
+/// 攻方原型（只在副本上）：同 [`newest_valid_root_txg_on_every_device`]，一条根归哪块盘按它读出来的那个槽所在的区域定，不按 txg 的落点公式。
+fn opus_newest_valid_root_txg_on_every_device_by_the_slot_read(
+    roots_with_ring_slots: &[(RootRingSlot, RootRecord)],
+    table: &InstanceTableRecords,
+    all_devices: &[DeviceIdentity],
+    region_devices: &[DeviceIdentity; 3],
+) -> Option<CheckpointTxg> {
+    all_devices
+        .iter()
+        .map(|device| {
+            roots_with_ring_slots
+                .iter()
+                .filter(|(ring_slot, root)| {
+                    !abandoned_by_table(root, table)
+                        && region_devices[usize::try_from(ring_slot.region).expect("区域号")] == *device
+                })
+                .map(|(_, root)| root.checkpoint_txg)
+                .max()
+        })
+        .collect::<Option<Vec<CheckpointTxg>>>()?
+        .into_iter()
+        .min()
 }
 
