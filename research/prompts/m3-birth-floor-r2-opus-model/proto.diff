+#[test]
+fn tree_floor_and_beta_over_final_images() {
+    let jobs = jobs();
+    let threads: usize = std::env::var("SINGLEFS_THREAD_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(1).max(1);
+    let limit: usize = std::env::var("R2_LIMIT").ok().and_then(|v| v.parse().ok()).unwrap_or(usize::MAX);
+    let faults_on = std::env::var("R2_NO_FAULTS").is_err();
+    let shard: Option<(usize, usize)> = std::env::var("R2_SHARD").ok().and_then(|text| {
+        let (k, n) = text.split_once('/')?;
+        Some((k.parse().ok()?, n.parse().ok()?))
+    });
+    let jobs: Vec<Job> = jobs
+        .into_iter()
+        .enumerate()
+        .filter(|(index, _)| shard.is_none_or(|(k, n)| index % n == k))
+        .map(|(_, job)| job)
+        .take(limit)
+        .collect();
+    println!("R2_JOBS {}", jobs.len());
+    let started = std::time::Instant::now();
+    let totals: Mutex<Totals> = Mutex::new(Totals::default());
+    let next = Mutex::new(0usize);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| {
+                let start = Driver::after_first_file();
+                let mut starts: BTreeMap<&'static str, Driver> = BTreeMap::new();
+                let mut local = Totals::default();
+                loop {
+                    let index = {
+                        let mut next = next.lock().expect("锁");
+                        let index = *next;
+                        *next += 1;
+                        index
+                    };
+                    let Some((name, prefix_name, ops)) = jobs.get(index) else { break };
+                    let prefix_start = starts.entry(prefix_name).or_insert_with(|| {
+                        let mut driver = start.fork();
+                        for op in prefix(prefix_name) {
+                            assert!(matches!(driver.apply(op), Outcome::Applied), "前缀 {prefix_name} 的 {op:?} 被拒");
+                        }
+                        driver
+                    });
+                    let mut driver = prefix_start.fork();
+                    let mut refused = Vec::new();
+                    for op in ops {
+                        if let Outcome::Refused(reason) = driver.apply(*op) {
+                            refused.push(format!("{op:?}: {}", reason.chars().take(60).collect::<String>()));
+                        }
+                    }
+                    if !refused.is_empty() {
+                        note(&mut local, "history-with-refused-step".to_string(), 1, 1, Some(format!("{name} {refused:?}")));
+                    }
+                    let image = driver.image();
+                    judge_image(&mut local, name, "none", &image);
+                    if !faults_on {
+                        continue;
+                    }
+                    let roots = ring_roots(&image);
+                    for (txg, instance, device, offset) in &roots {
+                        let mut faulted = image.clone();
+                        zero_root(&mut faulted, *device, *offset);
+                        judge_image(&mut local, &format!("{name} zero(txg {txg} 实例 {instance})"), "zero1", &faulted);
+                    }
+                    for window in roots.windows(2) {
+                        let mut faulted = image.clone();
+                        zero_root(&mut faulted, window[0].2, window[0].3);
+                        zero_root(&mut faulted, window[1].2, window[1].3);
+                        judge_image(&mut local, &format!("{name} zero(txg {} 与 {})", window[0].0, window[1].0), "zero2", &faulted);
+                    }
+                }
+                let mut totals = totals.lock().expect("锁");
+                totals.images += local.images;
+                for (key, entry) in local.by_key {
+                    let total = totals.by_key.entry(key).or_default();
+                    total.0 += entry.0;
+                    total.1 += entry.1;
+                    total.2 += entry.2;
+                    if total.3.is_none() {
+                        total.3 = entry.3;
+                    }
+                }
+            });
+        }
+    });
+    let totals = totals.into_inner().expect("锁");
+    println!("R2_DONE images={} seconds={:.1}", totals.images, started.elapsed().as_secs_f64());
+    for (key, (evaluated, violations, images_red, first)) in totals.by_key {
+        println!("R2 {key} evaluated={evaluated} violations={violations} images={images_red} first={}", first.unwrap_or_else(|| "-".into()));
+    }
+}
