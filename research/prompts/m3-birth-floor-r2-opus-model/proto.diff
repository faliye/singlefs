@@ -0,0 +1,596 @@
+//! m3-birth-floor-r2 攻方原型（第一轮 `bf_bad_images.rs` 的改造法照搬，另加两种）：从合法历史的镜像出发，把一个（或一串）单元的诞生代号改小，指它的指针、中央映射 key、分配记录的分配代、
+//! journal 点名项一起跟着改，校验和沿引用链补到根槽与记录（记录改完重接反向链）：盘上处处自洽，唯独诞生代号比它真正写出的那次发布早。
+//! 每份坏镜像上判诞生代号下界三种写法（CS1）与池级 checker，看谁红。
+use std::collections::BTreeSet;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::{ImageReader, InvariantVerdict};
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::{birth_floor_judgements, tree_floor_judgements};
+use singlefs_core::address::{CheckpointTxg, DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_core::checksum::{crc32_castagnoli, wide_checksum_with_field_zeroed};
+use singlefs_core::journal::{back_chain_of, record_offset, JournalRecord};
+use singlefs_core::recovery::PoolReader;
+use singlefs_core::unit::unit_filesystem_identifier;
+use singlefs_format::{JOURNAL_RECORD_BYTES, JOURNAL_RING_DEFAULT_BYTES};
+use singlefs_harness::memory_pool::MemoryPool;
+
+const SLOT: u64 = 16384;
+const DEVICES: [u32; 2] = [0, 1];
+
+fn read(pool: &MemoryPool, device: u32, offset: u64, length: usize) -> Vec<u8> {
+    let aligned = length.div_ceil(512) * 512;
+    let mut bytes = PoolReader::read(pool, DeviceIdentity(device), DeviceOffsetInBytes(offset), aligned).expect("读");
+    bytes.truncate(length);
+    bytes
+}
+
+fn write(pool: &mut MemoryPool, device: u32, offset: u64, bytes: &[u8]) {
+    pool.devices.get_mut(&DeviceIdentity(device)).expect("盘").write(DeviceOffsetInBytes(offset), bytes);
+}
+
+fn get_u64(bytes: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(bytes[offset..offset + 8].try_into().expect("8 字节"))
+}
+
+fn set_u64(bytes: &mut [u8], offset: usize, value: u64) {
+    bytes[offset..offset + 8].copy_from_slice(&value.to_le_bytes());
+}
+
+/// 按类重封：先载荷 CRC，再头校验和（码 1：头 105、CRC 在 101；码 3：头 107、CRC 在 89；码 2：头 86 + 2k、CRC 在 76 + 2k）。
+fn reseal_unit(bytes: &mut [u8]) {
+    let (header_end, payload_crc_offset) = match bytes[6] {
+        1 => (105usize, 101usize),
+        3 => (107, 89),
+        _ => (86 + 2 * usize::from(bytes[51]), 76 + 2 * usize::from(bytes[51])),
+    };
+    let payload_crc = crc32_castagnoli(&bytes[header_end..]);
+    bytes[payload_crc_offset..payload_crc_offset + 4].copy_from_slice(&payload_crc.to_le_bytes());
+    singlefs_core::unit::seal_header_checksum(bytes, header_end);
+}
+
+fn birth_offset(bytes: &[u8]) -> usize {
+    match bytes[6] {
+        1 => 75,
+        3 => 73,
+        _ => 52 + 2 * usize::from(bytes[51]),
+    }
+}
+
+fn unit_length(class: u8) -> usize {
+    match class {
+        2 => 16384,
+        _ => 32768,
+    }
+}
+
+/// 单元区里盘 0 上头 magic 对、类标签 1 / 2 / 3 的起点槽：(槽, 字节数)。
+fn units_of(pool: &MemoryPool) -> Vec<(u64, usize)> {
+    let mut slots: BTreeSet<u64> = ImageReader::candidate_unit_slots(pool, 0).unwrap_or_default().into_iter().collect();
+
+    slots
+        .into_iter()
+        .filter_map(|slot| {
+            let header = read(pool, 0, slot * SLOT, 8);
+            (&header[..4] == b"SFSU" && matches!(header[6], 1..=3)).then(|| (slot, unit_length(header[6])))
+        })
+        .collect()
+}
+
+/// 根环全部槽：(盘, 偏移)。区域 r 在盘 [0, 1, 0][r] 上，起点 64 × 16384 + r × 3 MiB，槽距 4096。
+fn root_slots() -> Vec<(u32, u64)> {
+    (0..3u64)
+        .flat_map(|region| (0..8u64).map(move |slot| ([0u32, 1, 0][usize::try_from(region).expect("区域")], 64 * SLOT + region * 3 * (1 << 20) + slot * 4096)))
+        .collect()
+}
+
+fn location_pattern(device: u32, slot: u64, checksum: u32) -> Vec<u8> {
+    [device.to_le_bytes().to_vec(), slot.to_le_bytes()[..6].to_vec(), checksum.to_le_bytes().to_vec()].concat()
+}
+
+fn positions(haystack: &[u8], needle: &[u8]) -> Vec<usize> {
+    (0..=haystack.len().saturating_sub(needle.len())).filter(|index| haystack[*index..*index + needle.len()] == *needle).collect()
+}
+
+fn fsid_low() -> u64 {
+    unit_filesystem_identifier(&singlefs_harness::history::HistoryDeviceWidth::FourGibibytes.parameters().filesystem_identifier)
+}
+
+fn journal_counters(pool: &MemoryPool) -> Vec<u64> {
+    (1..100_000u64)
+        .take_while(|counter| {
+            JournalRecord::parse(&read(pool, 0, record_offset(*counter, JOURNAL_RING_DEFAULT_BYTES).0, usize::try_from(JOURNAL_RECORD_BYTES).expect("4096")), fsid_low()).is_some()
+        })
+        .collect()
+}
+
+/// journal 里每条记录：点名项与新根段指针里位置条目是 (盘, slot, old) 的换成 new；`birth` 给出时，那一项的诞生代号 from → to。
+/// 改完从头把反向链重接一遍。
+fn rewrite_journal(pool: &mut MemoryPool, slot: u64, old: u32, new: u32, birth: Option<(u64, u64)>) {
+    let counters = journal_counters(pool);
+    for device in DEVICES {
+        for counter in &counters {
+            let offset = record_offset(*counter, JOURNAL_RING_DEFAULT_BYTES).0;
+            let Some(mut record) = JournalRecord::parse(&read(pool, device, offset, 4096), fsid_low()) else { continue };
+            let mut touched = false;
+            for named in &mut record.named {
+                if named.locations[0].slot.0 == slot && named.locations[0].unit_checksum == old {
+                    for location in &mut named.locations {
+                        location.unit_checksum = new;
+                    }
+                    if let Some((from, to)) = birth {
+                        assert_eq!(named.birth_txg.0, from, "点名项的诞生代号本来是 {from}");
+                        named.birth_txg = CheckpointTxg(to);
+                    }
+                    touched = true;
+                }
+            }
+            for pointer in [&mut record.new_tree_table, &mut record.new_mapping_root] {
+                if pointer.locations[0].slot.0 == slot && pointer.locations[0].unit_checksum == old {
+                    for location in &mut pointer.locations {
+                        location.unit_checksum = new;
+                    }
+                    if let Some((from, to)) = birth {
+                        assert_eq!(pointer.head.birth_txg.0, from, "新根段指针的诞生代号本来是 {from}");
+                        pointer.head.birth_txg = CheckpointTxg(to);
+                    }
+                    touched = true;
+                }
+            }
+            if touched {
+                write(pool, device, offset, &record.to_bytes());
+            }
+        }
+        for window in counters.windows(2) {
+            let previous = read(pool, device, record_offset(window[0], JOURNAL_RING_DEFAULT_BYTES).0, 4096);
+            let offset = record_offset(window[1], JOURNAL_RING_DEFAULT_BYTES).0;
+            let mut later = JournalRecord::parse(&read(pool, device, offset, 4096), fsid_low()).expect("改前自证过的记录");
+            let chain = back_chain_of(&previous);
+            if later.back_chain != chain {
+                later.back_chain = chain;
+                write(pool, device, offset, &later.to_bytes());
+            }
+        }
+    }
+}
+
+/// 一个单元的整单元校验和从 old 变成 new：父单元里的位置条目、根槽、journal 里的点名项逐个补上，被补的父单元重封、再往上补。
+fn propagate(pool: &mut MemoryPool, units: &[(u64, usize)], mut changes: Vec<(u64, u32, u32)>) {
+    // 先进先出：同一个单元先后变两次（c1 → c2 → c3）时，引用它的地方要先补 c1 → c2、再补 c2 → c3。
+    while !changes.is_empty() {
+        let (slot, old, new) = changes.remove(0);
+        if old == new {
+            continue;
+        }
+        for (container, length) in units.iter().copied() {
+            if container == slot {
+                continue;
+            }
+            let before = read(pool, 0, container * SLOT, length);
+            let mut bytes = before.clone();
+            let mut touched = false;
+            for device in DEVICES {
+                for position in positions(&bytes, &location_pattern(device, slot, old)) {
+                    bytes[position..position + 14].copy_from_slice(&location_pattern(device, slot, new));
+                    touched = true;
+                }
+            }
+            if touched {
+                reseal_unit(&mut bytes);
+                for device in DEVICES {
+                    write(pool, device, container * SLOT, &bytes);
+                }
+                changes.push((container, crc32_castagnoli(&before), crc32_castagnoli(&bytes)));
+            }
+        }
+        for (device, offset) in root_slots() {
+            let mut bytes = read(pool, device, offset, 512);
+            let mut touched = false;
+            for location_device in DEVICES {
+                for position in positions(&bytes, &location_pattern(location_device, slot, old)) {
+                    bytes[position..position + 14].copy_from_slice(&location_pattern(location_device, slot, new));
+                    touched = true;
+                }
+            }
+            if touched {
+                let digest = wide_checksum_with_field_zeroed(&bytes, 512, 138);
+                bytes[138..170].copy_from_slice(&digest);
+                write(pool, device, offset, &bytes);
+            }
+        }
+        rewrite_journal(pool, slot, old, new, None);
+    }
+}
+
+/// 把 `slot` 那个单元的诞生代号从 `from` 改成 `to`，并改：指它的指针（码 2 节点里、根槽里）的诞生代号、中央映射条目 key 的出生 txg
+/// （key 宽 27 的节点，条目 key 偏移 9）与节点头里与它相同的最小 / 最大 key、分配记录树叶（key 宽 10）里两盘的未释放记录分配代、
+/// journal 点名项与新根段指针；校验和沿引用链补上去。交回改了几处（单元、指针、映射 key、分配记录、journal）。
+fn lower_birth(pool: &mut MemoryPool, slot: u64, from: u64, to: u64) -> [usize; 4] {
+    lower_birth_patching(pool, slot, from, to, &|_| ())
+}
+
+fn lower_birth_patching(pool: &mut MemoryPool, slot: u64, from: u64, to: u64, patch: &dyn Fn(&mut Vec<u8>)) -> [usize; 4] {
+    let units = units_of(pool);
+    let length = units.iter().find(|(start, _)| *start == slot).expect("登记过的单元").1;
+    let before = read(pool, 0, slot * SLOT, length);
+    let mut bytes = before.clone();
+    let offset = birth_offset(&bytes);
+    assert_eq!(get_u64(&bytes, offset), from, "槽 {slot} 的诞生代号本来是 {from}");
+    set_u64(&mut bytes, offset, to);
+    patch(&mut bytes);
+    reseal_unit(&mut bytes);
+    for device in DEVICES {
+        write(pool, device, slot * SLOT, &bytes);
+    }
+    let (old, new) = (crc32_castagnoli(&before), crc32_castagnoli(&bytes));
+    let mut counts = [0usize; 4];
+    let mut changes = vec![(slot, old, new)];
+    // 指针与映射 key：在补位置条目之前、按旧校验和找。
+    for (container, container_length) in units.iter().copied() {
+        if container == slot {
+            continue;
+        }
+        let container_before = read(pool, 0, container * SLOT, container_length);
+        let mut container_bytes = container_before.clone();
+        let key_width = usize::from(container_bytes[51]);
+        let mut touched = false;
+        for position in positions(&container_bytes, &location_pattern(0, slot, old)) {
+            if container_bytes[6] == 2 && key_width == 27 && position >= 27 {
+                // 中央映射条目：key 27 + 两条位置条目。
+                let key_start = position - 27;
+                let old_key = container_bytes[key_start..key_start + 27].to_vec();
+                if get_u64(&container_bytes, key_start + 9) == from {
+                    set_u64(&mut container_bytes, key_start + 9, to);
+                    let new_key = container_bytes[key_start..key_start + 27].to_vec();
+                    for header_key in [52usize, 52 + 27] {
+                        if container_bytes[header_key..header_key + 27] == old_key[..] {
+                            container_bytes[header_key..header_key + 27].copy_from_slice(&new_key);
+                        }
+                    }
+                    counts[1] += 1;
+                    touched = true;
+                }
+            } else if position >= 8 && get_u64(&container_bytes, position - 8) == from {
+                set_u64(&mut container_bytes, position - 8, to);
+                counts[0] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            for device in DEVICES {
+                for position in positions(&container_bytes, &location_pattern(device, slot, old)) {
+                    container_bytes[position..position + 14].copy_from_slice(&location_pattern(device, slot, new));
+                }
+            }
+            reseal_unit(&mut container_bytes);
+            for device in DEVICES {
+                write(pool, device, container * SLOT, &container_bytes);
+            }
+            changes.push((container, crc32_castagnoli(&container_before), crc32_castagnoli(&container_bytes)));
+        }
+    }
+    for (device, root_offset) in root_slots() {
+        let mut root_bytes = read(pool, device, root_offset, 512);
+        let mut touched = false;
+        for position in positions(&root_bytes, &location_pattern(0, slot, old)) {
+            if position >= 8 && get_u64(&root_bytes, position - 8) == from {
+                set_u64(&mut root_bytes, position - 8, to);
+                counts[0] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            for location_device in DEVICES {
+                for position in positions(&root_bytes, &location_pattern(location_device, slot, old)) {
+                    root_bytes[position..position + 14].copy_from_slice(&location_pattern(location_device, slot, new));
+                }
+            }
+            let digest = wide_checksum_with_field_zeroed(&root_bytes, 512, 138);
+            root_bytes[138..170].copy_from_slice(&digest);
+            write(pool, device, root_offset, &root_bytes);
+        }
+    }
+    rewrite_journal(pool, slot, old, new, Some((from, to)));
+    counts[3] += 1;
+    // 分配记录树叶（key 宽 10）：两盘各一条未释放记录，分配代 from → to。
+    for (container, container_length) in units.iter().copied() {
+        let container_before = read(pool, 0, container * SLOT, container_length);
+        if container_before[6] != 2 || container_before[51] != 10 {
+            continue;
+        }
+        let mut container_bytes = container_before.clone();
+        let count = usize::from(u16::from_le_bytes([container_bytes[102], container_bytes[103]]));
+        let mut touched = false;
+        for index in 0..count {
+            let record = 135 + 20 * index;
+            let mut slot_bytes = [0u8; 8];
+            slot_bytes[..6].copy_from_slice(&container_bytes[record + 4..record + 10]);
+            let span_field = u16::from_le_bytes([container_bytes[record + 10], container_bytes[record + 11]]);
+            if u64::from_le_bytes(slot_bytes) == slot && span_field & 0x8000 == 0 && get_u64(&container_bytes, record + 12) == from {
+                set_u64(&mut container_bytes, record + 12, to);
+                counts[2] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            reseal_unit(&mut container_bytes);
+            for device in DEVICES {
+                write(pool, device, container * SLOT, &container_bytes);
+            }
+            changes.push((container, crc32_castagnoli(&container_before), crc32_castagnoli(&container_bytes)));
+        }
+    }
+    let units = units_of(pool);
+    // 第一项（被改的单元自己）已补过指针与根槽，这里只补它往上的父单元链；其余各项照常补。
+    propagate(pool, &units, changes);
+    counts
+}
+
+/// 镜像上最新那条根引用的、由那次发布新写的单元（诞生代号 = 那条根的 txg）：(槽, 类, 码 2 时的 key 宽)。
+fn units_born_at(pool: &MemoryPool, txg: u64) -> Vec<(u64, u8, u8)> {
+    units_of(pool)
+        .into_iter()
+        .filter_map(|(slot, length)| {
+            let bytes = read(pool, 0, slot * SLOT, length.min(4096));
+            (get_u64(&bytes, birth_offset(&bytes)) == txg).then(|| (slot, bytes[6], bytes[51]))
+        })
+        .collect()
+}
+
+
+fn report(label: &str, image: &MemoryPool) {
+    let violated: Vec<(&str, String)> = check_pool_image(image)
+        .into_iter()
+        .filter_map(|(invariant, verdict)| match verdict {
+            InvariantVerdict::Violated(detail) => Some((invariant, detail.chars().take(200).collect())),
+            _ => None,
+        })
+        .collect();
+    println!("BJ {label} pool_checker_violated={violated:?}");
+    for (key, tally) in tree_floor_judgements(image) {
+        if key.starts_with("CS2:tf") || key.starts_with("CS2:beta") {
+            println!("BJ {label} {key} evaluated={} violations={} first={}", tally.evaluated, tally.violations, tally.first_violation.unwrap_or_else(|| "-".to_string()));
+        }
+    }
+    for (key, tally) in birth_floor_judgements(image) {
+        if key == "CS1:v3" || key == "CS1:v1" || key == "CS1:lower" {
+            println!("BJ {label} {key} evaluated={} violations={} first={}", tally.evaluated, tally.violations, tally.first_violation.unwrap_or_else(|| "-".to_string()));
+        }
+    }
+}
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+fn image_after(ops: &[Op]) -> MemoryPool {
+    let mut driver = Driver::after_first_file();
+    for op in ops {
+        assert!(matches!(driver.apply(*op), Outcome::Applied), "{op:?} 被拒");
+    }
+    driver.image()
+}
+
+/// inode 叶（码 3）里改动计数（记录内偏移 88）等于 `from` 的记录，按 140 字节一条从头 107 之后找，改成 `to`。交回改了几条。
+fn patch_change_counts(bytes: &mut Vec<u8>, from: u64, to: u64) -> usize {
+    let mut patched = 0;
+    let mut position = 107usize;
+    while position + 140 <= bytes.len() {
+        let inode = get_u64(bytes, position);
+        let object_birth = get_u64(bytes, position + 8);
+        if inode != 0 && inode < 100_000 && object_birth <= from && get_u64(bytes, position + 88) == from {
+            set_u64(bytes, position + 88, to);
+            patched += 1;
+        }
+        position += 1;
+    }
+    patched
+}
+
+#[test]
+fn chain_lowered_and_reappearance_bad_images() {
+    // J3-a / J3-b / J3-c：不回退的历史（最新根 txg 6，R⁻ txg 5），整条用户可见链（数据单元、extent 树、inode 叶、inode 树根）一起改小。
+    // a：改到 4（严格小于 R⁻）；b：改到 4，另把 inode 叶里改动计数 6 的那条记录改成 4（I-9.26 的上界跟着压住）；c：改到 5 并改改动计数。
+    let plain = [ow(1), ow(2), ow(3)];
+    let clean = image_after(&plain);
+    let born: Vec<(u64, u8, u8)> = units_born_at(&clean, 6);
+    println!("BJ plain units_born_at_6={born:?}");
+    let chain: Vec<u64> = std::env::var("BJ_CHAIN").ok().map(|t| t.split(',').filter_map(|p| p.parse().ok()).collect()).unwrap_or(vec![50186, 50277, 50278, 50280]);
+    for (label, to, patch_count) in [("J3-a chain→4", 4u64, false), ("J3-b chain→4+count", 4, true), ("J3-c chain→5+count", 5, true)] {
+        let mut bad = clean.clone();
+        for slot in &chain {
+            let header = read(&bad, 0, slot * SLOT, 8);
+            let is_inode_leaf = header[6] == 3;
+            let counts = if patch_count && is_inode_leaf {
+                lower_birth_patching(&mut bad, *slot, 6, to, &|bytes| {
+                    let patched = patch_change_counts(bytes, 6, to);
+                    println!("BJ {label} slot={slot} change_counts_patched={patched}");
+                })
+            } else {
+                lower_birth(&mut bad, *slot, 6, to)
+            };
+            println!("BJ {label} lowered slot={slot} counts={counts:?}");
+        }
+        report(label, &bad);
+    }
+}
+
+/// 单元区里类标签 3、诞生代号 `birth` 的单元：(槽, 第一条记录的 inode 号)。
+fn inode_leaves_born_at(pool: &MemoryPool, birth: u64) -> Vec<(u64, u64)> {
+    units_of(pool)
+        .into_iter()
+        .filter_map(|(slot, length)| {
+            let bytes = read(pool, 0, slot * SLOT, length);
+            (bytes[6] == 3 && get_u64(&bytes, 73) == birth).then(|| {
+                let first = (107..bytes.len() - 140).find(|p| get_u64(&bytes, *p) != 0 && get_u64(&bytes, *p) < 100_000).map_or(0, |p| get_u64(&bytes, p));
+                (slot, first)
+            })
+        })
+        .collect()
+}
+
+fn checksum_of(pool: &MemoryPool, slot: u64, length: usize) -> u32 {
+    crc32_castagnoli(&read(pool, 0, slot * SLOT, length))
+}
+
+/// 码 2 节点里第一条指向 (盘 0, slot, checksum) 的指针在节点里的起点（位置条目在指针偏移 50）。
+fn pointer_start_in(bytes: &[u8], slot: u64, checksum: u32) -> Option<usize> {
+    positions(bytes, &location_pattern(0, slot, checksum)).first().map(|position| position - 50)
+}
+
+#[test]
+fn reappearance_only_bad_image() {
+    // J3-d：建 300 个 inode（txg 4，两片叶）、覆盖写（5）、建 1 个 inode（6，第二片叶换成新的）、覆盖写（7）。
+    // 把 txg 7 那棵 inode 树根里指第二片叶的指针换回 txg 4 的那一片（它在 4、5 两条候选根里被引用、6 不引用）：
+    // 它在候选集里「引用—不引用—引用」，在 7 上再次出现；第一次出现在 4，按树继承下界（只判第一次出现）不判，β 判。
+    // 分配记录跟着改：txg 7 那棵分配记录树里新叶记成已释放（释放代 7）、旧叶记成未释放（分配代 4）。BJ_STEP 控制做到哪一步。
+    let ops = [Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2)];
+    let clean = image_after(&ops);
+    report("J3-d/clean", &clean);
+    let leaves4 = inode_leaves_born_at(&clean, 4);
+    let leaves6 = inode_leaves_born_at(&clean, 6);
