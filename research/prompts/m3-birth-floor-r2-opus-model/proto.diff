+/// 根环转过一圈的长历史：回退（挂着）把一片旧叶带回来、之后一次发布崩在根槽之前（由记录施加）、重新挂载、再接着覆盖写。
+/// 由记录施加的那一版 txg N 的根槽从没写过，它在根环里那个槽一直坐着 txg N − 24 的旧根；环再转过去时，候选集里这条旧根
+/// 与 N 之后的根之间隔着一段被盖掉的 txg。逐步判每一张终态镜像。
+/// 历史：建 300 个 inode、覆盖写、建 1 个 inode、覆盖写 a 次、回退到从新到旧第 r 条、覆盖写 b 次、回退崩在根槽之前（第 c 条）、
+/// 重新挂载、覆盖写 d 次（d 从 0 到 26，每一步各判一张）。
+#[test]
+fn stale_root_slot_after_an_applied_only_version() {
+    if std::env::var("R2_STALE").is_err() {
+        return;
+    }
+    let threads: usize = std::env::var("SINGLEFS_THREAD_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(1).max(1);
+    let b_values: Vec<usize> = std::env::var("R2_B").ok().map(|t| t.split(',').filter_map(|p| p.parse().ok()).collect()).unwrap_or((12..=26).collect());
+    let r_values: Vec<usize> = std::env::var("R2_R").ok().map(|t| t.split(',').filter_map(|p| p.parse().ok()).collect()).unwrap_or((2..=5).collect());
+    let a_values: Vec<usize> = std::env::var("R2_A").ok().map(|t| t.split(',').filter_map(|p| p.parse().ok()).collect()).unwrap_or(vec![1, 2, 3, 4]);
+    let mut combos: Vec<(usize, usize, usize, usize)> = Vec::new();
+    for a in a_values {
+        for r in r_values.iter().copied() {
+            for b in b_values.iter().copied() {
+                for c in 1..=2usize {
+                    combos.push((a, r, b, c));
+                }
+            }
+        }
+    }
+    println!("R2_STALE_COMBOS {}", combos.len());
+    let started = std::time::Instant::now();
+    let totals: Mutex<Totals> = Mutex::new(Totals::default());
+    let next = Mutex::new(0usize);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| {
+                let ring_mib: Option<u64> = std::env::var("R2_JRING_MIB").ok().and_then(|v| v.parse().ok());
+                let sw_units: Option<usize> = std::env::var("R2_SW_UNITS").ok().and_then(|v| v.parse().ok());
+                let start = Driver::after_first_file_with_journal_ring(ring_mib.map(|mib| mib << 20));
+                let mut local = Totals::default();
+                loop {
+                    let index = {
+                        let mut next = next.lock().expect("锁");
+                        let index = *next;
+                        *next += 1;
+                        index
+                    };
+                    let Some((a, r, b, c)) = combos.get(index).copied() else { break };
+                    let burn = |i: usize| match sw_units {
+                        Some(units) => Op::SequentialWrite { units, seed: 40 + i as u64 },
+                        None => ow(40 + i as u64),
+                    };
+                    let mut driver = start.fork();
+                    let mut ops = vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }];
+                    ops.extend((0..a).map(|i| ow(10 + i as u64)));
+                    let label_extra = format!("jring={ring_mib:?} sw={sw_units:?}");
+                    ops.push(Op::RollBack { index: r });
+                    ops.extend((0..b).map(burn));
+                    ops.push(Op::RollBackCrashBeforeRoot { index: c });
+                    ops.push(Op::Remount);
+                    let mut refused = None;
+                    for op in &ops {
+                        if let Outcome::Refused(reason) = driver.apply(*op) {
+                            refused = Some(format!("{op:?}: {}", reason.chars().take(80).collect::<String>()));
+                            break;
+                        }
+                    }
+                    if let Some(reason) = refused {
+                        note(&mut local, "stale:refused".to_string(), 1, 1, Some(format!("a={a} r={r} b={b} c={c} {reason}")));
+                        continue;
+                    }
+                    for d in 0..=26usize {
+                        if d > 0 {
+                            if let Outcome::Refused(reason) = driver.apply(ow(80 + d as u64)) {
+                                note(&mut local, "stale:refused".to_string(), 1, 1, Some(format!("a={a} r={r} b={b} c={c} d={d} {reason}")));
+                                break;
+                            }
+                        }
+                        let image = driver.image();
+                        judge_image(&mut local, &format!("stale {label_extra} a={a} r={r} b={b} c={c} d={d}"), "stale", &image);
+                    }
+                }
+                let mut totals = totals.lock().expect("锁");
+                totals.images += local.images;
+                for (key, entry) in local.by_key {
+                    let total = totals.by_key.entry(key).or_default();
+                    total.0 += entry.0;
+                    total.1 += entry.1;
+                    total.2 += entry.2;
+                    if total.3.is_none() {
+                        total.3 = entry.3;
+                    }
+                }
+            });
+        }
+    });
+    let totals = totals.into_inner().expect("锁");
+    println!("R2_DONE images={} seconds={:.1}", totals.images, started.elapsed().as_secs_f64());
+    for (key, (evaluated, violations, images_red, first)) in totals.by_key {
+        println!("R2 {key} evaluated={evaluated} violations={violations} images={images_red} first={}", first.unwrap_or_else(|| "-".into()));
+    }
+}
