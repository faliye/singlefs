+++ m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_r2_crash.rs	2026-10-02 13:00:17.662213156 +0000
@@ -0,0 +1,155 @@
+//! m3-birth-floor-r2 攻方原型（只在草稿副本上）：「根环旧槽 + journal 环绕回」那段合法历史（短环）停在一个起点，
+//! 之后一步（抬 F / 重新挂载 / 回退）录下写流，按层 0 的切段与全量展开枚举每个崩溃状态（`judge_layer0_state_range` 配 `full_expansion`，
+//! 与 `enumerate_layer0_versions` 同一个枚举域：每一段都展开、段内整写子集逐个、原地覆写带撕裂第三态），每个状态跑层 0 的整套判定
+//! （两种 journal 政策的恢复、两份 oracle、池级 checker、记录核对器），再在同一张崩溃镜像上判按树继承下界与 β。
+//! 每段跑之前用 `closed_form_state_count` 与带撕裂第三态的状态数算全量，超过 R2_MAX_STATES（默认 1_000_000）的那段不跑、只报数。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::proto_b::tree_floor_judgements;
+use singlefs_checker_tier::crash::{full_expansion, judge_layer0_state_range, layer0_state_count_with_torn_in_place_overwrites};
+use singlefs_core::address::{CheckpointTxg, InstanceGeneration};
+use singlefs_harness::memory_pool::{closed_form_state_count, writes_and_segments_with_stream_indexes, PublishedVersion};
+use singlefs_harness::segments::StepKind;
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+/// 起点：6 MiB 环（小盘那一档的环长）、建 300 个 inode、覆盖写、建 1 个 inode、覆盖写 2 次、回退到从新到旧第 3 条（txg 5）、
+/// 顺序写 72 单元 22 次、回退崩在根槽之前（第 1 条）、重新挂载。之后每多 `extra_overwrites` 次覆盖写另起一个起点。
+fn start_ops(units: usize, extra_overwrites: usize) -> Vec<Op> {
+    let mut ops = vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(10), ow(11), Op::RollBack { index: 3 }];
+    ops.extend((0..22).map(|i| Op::SequentialWrite { units, seed: 40 + i as u64 }));
+    ops.push(Op::RollBackCrashBeforeRoot { index: 1 });
+    ops.push(Op::Remount);
+    ops.extend((0..extra_overwrites).map(|d| ow(80 + d as u64 + 1)));
+    ops
+}
+
+#[test]
+fn tree_floor_over_crash_states_of_the_wrapped_history() {
+    let ring_mib: u64 = std::env::var("R2_JRING_MIB").ok().and_then(|v| v.parse().ok()).unwrap_or(6);
+    let units: usize = std::env::var("R2_SW_UNITS").ok().and_then(|v| v.parse().ok()).unwrap_or(72);
+    let extra: usize = std::env::var("R2_D").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    let suffix_names: Vec<String> = std::env::var("R2_SUFFIXES").unwrap_or_else(|_| "raiseTo8,raiseTo5,raiseTo9,remount,rb1".into()).split(',').map(str::to_string).collect();
+    let count_only = std::env::var("R2_COUNT_ONLY").is_ok();
+    let max_states: u64 = std::env::var("R2_MAX_STATES").ok().and_then(|v| v.parse().ok()).unwrap_or(1_000_000);
+    let threads: usize = std::env::var("SINGLEFS_THREAD_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(1).max(1);
+    let state_limit: Option<u64> = std::env::var("R2_STATE_LIMIT").ok().and_then(|v| v.parse().ok());
+    let mut start = Driver::after_first_file_with_journal_ring(Some(ring_mib << 20));
+    for op in start_ops(units, extra) {
+        assert!(matches!(start.apply(op), Outcome::Applied), "起点的 {op:?} 被拒");
+    }
+    let mut grand_total = 0u64;
+    for suffix_name in &suffix_names {
+        let suffix: Vec<Op> = match suffix_name.as_str() {
+            "raiseTo8" => vec![Op::RaiseFloorTo { txg: 8 }],
+            "raiseTo5" => vec![Op::RaiseFloorTo { txg: 5 }],
+            "raiseTo9" => vec![Op::RaiseFloorTo { txg: 9 }],
+            "remount" => vec![Op::Remount],
+            "rb1" => vec![Op::RollBack { index: 1 }],
+            "rb2" => vec![Op::RollBack { index: 2 }],
+            other => panic!("后缀 {other}"),
+        };
+        let name = format!("jring={ring_mib}MiB sw={units} d={extra} [{suffix_name}]");
+        let started = std::time::Instant::now();
+        let mut driver = start.fork();
+        let base = driver.image();
+        let mut outcomes = Vec::new();
+        for op in &suffix {
+            outcomes.push(format!("{op:?}:{}", match driver.apply(*op) { Outcome::Applied => "ok".to_string(), Outcome::Refused(reason) => format!("REFUSED {}", reason.chars().take(100).collect::<String>()) }));
+        }
+        let operations = driver.retained_operations();
+        let (writes, segments, _) = writes_and_segments_with_stream_indexes(&operations, &driver.geometry());
+        let closed = closed_form_state_count(&segments);
+        let torn = layer0_state_count_with_torn_in_place_overwrites(&base, &writes, &segments, &full_expansion);
+        println!("R2C_HISTORY name={name} writes={} segments={} closed_form_states={closed} layer0_states={torn} outcomes={outcomes:?}", writes.len(), segments.len());
+        if count_only || writes.is_empty() {
+            continue;
+        }
+        if torn > max_states {
+            println!("R2C_SKIPPED name={name} layer0_states={torn} > {max_states}");
+            continue;
+        }
+        let Some(judged_root_index) = writes.iter().rposition(|write| write.kind == StepKind::RootRecordFua) else {
+            println!("R2C_SKIPPED name={name} 没有根槽写");
+            continue;
+        };
+        let versions: Vec<PublishedVersion> = driver
+            .contents
+            .iter()
+            .map(|((instance, txg), content)| PublishedVersion {
+                instance: InstanceGeneration(u32::try_from(*instance).expect("实例号")),
+                checkpoint_txg: CheckpointTxg(*txg),
+                content: content.clone(),
+            })
+            .collect();
+        // 只为估时与分批：R2_STATE_START 起、R2_STATE_LIMIT 个（正式跑不设，或按批把 [0, 全量) 拼满）。
+        let first_state: u64 = std::env::var("R2_STATE_START").ok().and_then(|v| v.parse().ok()).unwrap_or(0).min(torn);
+        let judged = state_limit.map_or(torn - first_state, |limit| limit.min(torn - first_state));
+        let aggregate: Mutex<BTreeMap<String, (u64, u64, u64, Option<String>)>> = Mutex::new(BTreeMap::new());
+        let chunk = judged.div_ceil(threads as u64);
+        std::thread::scope(|scope| {
+            for thread in 0..threads as u64 {
+                let range = first_state + (thread * chunk).min(judged)..first_state + ((thread + 1) * chunk).min(judged);
+                let (base, writes, segments, versions, aggregate, name) = (&base, &writes, &segments, &versions, &aggregate, &name);
+                scope.spawn(move || {
+                    let mut local: BTreeMap<String, (u64, u64, u64, Option<String>)> = BTreeMap::new();
+                    let mut note = |key: String, evaluated: u64, violations: u64, first: Option<String>| {
+                        let entry = local.entry(key).or_default();
+                        entry.0 += evaluated;
+                        entry.1 += violations;
+                        entry.2 += u64::from(violations > 0);
+                        if entry.3.is_none() && violations > 0 {
+                            entry.3 = first;
+                        }
+                    };
+                    let _ = judge_layer0_state_range(base, writes, segments, judged_root_index, versions, &full_expansion, range, &mut |ordinal, image, judgement| {
+                        let red = judgement.red_items();
+                        note("layer0-red-states".into(), 1, u64::from(!red.is_empty()), Some(format!("{name} state={ordinal} {red:?}")));
+                        let i31 = judgement.pool_checker.iter().find(|(invariant, _)| *invariant == "I-3.1").map(|(_, verdict)| match verdict {
+                            InvariantVerdict::Holds => "holds",
+                            InvariantVerdict::Violated(_) => "violated",
+                            InvariantVerdict::NotApplicable(_) => "not-applicable",
+                        }).unwrap_or("absent");
+                        let tallies = if std::env::var("R2_NO_TF").is_ok() { BTreeMap::new() } else { tree_floor_judgements(image) };
+                        let tf_red = tallies.get("CS2:tf-lenient").is_some_and(|tally| tally.violations > 0);
+                        let beta_red = tallies.get("CS2:beta-lenient").is_some_and(|tally| tally.violations > 0);
+                        for (key, tally) in &tallies {
+                            if key.starts_with("CS2:tf") || key.starts_with("CS2:beta") {
+                                note(format!("crash:{key}"), tally.evaluated, tally.violations, tally.first_violation.clone().map(|text| format!("{name} state={ordinal} :: {text}")));
+                            }
+                        }
+                        note(format!("state:I-3.1={i31}"), 1, 1, Some(format!("{name} state={ordinal}")));
+                        if tf_red {
+                            note(format!("tf-red-state:I-3.1={i31}"), 1, 1, Some(format!("{name} state={ordinal} layer0_red={red:?}")));
+                            note("tf-red-state:layer0-green".into(), 1, u64::from(red.is_empty()), Some(format!("{name} state={ordinal} versions={}", tallies.get("CS2:versions").and_then(|t| t.first_violation.clone()).unwrap_or_default())));
+                        }
+                        if beta_red {
+                            note("beta-red-state:layer0-green".into(), 1, u64::from(red.is_empty()), Some(format!("{name} state={ordinal}")));
+                        }
+                    });
+                    let mut aggregate = aggregate.lock().expect("锁");
+                    for (key, entry) in local {
+                        let total = aggregate.entry(key).or_default();
+                        total.0 += entry.0;
+                        total.1 += entry.1;
+                        total.2 += entry.2;
+                        if total.3.is_none() {
+                            total.3 = entry.3;
+                        }
+                    }
+                });
+            }
+        });
+        grand_total += judged;
+        println!("R2C_DONE name={name} states={judged} from={first_state} of={torn} seconds={:.1}", started.elapsed().as_secs_f64());
+        for (key, (evaluated, violations, states, first)) in aggregate.into_inner().expect("锁") {
+            println!("R2C name={name} :: {key} evaluated={evaluated} violations={violations} states={states} first={}", first.unwrap_or_else(|| "-".into()));
+        }
+    }
+    println!("R2C_TOTAL states_judged={grand_total}");
+}
diff -ruN '--exclude=target' m3-batch5-freeze/tree/crates/bf-proto/tests/bf_r2_sweep.rs m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_r2_sweep.rs
--- m3-batch5-freeze/tree/crates/bf-proto/tests/bf_r2_sweep.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_r2_sweep.rs	2026-10-02 13:01:17.584483606 +0000
@@ -0,0 +1,356 @@
+//! m3-birth-floor-r2 攻方原型（只在草稿副本上）：合法历史的终态镜像上判按树继承下界（TF）与 β 出现规则，
+//! 回退前的前缀固定几种，回退的方式（挂着回退 / 回退崩在根槽之前再挂载）与回退目标逐个取，回退之后的用户动作放开扫（长度 0–2 的全部序列），
+//! 每张终态镜像再叠「根环里一条根槽读坏」（逐条、相邻两条）。每张镜像跑池级 checker 与两个谓词。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::{chosen_system_configurations, valid_roots, ImageReader, InvariantVerdict};
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::tree_floor_judgements;
+use singlefs_core::address::{DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_harness::memory_pool::MemoryPool;
+
+const SLOT: u64 = 16384;
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+/// 根环里读得出的每条根：(txg, 实例, 盘, 偏移)。区域 r 在盘 [0, 1, 0][r] 上，起点 64 × 16384 + r × 3 MiB，槽距 4096。
+pub fn ring_roots(image: &MemoryPool) -> Vec<(u64, u32, u32, u64)> {
+    let Some(geometry) = chosen_system_configurations(image).into_iter().find_map(|(_, chosen)| chosen.map(|(_, geometry)| geometry)) else {
+        return Vec::new();
+    };
+    let mut roots: Vec<(u64, u32, u32, u64)> = valid_roots(image as &dyn ImageReader, &geometry)
+        .into_iter()
+        .map(|(region, slot, view)| {
+            let device = [0u32, 1, 0][usize::try_from(region).expect("区域")];
+            (view.checkpoint_txg, view.instance, device, 64 * SLOT + region * 3 * (1 << 20) + slot * 4096)
+        })
+        .collect();
+    roots.sort_unstable();
+    roots
+}
+
+fn zero_root(image: &mut MemoryPool, device: u32, offset: u64) {
+    image.devices.get_mut(&DeviceIdentity(device)).expect("盘").write(DeviceOffsetInBytes(offset), &[0u8; 4096]);
+}
+
+fn prefix(name: &str) -> Vec<Op> {
+    match name {
+        "A" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2)],
+        "B" => vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }],
+        "C" => vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }, ow(2), Op::NewInodes { count: 2 }, ow(3)],
+        other => panic!("前缀 {other}"),
+    }
+}
+
+fn alphabet() -> Vec<(&'static str, Op)> {
+    let mut letters = base_alphabet();
+    if std::env::var("R2_ALPHA").is_ok_and(|alpha| alpha == "raise") {
+        letters.push(("raise5", Op::RaiseFloorBy { steps: 5 }));
+        letters.push(("raise6", Op::RaiseFloorBy { steps: 6 }));
+        letters.push(("raise7", Op::RaiseFloorBy { steps: 7 }));
+    }
+    letters
+}
+
+fn base_alphabet() -> Vec<(&'static str, Op)> {
+    vec![
+        ("ow", ow(9)),
+        ("ni1", Op::NewInodes { count: 1 }),
+        ("ni240", Op::NewInodes { count: 240 }),
+        ("sw2", Op::SequentialWrite { units: 2, seed: 5 }),
+        ("raise1", Op::RaiseFloorBy { steps: 1 }),
+        ("raise3", Op::RaiseFloorBy { steps: 3 }),
+        ("remount", Op::Remount),
+        ("rb1", Op::RollBack { index: 1 }),
+        ("rb3", Op::RollBack { index: 3 }),
+    ]
+}
+
+type Job = (String, &'static str, Vec<Op>);
+
+fn jobs() -> Vec<Job> {
+    let letters = alphabet();
+    let mut suffixes: Vec<(String, Vec<Op>)> = vec![(String::new(), Vec::new())];
+    for (a, op_a) in &letters {
+        suffixes.push((format!("{a}"), vec![*op_a]));
+        for (b, op_b) in &letters {
+            suffixes.push((format!("{a},{b}"), vec![*op_a, *op_b]));
+        }
+    }
+    if std::env::var("R2_ALPHA").is_ok_and(|alpha| alpha == "raise") {
+        // 只留至少带一次 raise5 / raise6 / raise7 的后缀（其余在基础字母表那一遍里跑过）。
+        suffixes.retain(|(name, _)| name.split(',').any(|letter| matches!(letter, "raise5" | "raise6" | "raise7")));
+    }
+    let only_prefix = std::env::var("R2_PREFIX").ok();
+    let mut out = Vec::new();
+    for prefix_name in ["A", "B", "C"] {
+        if only_prefix.as_ref().is_some_and(|only| only != prefix_name) {
+            continue;
+        }
+        for target in 1..=4usize {
+            for crash in [false, true] {
+                let mut head: Vec<Op> = Vec::new();
+                let mode = if crash {
+                    head.push(Op::RollBackCrashBeforeRoot { index: target });
+                    head.push(Op::Remount);
+                    format!("rbcrash{target}-remount")
+                } else {
+                    head.push(Op::RollBack { index: target });
+                    format!("rb{target}")
+                };
+                for (suffix_name, suffix) in &suffixes {
+                    let mut ops = head.clone();
+                    ops.extend(suffix.iter().copied());
+                    out.push((format!("{prefix_name}/{mode}/[{suffix_name}]"), prefix_name, ops));
+                }
+            }
+        }
+    }
+    out
+}
+
+#[derive(Default)]
+struct Totals {
+    images: u64,
+    by_key: BTreeMap<String, (u64, u64, u64, Option<String>)>,
+}
+
+fn note(totals: &mut Totals, key: String, evaluated: u64, violations: u64, first: Option<String>) {
+    let entry = totals.by_key.entry(key).or_default();
+    entry.0 += evaluated;
+    entry.1 += violations;
+    entry.2 += u64::from(violations > 0);
+    if entry.3.is_none() && violations > 0 {
+        entry.3 = first;
+    }
+}
+
+fn judge_image(totals: &mut Totals, label: &str, fault: &str, image: &MemoryPool) {
+    totals.images += 1;
+    let verdicts = check_pool_image(image);
+    if std::env::var("R2_SHOW").is_ok_and(|show| label.contains(show.as_str())) {
+        for (invariant, verdict) in &verdicts {
+            if let InvariantVerdict::Violated(detail) = verdict {
+                println!("R2_SHOW_POOL {label} {invariant} {}", detail.chars().take(1500).collect::<String>());
+            }
+        }
+    }
+    let pool_red: Vec<&str> = verdicts
+        .into_iter()
+        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+        .map(|(invariant, _)| invariant)
+        .collect();
+    note(totals, format!("{fault}:pool-checker"), 1, u64::from(!pool_red.is_empty()), Some(format!("{label} {pool_red:?}")));
+    let judgements = tree_floor_judgements(image);
+    if std::env::var("R2_SHOW").is_ok_and(|show| label.contains(show.as_str())) {
+        for (key, tally) in &judgements {
+            println!("R2_SHOW {label} {key} evaluated={} violations={} first={}", tally.evaluated, tally.violations, tally.first_violation.clone().unwrap_or_default());
+        }
+    }
+    for (key, tally) in &judgements {
+        if !(key.contains(":tf") || key.contains(":beta") || key.contains("na-pair") || key.contains("unreadable") || key.contains("reappear") || key.contains("gap-skipped")) {
+            continue;
+        }
+        let violations = if key.contains("na-pair") || key.contains("unreadable") || key.contains("reappear") || key.contains("gap-skipped") { tally.evaluated } else { tally.violations };
+        note(totals, format!("{fault}:{key}"), tally.evaluated, violations, tally.first_violation.clone().map(|text| format!("{label} :: {text}")));
+        if tally.violations > 0 && (key.starts_with("CS2:tf") || key.starts_with("CS2:beta")) {
+            println!("R2_RED {label} fault={fault} {key} violations={} pool_red={pool_red:?} first={}", tally.violations, tally.first_violation.clone().unwrap_or_default());
+            if let Some(versions) = judgements.get("CS2:versions") {
+                println!("R2_RED_VERSIONS {label} fault={fault} {}", versions.first_violation.clone().unwrap_or_default());
+            }
+        }
+    }
+}
