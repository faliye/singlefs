+    let (new_leaf, first_inode) = leaves6[0];
+    let (old_leaf, _) = *leaves4.iter().find(|(_, first)| *first == first_inode).expect("txg 4 里同一段 inode 号的那片叶");
+    let units = units_of(&clean);
+    let new_sum = checksum_of(&clean, new_leaf, 32768);
+    let old_sum = checksum_of(&clean, old_leaf, 32768);
+    // 旧叶的指针字节：从任一引用它的码 2 节点里取。
+    let mut old_pointer: Option<Vec<u8>> = None;
+    let mut parent7: Option<u64> = None;
+    for (slot, length) in &units {
+        let bytes = read(&clean, 0, slot * SLOT, *length);
+        if bytes[6] != 2 {
+            continue;
+        }
+        if old_pointer.is_none() {
+            if let Some(start) = pointer_start_in(&bytes, old_leaf, old_sum) {
+                old_pointer = Some(bytes[start..start + 86].to_vec());
+            }
+        }
+        if get_u64(&bytes, birth_offset(&bytes)) == 7 && !matches!(bytes[51], 10 | 22 | 24 | 27) && pointer_start_in(&bytes, new_leaf, new_sum).is_some() {
+            println!("BJ J3-d candidate parent slot={slot} key_width={}", bytes[51]);
+            parent7 = Some(*slot);
+        }
+    }
+    let old_pointer = old_pointer.expect("旧叶的指针");
+    let parent7 = parent7.expect("txg 7 的 inode 树根");
+    println!("BJ J3-d new_leaf={new_leaf} old_leaf={old_leaf} parent7={parent7}");
+    let step: u32 = std::env::var("BJ_STEP").ok().and_then(|v| v.parse().ok()).unwrap_or(2);
+    let mut bad = clean.clone();
+    let before = read(&bad, 0, parent7 * SLOT, 16384);
+    let mut bytes = before.clone();
+    let start = pointer_start_in(&bytes, new_leaf, new_sum).expect("指针");
+    bytes[start..start + 86].copy_from_slice(&old_pointer);
+    reseal_unit(&mut bytes);
+    for device in DEVICES {
+        write(&mut bad, device, parent7 * SLOT, &bytes);
+    }
+    propagate(&mut bad, &units, vec![(parent7, crc32_castagnoli(&before), crc32_castagnoli(&bytes))]);
+    report("J3-d/step1-pointer", &bad);
+    if step >= 2 {
+        // txg 7 那棵分配记录树的叶（key 宽 10、诞生代号 7）：新叶的两条记成已释放、释放代 7；旧叶的两条记成未释放、分配代 4。
+        let units = units_of(&bad);
+        let mut changes = Vec::new();
+        for (container, length) in units.iter().copied() {
+            let container_before = read(&bad, 0, container * SLOT, length);
+            if container_before[6] != 2 || container_before[51] != 10 || get_u64(&container_before, birth_offset(&container_before)) != 7 {
+                continue;
+            }
+            let mut container_bytes = container_before.clone();
+            let count = usize::from(u16::from_le_bytes([container_bytes[102], container_bytes[103]]));
+            let mut touched = 0;
+            for index in 0..count {
+                let record = 135 + 20 * index;
+                let mut slot_bytes = [0u8; 8];
+                slot_bytes[..6].copy_from_slice(&container_bytes[record + 4..record + 10]);
+                let slot = u64::from_le_bytes(slot_bytes);
+                let span = u16::from_le_bytes([container_bytes[record + 10], container_bytes[record + 11]]);
+                if slot == new_leaf && span & 0x8000 == 0 {
+                    container_bytes[record + 10..record + 12].copy_from_slice(&(span | 0x8000).to_le_bytes());
+                    set_u64(&mut container_bytes, record + 12, 7);
+                    touched += 1;
+                } else if slot == old_leaf && span & 0x8000 != 0 {
+                    container_bytes[record + 10..record + 12].copy_from_slice(&(span & 0x7fff).to_le_bytes());
+                    set_u64(&mut container_bytes, record + 12, 4);
+                    touched += 1;
+                }
+            }
+            if touched > 0 {
+                println!("BJ J3-d allocation leaf {container} records_touched={touched}");
+                reseal_unit(&mut container_bytes);
+                for device in DEVICES {
+                    write(&mut bad, device, container * SLOT, &container_bytes);
+                }
+                changes.push((container, crc32_castagnoli(&container_before), crc32_castagnoli(&container_bytes)));
+            }
+        }
+        propagate(&mut bad, &units, changes);
+        report("J3-d/step2-allocation", &bad);
+    }
+    if step >= 3 {
+        // txg 7 那棵中央映射树的根（key 宽 27、诞生代号 7）：新叶那一条（key 27 + 两条位置条目 28）换成旧叶的那一条（从引用它的更早的映射根里取），
+        // 节点头里的最小 / 最大 key 是它的跟着换。
+        let units = units_of(&bad);
+        let new_sum_now = checksum_of(&bad, new_leaf, 32768);
+        let old_sum_now = checksum_of(&bad, old_leaf, 32768);
+        let mut old_entry: Option<Vec<u8>> = None;
+        let mut mapping7: Option<u64> = None;
+        for (slot, length) in &units {
+            let bytes = read(&bad, 0, slot * SLOT, *length);
+            if bytes[6] != 2 || bytes[51] != 27 {
+                continue;
+            }
+            if old_entry.is_none() {
+                if let Some(position) = positions(&bytes, &location_pattern(0, old_leaf, old_sum_now)).first() {
+                    old_entry = Some(bytes[position - 27..position + 28].to_vec());
+                }
+            }
+            if get_u64(&bytes, birth_offset(&bytes)) == 7 && !positions(&bytes, &location_pattern(0, new_leaf, new_sum_now)).is_empty() {
+                mapping7 = Some(*slot);
+            }
+        }
+        match (old_entry, mapping7) {
+            (Some(old_entry), Some(mapping7)) => {
+                let before = read(&bad, 0, mapping7 * SLOT, 16384);
+                let mut bytes = before.clone();
+                let position = positions(&bytes, &location_pattern(0, new_leaf, new_sum_now))[0];
+                let old_key = bytes[position - 27..position].to_vec();
+                bytes[position - 27..position + 28].copy_from_slice(&old_entry);
+                for header_key in [52usize, 52 + 27] {
+                    if bytes[header_key..header_key + 27] == old_key[..] {
+                        bytes[header_key..header_key + 27].copy_from_slice(&old_entry[..27]);
+                    }
+                }
+                reseal_unit(&mut bytes);
+                for device in DEVICES {
+                    write(&mut bad, device, mapping7 * SLOT, &bytes);
+                }
+                println!("BJ J3-d mapping root {mapping7} entry replaced (old key {:?} → new key {:?})", &old_key[..12], &old_entry[..12]);
+                propagate(&mut bad, &units, vec![(mapping7, crc32_castagnoli(&before), crc32_castagnoli(&bytes))]);
+                report("J3-d/step3-mapping", &bad);
+            }
+            other => println!("BJ J3-d step3 找不到映射条目 {:?}", (other.0.is_some(), other.1)),
+        }
+    }
+}
+
+#[test]
+fn one_copy_unreadable_under_an_inherited_tree() {
+    // 「压得住」两种读法在合法镜像上：覆盖写 4 次、回退到从新到旧第 4 条（txg 4）、抬 F 到 5（回退目标离开候选集，回退根 txg 8
+    // 整棵继承 txg 4 的用户可见树）。把继承来的子树里一个单元的盘 1 那一份抹成 0（一份介质坏，另一份完好），逐个判。
+    let ops = [ow(1), ow(2), ow(3), ow(4), Op::RollBack { index: 3 }, Op::RaiseFloorTo { txg: 5 }];
+    let clean = image_after(&ops);
+    report("one-copy/clean", &clean);
+    let units = units_of(&clean);
+    for (slot, length) in units {
+        let bytes = read(&clean, 0, slot * SLOT, length.min(4096));
+        let birth = get_u64(&bytes, birth_offset(&bytes));
+        if birth > 4 || birth < 3 || !matches!(bytes[6], 1 | 3) && !(bytes[6] == 2 && matches!(bytes[51], 8 | 24)) {
+            continue;
+        }
+        let mut bad = clean.clone();
+        write(&mut bad, 1, slot * SLOT, &vec![0u8; length]);
+        report(&format!("one-copy slot={slot} class={} key_width={} birth={birth}", bytes[6], bytes[51]), &bad);
+    }
+}
