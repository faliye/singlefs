+[package]
+name = "bf-proto"
+version = "0.1.0"
+publish = false
+edition = "2021"
+description = "m3-birth-floor-r1 攻方原型（只在草稿副本上）：诞生代号下界三种写法在合法历史、崩溃状态与坏镜像上"
+
+[dependencies]
+singlefs-checker = { path = "../singlefs-checker" }
+singlefs-core = { path = "../singlefs-core" }
+singlefs-format = { path = "../singlefs-format" }
+singlefs-harness = { path = "../singlefs-harness" }
+singlefs-checker-tier = { path = "../singlefs-checker-tier" }
diff -ruN '--exclude=target' m3-batch5-freeze/tree/crates/bf-proto/src/lib.rs m3-birth-floor-r2-opus/tree/crates/bf-proto/src/lib.rs
--- m3-batch5-freeze/tree/crates/bf-proto/src/lib.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r2-opus/tree/crates/bf-proto/src/lib.rs	2026-10-02 12:17:42.523606222 +0000
@@ -0,0 +1,363 @@
+//! m3-birth-floor-r1 攻方原型的驱动（只在草稿副本上）：内存稀疏盘上建池，按一串操作推进，每步之后交整份镜像；
+//! 录制流开内容保留，崩溃状态按层 0 的切段与全量展开枚举（`singlefs_checker_tier::crash::judge_layer0_state_range`）。
+use std::collections::BTreeMap;
+
+use singlefs_checker::image::{chosen_system_configurations, valid_roots, ImageReader};
+use singlefs_core::address::{CheckpointTxg, DeviceIdentity, InstanceGeneration};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::make_filesystem::{allocator_after_make_filesystem, make_filesystem, MakeFilesystemParameters};
+use singlefs_core::mount::{
+    mount_writable, raise_rollback_floor, roll_back_by_a_forward_publish, ParametersAndDeviceTableOfTheMount,
+    RollbackTarget, ShadowLedger,
+};
+use singlefs_core::mounted_session::{MountedSession, UserChange};
+use singlefs_core::transaction::{acquire_instance, publish_first_file, warm_up, FirstFile, PoolVersion, PoolWriter};
+use singlefs_core::unit::data_unit_payload_capacity;
+use singlefs_harness::history::HistoryDeviceWidth;
+use singlefs_harness::memory_pool::{MemoryPool, SparseBlockDevice};
+use singlefs_harness::scenario::{first_file_content, FIXED_WRITE_TIME_SECONDS};
+use singlefs_harness::segments::FixedGeometry;
+use singlefs_harness::{RecordingBlockDevice, RetainedOperation, SharedStream};
+
+pub type Device = RecordingBlockDevice<SparseBlockDevice>;
+
+/// 驱动的一步。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Op {
+    /// 覆盖写一个数据单元以内的内容（字节数、填充种子）。
+    Overwrite { bytes: usize, seed: u64 },
+    /// 顺序写 `units` 个满数据单元。
+    SequentialWrite { units: usize, seed: u64 },
+    /// 建 `count` 个空 inode。
+    NewInodes { count: u64 },
+    /// 回退到根环里从新到旧第 `index` 条（按 (txg, 实例) 排、去重）。
+    RollBack { index: usize },
+    /// 抬 F 到 `txg`。
+    RaiseFloorTo { txg: u64 },
+    /// 抬 F：现行 F 加 `steps`。
+    RaiseFloorBy { steps: u64 },
+    /// 关掉会话、重新可写挂载（写行与暖机）。
+    Remount,
+    /// 回退那次发布崩在根槽 FUA 之前：它的单元与记录（与之前的屏障）都已持久、根槽写与之后的写都没持久；会话随进程一起没了。
+    /// 之后接 `Remount`：恢复按记录施加出这一版（D23（journal 的角色与格式） 已定项 15），根槽从没落盘。
+    RollBackCrashBeforeRoot { index: usize },
+}
+
+/// 一步的结局。
+#[derive(Clone, Debug)]
+pub enum Outcome {
+    Applied,
+    Refused(String),
+}
+
+pub struct Driver {
+    pub width: HistoryDeviceWidth,
+    pub parameters: MakeFilesystemParameters,
+    pub devices: Vec<(DeviceIdentity, Device)>,
+    pub stream: SharedStream,
+    pub session: Option<MountedSession>,
+    /// (实例, txg) → 那一版的文件内容（层 0 oracle 的版本表用）。
+    pub contents: BTreeMap<(u64, u64), Vec<u8>>,
+    pub step: u64,
+    before_content: Option<Vec<u8>>,
+    /// 最近一次记下的文件内容：崩溃之后会话没了、现行版本读不到时，挂载写出的那几条根照它记。
+    last_content: Option<Vec<u8>>,
+}
+
+fn content_of(bytes: usize, seed: u64) -> Vec<u8> {
+    (0..bytes)
+        .map(|index| u8::try_from((index as u64).wrapping_mul(31).wrapping_add(seed * 7) % 251).expect("小于 256"))
+        .collect()
+}
+
+impl Driver {
+    /// mkfs → 取号 → 暖机 → 新池新建文件（同一个进程，会话照 history 起点 AfterFirstFile 那样建）。
+    #[must_use]
+    pub fn after_first_file() -> Self {
+        Self::after_first_file_with_journal_ring(None)
+    }
+
+    /// 同 [`Self::after_first_file`]，journal 环长可另给（m3-birth-floor-r2：环绕回那一形要一条短环）。
+    #[must_use]
+    pub fn after_first_file_with_journal_ring(journal_ring_bytes: Option<u64>) -> Self {
+        let width = HistoryDeviceWidth::FourGibibytes;
+        let mut parameters = width.parameters();
+        if let Some(bytes) = journal_ring_bytes {
+            parameters.geometry.journal_ring_bytes = bytes;
+        }
+        let stream = SharedStream::retaining_contents();
+        let mut devices: Vec<(DeviceIdentity, Device)> = [DeviceIdentity(0), DeviceIdentity(1)]
+            .into_iter()
+            .map(|identity| {
+                (
+                    identity,
+                    RecordingBlockDevice::with_shared_stream(
+                        identity,
+                        SparseBlockDevice::new(width.device_bytes(), PhysicalBlockSizeInBytes(512)),
+                        stream.clone(),
+                    ),
+                )
+            })
+            .collect();
+        let genesis = make_filesystem(&parameters, &mut devices).expect("mkfs");
+        let mut allocator = allocator_after_make_filesystem(&parameters, &devices, &genesis);
+        let parameters_and_device_table =
+            ParametersAndDeviceTableOfTheMount::of_a_pool_on_disk(&devices).expect("读池");
+        let content = first_file_content();
+        let (instance, output) = {
+            let mut writer = PoolWriter::new(&parameters, &mut devices);
+            let instance = acquire_instance(&mut writer).expect("取号");
+            let warmed = warm_up(&mut writer, &genesis.root, instance).expect("暖机");
+            let output = publish_first_file(
+                &mut writer,
+                &mut allocator,
+                warmed.roots.last().expect("暖机两代根"),
+                FirstFile { content: &content, write_time_seconds: FIXED_WRITE_TIME_SECONDS },
+                instance,
+                &warmed.last_record_bytes,
+            )
+            .expect("第一个文件");
+            (instance, output)
+        };
+        let mut contents = BTreeMap::new();
+        contents.insert((instance.0.into(), output.root.checkpoint_txg.0), content);
+        let session = MountedSession {
+            allocator,
+            current: PoolVersion::WithFile(output),
+            instance,
+            shadow_ledger: ShadowLedger::On,
+            parameters_and_device_table,
+        };
+        Driver { width, parameters, devices, stream, session: Some(session), contents, step: 0, before_content: None, last_content: None }
+    }
+
+    /// 从这个起点另起一份：盘的字节、会话与版本表拷一份，录制流新开一条（空的）。起点只建一次池，每段历史从它拷。
+    #[must_use]
+    pub fn fork(&self) -> Self {
+        let stream = SharedStream::retaining_contents();
+        let devices = self
+            .devices
+            .iter()
+            .map(|(identity, device)| {
+                let mut sparse = SparseBlockDevice::new(self.width.device_bytes(), PhysicalBlockSizeInBytes(512));
+                sparse.image = device.wrapped_device().image.clone();
+                (*identity, RecordingBlockDevice::with_shared_stream(*identity, sparse, stream.clone()))
+            })
+            .collect();
+        let session = self.session.as_ref().map(|session| MountedSession {
+            allocator: session.allocator.clone(),
+            current: session.current.clone(),
+            instance: session.instance,
+            shadow_ledger: session.shadow_ledger,
+            parameters_and_device_table: session.parameters_and_device_table.clone(),
+        });
+        Driver {
+            width: self.width,
+            parameters: self.parameters.clone(),
+            devices,
+            stream,
+            session,
+            contents: self.contents.clone(),
+            step: self.step,
+            before_content: None,
+            last_content: self.last_content.clone(),
+        }
+    }
+
+    #[must_use]
+    pub fn image(&self) -> MemoryPool {
+        MemoryPool {
+            devices: self
+                .devices
+                .iter()
+                .map(|(identity, device)| (*identity, device.wrapped_device().image.clone()))
+                .collect(),
+            device_size_in_bytes: self.width.device_bytes(),
+        }
+    }
+
+    #[must_use]
+    pub fn geometry(&self) -> FixedGeometry {
+        FixedGeometry {
+            fixed_structure_slot_spacing: self.parameters.geometry.fixed_structure_slot_spacing,
+            journal_ring_bytes: self.parameters.geometry.journal_ring_bytes,
+            root_ring_slots_per_region: self.parameters.geometry.root_ring_slots_per_region,
+        }
+    }
+
+    #[must_use]
+    pub fn retained_operations(&self) -> Vec<RetainedOperation> {
+        self.stream.retained_operations()
+    }
+
+    fn current_content(&self) -> Option<Vec<u8>> {
+        let session = self.session.as_ref()?;
+        let version = session.current.file_version()?;
+        self.contents.get(&(session.instance.0.into(), version.root.checkpoint_txg.0)).cloned()
+    }
+
+    /// 现行那一版记成 `content`；这一步里新出现在根环里、txg 低于现行那一版的根（推的抬 F 空发布、写行与暖机）记成 `before`。
+    fn note_current(&mut self, content: Option<Vec<u8>>) {
+        let before = self.before_content.take();
+        let Some(session) = self.session.as_ref() else { return };
+        let Some(version) = session.current.file_version() else { return };
+        let key = (u64::from(version.root.instance.0), version.root.checkpoint_txg.0);
+        let current_txg = version.root.checkpoint_txg.0;
+        if let Some(content) = content {
+            self.last_content = Some(content.clone());
+            self.contents.insert(key, content);
+        }
+        if let Some(before) = before.or_else(|| self.last_content.clone()) {
+            for (txg, instance) in self.ring_roots_newest_first() {
+                let key = (u64::from(instance), txg);
+                if txg < current_txg && !self.contents.contains_key(&key) {
+                    self.contents.insert(key, before.clone());
+                }
+            }
+        }
+    }
+
+    /// 根环里读得出的根，(txg, 实例) 从新到旧、去重。
+    #[must_use]
+    pub fn ring_roots_newest_first(&self) -> Vec<(u64, u32)> {
+        let image = self.image();
+        let Some(geometry) = chosen_system_configurations(&image)
+            .into_iter()
+            .find_map(|(_, chosen)| chosen.map(|(_, geometry)| geometry))
+        else {
+            return Vec::new();
+        };
+        let mut roots: Vec<(u64, u32)> =
+            valid_roots(&image as &dyn ImageReader, &geometry).into_iter().map(|(_, _, view)| (view.checkpoint_txg, view.instance)).collect();
+        roots.sort_unstable_by(|left, right| right.cmp(left));
+        roots.dedup();
+        roots
+    }
+
+    fn apply_rollback(&mut self, index: usize) -> Outcome {
+                let roots = self.ring_roots_newest_first();
+            let Some((txg, instance)) = roots.get(index.min(roots.len().saturating_sub(1))).copied() else {
+                return Outcome::Refused("根环空".into());
+            };
+            let target_content = self.contents.get(&(u64::from(instance), txg)).cloned();
+            let Some(session) = self.session.as_mut() else { return Outcome::Refused("没有会话".into()) };
+            let PoolVersion::WithFile(current) = &mut session.current else {
+                return Outcome::Refused("现行版本没有文件".into());
+            };
+            match roll_back_by_a_forward_publish(
+                &self.parameters,
+                &mut self.devices,
+                &mut session.allocator,
+                current,
+                RollbackTarget { instance: InstanceGeneration(instance.into()), checkpoint_txg: CheckpointTxg(txg) },
+            ) {
+                Ok(_) => {
+                    self.note_current(target_content);
+                    Outcome::Applied
+                }
+                Err(error) => Outcome::Refused(format!("{error:?}")),
+            }
+    }
+
+    pub fn apply(&mut self, op: Op) -> Outcome {
+        self.step += 1;
+        let write_time_seconds = FIXED_WRITE_TIME_SECONDS + self.step;
+        let before_content = self.current_content().or_else(|| self.last_content.clone());
+        self.before_content = before_content.clone();
+        match op {
+            Op::Overwrite { bytes, seed } | Op::SequentialWrite { units: bytes, seed } => {
+                let content = match op {
+                    Op::Overwrite { .. } => content_of(bytes.min(data_unit_payload_capacity()), seed),
+                    _ => content_of(bytes * data_unit_payload_capacity(), seed),
+                };
+                let Some(session) = self.session.as_mut() else { return Outcome::Refused("没有会话".into()) };
+                let file = FirstFile { content: &content, write_time_seconds };
+                let change = match op {
+                    Op::Overwrite { .. } => UserChange::Overwrite(file),
+                    _ => UserChange::SequentialWrite(file),
+                };
+                match session.publish_user_change(&mut self.devices, change) {
+                    Ok(published) => {
+                        // 推过的抬 F 空发布：内容不变。
+                        let _ = published;
+                        self.note_current(Some(content));
+                        Outcome::Applied
+                    }
+                    Err(error) => Outcome::Refused(format!("{error:?}")),
+                }
+            }
+            Op::NewInodes { count } => {
+                let Some(session) = self.session.as_mut() else { return Outcome::Refused("没有会话".into()) };
+                match session.publish_user_change(&mut self.devices, UserChange::NewInodes { count, write_time_seconds }) {
+                    Ok(_) => {
+                        self.note_current(before_content);
+                        Outcome::Applied
+                    }
+                    Err(error) => Outcome::Refused(format!("{error:?}")),
+                }
+            }
+            Op::RollBackCrashBeforeRoot { index } => {
+                let image_before = self.image();
+                let operations_before = self.stream.retained_operations().len();
+                let outcome = self.apply_rollback(index);
+                if !matches!(outcome, Outcome::Applied) {
+                    return outcome;
+                }
+                let operations = self.stream.retained_operations();
+                let (writes, _) = singlefs_harness::memory_pool::writes_and_segments(&operations[operations_before..], &self.geometry());
+                let first_root = writes
+                    .iter()
+                    .position(|write| write.kind == singlefs_harness::segments::StepKind::RootRecordFua)
+                    .expect("回退那次发布写根槽");
+                for (identity, device) in &mut self.devices {
+                    let mut image = image_before.devices.get(identity).expect("盘").clone();
+                    for write in writes[..first_root].iter().filter(|write| write.device == *identity) {
+                        write.contents.apply_to(&mut image, write.offset);
+                    }
+                    device.wrapped_device_mut().image = image;
+                }
+                self.session = None;
+                Outcome::Applied
+            }
+            Op::RollBack { index } => self.apply_rollback(index),
+            Op::RaiseFloorTo { .. } | Op::RaiseFloorBy { .. } => {
+                let Some(session) = self.session.as_mut() else { return Outcome::Refused("没有会话".into()) };
+                let shadow_ledger = session.shadow_ledger;
+                let PoolVersion::WithFile(current) = &mut session.current else {
+                    return Outcome::Refused("现行版本没有文件".into());
+                };
+                let new_floor = match op {
+                    Op::RaiseFloorTo { txg } => txg,
+                    Op::RaiseFloorBy { steps } => current.root.rollback_floor.0 + steps,
+                    _ => unreachable!("上面只放进这两种"),
+                };
+                match raise_rollback_floor(
+                    &self.parameters,
+                    &mut self.devices,
+                    &mut session.allocator,
+                    current,
+                    CheckpointTxg(new_floor),
+                    shadow_ledger,
+                ) {
+                    Ok(_) => {
+                        self.note_current(before_content);
+                        Outcome::Applied
+                    }
+                    Err(error) => Outcome::Refused(format!("{error:?}")),
+                }
+            }
+            Op::Remount => {
+                self.session = None;
+                match mount_writable(&self.parameters, &mut self.devices) {
+                    Ok(mounted) => {
+                        let (_, session) = MountedSession::of_the_mount(mounted);
+                        self.session = Some(session);
+                        self.note_current(before_content);
+                        Outcome::Applied
+                    }
+                    Err(error) => Outcome::Refused(format!("{error:?}")),
+                }
+            }
+        }
+    }
+}
diff -ruN '--exclude=target' m3-batch5-freeze/tree/crates/bf-proto/tests/bf_after_step.rs m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_after_step.rs
--- m3-batch5-freeze/tree/crates/bf-proto/tests/bf_after_step.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_after_step.rs	2026-10-02 12:09:39.844169587 +0000
@@ -0,0 +1,170 @@
+//! m3-birth-floor-r1 攻方原型：内存稀疏盘上的写死历史与放开扫，每一步之后的整份镜像上判诞生代号下界三种写法（CS1 / CS2）与池级 checker。
+//! 历史取驱动的操作（覆盖写、顺序写、建 inode、回退、抬 F、重新可写挂载）。环境变量 BF_SET 选哪一组历史。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::birth_floor_judgements;
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    images_red: u64,
+    first: Option<String>,
+}
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+/// 一组历史：名字、操作串。
+fn histories(set: &str) -> Vec<(String, Vec<Op>)> {
+    let mut out = Vec::new();
+    let prefixes: Vec<(&str, Vec<Op>)> = vec![
+        ("ow4", vec![ow(1), ow(2), ow(3), ow(4)]),
+        ("ni300-ow-ni1", vec![Op::NewInodes { count: 300 }, ow(1), Op::NewInodes { count: 1 }]),
+        ("sw3-ow-sw2", vec![Op::SequentialWrite { units: 3, seed: 1 }, ow(2), Op::SequentialWrite { units: 2, seed: 3 }]),
+        ("ni300-sw3-ni1-ow", vec![Op::NewInodes { count: 300 }, Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 1 }, ow(2)]),
+        ("sw3-ni240-ow-ni5", vec![Op::SequentialWrite { units: 3, seed: 1 }, Op::NewInodes { count: 240 }, ow(2), Op::NewInodes { count: 5 }]),
+    ];
+    let mut tails: Vec<(String, Vec<Op>)> = Vec::new();
+    for steps in [1u64, 2, 3, 4, 5, 6, 8] {
+        tails.push((format!("raise{steps}"), vec![Op::RaiseFloorBy { steps }]));
+        tails.push((format!("ow-raise{steps}"), vec![ow(50), Op::RaiseFloorBy { steps }]));
+        tails.push((format!("ni-raise{steps}"), vec![Op::NewInodes { count: 2 }, Op::RaiseFloorBy { steps }]));
+        tails.push((format!("sw1-raise{steps}"), vec![Op::SequentialWrite { units: 1, seed: 9 }, Op::RaiseFloorBy { steps }]));
+        tails.push((format!("remount-raise{steps}"), vec![Op::Remount, Op::RaiseFloorBy { steps }]));
+        tails.push((format!("rb0-raise{steps}"), vec![Op::RollBack { index: 2 }, Op::RaiseFloorBy { steps }]));
+    }
+    // 回退目标离开根环：再写 26 次。
+    tails.push(("turn-ow26".to_string(), (60..86).map(ow).collect()));
+    tails.push(("turn-ni-ow25".to_string(), std::iter::once(Op::NewInodes { count: 3 }).chain((60..85).map(ow)).collect()));
+    match set {
+        "sweep" => {
+            for (prefix_name, prefix) in &prefixes {
+                for index in 0..=5usize {
+                    for (tail_name, tail) in &tails {
+                        let mut ops = prefix.clone();
+                        ops.push(Op::RollBack { index });
+                        ops.extend(tail.iter().copied());
+                        out.push((format!("{prefix_name}/rb{index}/{tail_name}"), ops));
+                    }
+                }
+            }
+        }
+        "double" => {
+            // 两次回退：回退到一条回退根、或回退之后再回退到更早的根。
+            for (prefix_name, prefix) in &prefixes {
+                for first in 1..=4usize {
+                    for second in 0..=6usize {
+                        for (tail_name, tail) in tails.iter().filter(|(name, _)| name.starts_with("raise") || name.starts_with("ow-raise") || name.starts_with("turn-ow")) {
+                            let mut ops = prefix.clone();
+                            ops.push(Op::RollBack { index: first });
+                            ops.push(ow(70));
+                            ops.push(Op::NewInodes { count: 1 });
+                            ops.push(Op::RollBack { index: second });
+                            ops.extend(tail.iter().copied());
+                            out.push((format!("{prefix_name}/rb{first}/ow/ni/rb{second}/{tail_name}"), ops));
+                        }
+                    }
+                }
+            }
+        }
+        other => panic!("BF_SET={other} 不认得"),
+    }
+    out
+}
+
+#[test]
+fn birth_floor_variants_after_each_step() {
+    let set = std::env::var("BF_SET").unwrap_or_else(|_| "sweep".to_string());
+    let limit: usize = std::env::var("BF_LIMIT").ok().and_then(|v| v.parse().ok()).unwrap_or(usize::MAX);
+    let skip: usize = std::env::var("BF_SKIP").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    let threads: usize = std::env::var("SINGLEFS_THREAD_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(1).max(1);
+    let all: Vec<(String, Vec<Op>)> = histories(&set).into_iter().skip(skip).take(limit).collect();
+    let started = std::time::Instant::now();
+    let aggregate: Mutex<BTreeMap<String, Aggregate>> = Mutex::new(BTreeMap::new());
+    let refused: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+    let images = Mutex::new(0u64);
+    let next = Mutex::new(0usize);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let index = {
+                    let mut next = next.lock().expect("锁");
+                    if *next >= all.len() {
+                        return;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let (name, ops) = &all[index];
+                let mut driver = Driver::after_first_file();
+                let mut local: BTreeMap<String, Aggregate> = BTreeMap::new();
+                let mut local_images = 0u64;
+                for (step, op) in std::iter::once(None).chain(ops.iter().map(Some)).enumerate() {
+                    if let Some(op) = op {
+                        if let Outcome::Refused(reason) = driver.apply(*op) {
+                            let short: String = reason.chars().take(60).collect();
+                            *refused.lock().expect("锁").entry(format!("{op:?}=>{short}").chars().take(120).collect()).or_insert(0) += 1;
+                        }
+                    }
+                    let image = driver.image();
+                    local_images += 1;
+                    let violated: Vec<&str> = check_pool_image(&image)
+                        .into_iter()
+                        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+                        .map(|(invariant, _)| invariant)
+                        .collect();
+                    let mut note = |key: String, evaluated: u64, violations: u64, first: Option<String>| {
+                        let entry = local.entry(key).or_default();
+                        entry.evaluated += evaluated;
+                        entry.violations += violations;
+                        if violations > 0 || (first.is_some() && evaluated > 0) {
+                            entry.images_red += u64::from(violations > 0);
+                            if entry.first.is_none() {
+                                entry.first = first.map(|text| format!("{name} step={step} :: {text}"));
+                            }
+                        }
+                    };
+                    note("pool-checker-red-images".to_string(), 1, u64::from(!violated.is_empty()), (!violated.is_empty()).then(|| format!("{violated:?}")));
+                    for (key, tally) in birth_floor_judgements(&image) {
+                        note(key, tally.evaluated, tally.violations, tally.first_violation);
+                    }
+                }
+                *images.lock().expect("锁") += local_images;
+                let mut aggregate = aggregate.lock().expect("锁");
+                for (key, entry) in local {
+                    let total = aggregate.entry(key).or_default();
+                    total.evaluated += entry.evaluated;
+                    total.violations += entry.violations;
+                    total.images_red += entry.images_red;
+                    if total.first.is_none() {
+                        total.first = entry.first;
+                    }
+                }
+            });
+        }
+    });
+    println!(
+        "BF_RUN set={set} histories={} images={} seconds={:.1}",
+        all.len(),
+        images.into_inner().expect("锁"),
+        started.elapsed().as_secs_f64()
+    );
+    for (key, count) in refused.into_inner().expect("锁") {
+        println!("BF_REFUSED {key} count={count}");
+    }
+    for (key, entry) in aggregate.into_inner().expect("锁") {
+        println!(
+            "BF name={key} evaluated={} violations={} images_red={} first={}",
+            entry.evaluated,
+            entry.violations,
+            entry.images_red,
+            entry.first.unwrap_or_else(|| "-".to_string())
+        );
+    }
+}
diff -ruN '--exclude=target' m3-batch5-freeze/tree/crates/bf-proto/tests/bf_bad_images.rs m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_bad_images.rs
--- m3-batch5-freeze/tree/crates/bf-proto/tests/bf_bad_images.rs	1970-01-01 00:00:00.000000000 +0000
+++ m3-birth-floor-r2-opus/tree/crates/bf-proto/tests/bf_bad_images.rs	2026-10-02 13:00:17.661870967 +0000
@@ -0,0 +1,424 @@
+//! m3-birth-floor-r1 攻方原型：从合法历史的镜像出发，把一个（或一串）单元的诞生代号改小，指它的指针、中央映射 key、分配记录的分配代、
+//! journal 点名项一起跟着改，校验和沿引用链补到根槽与记录（记录改完重接反向链）：盘上处处自洽，唯独诞生代号比它真正写出的那次发布早。
+//! 每份坏镜像上判诞生代号下界三种写法（CS1）与池级 checker，看谁红。
+use std::collections::BTreeSet;
+
+use bf_proto::{Driver, Op, Outcome};
+use singlefs_checker::image::{ImageReader, InvariantVerdict};
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::{birth_floor_judgements, tree_floor_judgements};
+use singlefs_core::address::{CheckpointTxg, DeviceIdentity, DeviceOffsetInBytes};
+use singlefs_core::checksum::{crc32_castagnoli, wide_checksum_with_field_zeroed};
+use singlefs_core::journal::{back_chain_of, record_offset, JournalRecord};
+use singlefs_core::recovery::PoolReader;
+use singlefs_core::unit::unit_filesystem_identifier;
+use singlefs_format::{JOURNAL_RECORD_BYTES, JOURNAL_RING_DEFAULT_BYTES};
+use singlefs_harness::memory_pool::MemoryPool;
+
+const SLOT: u64 = 16384;
+const DEVICES: [u32; 2] = [0, 1];
+
+fn read(pool: &MemoryPool, device: u32, offset: u64, length: usize) -> Vec<u8> {
+    let aligned = length.div_ceil(512) * 512;
+    let mut bytes = PoolReader::read(pool, DeviceIdentity(device), DeviceOffsetInBytes(offset), aligned).expect("读");
+    bytes.truncate(length);
+    bytes
+}
+
+fn write(pool: &mut MemoryPool, device: u32, offset: u64, bytes: &[u8]) {
+    pool.devices.get_mut(&DeviceIdentity(device)).expect("盘").write(DeviceOffsetInBytes(offset), bytes);
+}
+
+fn get_u64(bytes: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(bytes[offset..offset + 8].try_into().expect("8 字节"))
+}
+
+fn set_u64(bytes: &mut [u8], offset: usize, value: u64) {
+    bytes[offset..offset + 8].copy_from_slice(&value.to_le_bytes());
+}
+
+/// 按类重封：先载荷 CRC，再头校验和（码 1：头 105、CRC 在 101；码 3：头 107、CRC 在 89；码 2：头 86 + 2k、CRC 在 76 + 2k）。
+fn reseal_unit(bytes: &mut [u8]) {
+    let (header_end, payload_crc_offset) = match bytes[6] {
+        1 => (105usize, 101usize),
+        3 => (107, 89),
+        _ => (86 + 2 * usize::from(bytes[51]), 76 + 2 * usize::from(bytes[51])),
+    };
+    let payload_crc = crc32_castagnoli(&bytes[header_end..]);
+    bytes[payload_crc_offset..payload_crc_offset + 4].copy_from_slice(&payload_crc.to_le_bytes());
+    singlefs_core::unit::seal_header_checksum(bytes, header_end);
+}
+
+fn birth_offset(bytes: &[u8]) -> usize {
+    match bytes[6] {
+        1 => 75,
+        3 => 73,
+        _ => 52 + 2 * usize::from(bytes[51]),
+    }
+}
+
+fn unit_length(class: u8) -> usize {
+    match class {
+        2 => 16384,
+        _ => 32768,
+    }
+}
+
+/// 单元区里盘 0 上头 magic 对、类标签 1 / 2 / 3 的起点槽：(槽, 字节数)。
+fn units_of(pool: &MemoryPool) -> Vec<(u64, usize)> {
+    let mut slots: BTreeSet<u64> = ImageReader::candidate_unit_slots(pool, 0).unwrap_or_default().into_iter().collect();
+
+    slots
+        .into_iter()
+        .filter_map(|slot| {
+            let header = read(pool, 0, slot * SLOT, 8);
+            (&header[..4] == b"SFSU" && matches!(header[6], 1..=3)).then(|| (slot, unit_length(header[6])))
+        })
+        .collect()
+}
+
+/// 根环全部槽：(盘, 偏移)。区域 r 在盘 [0, 1, 0][r] 上，起点 64 × 16384 + r × 3 MiB，槽距 4096。
+fn root_slots() -> Vec<(u32, u64)> {
+    (0..3u64)
+        .flat_map(|region| (0..8u64).map(move |slot| ([0u32, 1, 0][usize::try_from(region).expect("区域")], 64 * SLOT + region * 3 * (1 << 20) + slot * 4096)))
+        .collect()
+}
+
+fn location_pattern(device: u32, slot: u64, checksum: u32) -> Vec<u8> {
+    [device.to_le_bytes().to_vec(), slot.to_le_bytes()[..6].to_vec(), checksum.to_le_bytes().to_vec()].concat()
+}
+
+fn positions(haystack: &[u8], needle: &[u8]) -> Vec<usize> {
+    (0..=haystack.len().saturating_sub(needle.len())).filter(|index| haystack[*index..*index + needle.len()] == *needle).collect()
+}
+
+fn fsid_low() -> u64 {
+    unit_filesystem_identifier(&singlefs_harness::history::HistoryDeviceWidth::FourGibibytes.parameters().filesystem_identifier)
+}
+
+fn journal_counters(pool: &MemoryPool) -> Vec<u64> {
+    (1..100_000u64)
+        .take_while(|counter| {
+            JournalRecord::parse(&read(pool, 0, record_offset(*counter, JOURNAL_RING_DEFAULT_BYTES).0, usize::try_from(JOURNAL_RECORD_BYTES).expect("4096")), fsid_low()).is_some()
+        })
+        .collect()
+}
+
+/// journal 里每条记录：点名项与新根段指针里位置条目是 (盘, slot, old) 的换成 new；`birth` 给出时，那一项的诞生代号 from → to。
+/// 改完从头把反向链重接一遍。
+fn rewrite_journal(pool: &mut MemoryPool, slot: u64, old: u32, new: u32, birth: Option<(u64, u64)>) {
+    let counters = journal_counters(pool);
+    for device in DEVICES {
+        for counter in &counters {
+            let offset = record_offset(*counter, JOURNAL_RING_DEFAULT_BYTES).0;
+            let Some(mut record) = JournalRecord::parse(&read(pool, device, offset, 4096), fsid_low()) else { continue };
+            let mut touched = false;
+            for named in &mut record.named {
+                if named.locations[0].slot.0 == slot && named.locations[0].unit_checksum == old {
+                    for location in &mut named.locations {
+                        location.unit_checksum = new;
+                    }
+                    if let Some((from, to)) = birth {
+                        assert_eq!(named.birth_txg.0, from, "点名项的诞生代号本来是 {from}");
+                        named.birth_txg = CheckpointTxg(to);
+                    }
+                    touched = true;
+                }
+            }
+            for pointer in [&mut record.new_tree_table, &mut record.new_mapping_root] {
+                if pointer.locations[0].slot.0 == slot && pointer.locations[0].unit_checksum == old {
+                    for location in &mut pointer.locations {
+                        location.unit_checksum = new;
+                    }
+                    if let Some((from, to)) = birth {
+                        assert_eq!(pointer.head.birth_txg.0, from, "新根段指针的诞生代号本来是 {from}");
+                        pointer.head.birth_txg = CheckpointTxg(to);
+                    }
+                    touched = true;
+                }
+            }
+            if touched {
+                write(pool, device, offset, &record.to_bytes());
+            }
+        }
+        for window in counters.windows(2) {
+            let previous = read(pool, device, record_offset(window[0], JOURNAL_RING_DEFAULT_BYTES).0, 4096);
+            let offset = record_offset(window[1], JOURNAL_RING_DEFAULT_BYTES).0;
+            let mut later = JournalRecord::parse(&read(pool, device, offset, 4096), fsid_low()).expect("改前自证过的记录");
+            let chain = back_chain_of(&previous);
+            if later.back_chain != chain {
+                later.back_chain = chain;
+                write(pool, device, offset, &later.to_bytes());
+            }
+        }
+    }
+}
+
+/// 一个单元的整单元校验和从 old 变成 new：父单元里的位置条目、根槽、journal 里的点名项逐个补上，被补的父单元重封、再往上补。
+fn propagate(pool: &mut MemoryPool, units: &[(u64, usize)], mut changes: Vec<(u64, u32, u32)>) {
+    // 先进先出：同一个单元先后变两次（c1 → c2 → c3）时，引用它的地方要先补 c1 → c2、再补 c2 → c3。
+    while !changes.is_empty() {
+        let (slot, old, new) = changes.remove(0);
+        if old == new {
+            continue;
+        }
+        for (container, length) in units.iter().copied() {
+            if container == slot {
+                continue;
+            }
+            let before = read(pool, 0, container * SLOT, length);
+            let mut bytes = before.clone();
+            let mut touched = false;
+            for device in DEVICES {
+                for position in positions(&bytes, &location_pattern(device, slot, old)) {
+                    bytes[position..position + 14].copy_from_slice(&location_pattern(device, slot, new));
+                    touched = true;
+                }
+            }
+            if touched {
+                reseal_unit(&mut bytes);
+                for device in DEVICES {
+                    write(pool, device, container * SLOT, &bytes);
+                }
+                changes.push((container, crc32_castagnoli(&before), crc32_castagnoli(&bytes)));
+            }
+        }
+        for (device, offset) in root_slots() {
+            let mut bytes = read(pool, device, offset, 512);
+            let mut touched = false;
+            for location_device in DEVICES {
+                for position in positions(&bytes, &location_pattern(location_device, slot, old)) {
+                    bytes[position..position + 14].copy_from_slice(&location_pattern(location_device, slot, new));
+                    touched = true;
+                }
+            }
+            if touched {
+                let digest = wide_checksum_with_field_zeroed(&bytes, 512, 138);
+                bytes[138..170].copy_from_slice(&digest);
+                write(pool, device, offset, &bytes);
+            }
+        }
+        rewrite_journal(pool, slot, old, new, None);
+    }
+}
+
+/// 把 `slot` 那个单元的诞生代号从 `from` 改成 `to`，并改：指它的指针（码 2 节点里、根槽里）的诞生代号、中央映射条目 key 的出生 txg
+/// （key 宽 27 的节点，条目 key 偏移 9）与节点头里与它相同的最小 / 最大 key、分配记录树叶（key 宽 10）里两盘的未释放记录分配代、
+/// journal 点名项与新根段指针；校验和沿引用链补上去。交回改了几处（单元、指针、映射 key、分配记录、journal）。
+fn lower_birth(pool: &mut MemoryPool, slot: u64, from: u64, to: u64) -> [usize; 4] {
+    let units = units_of(pool);
+    let length = units.iter().find(|(start, _)| *start == slot).expect("登记过的单元").1;
+    let before = read(pool, 0, slot * SLOT, length);
+    let mut bytes = before.clone();
+    let offset = birth_offset(&bytes);
+    assert_eq!(get_u64(&bytes, offset), from, "槽 {slot} 的诞生代号本来是 {from}");
+    set_u64(&mut bytes, offset, to);
+    reseal_unit(&mut bytes);
+    for device in DEVICES {
+        write(pool, device, slot * SLOT, &bytes);
+    }
+    let (old, new) = (crc32_castagnoli(&before), crc32_castagnoli(&bytes));
+    let mut counts = [0usize; 4];
+    let mut changes = vec![(slot, old, new)];
+    // 指针与映射 key：在补位置条目之前、按旧校验和找。
+    for (container, container_length) in units.iter().copied() {
+        if container == slot {
+            continue;
+        }
+        let container_before = read(pool, 0, container * SLOT, container_length);
+        let mut container_bytes = container_before.clone();
+        let key_width = usize::from(container_bytes[51]);
+        let mut touched = false;
+        for position in positions(&container_bytes, &location_pattern(0, slot, old)) {
+            if container_bytes[6] == 2 && key_width == 27 && position >= 27 {
+                // 中央映射条目：key 27 + 两条位置条目。
+                let key_start = position - 27;
+                let old_key = container_bytes[key_start..key_start + 27].to_vec();
+                if get_u64(&container_bytes, key_start + 9) == from {
+                    set_u64(&mut container_bytes, key_start + 9, to);
+                    let new_key = container_bytes[key_start..key_start + 27].to_vec();
+                    for header_key in [52usize, 52 + 27] {
+                        if container_bytes[header_key..header_key + 27] == old_key[..] {
+                            container_bytes[header_key..header_key + 27].copy_from_slice(&new_key);
+                        }
+                    }
+                    counts[1] += 1;
+                    touched = true;
+                }
+            } else if position >= 8 && get_u64(&container_bytes, position - 8) == from {
+                set_u64(&mut container_bytes, position - 8, to);
+                counts[0] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            for device in DEVICES {
+                for position in positions(&container_bytes, &location_pattern(device, slot, old)) {
+                    container_bytes[position..position + 14].copy_from_slice(&location_pattern(device, slot, new));
+                }
+            }
+            reseal_unit(&mut container_bytes);
+            for device in DEVICES {
+                write(pool, device, container * SLOT, &container_bytes);
+            }
+            changes.push((container, crc32_castagnoli(&container_before), crc32_castagnoli(&container_bytes)));
+        }
+    }
+    for (device, root_offset) in root_slots() {
+        let mut root_bytes = read(pool, device, root_offset, 512);
+        let mut touched = false;
+        for position in positions(&root_bytes, &location_pattern(0, slot, old)) {
+            if position >= 8 && get_u64(&root_bytes, position - 8) == from {
+                set_u64(&mut root_bytes, position - 8, to);
+                counts[0] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            for location_device in DEVICES {
+                for position in positions(&root_bytes, &location_pattern(location_device, slot, old)) {
+                    root_bytes[position..position + 14].copy_from_slice(&location_pattern(location_device, slot, new));
+                }
+            }
+            let digest = wide_checksum_with_field_zeroed(&root_bytes, 512, 138);
+            root_bytes[138..170].copy_from_slice(&digest);
+            write(pool, device, root_offset, &root_bytes);
+        }
+    }
+    rewrite_journal(pool, slot, old, new, Some((from, to)));
+    counts[3] += 1;
+    // 分配记录树叶（key 宽 10）：两盘各一条未释放记录，分配代 from → to。
+    for (container, container_length) in units.iter().copied() {
+        let container_before = read(pool, 0, container * SLOT, container_length);
+        if container_before[6] != 2 || container_before[51] != 10 {
+            continue;
+        }
+        let mut container_bytes = container_before.clone();
+        let count = usize::from(u16::from_le_bytes([container_bytes[102], container_bytes[103]]));
+        let mut touched = false;
+        for index in 0..count {
+            let record = 135 + 20 * index;
+            let mut slot_bytes = [0u8; 8];
+            slot_bytes[..6].copy_from_slice(&container_bytes[record + 4..record + 10]);
+            let span_field = u16::from_le_bytes([container_bytes[record + 10], container_bytes[record + 11]]);
+            if u64::from_le_bytes(slot_bytes) == slot && span_field & 0x8000 == 0 && get_u64(&container_bytes, record + 12) == from {
+                set_u64(&mut container_bytes, record + 12, to);
+                counts[2] += 1;
+                touched = true;
+            }
+        }
+        if touched {
+            reseal_unit(&mut container_bytes);
+            for device in DEVICES {
+                write(pool, device, container * SLOT, &container_bytes);
+            }
+            changes.push((container, crc32_castagnoli(&container_before), crc32_castagnoli(&container_bytes)));
+        }
+    }
+    let units = units_of(pool);
+    // 第一项（被改的单元自己）已补过指针与根槽，这里只补它往上的父单元链；其余各项照常补。
+    propagate(pool, &units, changes);
+    counts
+}
+
+/// 镜像上最新那条根引用的、由那次发布新写的单元（诞生代号 = 那条根的 txg）：(槽, 类, 码 2 时的 key 宽)。
+fn units_born_at(pool: &MemoryPool, txg: u64) -> Vec<(u64, u8, u8)> {
+    units_of(pool)
+        .into_iter()
+        .filter_map(|(slot, length)| {
+            let bytes = read(pool, 0, slot * SLOT, length.min(4096));
+            (get_u64(&bytes, birth_offset(&bytes)) == txg).then(|| (slot, bytes[6], bytes[51]))
+        })
+        .collect()
+}
+
+fn report(label: &str, image: &MemoryPool) {
+    let violated: Vec<(&str, String)> = check_pool_image(image)
+        .into_iter()
+        .filter_map(|(invariant, verdict)| match verdict {
+            InvariantVerdict::Violated(detail) => Some((invariant, detail.chars().take(160).collect())),
+            _ => None,
+        })
+        .collect();
+    println!("BI {label} pool_checker_violated={violated:?}");
+    for (key, tally) in tree_floor_judgements(image) {
+        if key.starts_with("CS2:tf") || key.starts_with("CS2:beta") {
+            println!(
+                "BI {label} {key} evaluated={} violations={} first={}",
+                tally.evaluated,
+                tally.violations,
+                tally.first_violation.unwrap_or_else(|| "-".to_string())
+            );
+        }
+    }
+    for (key, tally) in birth_floor_judgements(image) {
+        if key.starts_with("CS1:") && !key.contains("i35") && !key.contains("upper") {
+            println!(
+                "BI {label} {key} evaluated={} violations={} first={}",
+                tally.evaluated,
+                tally.violations,
+                tally.first_violation.unwrap_or_else(|| "-".to_string())
+            );
+        }
+    }
+}
+
+fn ow(seed: u64) -> Op {
+    Op::Overwrite { bytes: 1000 + (seed as usize % 3000), seed }
+}
+
+fn image_after(ops: &[Op]) -> MemoryPool {
+    let mut driver = Driver::after_first_file();
+    for op in ops {
+        assert!(matches!(driver.apply(*op), Outcome::Applied), "{op:?} 被拒");
+    }
+    driver.image()
+}
+
+#[test]
+fn bad_images_with_a_lowered_birth() {
+    // BI-0：干净镜像（三段历史的终态）。
+    let rollback_kept = [ow(1), ow(2), ow(3), Op::RollBack { index: 2 }];
+    let rollback_raised = [ow(1), ow(2), ow(3), ow(4), Op::RollBack { index: 3 }, Op::RaiseFloorTo { txg: 5 }];
+    let plain = [ow(1), ow(2), ow(3)];
+    for (label, ops, newest_txg) in [("rollback-kept", &rollback_kept[..], 7u64), ("rollback-raised", &rollback_raised[..], 8u64), ("plain", &plain[..], 6u64)] {
+        let clean = image_after(ops);
+        report(&format!("{label}/clean"), &clean);
+        let born = units_born_at(&clean, newest_txg);
+        println!("BI {label} units_born_at_{newest_txg}={born:?}");
+    }
+    // BI-1：回退根自己新写的单元（码 2，非用户可见树）诞生代号 txg 7 → 6，R_old 还在候选集里。
+    let clean = image_after(&rollback_kept);
+    for (slot, class, key_width) in units_born_at(&clean, 7) {
+        let mut bad = clean.clone();
+        let counts = lower_birth(&mut bad, slot, 7, 6);
+        report(&format!("BI-1 slot={slot} class={class} key_width={key_width} counts={counts:?}"), &bad);
+    }
+    // BI-1b：同上，R_old 已被抬 F 越过（回退根在 txg 8，抬 F 那几次空发布在它后面）。回退根 txg 8 新写的单元 8 → 7。
+    let clean = image_after(&rollback_raised);
+    for (slot, class, key_width) in units_born_at(&clean, 8) {
+        let mut bad = clean.clone();
+        let counts = lower_birth(&mut bad, slot, 8, 7);
+        report(&format!("BI-1b slot={slot} class={class} key_width={key_width} counts={counts:?}"), &bad);
+    }
+    // BI-3：不回退的历史，最新根 txg 6 新写的单元逐个 6 → 5（只改一个）。
+    let clean = image_after(&plain);
+    for (slot, class, key_width) in units_born_at(&clean, 6) {
+        let mut bad = clean.clone();
+        let counts = lower_birth(&mut bad, slot, 6, 5);
+        report(&format!("BI-3 slot={slot} class={class} key_width={key_width} counts={counts:?}"), &bad);
+    }
+    // BI-2：不回退的历史，最新根 txg 6 新写的用户可见单元（数据单元、extent 树、inode 树）整条链一起 6 → 5，先子后父。
+    let mut bad = clean.clone();
+    let user_visible: Vec<u64> = std::env::var("BI2_SLOTS")
+        .ok()
+        .map(|text| text.split(',').filter_map(|part| part.parse().ok()).collect())
+        .unwrap_or_default();
+    for slot in &user_visible {
+        let counts = lower_birth(&mut bad, *slot, 6, 5);
+        println!("BI BI-2 lowered slot={slot} counts={counts:?}");
+    }
+    if !user_visible.is_empty() {
+        report(&format!("BI-2 slots={user_visible:?}"), &bad);
+    }
+}
