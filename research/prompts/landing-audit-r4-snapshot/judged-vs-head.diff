+SWITCH_ENTRY = re.compile(r"^\s*#?(?P<indent>\s*)(?P<name>[A-Z][A-Z0-9_]*_BREAK)=(?P<value>[a-z0-9][A-Za-z0-9_.,:-]*)(?P<rest>.*)$")
