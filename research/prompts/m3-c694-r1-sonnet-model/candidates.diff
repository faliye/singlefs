+/// 正推腿的候选开关（只在副本里）：默认全关 = 今天的实现；harness 探针按场景拨。
+pub mod candidate_switches {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    pub static W1: AtomicBool = AtomicBool::new(false);
+    pub static W2: AtomicBool = AtomicBool::new(false);
+    pub static W4: AtomicBool = AtomicBool::new(false);
+    /// K3 候选：只在映射根是空指针时先判树表 0 条（读序对别的版本不变）。
+    pub static K3_CONDITIONAL: AtomicBool = AtomicBool::new(false);
+    /// K3 候选：无条件把树表那一段挪到映射树之前。
+    pub static K3_REORDER: AtomicBool = AtomicBool::new(false);
+    pub fn w1_waive_a_root_whose_bootstrap_units_were_overwritten() -> bool {
+        W1.load(Ordering::SeqCst)
+    }
+    pub fn w2_waive_every_unreadable_account() -> bool {
+        W2.load(Ordering::SeqCst)
+    }
+    pub fn w4_isolate_what_the_unapplied_records_name() -> bool {
+        W4.load(Ordering::SeqCst)
+    }
+}
