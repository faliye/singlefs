+pub const PROTOTYPE_SYSCFG_MAGIC: [u8; 4] = *b"SFSF";
+
+/// 第 `copy` 份（0 / 1）在一块 `size` 字节的盘上的偏移。
+#[must_use]
+pub fn prototype_syscfg_offset(size: u64, copy: u64) -> DeviceOffsetInBytes {
+    DeviceOffsetInBytes(size - 4096 * (copy + 1))
+}
+
+/// 一份读得出就交回 (seq, F)。
+#[must_use]
+pub fn prototype_syscfg_parse(bytes: &[u8]) -> Option<(u64, u64)> {
+    if bytes.len() < 24 || bytes[..4] != PROTOTYPE_SYSCFG_MAGIC {
+        return None;
+    }
+    let crc = u32::from_le_bytes(bytes[20..24].try_into().ok()?);
+    if crc32_castagnoli(&bytes[..20]) != crc {
+        return None;
+    }
+    Some((
+        u64::from_le_bytes(bytes[4..12].try_into().ok()?),
+        u64::from_le_bytes(bytes[12..20].try_into().ok()?),
+    ))
+}
+
+#[must_use]
+pub fn prototype_syscfg_bytes(seq: u64, floor: u64) -> Vec<u8> {
+    let mut bytes = vec![0u8; 4096];
+    bytes[..4].copy_from_slice(&PROTOTYPE_SYSCFG_MAGIC);
+    bytes[4..12].copy_from_slice(&seq.to_le_bytes());
+    bytes[12..20].copy_from_slice(&floor.to_le_bytes());
+    let crc = crc32_castagnoli(&bytes[..20]);
+    bytes[20..24].copy_from_slice(&crc.to_le_bytes());
+    bytes
+}
+
+/// 盘上读得出的每一份：(盘, 份, seq, F)。
+#[must_use]
+pub fn prototype_syscfg_copies<Reader: PoolReader + ?Sized>(reader: &Reader) -> Vec<(DeviceIdentity, u64, u64, u64)> {
+    let mut copies = Vec::new();
+    for device in reader.device_identities() {
+        let Some(size) = reader.device_size_in_bytes(device) else { continue };
+        for copy in 0..2 {
+            if let Some(bytes) = reader.read(device, prototype_syscfg_offset(size, copy), 512) {
+                if let Some((seq, floor)) = prototype_syscfg_parse(&bytes) {
+                    copies.push((device, copy, seq, floor));
+                }
+            }
+        }
+    }
+    copies
+}
+
+/// 系统配置里读得出的 F 的最大值（读不出一份都没有 ⇒ 0）。
+#[must_use]
+pub fn prototype_syscfg_floor<Reader: PoolReader + ?Sized>(reader: &Reader) -> CheckpointTxg {
+    CheckpointTxg(prototype_syscfg_copies(reader).iter().map(|c| c.3).max().unwrap_or(0))
+}
+
+/// 同 [`prototype_syscfg_write`]，不发屏障（跟在系统配置轮换后面，持久由之后的屏障保证）。
+///
+/// # Errors
+/// 块设备的错。
+pub fn prototype_syscfg_write_without_barrier<Device: BlockDevice>(
+    devices: &mut [(DeviceIdentity, Device)],
+    floor: CheckpointTxg,
+) -> Result<usize, crate::block_device::BlockDeviceError> {
+    let copies = prototype_syscfg_copies(&*devices);
+    let mut written = 0;
+    for (identity, device) in devices.iter_mut() {
+        let size = device.size_in_bytes();
+        let mine: Vec<&(DeviceIdentity, u64, u64, u64)> = copies.iter().filter(|c| c.0 == *identity).collect();
+        let next_seq = mine.iter().map(|c| c.2).max().unwrap_or(0) + 1;
+        let target = (0..2u64)
+            .min_by_key(|copy| mine.iter().find(|c| c.1 == *copy).map_or(0, |c| c.2))
+            .expect("两份");
+        device.write_at(
+            prototype_syscfg_offset(size, target),
+            &prototype_syscfg_bytes(next_seq, floor.0),
+            crate::block_device::WriteDurability::Plain,
+        )?;
+        written += 1;
+    }
+    PROTOTYPE_SYSCFG_WRITES.fetch_add(u64::try_from(written).expect("数"), std::sync::atomic::Ordering::SeqCst);
+    Ok(written)
+}
+
+/// 每块盘写一份（轮换到 seq 较小或读不出的那一份），之后一道屏障。交回写了几块盘。
+///
+/// # Errors
+/// 块设备的错。
+pub fn prototype_syscfg_write<Device: BlockDevice>(
+    devices: &mut [(DeviceIdentity, Device)],
+    floor: CheckpointTxg,
+) -> Result<usize, crate::block_device::BlockDeviceError> {
+    let copies = prototype_syscfg_copies(&*devices);
+    let mut written = 0;
+    for (identity, device) in devices.iter_mut() {
+        let size = device.size_in_bytes();
+        let mine: Vec<&(DeviceIdentity, u64, u64, u64)> = copies.iter().filter(|c| c.0 == *identity).collect();
+        let next_seq = mine.iter().map(|c| c.2).max().unwrap_or(0) + 1;
+        let target = (0..2u64)
+            .min_by_key(|copy| mine.iter().find(|c| c.1 == *copy).map_or(0, |c| c.2))
+            .expect("两份");
+        device.write_at(
+            prototype_syscfg_offset(size, target),
+            &prototype_syscfg_bytes(next_seq, floor.0),
+            crate::block_device::WriteDurability::Plain,
+        )?;
+        written += 1;
+    }
+    for (_, device) in devices.iter_mut() {
+        device.barrier()?;
+    }
+    PROTOTYPE_SYSCFG_BARRIERED_WRITES.fetch_add(u64::try_from(written).expect("数"), std::sync::atomic::Ordering::SeqCst);
+    PROTOTYPE_SYSCFG_WRITES.fetch_add(u64::try_from(written).expect("数"), std::sync::atomic::Ordering::SeqCst);
+    Ok(written)
+}
