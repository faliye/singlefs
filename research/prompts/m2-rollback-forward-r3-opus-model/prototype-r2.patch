+/// 原型的拒绝。
+#[derive(Debug)]
+pub enum PrototypeForwardError {
+    Mount(MountError),
+    /// 回退目标或最新那一版是树表 0 条的一版：原型不做。
+    VersionWithoutFile,
+    /// R_old 分配着的一个落点在最新那一版里没有记录或已被别的单元占了：R_old 已不受保护。
+    TargetUnitNotProtected { slot: SlotNumber },
+}
+
+impl From<MountError> for PrototypeForwardError {
+    fn from(error: MountError) -> Self {
+        PrototypeForwardError::Mount(error)
+    }
+}
