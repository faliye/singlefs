+/// 原型（m2-rollback-forward-r1 攻方腿副本）：挂载时做的向前发布回退。先照可写挂载恢复（择根、施加前缀）得最新那一版 E，
+/// 再以 R_old 那一版为「上一版」发写行那次发布：树表、映射、inode / extent 树照 R_old 那一版；实例表取 E 那一版的行加这次挂载的普通行
+/// （不写回退行、不写见证）；分配器从 E 那一版的账起、按臂调整；txg、计数器、树 ID 水位同可写挂载。
+///
+/// # Errors
+/// 目标不在环里、不在候选集（按 E 的实例表判、txg ≥ F_生效、见证）、两版任一是树表 0 条、R_old 的落点已不受保护，与可写挂载的各种拒绝。
+pub fn prototype_mount_rollback_forward<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut Vec<(DeviceIdentity, Device)>,
+    target: RollbackTarget,
+    arm: PrototypeForwardArm,
+) -> Result<(Mounted, PrototypeForwardCounts), PrototypeForwardError> {
+    admit_the_writable_device_count(DeviceCount(devices.len()))?;
+    let system_configuration = choose_system_configuration(&*devices).map_err(MountError::from)?;
+    let chosen_root = choose_root(&*devices, &system_configuration)
+        .ok_or(MountError::from(RecoveryFailure::NoValidRoot))?;
+    let records = scan_journal(&*devices, &system_configuration);
+    let (journal, effective_root) = replay_journal(
+        &*devices,
+        &chosen_root,
+        system_configuration.immutable.sizes.journal_ring_bytes,
+        &records,
+        true,
+        rollback_high_water_of_root(&*devices, &chosen_root),
+    )
+    .map_err(MountError::from)?;
+    let own_record = records
+        .values()
+        .filter(|record| {
+            record.instance == effective_root.instance
+                && record.checkpoint_txg == effective_root.checkpoint_txg
+                && record.place_in_publish
+                    == crate::journal::JournalRecordPlaceInPublish::LastRecordOfThePublish
+        })
+        .max_by_key(|record| record.counter)
+        .or_else(|| records.values().max_by_key(|record| record.counter))
+        .cloned();
+    let newest = rebuild_previous_version(devices, &effective_root, own_record)?;
+    let roots = readable_roots(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    );
+    let target_root = roots
+        .iter()
+        .find(|root| {
+            root.instance == target.instance && root.checkpoint_txg == target.checkpoint_txg
+        })
+        .copied()
+        .ok_or(MountError::RollbackTargetNotACandidate {
+            target,
+            exclusion: RollbackCandidateExclusion::NotInRing,
+        })?;
+    let effective_floor = effective_rollback_floor(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    );
+    if target.checkpoint_txg < effective_floor {
+        return Err(MountError::RollbackTargetNotACandidate {
+            target,
+            exclusion: RollbackCandidateExclusion::BelowEffectiveFloor,
+        }
+        .into());
+    }
+    let newest_rows = newest.instance_table_chain().records.rows.clone();
+    if (arm != PrototypeForwardArm::FullWithoutTableValidityCheck
+        && newest_rows
+            .iter()
+            .any(|row| row.instance == target.instance && target.checkpoint_txg > row.selected_root_txg))
+        || rollback_witness_of_the_pool(&*devices, &system_configuration)
+            .abandons(target.instance, target.checkpoint_txg)
+    {
+        return Err(MountError::RollbackTargetNotACandidate {
+            target,
+            exclusion: RollbackCandidateExclusion::OnAbandonedTimeline,
+        }
+        .into());
+    }
+    let target_own_record = records
+        .values()
+        .filter(|record| {
+            record.instance == target.instance && record.checkpoint_txg == target.checkpoint_txg
+        })
+        .max_by_key(|record| record.counter)
+        .or_else(|| records.values().max_by_key(|record| record.counter))
+        .cloned();
+    let selected_version_journal_position =
+        journal_position_of_the_selected_version(&target_root, target_own_record.as_ref());
+    let previous = rebuild_previous_version(devices, &target_root, target_own_record)?;
+    let (Some(newest_output), Some(target_output)) = (newest.file_version(), previous.file_version())
+    else {
+        return Err(PrototypeForwardError::VersionWithoutFile);
+    };
+    let next_counter = records
+        .values()
+        .map(|record| record.counter)
+        .max()
+        .unwrap_or(0)
+        + 1;
+    let first_txg = first_txg_of_new_instance(devices, &system_configuration, &records);
+    let tree_identifier_watermark_of_the_ring = tree_identifier_watermark_of_the_ring(
+        devices,
+        &system_configuration,
+        &records,
+        &effective_root,
+    );
+    let RebuiltAllocator {
+        mut allocator,
+        effective_floor,
+        abandoned_roots_unreadable,
+    } = rebuilt_allocator(
+        devices,
+        &system_configuration,
+        &newest,
+        first_txg,
+        &|_| false,
+        ShadowLedger::On,
+    )?;
+    // 调整分配器（臂见 `PrototypeForwardArm`）。第一版两盘同槽：按第一块盘的记录认落点，释放与复活走分配器的逐盘动作。
+    let first_device = allocator.devices[0].device;
+    let target_allocated: BTreeMap<u64, (u16, CheckpointTxg)> = target_output
+        .allocation_records
+        .iter()
+        .filter(|record| record.device == first_device && !record.is_released)
+        .map(|record| (record.slot.0, (record.span_slots, record.generation)))
+        .collect();
+    let newest_records: Vec<AllocationRecord> = allocator
+        .records()
+        .iter()
+        .filter(|record| record.device == first_device)
+        .copied()
+        .collect();
+    let role_of_slot: BTreeMap<u64, TransactionUnit> = newest_output
+        .units
+        .iter()
+        .map(|unit| (unit.slot.0, unit.identity))
+        .collect();
+    let target_role_of_slot: BTreeMap<u64, TransactionUnit> = target_output
+        .units
+        .iter()
+        .map(|unit| (unit.slot.0, unit.identity))
+        .collect();
+    let mut counts = PrototypeForwardCounts {
+        target_allocation_record_tree_nodes: u64::try_from(
+            target_output.allocation_record_tree.node_set().len(),
+        )
+        .expect("节点数"),
+        newest_allocation_record_tree_nodes: u64::try_from(
+            newest_output.allocation_record_tree.node_set().len(),
+        )
+        .expect("节点数"),
+        ..PrototypeForwardCounts::default()
+    };
+    let newest_slots: BTreeSet<u64> = newest_records.iter().map(|record| record.slot.0).collect();
+    let check = arm != PrototypeForwardArm::FullWithoutProtectionCheck;
+    for slot in target_allocated.keys() {
+        if check && !newest_slots.contains(slot) {
+            return Err(PrototypeForwardError::TargetUnitNotProtected {
+                slot: SlotNumber(*slot),
+            });
+        }
+    }
+    for record in &newest_records {
+        let placement = Placement {
+            slot: record.slot,
+            span: u64::from(record.span_slots),
+        };
