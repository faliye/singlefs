+// 原型（m2-rollback-forward-r2 云端攻方腿副本，不是条款，被攻过零轮）：挂着的时候向前发布的回退（同一实例、走普通发布路径、不取号、
+// txg 照常加一），与卸载时抬 F 的 B1 两种读法。由 `mount.rs` 末尾 `include!` 进来，能用 mount 的私有函数。
+
+/// 挂着的时候回退的各臂。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Rbf2Arm {
+    /// 复活 + 按用户可见单元求差释放 + 同槽同分配代核 + inode 号水位取环里 max。
+    Full,
+    /// 不做同槽同分配代核（只靠候选集挡）。
+    WithoutProtectionCheck,
+    /// 同 Full，另把「两棵分配记录树整棵求差」的字面做满：最新那一版账里分配着、R_old 那一版账里没分配、而这次发布又没换下的落点
+    /// （发布之后仍被新根引用的固定点节点）也释放。
+    LiteralWholeTreeDiff,
+    /// inode 号水位照最新那一版（不取环里 max）。
+    WatermarkOfNewestOnly,
+    /// 候选集不按实例表判仍然有效。
+    WithoutTableValidityCheck,
+}
+
+/// 原型的拒绝。
+#[derive(Debug)]
+pub enum Rbf2Error {
+    Mount(MountError),
+    Publish(PublishError),
+    PublishFrozen,
+    NotInRing,
+    BelowFloor { floor: CheckpointTxg },
+    OnAbandonedTimeline,
+    VersionWithoutFile,
+    TreeIdentifiersDiffer,
+    TargetUnitNotProtected { slot: SlotNumber, why: &'static str },
+}
+
+impl From<MountError> for Rbf2Error {
+    fn from(error: MountError) -> Self {
+        Rbf2Error::Mount(error)
+    }
+}
+
+/// 原型的计数。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Rbf2Counts {
+    pub txg: u64,
+    pub floor_used: u64,
+    pub released_placements: u64,
+    pub revived_placements: u64,
+    /// 同槽同分配代核关着时跳过的落点（已回收或被别的分配代占着）。
+    pub revive_skipped: u64,
+    /// 两棵账整棵求差多出来、而新根仍引用着的落点数（每臂都量；只有 LiteralWholeTreeDiff 真释放它们）。
+    pub whole_tree_diff_referenced_by_the_new_root: u64,
+    pub inode_watermark_of_newest: u64,
+    pub inode_watermark_of_the_ring: u64,
+    pub target_allocation_record_tree_nodes: u64,
+}
+
+/// 用户可见树那一族的角色：数据单元、extent 树、inode 树。
+#[must_use]
+pub fn prototype_is_user_visible_role(role: TransactionUnit) -> bool {
+    matches!(
+        role,
+        TransactionUnit::Data(_)
+            | TransactionUnit::ExtentLowerNode(_)
+            | TransactionUnit::ExtentUpperNodeBelowTheRoot(_)
+            | TransactionUnit::ExtentRoot
+            | TransactionUnit::InodeLeafContainer(_)
+            | TransactionUnit::InodeRoot
+    )
+}
+
+fn prototype_record_standing_for(
+    records: &BTreeMap<(InstanceGeneration, u64), crate::journal::JournalRecord>,
+    root: &RootRecord,
+) -> Option<crate::journal::JournalRecord> {
+    records
+        .values()
+        .filter(|record| {
+            record.instance == root.instance
+                && record.checkpoint_txg == root.checkpoint_txg
+                && record.place_in_publish
+                    == crate::journal::JournalRecordPlaceInPublish::LastRecordOfThePublish
+        })
+        .max_by_key(|record| record.counter)
+        .or_else(|| {
+            records
+                .values()
+                .filter(|record| {
+                    record.instance == root.instance && record.checkpoint_txg == root.checkpoint_txg
+                })
+                .max_by_key(|record| record.counter)
+        })
+        .or_else(|| records.values().max_by_key(|record| record.counter))
+        .cloned()
+}
+
+/// 环里每一条读得出、重建得出的根的 inode 号水位的 max（读不出、树表 0 条的跳过）。
+#[allow(clippy::ptr_arg)]
+pub fn prototype_inode_watermark_of_the_ring<Device: BlockDevice>(
+    devices: &Vec<(DeviceIdentity, Device)>,
+) -> u64 {
+    let Ok(system_configuration) = choose_system_configuration(&*devices) else {
+        return 0;
+    };
+    let records = scan_journal(&*devices, &system_configuration);
+    readable_roots(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    )
+    .iter()
+    .filter_map(|root| {
+        match rebuild_version(&*devices, root, prototype_record_standing_for(&records, root)) {
+            Ok(RebuiltVersion::WithFile(output)) => Some(output.inode_number_watermark()),
+            _ => None,
+        }
+    })
+    .max()
+    .unwrap_or(0)
+}
+
+/// 原型：挂着的时候向前发布的回退。新根的用户可见树 = R_old 那一版的，固定点单元以现行那一版为上一版照常重写；
+/// 分配器从现行那一版的账起：现行那一版引用、R_old 不引用的用户可见单元释放（释放代 = 这次的 txg），R_old 引用、现行那一版已释放的复活
+/// （分配代写回 R_old 那条记录的）。候选集：在环里、txg ≥ max(F_生效(盘上), 现行 F)、按现行那一版的实例表仍然有效。
+///
+/// # Errors
+/// 见 `Rbf2Error`。
+#[allow(clippy::too_many_lines)]
+pub fn prototype_rollback_in_mount<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut Vec<(DeviceIdentity, Device)>,
+    allocator: &mut PoolAllocator,
+    current: &mut TransactionOutput,
+    target: RollbackTarget,
+    arm: Rbf2Arm,
+) -> Result<Rbf2Counts, Rbf2Error> {
+    if allocator.frozen_publish().is_some() {
+        return Err(Rbf2Error::PublishFrozen);
+    }
+    let system_configuration = choose_system_configuration(&*devices).map_err(MountError::from)?;
+    let roots = readable_roots(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    );
+    let target_root = roots
+        .iter()
+        .find(|root| root.instance == target.instance && root.checkpoint_txg == target.checkpoint_txg)
+        .copied()
+        .ok_or(Rbf2Error::NotInRing)?;
+    let disk_floor = effective_rollback_floor(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    );
+    let floor = disk_floor.max(current.root.rollback_floor);
+    if target.checkpoint_txg < floor {
+        return Err(Rbf2Error::BelowFloor { floor });
+    }
+    let table = instance_table_chain_of_root(&*devices, &current.root)
+        .map_err(|_unreadable_or_malformed| MountError::InstanceTableMalformed)?
+        .records;
+    if arm != Rbf2Arm::WithoutTableValidityCheck && abandoned_by_table(&target_root, &table) {
+        return Err(Rbf2Error::OnAbandonedTimeline);
+    }
+    let records = scan_journal(&*devices, &system_configuration);
+    let old = match rebuild_version(
+        &*devices,
+        &target_root,
+        prototype_record_standing_for(&records, &target_root),
+    )
+    .map_err(map_rebuild_failure)?
+    {
+        RebuiltVersion::WithFile(output) => output,
+        RebuiltVersion::WithoutFile => return Err(Rbf2Error::VersionWithoutFile),
+    };
+    if old.tree_identifiers != current.tree_identifiers {
+        return Err(Rbf2Error::TreeIdentifiersDiffer);
+    }
+    let rollback_txg = CheckpointTxg(current.root.checkpoint_txg.0 + 1);
+    let mut counts = Rbf2Counts {
+        txg: rollback_txg.0,
+        floor_used: floor.0,
+        inode_watermark_of_newest: current.inode_number_watermark(),
+        target_allocation_record_tree_nodes: u64::try_from(
+            old.allocation_record_tree.node_set().len(),
+        )
+        .expect("节点数"),
+        ..Rbf2Counts::default()
+    };
+    counts.inode_watermark_of_the_ring = prototype_inode_watermark_of_the_ring(devices);
+    // 上一版 = 现行那一版，只把用户可见的那几样换成 R_old 的。
+    let mut hybrid = current.clone();
+    let mut units: Vec<PublishedUnit> = old
+        .units
+        .iter()
+        .filter(|unit| prototype_is_user_visible_role(unit.identity))
+        .cloned()
+        .collect();
+    units.extend(
+        current
+            .units
+            .iter()
+            .filter(|unit| !prototype_is_user_visible_role(unit.identity))
+            .cloned(),
+    );
+    hybrid.units = units;
+    let mut mapped: Vec<(TransactionUnit, Vec<u8>)> = old
+        .mapped_units
+        .iter()
+        .filter(|(role, _)| prototype_is_user_visible_role(*role))
+        .cloned()
+        .collect();
+    mapped.extend(
+        current
+            .mapped_units
+            .iter()
+            .filter(|(role, _)| !prototype_is_user_visible_role(*role))
+            .cloned(),
+    );
+    hybrid.mapped_units = mapped;
+    hybrid.data_pointers = old.data_pointers.clone();
+    hybrid.extent_tree = old.extent_tree.clone();
+    hybrid.inode_leaf_containers = old.inode_leaf_containers.clone();
+    hybrid.inode_record = old.inode_record.clone();
+    let user_trees = [old.tree_identifiers.extent, old.tree_identifiers.inode];
+    for entry in &mut hybrid.tree_table_entries {
+        if user_trees.contains(&entry.tree) {
+            *entry = *old
+                .tree_table_entries
+                .iter()
+                .find(|old_entry| old_entry.tree == entry.tree)
+                .expect("R_old 那一版树表里有同号的树");
+        }
+    }
+    if arm != Rbf2Arm::WatermarkOfNewestOnly {
+        let watermark = counts
+            .inode_watermark_of_newest
+            .max(counts.inode_watermark_of_the_ring);
+        for entry in &mut hybrid.accounting_entries {
+            if entry.statistic == crate::records::STATISTIC_INODE_WATERMARK {
+                entry.value = watermark;
+            }
+        }
+    }
+    // 分配器：在拷贝上调整，发布成了才换上。
+    let mut working = allocator.clone();
+    let first_device = working.devices[0].device;
+    let old_user_slots: BTreeSet<u64> = old
+        .units
+        .iter()
+        .filter(|unit| prototype_is_user_visible_role(unit.identity))
+        .map(|unit| unit.slot.0)
+        .collect();
+    let old_allocated: BTreeMap<u64, (u16, CheckpointTxg)> = old
+        .allocation_records
+        .iter()
+        .filter(|record| record.device == first_device && !record.is_released)
+        .map(|record| (record.slot.0, (record.span_slots, record.generation)))
+        .collect();
+    let check = arm != Rbf2Arm::WithoutProtectionCheck;
+    let record_now = |working: &PoolAllocator, slot: u64| {
+        working
+            .records()
+            .iter()
+            .find(|record| record.device == first_device && record.slot.0 == slot)
+            .copied()
+    };
+    // 复活与核。
+    for slot in &old_user_slots {
+        let Some((span, generation)) = old_allocated.get(slot).copied() else {
+            if check {
+                return Err(Rbf2Error::TargetUnitNotProtected {
+                    slot: SlotNumber(*slot),
+                    why: "R_old 那一版的账里这个用户可见单元不是仍分配",
+                });
+            }
+            counts.revive_skipped += 1;
+            continue;
+        };
+        let placement = Placement {
+            slot: SlotNumber(*slot),
+            span: u64::from(span),
+        };
+        match record_now(&working, *slot) {
+            None => {
+                if check {
+                    return Err(Rbf2Error::TargetUnitNotProtected {
+                        slot: SlotNumber(*slot),
+                        why: "现行那一版的账里没有这个槽",
+                    });
+                }
+                counts.revive_skipped += 1;
+            }
+            Some(record) if record.span_slots != span => {
+                if check {
+                    return Err(Rbf2Error::TargetUnitNotProtected {
+                        slot: SlotNumber(*slot),
+                        why: "跨度不同",
+                    });
+                }
+                counts.revive_skipped += 1;
+            }
+            Some(record) if !record.is_released => {
+                if record.generation != generation {
+                    if check {
+                        return Err(Rbf2Error::TargetUnitNotProtected {
+                            slot: SlotNumber(*slot),
+                            why: "仍分配而分配代不同",
+                        });
+                    }
+                    counts.revive_skipped += 1;
+                }
+            }
+            Some(_released) => {
+                let reclaimed = working
+                    .devices
+                    .iter()
+                    .any(|device| working.prototype_is_reclaimed(device.device, SlotNumber(*slot)));
+                if reclaimed {
+                    if check {
+                        return Err(Rbf2Error::TargetUnitNotProtected {
+                            slot: SlotNumber(*slot),
+                            why: "已释放且已回收",
+                        });
+                    }
+                    counts.revive_skipped += 1;
+                    continue;
+                }
+                working.prototype_revive_released(placement, generation);
+                counts.revived_placements += 1;
+            }
+        }
+    }
+    // 释放：现行那一版引用、R_old 不引用的用户可见单元。
+    let mut released_now: BTreeSet<u64> = BTreeSet::new();
+    for unit in current
+        .units
+        .iter()
+        .filter(|unit| prototype_is_user_visible_role(unit.identity))
+    {
+        if old_user_slots.contains(&unit.slot.0) || !released_now.insert(unit.slot.0) {
+            continue;
+        }
+        if let Some(record) = record_now(&working, unit.slot.0) {
+            if !record.is_released {
+                working.release(
+                    Placement {
+                        slot: unit.slot,
+                        span: u64::from(record.span_slots),
+                    },
+                    rollback_txg,
+                );
+                counts.released_placements += 1;
+            }
+        }
+    }
+    let tree_identifier_watermark = highest_tree_identifier_watermark_in_the_ring(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+        &records,
+    )
+    .unwrap_or(0)
+    .max(current.root.tree_identifier_watermark);
+    let newest_allocated_before: Vec<AllocationRecord> = current
+        .allocation_records
+        .iter()
+        .filter(|record| record.device == first_device && !record.is_released)
+        .copied()
+        .collect();
+    let plan = PublishPlan {
+        txg: rollback_txg,
+        counter: current.record.counter + 1,
+        transaction: current.highest_transaction_number_in_this_instance + 1,
+        highest_transaction_number_before_this_publish: current
+            .highest_transaction_number_in_this_instance,
+        instance: current.root.instance,
+        back_chain: back_chain_of(&current.record_bytes),
+        file: None,
+        new_inode_records: &[],
+        instance_table: InstanceTablePlan::Carry(current.root.instance_table),
+        tree_birth_txg: current.tree_birth_txg(),
+        tree_identifier_watermark,
+        rollback_floor: current.root.rollback_floor,
+    };
+    let mut pool = PoolWriter::new(parameters, devices.as_mut_slice());
+    let output = match publish_version(&mut pool, &mut working, plan, Some(&hybrid)) {
+        Ok(output) => output,
+        Err(error) => {
+            if working.frozen_publish().is_some() {
+                *allocator = working;
+            }
+            return Err(Rbf2Error::Publish(error));
+        }
+    };
+    // 两棵账整棵求差：现行那一版分配着、R_old 那一版不分配（同槽同代）的落点里，新根仍引用的。
+    let new_root_slots: BTreeSet<u64> = output.units.iter().map(|unit| unit.slot.0).collect();
+    let mut literal_extra: Vec<Placement> = Vec::new();
+    for record in &newest_allocated_before {
+        let in_old = old_allocated
+            .get(&record.slot.0)
+            .is_some_and(|(span, generation)| *span == record.span_slots && *generation == record.generation);
+        if in_old || !new_root_slots.contains(&record.slot.0) {
+            continue;
+        }
+        if let Some(now) = record_now(&working, record.slot.0) {
+            if !now.is_released {
+                literal_extra.push(Placement {
+                    slot: record.slot,
+                    span: u64::from(record.span_slots),
+                });
+            }
+        }
+    }
+    counts.whole_tree_diff_referenced_by_the_new_root = u64::try_from(literal_extra.len()).expect("数");
+    if arm == Rbf2Arm::LiteralWholeTreeDiff {
+        for placement in literal_extra {
+            working.release(placement, rollback_txg);
+        }
+    }
+    *allocator = working;
+    *current = output;
+    Ok(counts)
+}
+
+/// B1 的上限按字面：每块盘上最新的持久有效根（有效 = 自证合法 ∧ 按实例表不被抛弃 ∧ txg ≥ 今天的 F），各盘取小。
+#[allow(clippy::ptr_arg)]
+pub fn prototype_b1_ceiling<Device: BlockDevice>(
+    devices: &Vec<(DeviceIdentity, Device)>,
+    current: &TransactionOutput,
+) -> Result<CheckpointTxg, MountError> {
+    let system_configuration = choose_system_configuration(&*devices)?;
+    let table = instance_table_chain_of_root(&*devices, &current.root)
+        .map_err(|_unreadable_or_malformed| MountError::InstanceTableMalformed)?
+        .records;
+    let mut newest_per_device: BTreeMap<DeviceIdentity, CheckpointTxg> = BTreeMap::new();
+    for root in readable_roots(
+        &*devices,
+        &system_configuration.immutable.region_devices,
+        &system_configuration.immutable.sizes,
+        &system_configuration.immutable.filesystem_identifier,
+    )
+    .into_iter()
+    .filter(|root| root.checkpoint_txg >= current.root.rollback_floor)
+    .filter(|root| !abandoned_by_table(root, &table))
+    {
+        let device = system_configuration.immutable.region_devices[usize::try_from(
+            target_for_publish(
+                root.checkpoint_txg,
+                system_configuration.immutable.sizes.root_ring_slots_per_region,
+            )
+            .region,
+        )
+        .expect("区域号")];
+        let newest = newest_per_device.entry(device).or_insert(root.checkpoint_txg);
+        *newest = (*newest).max(root.checkpoint_txg);
+    }
+    newest_per_device
+        .values()
+        .copied()
+        .min()
+        .ok_or(MountError::Recovery(RecoveryFailure::NoValidRoot))
+}
+
+/// B1 卸载：抬 F 到现行那一版的 txg。`literal` 为真时先按字面上限判（超了就拒、一个字节不写）；为假时不判上限。
+///
+/// # Errors
+/// 见 `raise_rollback_floor`。
+pub fn prototype_unmount_b1<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut Vec<(DeviceIdentity, Device)>,
+    allocator: &mut PoolAllocator,
+    current: &mut TransactionOutput,
+    literal: bool,
+) -> Result<RaisedFloor, MountError> {
+    let newest = current.root.checkpoint_txg;
+    if literal {
+        let ceiling = prototype_b1_ceiling(devices, current)?;
+        if newest > ceiling {
+            return Err(MountError::RollbackFloorAboveCeiling {
+                requested: newest,
+                ceiling,
+            });
+        }
+    }
+    prototype_raise_rollback_floor(parameters, devices, allocator, current, newest, ShadowLedger::On, true)
+}
