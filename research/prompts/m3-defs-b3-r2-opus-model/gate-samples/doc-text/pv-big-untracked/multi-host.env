# 样本：假的多机私有配置。所有值都是编的，不对应任何真机器。
PEER_SSH_HOST=sample-peer-box-17
PEER_REPOSITORY_DIRECTORY=/srv/sample-private/peer-tree
QUIESCE_STOP_COMMAND='ssh -o BatchMode=yes sample-peer-box-17 systemctl --user stop sample-worker.service'
PEER_MEMORY_CAP=60G
ENABLE_ACROSS_MACHINES=1
ENABLE_GPU=0
SAMPLE_SHORT_WORD=tiny7
