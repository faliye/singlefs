+// ───────────── 攻方腿副本（m3-close-c656-r1）：同一份字节、不同写序的 mkfs，只在草稿目录的仓副本里 ─────────────
+
+/// 写序：今天的、乙（先作废旧池再写）、甲的两种写法（系统配置先写当提交点；新字节先写、系统配置最后动）。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MakeFilesystemOrderUnderAttack {
+    /// 与 [`make_filesystem`] 同序。
+    Today,
+    /// 乙：每块盘先清 [0, 根环基址) → 每块盘一道屏障 → 清根环三区域、journal 环、写两单元 → 屏障 → 根 FUA × 3 → 系统配置 × 4 → 屏障。
+    InvalidateFirst,
+    /// 甲（提交点 = 系统配置）：系统配置 × 4 先写 → 屏障 → 清 [槽 1 末尾, 根环基址)、根环三区域、journal 环、写两单元 → 屏障 → 根 FUA × 3 → 屏障。
+    /// 提交点之前一个字节都不写；提交点之后再清旧池的根环与 journal 环。
+    SystemConfigurationFirst,
+    /// 甲（正文举的例：先在旧池不读的地方写好、最后才动系统配置槽）：两单元 → 屏障 → 根 FUA × 3（只写槽 0，不清环）→ 系统配置 × 4 → 屏障
+    /// → 清 [槽 1 末尾, 根环基址)、每区域槽 1..S、journal 环 → 屏障。
+    NewBytesThenSystemConfiguration,
+}
+
+/// 同 [`make_filesystem`] 的字节（单元、根、系统配置逐字节相同），写序按 `order`。
+pub fn make_filesystem_in_order<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut [(DeviceIdentity, Device)],
+    order: MakeFilesystemOrderUnderAttack,
+) -> Result<MakeFilesystemOutput, MakeFilesystemError> {
+    if order == MakeFilesystemOrderUnderAttack::Today {
+        return make_filesystem(parameters, devices);
+    }
+    assert_eq!(devices.len(), 2);
+    let sizes: Vec<(DeviceIdentity, u64)> = devices
+        .iter()
+        .map(|(identity, device)| (*identity, device.size_in_bytes()))
+        .collect();
+    let unit_area_start = check_geometry(parameters, &sizes)?;
+    let instance_table_placement = instance_table_placement_at(unit_area_start);
+    let tree_table_genesis_placement = tree_table_genesis_placement_at(unit_area_start);
+    let identities: Vec<DeviceIdentity> = sizes.iter().map(|(identity, _)| *identity).collect();
+    let instance = MKFS_INSTANCE_GENERATION;
+    let genesis = CheckpointTxg(0);
+    let genesis_write_order = WriteOrder { instance, transaction: 0 };
+    let instance_table_sequence = BirthSequence(0);
+    let tree_table_sequence = BirthSequence(1);
+    let instance_table_identity = PackedIdentity {
+        birth_tree: TreeIdentifier(0),
+        record_type: PACKED_TYPE_INSTANCE_TABLE,
+        container: 0,
+        container_birth: genesis,
+    };
+    let instance_table_unit = build_packed_unit(
+        instance_table_identity,
+        u16::try_from(INSTANCE_ROW_BYTES).expect("88"),
+        &[instance_table_chain_record()],
+        genesis,
+        &parameters.filesystem_identifier,
+        genesis_write_order,
+        instance_table_sequence,
+    );
+    let tree_table_genesis_unit = build_index_node(
+        TreeIdentifier(0),
+        0,
+        TREE_TABLE_KEY_WIDTH,
+        &[0u8; 8],
+        &[0u8; 8],
+        genesis,
+        &parameters.filesystem_identifier,
+        instance,
+        tree_table_sequence,
+        u16::try_from(TREE_TABLE_ENTRY_BYTES).expect("200"),
+        &[],
+    );
+    let spacing = u64::from(parameters.geometry.fixed_structure_slot_spacing);
+    let root_ring_region_bytes = region_length_in_bytes(
+        parameters.geometry.fixed_structure_slot_spacing,
+        parameters.geometry.root_ring_slots_per_region,
+    );
+    let journal_ring_start = DeviceOffsetInBytes(JOURNAL_RING_START_SLOT * SLOT_BYTES);
+    let root_ring_base = region_start(0);
+    let root = RootRecord {
+        filesystem_identifier: parameters.filesystem_identifier,
+        unmount_marker: UnmountMarker::NotWrittenByTheUnmountSequence,
+        instance,
+        checkpoint_txg: genesis,
+        tree_table: NodePointer {
+            head: PointerHead { birth_tree: TreeIdentifier(0), birth_txg: genesis },
+            locations: location_entries(&identities, tree_table_genesis_placement.slot, &tree_table_genesis_unit),
+            instance,
+            birth_sequence: tree_table_sequence,
+        },
+        tree_identifier_watermark: TREE_IDENTIFIER_WATERMARK_AT_MKFS,
+        rollback_floor: ROLLBACK_FLOOR_AT_MKFS,
+        instance_table: NodePointer {
+            head: PointerHead { birth_tree: TreeIdentifier(0), birth_txg: genesis },
+            locations: location_entries(&identities, instance_table_placement.slot, &instance_table_unit),
+            instance,
+            birth_sequence: instance_table_sequence,
+        },
+        mapping_root: NodePointer::empty_root(),
+        allocation_record_tree_root: NodePointer::empty_root(),
+    };
+    let root_slot_bytes = usize::try_from(parameters.geometry.physical_block_size).expect("根槽宽");
+    let root_slot = root.to_slot(root_slot_bytes);
+    let system_configuration_of = |identity: DeviceIdentity| SystemConfiguration {
+        immutable: SystemImmutableConfiguration {
+            filesystem_identifier: parameters.filesystem_identifier,
+            this_device: identity,
+            device_count: u32::try_from(identities.len()).expect("设备数"),
+            region_devices: parameters.region_devices,
+            sizes: parameters.geometry,
+            journal_ring_start_slot: JOURNAL_RING_START_SLOT_OF_THE_FIRST_VERSION,
+            root_ring_base_slot: ROOT_RING_BASE_SLOT_OF_THE_FIRST_VERSION,
+            inode_record_truncation_fields: InodeRecordTruncationFieldsOfThePool::WRITTEN_BY_THIS_WRITER,
+        },
+        mutable: SystemMutableConfiguration,
+        runtime: SystemRuntimeConfiguration,
+        quantities: SystemRuntimeQuantities {
+            slot_generation: SYSTEM_CONFIGURATION_GENERATION_AT_MKFS,
+            journal_tail: 0,
+            journal_instance: instance,
+            rollback_floor: ROLLBACK_FLOOR_AT_MKFS,
+        },
+    }
+    .to_slot();
+    let end_of_slot_one = spacing + SYSTEM_CONFIGURATION_SLOT_BYTES;
+    macro_rules! barriers {
+        () => {
+            for (_, device) in devices.iter_mut() {
+                device.barrier()?;
+            }
+        };
+    }
+    macro_rules! units {
+        () => {
+            for (_, device) in devices.iter_mut() {
+                device.write_at(instance_table_placement.slot.to_device_offset(), &instance_table_unit, WriteDurability::Plain)?;
+                device.write_at(tree_table_genesis_placement.slot.to_device_offset(), &tree_table_genesis_unit, WriteDurability::Plain)?;
+            }
+        };
+    }
+    macro_rules! roots {
+        () => {
+            for ring_slot in genesis_root_ring_slots() {
+                let region_device = parameters.region_devices[usize::try_from(ring_slot.region).expect("区域号")];
+                let (_, device) = devices.iter_mut().find(|(identity, _)| *identity == region_device).expect("归属");
+                let offset = slot_offset(ring_slot, parameters.geometry.fixed_structure_slot_spacing);
+                device.write_at(offset, &root_slot, WriteDurability::ForceUnitAccess)?;
+            }
+        };
+    }
+    macro_rules! system_configurations {
+        () => {
+            for (identity, device) in devices.iter_mut() {
+                let slot = system_configuration_of(*identity);
+                for slot_index in 0..SYSTEM_CONFIGURATION_SLOTS_PER_DEVICE {
+                    device.write_at(DeviceOffsetInBytes(slot_index * spacing), &slot, WriteDurability::Plain)?;
+                }
+            }
+        };
+    }
+    match order {
+        MakeFilesystemOrderUnderAttack::Today => unreachable!(),
+        MakeFilesystemOrderUnderAttack::InvalidateFirst => {
+            for (_, device) in devices.iter_mut() {
+                device.write_zeroes_at(DeviceOffsetInBytes(0), root_ring_base.0)?;
+            }
+            barriers!();
+            for (_, device) in devices.iter_mut() {
+                for region_to_clear in 0..ROOT_RING_REGIONS {
+                    device.write_zeroes_at(region_start(region_to_clear), root_ring_region_bytes)?;
+                }
+                device.write_zeroes_at(journal_ring_start, parameters.geometry.journal_ring_bytes)?;
+            }
+            units!();
+            barriers!();
+            roots!();
+            system_configurations!();
+            barriers!();
+        }
+        MakeFilesystemOrderUnderAttack::SystemConfigurationFirst => {
+            system_configurations!();
+            barriers!();
+            for (_, device) in devices.iter_mut() {
+                device.write_zeroes_at(DeviceOffsetInBytes(end_of_slot_one), root_ring_base.0 - end_of_slot_one)?;
+                for region_to_clear in 0..ROOT_RING_REGIONS {
+                    device.write_zeroes_at(region_start(region_to_clear), root_ring_region_bytes)?;
+                }
+                device.write_zeroes_at(journal_ring_start, parameters.geometry.journal_ring_bytes)?;
+            }
+            units!();
+            barriers!();
+            roots!();
+            barriers!();
+        }
+        MakeFilesystemOrderUnderAttack::NewBytesThenSystemConfiguration => {
+            units!();
+            barriers!();
+            roots!();
+            system_configurations!();
+            barriers!();
+            for (_, device) in devices.iter_mut() {
+                device.write_zeroes_at(DeviceOffsetInBytes(end_of_slot_one), root_ring_base.0 - end_of_slot_one)?;
+                for region_to_clear in 0..ROOT_RING_REGIONS {
+                    let start = region_start(region_to_clear).0 + spacing;
+                    device.write_zeroes_at(DeviceOffsetInBytes(start), root_ring_region_bytes - spacing)?;
+                }
+                device.write_zeroes_at(journal_ring_start, parameters.geometry.journal_ring_bytes)?;
+            }
+            barriers!();
+        }
+    }
+    Ok(MakeFilesystemOutput { root, instance_table_unit, tree_table_genesis_unit, unit_area_start })
+}
