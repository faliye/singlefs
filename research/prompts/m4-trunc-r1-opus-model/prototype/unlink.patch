+    /// m4-trunc-r1 攻方副本：截断的最后一批若照删除批的 extent 计划走、又要重写留下的最后一个单元 k（留下 k + 1 个），
+    /// 留下的单元数恰是一片下段叶的整数倍时，罩着单元 k 的那片叶被判「全在留下那一段里」照抄。打出每个下段位置的来历。
+    #[test]
+    fn m4_trunc_r1_opus_the_leaf_holding_the_last_kept_unit_is_carried_when_the_kept_count_is_a_multiple_of_a_leaf() {
+        for (before, kept) in [(200_u64, 144_u64), (200, 143), (200, 145), (300, 288), (3, 2)] {
+            let plan = plan_the_extent_tree_after_a_deletion_batch(
+                &extent_tree_of_a_file_without_holes(before),
+                1,
+                before,
+                kept,
+            );
+            let last_kept = kept - 1;
+            for (position, origin) in &plan.lower_nodes {
+                let (first, last) = position.data_unit_range();
+                if position.level == 0 && (first..=last).contains(&last_kept) {
+                    println!(
+                        "M4TRUNC extent before={before} kept={kept} leaf_holding_unit={last_kept} position=({}, {}) origin={origin:?}",
+                        position.level, position.index
+                    );
+                }
+            }
+            if kept == 1 || !plan.lower_nodes.iter().any(|(p, _)| p.level == 0 && { let (f, l) = p.data_unit_range(); (f..=l).contains(&last_kept) }) {
+                println!("M4TRUNC extent before={before} kept={kept} leaf_holding_unit={last_kept} no_lower_leaf (inline)");
+            }
+        }
+    }
