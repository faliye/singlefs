+            history: &history,
+            presence: &presence,
+            mirroring: JournalMirroring::BothDevices {
+                second_device_copy_is_on_disk: &second_device_copy_is_on_disk,
+            },
+            residue: None,
+            chosen_version: 0,
+            verify_named_units: true,
