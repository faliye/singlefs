+pub fn is_inside_the_journal_ring(offset: DeviceOffsetInBytes, ring_bytes: u64) -> bool {
+    let ring_start = JOURNAL_RING_START_SLOT * SLOT_BYTES;
+    offset.0 >= ring_start && offset.0 < ring_start + ring_bytes
+}
