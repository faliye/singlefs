+        use std::sync::atomic::{AtomicU64, Ordering};
+        let one_interval_and_a_second =
+            std::time::Duration::from_secs(PROGRESS_LINE_INTERVAL_IN_SECONDS + 1);
+        let (piece_sender, piece_receiver) = std::sync::mpsc::channel::<JudgedBlock>();
