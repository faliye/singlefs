+        let counts_before = tally.counts.clone();
+        judge_a_legal_state(
+            &state,
+            implementation,
+            SpecificationSelfCheck::NotJudged,
+            unit_index == 0 && state_mask == 0 && record_count == 1,
+            &mut tally,
