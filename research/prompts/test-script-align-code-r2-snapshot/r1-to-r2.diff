+/// 一条停机条款 S1 的回比：本地值与 crates 那一侧的值，两边按文本比。
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct StopCheck {
+    name: String,
+    local: String,
+    crates: String,
+}
+
+impl StopCheck {
+    fn new(name: &str, local: impl std::fmt::Debug, crates: impl std::fmt::Debug) -> Self {
+        Self {
+            name: name.to_string(),
+            local: format!("{local:?}"),
+            crates: format!("{crates:?}"),
+        }
+    }
+    fn holds(&self) -> bool {
+        self.local == self.crates
+    }
+}
