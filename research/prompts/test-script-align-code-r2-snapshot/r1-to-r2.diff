+        let clock = || {
+            let reads = clock_reads.fetch_add(1, Ordering::SeqCst);
+            if reads == 2 {
+                // 放行的那一头只收一次，收过之后发不出去也无妨
+                let _ = release_sender.send(());
+            }
+            one_interval_and_a_second * u32::try_from(reads).expect("一条用例里读不了几十亿次")
+        };
