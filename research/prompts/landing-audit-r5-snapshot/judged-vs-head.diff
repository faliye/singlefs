+    @staticmethod
+    def dead_pid():
+        """比 pid_max 大的进程号：一定不在。"""
+        try:
+            return int(open("/proc/sys/kernel/pid_max").read()) + 1
+        except (OSError, ValueError):
+            return 99999999
