+/// first_txg 挂载时锚在 first_txg − 1，即根环表 latest_recorded_txg 的初值）。进程内恒锚在这个进程记到的最新根。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WindowAnchor { Off, Ring, FirstTxgMinusOne }
+#[must_use]
+pub fn window_anchor() -> WindowAnchor {
+    match std::env::var("SINGLEFS_WINDOW_ANCHOR").as_deref() {
+        Ok("ring") => WindowAnchor::Ring,
+        Ok("first_txg") => WindowAnchor::FirstTxgMinusOne,
+        _ => WindowAnchor::Off,
+    }
+}
+/// 窗口下沿：txg > 它才在窗口里（锚 − 3S；锚 < 3S 时 None = 全在窗口里）。
+#[must_use]
+pub fn window_lower(anchor: CheckpointTxg, ring_len: u64) -> Option<CheckpointTxg> {
+    anchor.0.checked_sub(ring_len).map(CheckpointTxg)
+}
+#[must_use]
+pub fn in_window(txg: CheckpointTxg, lower: Option<CheckpointTxg>) -> bool {
+    lower.is_none_or(|lower| txg > lower)
+}
