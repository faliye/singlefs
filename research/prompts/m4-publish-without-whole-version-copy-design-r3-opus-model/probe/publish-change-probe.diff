+//! 发布路径上只数、不改的探针：每次带树的发布落盘成了之后，拿上一版与这一版逐表比，数这次在 `units`、中央映射条目、
+//! 分配记录三张表上各改到几条（加、删、值变），与按键次序切成 64 条与 256 条一块时碰到几块；再数分配器在发布前后
+//! 空闲图上变了几槽、几段，与分配器里几样随池涨的集合此刻多大。数完存进进程里的一张表，由装置按造池阶段取走。
+//! 不读盘、不写盘、不改分配器与版本：只读两版与两份分配器。
+
+use crate::allocator::{AllocatorChangeCount, PoolAllocator};
+use crate::transaction::{TransactionOutput, TransactionUnit};
+use std::collections::{BTreeSet, HashMap};
+use std::sync::Mutex;
+
+/// 一张按键有序的表在一次发布里的变化。
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct TableChange {
+    pub entries_before: u64,
+    pub entries_after: u64,
+    pub added: u64,
+    pub removed: u64,
+    pub changed: u64,
+    /// 按上一版的键次序每 64 条一块，加、删、值变落到的块数（加的按插入点算）。
+    pub touched_blocks_of_64: u64,
+    /// 同上，每 256 条一块。
+    pub touched_blocks_of_256: u64,
+}
+
+impl TableChange {
+    /// 这次改到的条数：加、删、值变之和。
+    #[must_use]
+    pub fn changed_entries(&self) -> u64 {
+        self.added + self.removed + self.changed
+    }
+}
+
+/// 一次带树的发布数出来的东西。
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct PublishChangeCount {
+    pub txg: u64,
+    pub had_a_previous_version: bool,
+    /// 按角色当键：键是 `TransactionUnit` 的派生次序，值是（落点, 字节那份 `Arc` 的地址）。
+    pub units: TableChange,
+    /// 中央映射条目：映射 key 到第一份位置项的槽（进映射的角色取它在 `units` 里的落点，加上留给快照的条目）。
+    pub mapping_entries: TableChange,
+    /// 分配记录：键是 (设备, 槽号)，值是整条记录。
+    pub allocation_records: TableChange,
+    /// 这次真写出的角色数（`rewritten`）。
+    pub rewritten_roles: u64,
+    /// 落点与字节都与上一版某一项相同、角色却换了的项数（照抄的单元换了位置寻址的角色）。
+    pub units_carried_under_a_new_role: u64,
+    /// 这一版 `units` 里同一个角色第二次及以后出现的项数。
+    pub repeated_roles: u64,
+    /// 这一版 `units` 里相邻两项同一种角色、前一项的派生次序大于后一项的次数。
+    pub descents_within_a_role_kind: u64,
+    /// 两版都有的角色，按这一版的次序排、看它们在上一版里的下标，相邻两项下标往回走的次数。
+    pub order_flips_among_common_roles: u64,
+    /// 这次搬走的单元数（整理的一批）。
+    pub relocated_units: u64,
+    pub allocator: AllocatorChangeCount,
+}
+
+static COUNTS: Mutex<Vec<PublishChangeCount>> = Mutex::new(Vec::new());
+
+/// 取走到此刻为止数下的全部发布（按发布的次序），表清空。
+///
+/// # Panics
+/// 表的锁中毒：持锁的两处只做推入与整表取走。
+#[must_use]
+pub fn take_the_counts() -> Vec<PublishChangeCount> {
+    std::mem::take(&mut *COUNTS.lock().expect("探针表的锁"))
+}
+
+/// 两份按键升序、键各不相同的表逐条比。
+fn change_of_sorted_tables<Key: Ord, Value: PartialEq>(
+    before: &[(Key, Value)],
+    after: &[(Key, Value)],
+) -> TableChange {
+    let mut change = TableChange {
+        entries_before: u64::try_from(before.len()).expect("条数"),
+        entries_after: u64::try_from(after.len()).expect("条数"),
+        ..TableChange::default()
+    };
+    let mut blocks_of_64: BTreeSet<usize> = BTreeSet::new();
+    let mut blocks_of_256: BTreeSet<usize> = BTreeSet::new();
+    let mut mark = |rank: usize| {
+        blocks_of_64.insert(rank / 64);
+        blocks_of_256.insert(rank / 256);
+    };
+    let (mut index_before, mut index_after) = (0, 0);
+    // 迭代上界是两份表的条数之和：每一轮至少往前走一份。
+    while index_before < before.len() || index_after < after.len() {
+        match (before.get(index_before), after.get(index_after)) {
+            (Some(old), Some(new)) => match old.0.cmp(&new.0) {
+                std::cmp::Ordering::Less => {
+                    change.removed += 1;
+                    mark(index_before);
+                    index_before += 1;
+                }
+                std::cmp::Ordering::Greater => {
+                    change.added += 1;
+                    mark(index_before);
+                    index_after += 1;
+                }
+                std::cmp::Ordering::Equal => {
+                    if old.1 != new.1 {
+                        change.changed += 1;
+                        mark(index_before);
+                    }
+                    index_before += 1;
+                    index_after += 1;
+                }
+            },
+            (Some(_), None) => {
+                change.removed += 1;
+                mark(index_before);
+                index_before += 1;
+            }
+            (None, Some(_)) => {
+                change.added += 1;
+                mark(index_before);
+                index_after += 1;
+            }
+            (None, None) => break,
+        }
+    }
+    change.touched_blocks_of_64 = u64::try_from(blocks_of_64.len()).expect("块数");
+    change.touched_blocks_of_256 = u64::try_from(blocks_of_256.len()).expect("块数");
+    change
+}
+
+/// `units` 按角色当键排好：同一角色取最先那一项（与 `FirstEntryOfEachIdentity` 同一项）。值是（落点, 字节那份的地址）。
+fn units_keyed_by_role(version: &TransactionOutput) -> Vec<(TransactionUnit, (u64, usize))> {
+    let mut seen: BTreeSet<TransactionUnit> = BTreeSet::new();
+    let mut table: Vec<(TransactionUnit, (u64, usize))> = Vec::with_capacity(version.units.len());
+    for unit in &version.units {
+        if seen.insert(unit.identity) {
+            table.push((unit.identity, (unit.slot.0, unit.bytes.as_ptr() as usize)));
+        }
+    }
+    table.sort_by_key(|(role, _)| *role);
+    table
+}
+
+/// 中央映射条目按映射 key 排好：进映射的角色取它在 `units` 里的落点，加上留给快照的那几条（第一份位置项的槽）。
+fn mapping_entries_keyed_by_mapping_key(version: &TransactionOutput) -> Vec<(Vec<u8>, u64)> {
+    let mut slot_of_role: HashMap<TransactionUnit, u64> =
+        HashMap::with_capacity(version.units.len());
+    for unit in &version.units {
+        slot_of_role.entry(unit.identity).or_insert(unit.slot.0);
+    }
+    let mut table: Vec<(Vec<u8>, u64)> = version
+        .mapped_units
+        .iter()
+        .map(|(role, key)| {
+            (
+                key.clone(),
+                slot_of_role.get(role).copied().unwrap_or(u64::MAX),
+            )
+        })
+        .chain(
+            version
+                .mapping_entries_kept_for_the_snapshots
+                .iter()
+                .map(|(key, locations)| (key.clone(), locations[0].slot.0)),
+        )
+        .collect();
+    table.sort();
+    table.dedup_by(|later, earlier| later.0 == earlier.0);
+    table
+}
+
+/// 分配记录按 (设备, 槽号) 排好（版本里本来就按这个次序，这里再排一次不依赖它）。
+fn allocation_records_keyed_by_device_and_slot(
+    version: &TransactionOutput,
+) -> Vec<((u32, u64), crate::allocator::AllocationRecord)> {
+    let mut table: Vec<((u32, u64), crate::allocator::AllocationRecord)> = version
+        .allocation_records
+        .iter()
+        .map(|record| (record.sort_key(), *record))
+        .collect();
+    table.sort_by_key(|(key, _)| *key);
+    table
+}
+
+/// 角色次序那三样：重复的角色、同一种角色里派生次序往回走、两版共有角色的相对次序翻转。
+fn order_of_the_roles(
+    previous: Option<&TransactionOutput>,
+    output: &TransactionOutput,
+) -> (u64, u64, u64) {
+    let mut seen: BTreeSet<TransactionUnit> = BTreeSet::new();
+    let mut repeated = 0u64;
+    for unit in &output.units {
+        if !seen.insert(unit.identity) {
+            repeated += 1;
+        }
+    }
+    let descents = u64::try_from(
+        output
+            .units
+            .windows(2)
+            .filter(|pair| {
+                std::mem::discriminant(&pair[0].identity)
+                    == std::mem::discriminant(&pair[1].identity)
+                    && pair[0].identity > pair[1].identity
+            })
+            .count(),
+    )
+    .expect("次数");
+    let flips = previous.map_or(0, |previous_version| {
+        let mut position_before: HashMap<TransactionUnit, usize> = HashMap::new();
+        for (position, unit) in previous_version.units.iter().enumerate() {
+            position_before.entry(unit.identity).or_insert(position);
+        }
+        let mut seen_after: BTreeSet<TransactionUnit> = BTreeSet::new();
+        let positions: Vec<usize> = output
+            .units
+            .iter()
+            .filter(|unit| seen_after.insert(unit.identity))
+            .filter_map(|unit| position_before.get(&unit.identity).copied())
+            .collect();
+        u64::try_from(
+            positions
+                .windows(2)
+                .filter(|pair| pair[0] > pair[1])
+                .count(),
+        )
+        .expect("次数")
+    });
+    (repeated, descents, flips)
+}
+
+/// 照抄的单元换了角色：这一版里落点与字节那份都和上一版某一项相同、角色却不同的项数。
+fn units_carried_under_a_new_role(previous: &TransactionOutput, output: &TransactionOutput) -> u64 {
+    let mut before: HashMap<(u64, usize), TransactionUnit> =
+        HashMap::with_capacity(previous.units.len());
+    for unit in &previous.units {
+        before
+            .entry((unit.slot.0, unit.bytes.as_ptr() as usize))
+            .or_insert(unit.identity);
+    }
+    u64::try_from(
+        output
+            .units
+            .iter()
+            .filter(|unit| {
+                before
+                    .get(&(unit.slot.0, unit.bytes.as_ptr() as usize))
+                    .is_some_and(|role_before| *role_before != unit.identity)
+            })
+            .count(),
+    )
+    .expect("项数")
+}
+
+/// 一次带树的发布落盘成了之后调：上一版（没有就当空表）对这一版逐表比，分配器发布前后比，记进进程里的表。
+///
+/// # Panics
+/// 表的锁中毒（同 [`take_the_counts`]）。
+pub(crate) fn count_the_publish(
+    previous: Option<&TransactionOutput>,
+    output: &TransactionOutput,
+    allocator_before_this_publish: &PoolAllocator,
+    allocator_after_this_publish: &PoolAllocator,
+) {
+    let empty_units: Vec<(TransactionUnit, (u64, usize))> = Vec::new();
+    let empty_mapping: Vec<(Vec<u8>, u64)> = Vec::new();
+    let empty_records: Vec<((u32, u64), crate::allocator::AllocationRecord)> = Vec::new();
+    let units_after = units_keyed_by_role(output);
+    let mapping_after = mapping_entries_keyed_by_mapping_key(output);
+    let records_after = allocation_records_keyed_by_device_and_slot(output);
+    let (units, mapping_entries, allocation_records, carried_under_a_new_role) = match previous {
+        Some(previous_version) => (
+            change_of_sorted_tables(&units_keyed_by_role(previous_version), &units_after),
+            change_of_sorted_tables(
+                &mapping_entries_keyed_by_mapping_key(previous_version),
+                &mapping_after,
+            ),
+            change_of_sorted_tables(
+                &allocation_records_keyed_by_device_and_slot(previous_version),
+                &records_after,
+            ),
+            units_carried_under_a_new_role(previous_version, output),
+        ),
+        None => (
+            change_of_sorted_tables(&empty_units, &units_after),
+            change_of_sorted_tables(&empty_mapping, &mapping_after),
+            change_of_sorted_tables(&empty_records, &records_after),
+            0,
+        ),
+    };
+    let (repeated_roles, descents_within_a_role_kind, order_flips_among_common_roles) =
+        order_of_the_roles(previous, output);
+    let count = PublishChangeCount {
+        txg: output.root.checkpoint_txg.0,
+        had_a_previous_version: previous.is_some(),
+        units,
+        mapping_entries,
+        allocation_records,
+        rewritten_roles: u64::try_from(output.rewritten.len()).expect("角色数"),
+        units_carried_under_a_new_role: carried_under_a_new_role,
+        repeated_roles,
+        descents_within_a_role_kind,
+        order_flips_among_common_roles,
+        relocated_units: u64::try_from(output.units_relocated_by_this_publish.len())
+            .expect("单元数"),
+        allocator: allocator_after_this_publish.change_count_since(allocator_before_this_publish),
+    };
+    COUNTS.lock().expect("探针表的锁").push(count);
+}
