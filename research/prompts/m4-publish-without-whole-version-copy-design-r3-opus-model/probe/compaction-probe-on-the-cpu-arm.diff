+/// 分配记录按叶分块：改到的记录落在几片叶、这几片叶里共几条记录、这一版有记录的叶几片（[`PublishChangeCount::records_leaves_touched`] 那三项）。
+fn leaves_of_the_records_touched(
+    before: &[((u32, u64), crate::allocator::AllocationRecord)],
+    after: &[((u32, u64), crate::allocator::AllocationRecord)],
+) -> (u64, u64, u64) {
+    let leaf_of = |key: &(u32, u64)| {
+        (
+            key.0,
+            key.1 / singlefs_format::ALLOCATION_RECORD_TREE_LEAF_SLOTS,
+        )
+    };
+    let mut records_per_leaf_before: BTreeMap<(u32, u64), u64> = BTreeMap::new();
+    for (key, _) in before {
+        *records_per_leaf_before.entry(leaf_of(key)).or_insert(0) += 1;
+    }
+    let mut records_per_leaf_after: BTreeMap<(u32, u64), u64> = BTreeMap::new();
+    for (key, _) in after {
+        *records_per_leaf_after.entry(leaf_of(key)).or_insert(0) += 1;
+    }
+    let before_by_key: HashMap<(u32, u64), crate::allocator::AllocationRecord> =
+        before.iter().copied().collect();
+    let after_by_key: HashMap<(u32, u64), crate::allocator::AllocationRecord> =
+        after.iter().copied().collect();
+    let mut touched: BTreeSet<(u32, u64)> = BTreeSet::new();
+    for (key, record) in after {
+        if before_by_key.get(key) != Some(record) {
+            touched.insert(leaf_of(key));
+        }
+    }
+    for (key, _) in before {
+        if !after_by_key.contains_key(key) {
+            touched.insert(leaf_of(key));
+        }
+    }
+    let records_in_the_touched: u64 = touched
+        .iter()
+        .map(|leaf| {
+            records_per_leaf_before
+                .get(leaf)
+                .copied()
+                .unwrap_or(0)
+                .max(records_per_leaf_after.get(leaf).copied().unwrap_or(0))
+        })
+        .sum();
+    (
+        u64::try_from(touched.len()).expect("叶数"),
+        records_in_the_touched,
+        u64::try_from(records_per_leaf_after.len()).expect("叶数"),
+    )
+}
