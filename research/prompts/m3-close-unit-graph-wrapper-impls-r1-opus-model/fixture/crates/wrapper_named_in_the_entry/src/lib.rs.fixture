//! 对照：入口点名包装类型，两种规则都该收它的 impl、改它键都该变（判法没有一律判成「不在」）。
pub trait Store {
    fn put(&self, amount: u32) -> u32;
}

pub struct Base;

impl Store for Base {
    fn put(&self, amount: u32) -> u32 {
        amount
    }
}

pub struct Wrapper<Inner>(pub Inner);

impl<Inner: Store> Store for Wrapper<Inner> {
    fn put(&self, amount: u32) -> u32 {
        self.0.put(amount) * 2
    }
}

pub fn entry() -> u32 {
    Wrapper(Base).put(3)
}
