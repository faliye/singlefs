+/// 写第一个文件之外 inode `inode` 那个文件的那次发布之后的 extent 树（第一个文件那一份 [`ExtentTreePlan`]）：第一个文件的下段整段照抄；
+/// 上段的形状按「有条目的 inode 号」定（D8（核心索引结构） 已定项 14：上段根的层级是罩得住有条目的最大 inode 号的最低一层，按 inode 号的位置寻址）——
+/// 这次之后有条目的是上一版的那几个（第一个文件有数据单元时连它）加 `inode`，上段这一版的节点就是它们各自那片叶到根那一串的并；
+/// 其中 `inode` 那一串与上一版没有的位置这次重写，别的照抄（根层级长高时旧根照抄、换成根之下的角色，新根在上面重写）。
+/// 上一版有、这一版不再在任何一串上的节点（上一版只有零条目根、而 `inode` 落在别的叶上）这次换下。
+#[must_use]
+pub fn plan_the_extent_tree_after_writing_a_file_other_than_the_first(
+    previous: &TransactionOutput,
+    inode: InodeNumber,
+) -> ExtentTreePlan {
+    let previous_extent_tree = &previous.extent_tree;
+    let previous_upper_root_level = previous_extent_tree.upper_root().level;
+    let mut inodes_with_an_entry: BTreeSet<u64> = previous
+        .files_other_than_the_first
+        .iter()
+        .map(|file| file.inode.0)
+        .collect();
+    if !previous.data_pointers.is_empty() {
+        inodes_with_an_entry.insert(FIRST_INODE_NUMBER);
+    }
+    inodes_with_an_entry.insert(inode.0);
+    let largest_inode_with_an_entry = *inodes_with_an_entry
+        .last()
+        .expect("这次写的 inode 刚放进去");
+    let upper_root_level =
+        upper_root_level_for(largest_inode_with_an_entry).max(previous_upper_root_level);
+    let path_of_the_written_file: BTreeSet<ExtentUpperNodePosition> =
+        upper_path_of_inode(inode.0, upper_root_level)
+            .into_iter()
+            .collect();
+    let upper_positions_after_this_publish: BTreeSet<ExtentUpperNodePosition> =
+        inodes_with_an_entry
+            .iter()
+            .flat_map(|inode_with_an_entry| {
+                upper_path_of_inode(*inode_with_an_entry, upper_root_level)
+            })
+            .collect();
+    let previous_upper: BTreeSet<ExtentUpperNodePosition> = previous_extent_tree
+        .upper_nodes
+        .iter()
+        .map(|(position, _)| *position)
+        .collect();
+    let upper_nodes: Vec<(ExtentUpperNodePosition, ExtentTreeNodeOrigin)> =
+        upper_positions_after_this_publish
+            .iter()
+            .map(|position| {
+                let origin = if path_of_the_written_file.contains(position)
+                    || !previous_upper.contains(position)
+                {
+                    ExtentTreeNodeOrigin::RewrittenThisPublish
+                } else {
+                    ExtentTreeNodeOrigin::CarriedFromThePreviousVersion
+                };
+                (*position, origin)
+            })
+            .collect();
+    let replaced_previous_roles = previous_extent_tree
+        .upper_nodes
+        .iter()
+        .filter(|(position, _)| {
+            path_of_the_written_file.contains(position)
+                || !upper_positions_after_this_publish.contains(position)
+        })
+        .map(|(position, _)| role_of_extent_upper_node(*position, previous_upper_root_level))
+        .collect();
+    ExtentTreePlan {
+        lower_nodes: previous_extent_tree
+            .lower_nodes
+            .iter()
+            .map(|(position, _)| {
+                (
+                    *position,
+                    ExtentTreeNodeOrigin::CarriedFromThePreviousVersion,
+                )
+            })
+            .collect(),
+        upper_nodes,
+        replaced_previous_roles,
+    }
+}
