     // 上面那张表是主走读沿链判下来的行，链断在哪一片就只有那一片之前的行：读不全时滤不掉的根认不出来。
     // 滤没滤全就看这同一遍走读走没走到末片（`Walk::walk_instance_table_chain` 记下的），不另读一遍。
     let abandoned_roots_filtering = walk.abandoned_roots_filtering;
+    // 攻方改法 F-N（零轮）：没走到末片时，根环里每条根、journal 环里每条记录的实例（挂载根那个实例与实例 0 除外：前者按 I-3.8 不会有行，
+    // 后者 mkfs 不写行、它的根不带 inode 树）都在已读到的行里各有恰好一行，滤法就已经是全的——没读到的那几片里不会再有这几个实例的行。
+    let abandoned_roots_filtering = match abandoned_roots_filtering {
+        AbandonedRootsFilteringOfTheCandidateSet::FilteredByTheNewestRootsInstanceTable => abandoned_roots_filtering,
+        AbandonedRootsFilteringOfTheCandidateSet::UnfilteredAsTheMainWalkStoppedBeforeTheLastPageOfTheNewestRootsInstanceTable => {
+            let mount_instance = roots[newest_index].2.instance;
+            let instances_with_a_row: BTreeSet<u32> = instance_table_rows.iter().map(|row| row.instance).collect();
+            let rows_unique = instances_with_a_row.len() == instance_table_rows.len();
+            let every_instance_in_the_rings_has_its_row_read = roots
+                .iter()
+                .map(|(_, _, root)| root.instance)
+                .chain(journal_records_by_device.iter().flat_map(|(_, records)| records.values().map(|record| record.instance)))
+                .all(|instance| instance == mount_instance || instance == 0 || instances_with_a_row.contains(&instance));
+            if rows_unique && every_instance_in_the_rings_has_its_row_read {
+                AbandonedRootsFilteringOfTheCandidateSet::FilteredByTheNewestRootsInstanceTable
+            } else {
+                abandoned_roots_filtering
+            }
+        }
+    };
     // 回退候选集的下界取 F 生效值（D16（发布语义） 已定项 1「生效」，SysPre）：max(各幸存盘最新持久有效根所带 F 的最大值,
     // 池里自证过的系统配置槽带的 F)。有效 = 按最新根指着的实例表判不是被抛弃的；每块盘取落在它上面的根环区域里 (txg, 实例) 最大的那一条
     // （最新根的实例表读不出时一行都没有、不滤）；被抛弃时间线上的根带的 F 也算进来（D16（发布语义） 已定项 1，用户 2026-09-28 定「算进」）。
