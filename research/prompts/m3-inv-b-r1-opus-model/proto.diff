+//! 攻方原型（m3-inv-b-r1，只在副本上）：B3 下界（I-3.5 ② 按回退候选集判）在管理员回退的合法历史上误红，两段写死的历史。
+//! 用户决定的那几步（回退到第几条、抬 F 抬到哪、之后写几次）另一条用例放开扫。
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::proto_b::proto_judgements;
+use singlefs_harness::history::{
+    execute_history_observing, ContentChoice, ContentLength, FloorTargetChoice, GeneratedHistory,
+    HistoryEnding, HistoryOperation, HistorySeed, HistoryStartingPoint, RollbackTargetChoice,
+};
+use singlefs_harness::SharedStream;
+
+thread_local! {
+    static V1_RED_STEPS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+fn overwrite(seed: u64) -> HistoryOperation {
+    HistoryOperation::PublishOverwrite(ContentChoice {
+        length: ContentLength::InsideOneDataUnit { selector: 1000 + seed },
+        fill_seed: seed,
+    })
+}
+
+/// 跑一段写死的历史，逐步打印：这一步之后池级 checker 红了哪几条、B3-lower 判了几次红几次、第一处红。交回 B3-lower 红的步数。
+fn run(label: &str, operations: Vec<HistoryOperation>, print: bool) -> (usize, bool) {
+    let history = GeneratedHistory {
+        seed: HistorySeed(0),
+        starting_point: HistoryStartingPoint::AfterFirstFile,
+        operations,
+    };
+    let stream = SharedStream::new();
+    let mut step = 0usize;
+    let mut red_steps = 0usize;
+    let mut v1_red_steps = 0usize;
+    let run = execute_history_observing(&history, &stream, &mut |observation| {
+        let violated: Vec<&str> = check_pool_image(observation.image)
+            .into_iter()
+            .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+            .map(|(name, _)| name)
+            .collect();
+        let proto = proto_judgements(observation.image);
+        let lower = proto.get("B3-lower").cloned().unwrap_or_default();
+        let v1 = proto.get("B3-lower-v1").cloned().unwrap_or_default();
+        let v1_exempted = proto.get("B3-lower-v1-exempted").cloned().unwrap_or_default();
+        if lower.violations > 0 {
+            red_steps += 1;
+        }
+        if v1.violations > 0 {
+            v1_red_steps += 1;
+        }
+        if print {
+            println!(
+                "PROTO_B3 {label} step={step} op={:?} checker_violated={violated:?} b3_lower_evaluated={} b3_lower_red={} v1_evaluated={} v1_red={} v1_exempted={} first={}",
+                observation.operation.map(|operation| operation.kind()),
+                lower.evaluated,
+                lower.violations,
+                v1.evaluated,
+                v1.violations,
+                v1_exempted.evaluated,
+                lower.first_violation.unwrap_or_else(|| "-".to_string())
+            );
+        }
+        step += 1;
+    });
+    let completed = matches!(run.ending, HistoryEnding::Completed);
+    if print {
+        println!("PROTO_B3 {label} completed={completed} steps_observed={step} b3_lower_red_steps={red_steps} v1_red_steps={v1_red_steps}");
+    }
+    V1_RED_STEPS.with(|cell| cell.set(cell.get() + v1_red_steps));
+    (red_steps, completed)
+}
+
+#[test]
+fn proto_b3_rollback_then_raise_the_floor_above_the_rollback_target() {
+    // A（txg 3）→ 覆盖写四次（4–7）→ 回退到从新到旧第 4 条（txg 4）→ 抬 F 到 0 + 5 = 5。
+    run(
+        "raise",
+        vec![
+            overwrite(1),
+            overwrite(2),
+            overwrite(3),
+            overwrite(4),
+            HistoryOperation::RollBackWhileMounted(RollbackTargetChoice::RingRoot { index_from_newest: 3 }),
+            HistoryOperation::RaiseRollbackFloor(FloorTargetChoice { steps_above_current_floor: 5 }),
+        ],
+        true,
+    );
+}
+
+#[test]
+fn proto_b3_rollback_then_the_target_turns_out_of_the_root_ring() {
+    // A（txg 3）→ 覆盖写两次（4、5）→ 回退到 txg 4（从新到旧第 2 条）→ 再覆盖写到 txg 4 那条根轮出根环（R × S = 24）。
+    let mut operations = vec![
+        overwrite(1),
+        overwrite(2),
+        HistoryOperation::RollBackWhileMounted(RollbackTargetChoice::RingRoot { index_from_newest: 1 }),
+    ];
+    for seed in 10..34 {
+        operations.push(overwrite(seed));
+    }
+    run("turn", operations, true);
+}
+
+/// 放开用户决定的那几步：前缀固定为 A 之后覆盖写 k 次（k ∈ {2, 4}），回退目标取根环从新到旧第 i 条（i ∈ 0..=5），
+/// 之后要么抬 F（steps ∈ {0, 2, 4, 6, 8}），要么不抬、再覆盖写 w 次（w ∈ {0, 3}）。数每一格 B3-lower 红没红。
+#[test]
+fn proto_b3_sweep_the_user_steps() {
+    let mut cells = 0usize;
+    let mut red_cells = 0usize;
+    let mut incomplete = 0usize;
+    for k in [2u64, 4] {
+        for index in 0..=5u64 {
+            let prefix: Vec<HistoryOperation> = (1..=k)
+                .map(overwrite)
+                .chain(std::iter::once(HistoryOperation::RollBackWhileMounted(
+                    RollbackTargetChoice::RingRoot { index_from_newest: index },
+                )))
+                .collect();
+            let mut tails: Vec<(String, Vec<HistoryOperation>)> = Vec::new();
+            for steps in [0u64, 2, 4, 6, 8] {
+                tails.push((
+                    format!("raise{steps}"),
+                    vec![HistoryOperation::RaiseRollbackFloor(FloorTargetChoice { steps_above_current_floor: steps })],
+                ));
+            }
+            for writes in [0u64, 3] {
+                tails.push((format!("write{writes}"), (100..100 + writes).map(overwrite).collect()));
+            }
+            for (tail_name, tail) in tails {
+                let mut operations = prefix.clone();
+                operations.extend(tail);
+                let (red_steps, completed) = run("sweep", operations, false);
+                cells += 1;
+                if !completed {
+                    incomplete += 1;
+                }
+                if red_steps > 0 {
+                    red_cells += 1;
+                    println!("PROTO_B3_SWEEP red k={k} rollback_index={index} tail={tail_name} red_steps={red_steps} completed={completed}");
+                }
+            }
+        }
+    }
+    println!(
+        "PROTO_B3_SWEEP cells={cells} red_cells={red_cells} not_completed={incomplete} v1_red_steps_over_all_cells={}",
+        V1_RED_STEPS.with(std::cell::Cell::get)
+    );
+}
diff -ruN a/crates/singlefs-harness/tests/inv_b_proto_histories.rs b/crates/singlefs-harness/tests/inv_b_proto_histories.rs
--- a/crates/singlefs-harness/tests/inv_b_proto_histories.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/singlefs-harness/tests/inv_b_proto_histories.rs	2026-09-30 13:16:36.291085888 +0000
@@ -0,0 +1,158 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：随机历史每一步之后的镜像上跑 `proto_b` 的候选措辞谓词，数每个谓词判了几次、红了几次、
+//! 第一处红在哪段历史的哪一步。历史照 `singlefs_harness::history` 的生成器与执行器，比重与种子区间从环境变量取。
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use singlefs_checker::walk::proto_b::proto_judgements;
+use singlefs_harness::history::{
+    execute_history_observing, generate_history_with_weights, GenerationWeights, HistoryEnding,
+    HistorySeed,
+};
+use singlefs_harness::SharedStream;
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    images_with_violation: u64,
+    first: Option<String>,
+}
+
+fn env_u64(name: &str, default: u64) -> u64 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn weights_named(name: &str) -> &'static GenerationWeights {
+    match name {
+        "broad" => &GenerationWeights::BROAD,
+        "reuse" => &GenerationWeights::REUSE_AFTER_RAISING_THE_FLOOR,
+        "rollback" => &GenerationWeights::ROLLBACK_AFTER_RAISING_THE_FLOOR,
+        "wall" => &GenerationWeights::TOWARD_THE_ALLOCATION_RECORD_WALL,
+        other => panic!("比重名 {other} 不认得"),
+    }
+}
+
+#[test]
+fn proto_predicates_over_random_histories() {
+    let first_seed = env_u64("PROTO_FIRST_SEED", 1_000_000);
+    let seeds = env_u64("PROTO_SEEDS", 4);
+    let operations = usize::try_from(env_u64("PROTO_OPERATIONS", 30)).expect("步数");
+    let weights_name = std::env::var("PROTO_WEIGHTS").unwrap_or_else(|_| "broad".to_string());
+    let weights = weights_named(&weights_name);
+    let threads = env_u64("SINGLEFS_THREAD_CAP", 1).max(1);
+    let started = std::time::Instant::now();
+    let aggregate: Mutex<BTreeMap<&'static str, Aggregate>> = Mutex::new(BTreeMap::new());
+    let endings: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+    let images = Mutex::new(0u64);
+    let next = Mutex::new(first_seed);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let seed = {
+                    let mut next = next.lock().expect("锁");
+                    if *next >= first_seed + seeds {
+                        return;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let history = generate_history_with_weights(HistorySeed(seed), operations, weights);
+                let stream = SharedStream::new();
+                let mut step = 0usize;
+                let mut local: BTreeMap<&'static str, Aggregate> = BTreeMap::new();
+                let mut local_images = 0u64;
+                let run = execute_history_observing(&history, &stream, &mut |observation| {
+                    local_images += 1;
+                    let kinds: String = history.operations[..step.min(history.operations.len())]
+                        .iter()
+                        .map(|operation| format!("{:?}", operation.kind()))
+                        .collect::<Vec<_>>()
+                        .join(">");
+                    // B7：同一张镜像上 I-3.9 在今天的守卫与收窄的守卫下各判一次，数判定不同的镜像与收窄之后判红的镜像。
+                    {
+                        use singlefs_checker::image::InvariantVerdict;
+                        use singlefs_checker::walk::proto_b::{set_i39_guard, I39Guard};
+                        let verdict_under = |guard: I39Guard| {
+                            set_i39_guard(guard);
+                            singlefs_checker::walk::check_pool_image(observation.image)
+                                .into_iter()
+                                .find(|(name, _)| *name == "I-3.9")
+                                .map(|(_, verdict)| verdict)
+                                .expect("I-3.9 在清单里")
+                        };
+                        let today = verdict_under(I39Guard::Today);
+                        let narrowed = verdict_under(I39Guard::Narrowed);
+                        let mut note = |name: &'static str, red: bool| {
+                            let entry = local.entry(name).or_default();
+                            entry.evaluated += 1;
+                            if red {
+                                entry.violations += 1;
+                                entry.images_with_violation += 1;
+                                if entry.first.is_none() {
+                                    entry.first = Some(format!("seed={seed} step={step} today={today:?} narrowed={narrowed:?}"));
+                                }
+                            }
+                        };
+                        note("B7-narrowed-differs-from-today", today != narrowed);
+                        note("B7-narrowed-violated", matches!(narrowed, InvariantVerdict::Violated(_)));
+                        note(
+                            "B7-today-not-applicable-for-an-incomplete-root",
+                            matches!(&today, InvariantVerdict::NotApplicable(reason) if reason.contains("走不完")),
+                        );
+                    }
+                    for (name, tally) in proto_judgements(observation.image) {
+                        let entry = local.entry(name).or_default();
+                        entry.evaluated += tally.evaluated;
+                        entry.violations += tally.violations;
+                        if tally.violations > 0 {
+                            entry.images_with_violation += 1;
+                            if entry.first.is_none() {
+                                entry.first = Some(format!(
+                                    "seed={seed} step={step} start={:?} ops=[{kinds}] :: {}",
+                                    history.starting_point,
+                                    tally.first_violation.clone().unwrap_or_default()
+                                ));
+                            }
+                        }
+                    }
+                    step += 1;
+                });
+                let ending = match &run.ending {
+                    HistoryEnding::NewFinding { .. } => "new_finding".to_string(),
+                    HistoryEnding::KnownRed { .. } => "known_red".to_string(),
+                    HistoryEnding::Completed => "completed".to_string(),
+                    #[allow(unreachable_patterns)]
+                    _ => "other".to_string(),
+                };
+                *endings.lock().expect("锁").entry(ending).or_insert(0) += 1;
+                *images.lock().expect("锁") += local_images;
+                let mut aggregate = aggregate.lock().expect("锁");
+                for (name, local_entry) in local {
+                    let entry = aggregate.entry(name).or_default();
+                    entry.evaluated += local_entry.evaluated;
+                    entry.violations += local_entry.violations;
+                    entry.images_with_violation += local_entry.images_with_violation;
+                    if entry.first.is_none() {
+                        entry.first = local_entry.first;
+                    }
+                }
+            });
+        }
+    });
+    let aggregate = aggregate.into_inner().expect("锁");
+    println!(
+        "PROTO_RUN weights={weights_name} first_seed={first_seed} seeds={seeds} operations={operations} images={} endings={:?} seconds={:.1}",
+        images.into_inner().expect("锁"),
+        endings.into_inner().expect("锁"),
+        started.elapsed().as_secs_f64()
+    );
+    for (name, entry) in aggregate {
+        println!(
+            "PROTO name={name} evaluated={} violations={} images_red={} first={}",
+            entry.evaluated,
+            entry.violations,
+            entry.images_with_violation,
+            entry.first.unwrap_or_else(|| "-".to_string())
+        );
+    }
+}
diff -ruN a/crates/singlefs-harness/tests/inv_b_proto_multi_record_crash.rs b/crates/singlefs-harness/tests/inv_b_proto_multi_record_crash.rs
--- a/crates/singlefs-harness/tests/inv_b_proto_multi_record_crash.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/singlefs-harness/tests/inv_b_proto_multi_record_crash.rs	2026-09-30 13:37:35.039751654 +0000
@@ -0,0 +1,311 @@
+//! 攻方原型（m3-inv-b-r1，只在副本上）：一次发布切成多条记录（产品路径：顺序写 N ≥ 2 个数据单元，一个数据单元一条记录）时，
+//! 崩溃状态与它之后的可写挂载、再发布的镜像上跑 `proto_b` 的候选措辞谓词。
+//!
+//! 历史：mkfs → 取号 1 → 暖机 → A（第一个文件，jsn 3，txg 3）→ 顺序写两个数据单元的 B（jsn 4、5，txg 4）→ 顺序写三个数据单元的 C
+//! （jsn 6、7、8，txg 5）。前缀固定到 B 做完；C 那次发布的写按 `writes_and_segments`（与层 0 同一条切段规则）切段，
+//! 每段之前的段全持久，段内整写子集逐个枚举（段内写数 ≤ `PROTO_SUBSET_LIMIT` 的段全枚举；更大的段只取全持久那一个状态，数写在输出里）。
+//! 每个状态四张镜像：崩溃镜像、可写挂载之后、再覆盖写一次之后、再顺序写两个数据单元之后。盘是内存稀疏盘。
+mod common;
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use common::{crash_state_devices, file_content, geometry, memory_pool_of_sparse_devices, parameters, FIXED_WRITE_TIME_SECONDS, IMAGE_BYTES};
+use singlefs_checker::image::InvariantVerdict;
+use singlefs_checker::walk::check_pool_image;
+use singlefs_checker::walk::proto_b::{proto_judgements, set_i39_guard, I39Guard};
+use singlefs_core::address::{DeviceIdentity, InstanceGeneration};
+use singlefs_core::allocator::{DeviceFreeMap, Placement, PoolAllocator};
+use singlefs_core::block_device::PhysicalBlockSizeInBytes;
+use singlefs_core::make_filesystem::{make_filesystem, INSTANCE_TABLE_SLOT, TREE_TABLE_GENESIS_SLOT};
+use singlefs_core::mount::mount_writable;
+use singlefs_core::transaction::{
+    acquire_instance, publish_first_file, publish_overwrite, publish_sequential_write, warm_up, FirstFile,
+    PoolVersion, PoolWriter,
+};
+use singlefs_core::unit::data_unit_payload_capacity;
+use singlefs_harness::memory_pool::{closed_form_state_count, writes_and_segments, MemoryPool, SparseBlockDevice};
+use singlefs_harness::{RecordingBlockDevice, SharedStream};
+
+const DISKS: [DeviceIdentity; 2] = [DeviceIdentity(0), DeviceIdentity(1)];
+
+fn content_needing(data_units: usize, seed: usize) -> Vec<u8> {
+    let payload_capacity = data_unit_payload_capacity();
+    (0..(data_units - 1) * payload_capacity + payload_capacity / 2)
+        .map(|index| u8::try_from((index * 13 + seed * 5 + 3) % 251).expect("小于 256"))
+        .collect()
+}
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    evaluated: u64,
+    violations: u64,
+    images_red: u64,
+    first: Option<String>,
+}
+
+fn env_usize(name: &str, default: usize) -> usize {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn judge(image: &MemoryPool, label: &str, aggregate: &mut BTreeMap<String, Aggregate>) {
+    if std::env::var("PROTO_DUMP").is_ok_and(|wanted| label.contains(&wanted)) {
+        println!("PROTO_MR_DUMP {label} journal={:?}", singlefs_checker::walk::proto_b::journal_summary(image));
+    }
+    set_i39_guard(I39Guard::Today);
+    let verdicts = check_pool_image(image);
+    let violated: Vec<&str> = verdicts
+        .iter()
+        .filter(|(_, verdict)| matches!(verdict, InvariantVerdict::Violated(_)))
+        .map(|(name, _)| *name)
+        .collect();
+    let entry = aggregate.entry("checker-any-violated".to_string()).or_default();
+    entry.evaluated += 1;
+    if !violated.is_empty() {
+        entry.violations += 1;
+        entry.images_red += 1;
+        if entry.first.is_none() {
+            entry.first = Some(format!("{label} :: {violated:?}"));
+        }
+    }
+    for (name, tally) in proto_judgements(image) {
+        let entry = aggregate.entry(name.to_string()).or_default();
+        entry.evaluated += tally.evaluated;
+        entry.violations += tally.violations;
+        if tally.violations > 0 {
+            entry.images_red += 1;
+            if entry.first.is_none() {
+                entry.first = Some(format!("{label} :: {}", tally.first_violation.unwrap_or_default()));
+            }
+        }
+    }
+}
+
+#[test]
+fn proto_predicates_over_crash_states_of_a_multi_record_publish() {
+    let subset_limit = env_usize("PROTO_SUBSET_LIMIT", 10);
+    let threads = env_usize("SINGLEFS_THREAD_CAP", 1).max(1);
+    let started = std::time::Instant::now();
+    let stream = SharedStream::retaining_contents();
+    let mut devices: Vec<(DeviceIdentity, RecordingBlockDevice<SparseBlockDevice>)> = DISKS
+        .iter()
+        .map(|identity| {
+            (
+                *identity,
+                RecordingBlockDevice::with_shared_stream(
+                    *identity,
+                    SparseBlockDevice::new(IMAGE_BYTES, PhysicalBlockSizeInBytes(512)),
+                    stream.clone(),
+                ),
+            )
+        })
+        .collect();
+    let publish_parameters = parameters();
+    let genesis = make_filesystem(&publish_parameters, &mut devices).expect("mkfs");
+    let mut allocator = PoolAllocator::new(
+        DISKS.iter().map(|device| DeviceFreeMap::new(*device, IMAGE_BYTES)).collect(),
+    );
+    allocator.mark_format_time_units(
+        Placement { slot: INSTANCE_TABLE_SLOT, span: 2 },
+        Placement { slot: TREE_TABLE_GENESIS_SLOT, span: 1 },
+    );
+    let operations_before_the_third;
+    {
+        let mut writer = PoolWriter::new(&publish_parameters, devices.as_mut_slice());
+        let instance = acquire_instance(&mut writer).expect("取号");
+        let warmed = warm_up(&mut writer, &genesis.root, instance).expect("暖机");
+        let content = file_content();
+        let first = publish_first_file(
+            &mut writer,
+            &mut allocator,
+            warmed.roots.last().expect("暖机两代根"),
+            FirstFile { content: &content, write_time_seconds: FIXED_WRITE_TIME_SECONDS },
+            instance,
+            &warmed.last_record_bytes,
+        )
+        .expect("A");
+        let second_content = content_needing(2, 1);
+        let second = publish_sequential_write(
+            &mut writer,
+            &mut allocator,
+            &first,
+            FirstFile { content: &second_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 60 },
+            InstanceGeneration(1),
+        )
+        .expect("B");
+        operations_before_the_third = stream.retained_operations().len();
+        let third_content = content_needing(env_usize("PROTO_C_UNITS", 3), 2);
+        let third = publish_sequential_write(
+            &mut writer,
+            &mut allocator,
+            &second,
+            FirstFile { content: &third_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 120 },
+            InstanceGeneration(1),
+        )
+        .expect("C");
+        println!(
+            "PROTO_MR history B=(txg {:?}, 记录 {} 条) C=(txg {:?}, 记录 {} 条, 末条 jsn {})",
+            second.root.checkpoint_txg,
+            second.earlier_records_of_this_publish.len() + 1,
+            third.root.checkpoint_txg,
+            third.earlier_records_of_this_publish.len() + 1,
+            third.record.counter
+        );
+    }
+    let operations = stream.retained_operations();
+    let mut base = MemoryPool::with_devices(&DISKS, IMAGE_BYTES);
+    base.apply(&operations[..operations_before_the_third]);
+    let (writes, segments) = writes_and_segments(&operations[operations_before_the_third..], &geometry());
+    println!(
+        "PROTO_MR segments={} sizes={:?} closed_form_state_count={}",
+        segments.len(),
+        segments.iter().map(Vec::len).collect::<Vec<_>>(),
+        closed_form_state_count(&segments)
+    );
+    // 状态表：(段号, 段内持久掩码)。
+    let mut states: Vec<(usize, u64)> = vec![(0, 0)];
+    let mut skipped_states = 0u64;
+    for (segment_index, segment) in segments.iter().enumerate() {
+        let full = (1u64 << segment.len()) - 1;
+        if segment.len() <= subset_limit {
+            states.extend((1..=full).map(|mask| (segment_index, mask)));
+        } else {
+            states.push((segment_index, full));
+            let mut structured: Vec<u64> = Vec::new();
+            if segment.iter().all(|write| writes[*write].kind.name() == writes[segment[0]].kind.name())
+                && format!("{:?}", writes[segment[0]].kind) == "JournalRecord"
+            {
+                // 记录段太大不全枚举时的结构化取样：按每块盘上的偏移把写排成记录序（第 r 条），两盘同一个记录集合；
+                // 取：只有后 k 条、只有前 k 条、只有第一条与最后一条、缺中间一条。
+                let mut offsets: Vec<u64> = segment.iter().map(|write| writes[*write].offset.0).collect();
+                offsets.sort_unstable();
+                offsets.dedup();
+                let records = offsets.len();
+                let mask_of = |kept: &dyn Fn(usize) -> bool| -> u64 {
+                    segment
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, write)| {
+                            let order = offsets.iter().position(|offset| *offset == writes[**write].offset.0).expect("在表里");
+                            kept(order)
+                        })
+                        .fold(0u64, |mask, (bit, _)| mask | (1 << bit))
+                };
+                for k in 1..records {
+                    structured.push(mask_of(&|order| order >= records - k));
+                    structured.push(mask_of(&|order| order < k));
+                }
+                structured.push(mask_of(&|order| order == 0 || order == records - 1));
+                for missing in 1..records - 1 {
+                    structured.push(mask_of(&|order| order != missing));
+                }
+                structured.sort_unstable();
+                structured.dedup();
+                structured.retain(|mask| *mask != full && *mask != 0);
+            }
+            skipped_states += full - 1 - u64::try_from(structured.len()).expect("条数");
+            states.extend(structured.into_iter().map(|mask| (segment_index, mask)));
+        }
+    }
+    println!("PROTO_MR states_enumerated={} states_skipped_in_large_segments={skipped_states}", states.len());
+    let aggregate: Mutex<BTreeMap<String, Aggregate>> = Mutex::new(BTreeMap::new());
+    let mount_outcomes: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+    let next = Mutex::new(0usize);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let index = {
+                    let mut next = next.lock().expect("锁");
+                    if *next >= states.len() {
+                        return;
+                    }
+                    *next += 1;
+                    *next - 1
+                };
+                let (segment_index, mask) = states[index];
+                let mut persisted = vec![false; writes.len()];
+                for earlier in &segments[..segment_index] {
+                    for write in earlier {
+                        persisted[*write] = true;
+                    }
+                }
+                for (bit, write) in segments[segment_index].iter().enumerate() {
+                    if mask & (1 << bit) != 0 {
+                        persisted[*write] = true;
+                    }
+                }
+                let kinds: Vec<String> = segments[segment_index]
+                    .iter()
+                    .map(|write| format!("{}@{}", writes[*write].kind.name(), writes[*write].device.0))
+                    .collect();
+                let label = format!("seg={segment_index} kinds={kinds:?} mask={mask:b}");
+                let mut local: BTreeMap<String, Aggregate> = BTreeMap::new();
+                let crash_stream = SharedStream::new();
+                let mut crash_devices = crash_state_devices(&base, &writes, &persisted, &crash_stream);
+                judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=crash"), &mut local);
+                let outcome = match mount_writable(&parameters(), &mut crash_devices) {
+                    Err(error) => format!("refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                    Ok(mounted) => {
+                        judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=mounted"), &mut local);
+                        let mut allocator = mounted.allocator;
+                        match mounted.current {
+                            PoolVersion::WithoutFile(_) => "mounted-without-file".to_string(),
+                            PoolVersion::WithFile(current) => {
+                                let instance = current.root.instance;
+                                let overwrite_content = content_needing(1, 7);
+                                let mut writer = PoolWriter::new(&publish_parameters, crash_devices.as_mut_slice());
+                                match publish_overwrite(
+                                    &mut writer,
+                                    &mut allocator,
+                                    &current,
+                                    FirstFile { content: &overwrite_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 180 },
+                                    instance,
+                                ) {
+                                    Err(error) => format!("overwrite-refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                                    Ok(overwritten) => {
+                                        let sequential_content = content_needing(2, 9);
+                                        let sequential = publish_sequential_write(
+                                            &mut writer,
+                                            &mut allocator,
+                                            &overwritten,
+                                            FirstFile { content: &sequential_content, write_time_seconds: FIXED_WRITE_TIME_SECONDS + 240 },
+                                            instance,
+                                        );
+                                        drop(writer);
+                                        // 覆盖写之后那张镜像取不到（写入口借着盘）：两次发布之后一起判，再各判不了；所以只判最后这张与挂载之后那张。
+                                        judge(&memory_pool_of_sparse_devices(&crash_devices), &format!("{label} stage=after-overwrite-and-sequential"), &mut local);
+                                        match sequential {
+                                            Ok(_) => "mounted-and-published-twice".to_string(),
+                                            Err(error) => format!("sequential-refused:{}", format!("{error:?}").chars().take(60).collect::<String>()),
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                };
+                *mount_outcomes.lock().expect("锁").entry(outcome).or_insert(0) += 1;
+                let mut aggregate = aggregate.lock().expect("锁");
+                for (name, local_entry) in local {
+                    let entry = aggregate.entry(name).or_default();
+                    entry.evaluated += local_entry.evaluated;
+                    entry.violations += local_entry.violations;
+                    entry.images_red += local_entry.images_red;
+                    if entry.first.is_none() {
+                        entry.first = local_entry.first;
+                    }
+                }
+            });
+        }
+    });
+    println!("PROTO_MR outcomes={:?} seconds={:.1}", mount_outcomes.into_inner().expect("锁"), started.elapsed().as_secs_f64());
+    for (name, entry) in aggregate.into_inner().expect("锁") {
+        println!(
+            "PROTO_MR name={name} evaluated={} violations={} images_red={} first={}",
+            entry.evaluated,
+            entry.violations,
+            entry.images_red,
+            entry.first.unwrap_or_else(|| "-".to_string())
+        );
+    }
+}
