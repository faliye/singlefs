+/// C283 的辩方实现（`m2-safety-r3`，自己实现，不用攻方的；对应正文 P1「判不过时」那一格）：
+/// 挂载准入被拒（`MountError::SpaceAdmissionRefusedBeforeAcquisition`，切换预留本身放不下——不含写行 /
+/// 暖机那两种取号之前的拒绝，D16（发布语义） 已定项 1「写行那次发布之前不推」在这里成立，原样交回，不重试）时，
+/// 先推一次空发布把 F 抬到 D16（发布语义） 已定项 1「抬 F 的上限」那一行的准入上限，重判一次；
+/// 抬不动（ceiling 不高于当前 F，或抬 F 本身报错、或所选那一版树表 0 条——没有文件时这一格几乎必是写行/暖机本身）
+/// 就原样报第一次的拒绝，不再重试第二次（P1「先推一次……推完重判」，不是无限重试）。
+///
+/// 抬 F 那一串本身内部有界（`raise_the_floor_through` 迭代上界是根环区域数），落在 D16（发布语义） 已定项 1
+/// 「一次准入最多 B = 8 次发布」的预算之内。
+///
+/// # Errors
+/// 同 [`mount_writable_with_admission_candidate`]；抬 F 之后重试仍被拒，交回重试那一次的错误（可能已经不是
+/// `SpaceAdmissionRefusedBeforeAcquisition`，例如变成别的取号之前的拒绝）。
+pub fn mount_writable_with_admission_candidate_and_c283<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut Vec<(DeviceIdentity, Device)>,
+    candidate: S4Candidate,
+) -> Result<Mounted, MountError> {
+    match mount_writable_with_admission_candidate(parameters, devices, candidate) {
+        Err(MountError::SpaceAdmissionRefusedBeforeAcquisition {
+            instance_to_acquire,
+            refusal,
+        }) => match raise_the_floor_once_for_c283(parameters, devices) {
+            Ok(true) => mount_writable_with_admission_candidate(parameters, devices, candidate),
+            Ok(false) | Err(_) => Err(MountError::SpaceAdmissionRefusedBeforeAcquisition {
+                instance_to_acquire,
+                refusal,
+            }),
+        },
+        other => other,
+    }
+}
+
+/// C283 辩方实现的内部一步：读盘重建出「所选那一版」与一份独立的分配器（与 `mount_writable_with_test_only_switches_and_candidate`
+/// 开头那一段同一套读法，只是这里不再往下建实例——只为了拿到 `raise_rollback_floor`要的 `&mut PoolAllocator` 与
+/// `&mut TransactionOutput`），算出抬 F 的上限，够抬就抬一次；`Ok(true)` = 抬了（F 已经在盘上更高），`Ok(false)` = 没什么可抬
+/// （树表 0 条的一版，或 ceiling 不高于当前 F）。
+fn raise_the_floor_once_for_c283<Device: BlockDevice>(
+    parameters: &MakeFilesystemParameters,
+    devices: &mut Vec<(DeviceIdentity, Device)>,
+) -> Result<bool, MountError> {
+    let system_configuration = choose_system_configuration(&*devices)?;
+    let chosen_root =
+        choose_root(&*devices, &system_configuration).ok_or(RecoveryFailure::NoValidRoot)?;
+    let records = scan_journal(&*devices, &system_configuration);
+    let (_journal, effective_root) = replay_journal(
+        &*devices,
+        &chosen_root,
+        system_configuration.immutable.sizes.journal_ring_bytes,
+        &records,
+        true,
+    )?;
+    let own_record = records
+        .values()
+        .filter(|record| {
+            record.instance == effective_root.instance
+                && record.checkpoint_txg == effective_root.checkpoint_txg
+                && record.place_in_publish
+                    == crate::journal::JournalRecordPlaceInPublish::LastRecordOfThePublish
+        })
+        .max_by_key(|record| record.counter)
+        .or_else(|| records.values().max_by_key(|record| record.counter))
+        .cloned();
+    let previous = rebuild_previous_version(devices, &effective_root, own_record)?;
+    let first_txg = first_txg_of_new_instance(devices, &system_configuration, &records);
+    let RebuiltAllocator { mut allocator, .. } = rebuilt_allocator(
+        devices,
+        &system_configuration,
+        &previous,
+        first_txg,
+        ShadowLedger::On,
+    )?;
+    let PreviousVersion::WithFile { mut output, table } = previous else {
+        // 树表 0 条的一版：没有文件时，切换预留本身放不下的这次拒绝几乎必是写行 / 暖机本身——
+        // D16（发布语义） 已定项 1「写行那次发布之前不推」在这里成立，原样交回，不抬。
+        return Ok(false);
+    };
+    let ceiling = rollback_floor_ceiling(
+        devices,
+        &system_configuration,
+        output.root.rollback_floor,
+        &table.records,
+    )?;
+    if ceiling <= output.root.rollback_floor {
+        return Ok(false);
+    }
+    raise_rollback_floor(
+        parameters,
+        devices,
+        &mut allocator,
+        &mut output,
+        ceiling,
+        ShadowLedger::On,
+    )?;
+    Ok(true)
+}
