+fn probe_tri_state<Device: BlockDevice>(
+    devices: &Vec<(DeviceIdentity, Device)>,
+    checkpoint_txg_of_the_publish: CheckpointTxg,
+    readable_records_of_the_publish: &[&crate::journal::JournalRecord],
+) -> (Option<CheckpointTxg>, bool) {
+    let packed_unit_bytes = usize::try_from(DATA_UNIT_BYTES).expect("32768");
+    let mut unreadable = false;
+    let mut found = None;
+    for named in readable_records_of_the_publish
+        .iter()
+        .flat_map(|record| record.named.iter())
+        .filter(|named| named.unit_class == crate::unit::UNIT_CLASS_PACKED)
+    {
+        let Ok(bytes) = read_unit_via_locations(devices, &named.locations, packed_unit_bytes) else {
+            unreadable = true;
+            continue;
+        };
+        let Ok(packed) = crate::unit::parse_packed_unit(&bytes) else {
+            unreadable = true;
+            continue;
+        };
+        if packed.identity.record_type != crate::unit::PACKED_TYPE_LINEAGE {
+            continue;
+        }
+        for record_bytes in packed.records {
+            if let Some(lineage) = LineageRecord::parse(&record_bytes) {
+                if (lineage.rollback_txg == checkpoint_txg_of_the_publish || std::env::var("SINGLEFS_PROBE_ARM").as_deref() == Ok("anylin")) && found.is_none() {
+                    found = Some(lineage.rollback_target_txg);
+                }
+            }
+        }
+    }
+    (found, unreadable)
+}
