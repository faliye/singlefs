+                cause,
+                slots_rewritten_before_the_failure: slots_rewritten,
+            });
+        }
+    }
+    Ok(SystemConfigurationSlotsRewritten {
+        slots_rewritten,
+        journal_instance_written,
+        journal_tail_written,
+    })
