+/// 工作线程要不要把每个状态的持久集合与看 journal 那一遍恢复的报告带回调用线程。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum StateReportRetention {
+    /// 有观察者：带回去，由调用线程按序号交给它。
+    HandEachStateToObserver,
+    /// 没有观察者：只带计数回去（全量流上两百多万个报告不必留）。
+    CountOnly,
+}
