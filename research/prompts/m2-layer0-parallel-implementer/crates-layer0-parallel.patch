+/// 每片几个状态。
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Layer0SliceLength {
+    /// 片数取 max(64, 16 × 工作线程数)，每片至少 16 个状态。
+    ScaledToWorkerThreads,
+    /// 每片固定这么多个状态（用例把切法推到两头：每片 1 个，或整条流 1 片）。
+    StatesPerSlice(NonZeroU64),
