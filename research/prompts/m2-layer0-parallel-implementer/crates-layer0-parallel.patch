+/// 一片跑完交回调用线程的东西。
+struct FinishedSlice {
+    slice_index: usize,
+    tally: Layer0Tally,
+    /// 按序号排好的（持久集合，看 journal 那一遍恢复的报告）；`CountOnly` 时是空的。
+    observed_states: Vec<(Vec<bool>, RecoveryReport)>,
+}
+
+/// 在工作线程上跑一片：每个状态自己建崩溃镜像、自己记进这一片的计数；基线与写表只读、各线程共用。
