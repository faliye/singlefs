--- after/crates/singlefs-core/src/attack_probe.rs	1970-01-01 00:00:00.000000000 +0000
+++ probe/crates/singlefs-core/src/attack_probe.rs	2026-10-22 05:21:36.536382590 +0000
@@ -0,0 +1,25 @@
+//! 攻方腿探针（只在攻方的副本里）：几处没改的线性查找各比较了几次。
+
+/// 探针的处数。0：`take_the_mapping_positions_over_the_location_hints` 末尾按角色在 `units` 上找；1：`mount.rs` 的
+/// `placements_taken_by_a_file_version` 按角色取单元；2：释放两处 `kept_for_the_snapshots.contains`；3：照抄分配记录树节点时在
+/// 这次重写的分配记录树单元里找；4：照抄第一个文件的数据单元时 `rewritten.contains`；5：`take_the_mapping_positions…` 被调的次数；
+/// 6：`roles_named_by_each_record_of_the_publish` 里 `data_roles_named_before_the_last_record.contains`。
+pub const SITES: usize = 7;
+
+thread_local! {
+    /// 每条线程各记各的：探针用例按场景分线程并行跑，各场景的数互不串。
+    static COUNTS: std::cell::Cell<[u64; SITES]> = const { std::cell::Cell::new([0; SITES]) };
+}
+
+pub fn add(site: usize) {
+    COUNTS.with(|counts| {
+        let mut now = counts.get();
+        now[site] += 1;
+        counts.set(now);
+    });
+}
+
+#[must_use]
+pub fn take() -> [u64; SITES] {
+    COUNTS.with(|counts| counts.replace([0; SITES]))
+}
