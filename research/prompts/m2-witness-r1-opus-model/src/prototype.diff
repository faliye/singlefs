+    /// 原型：盘上全部自证过的见证副本的并集，加上这次挂载要加的那一条。
+    fn witness_entries_to_carry(&self) -> std::collections::BTreeSet<crate::witness::WitnessEntry> {
+        let mut entries = crate::witness::read_witness(
+            &*self.devices,
+            &self.parameters.filesystem_identifier,
+            u64::from(self.parameters.geometry.fixed_structure_slot_spacing),
+            u64::from(self.parameters.geometry.physical_block_size),
+        );
