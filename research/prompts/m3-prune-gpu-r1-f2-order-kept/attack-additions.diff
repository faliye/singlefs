+fn investigate_order_minimal(output: &mut ResultLines) -> i32 {
+    let full = first_history();
+    let records = full.segments[8].clone();
+    let root = full.segments[9].clone();
+    let system_configuration = full.segments[10].clone();
+    let kinds_of = |indexes: &[usize], writes: &[RetainedWrite]| indexes.iter().map(|i| writes[*i].kind.name()).collect::<Vec<_>>();
+    output.line(format!("name=investigate_order_segments healthy_seg8={:?} seg9={:?} seg10={:?} write_count={}", kinds_of(&records, &full.writes), kinds_of(&root, &full.writes), kinds_of(&system_configuration, &full.writes), full.writes.len()));
+    // 与攻方 order 世界同一个改法：段 8（记录）与段 9（根）在写表里对调。
+    let mut order: Vec<usize> = full.segments[..8].iter().flatten().copied().collect();
+    order.extend(root.iter().copied());
+    order.extend(records.iter().copied());
+    for segment in &full.segments[10..] {
+        order.extend(segment.iter().copied());
+    }
+    let writes: Vec<RetainedWrite> = order.iter().map(|index| full.writes[*index].clone()).collect();
+    let mutant = History { base: full.base.clone(), writes, segments: Vec::new(), versions: full.versions.clone() };
+    output.line(format!("name=investigate_order_publishes stream=healthy {}", describe_publishes(&full.writes)));
+    output.line(format!("name=investigate_order_publishes stream=root_before_records {}", describe_publishes(&mutant.writes)));
+    // 崩溃状态 A：段 0..7 与根持久、两条记录与系统配置都没持久。两张写表各按自己的下标摆同一个持久集合。
+    let absent_in_healthy: BTreeSet<usize> = records.iter().chain(system_configuration.iter()).copied().collect();
+    let healthy_persisted: Vec<bool> = (0..full.writes.len()).map(|index| !absent_in_healthy.contains(&index)).collect();
+    let mutant_persisted: Vec<bool> = order.iter().map(|original| !absent_in_healthy.contains(original)).collect();
+    judge_verbose(output, "A_root_persisted_records_absent_sysconf_absent/healthy_write_order", &full, &healthy_persisted);
+    judge_verbose(output, "A_root_persisted_records_absent_sysconf_absent/root_before_records_write_order", &mutant, &mutant_persisted);
+    // 崩溃状态 B：只有两条记录没持久（系统配置也落了）。
+    let only_records: BTreeSet<usize> = records.iter().copied().collect();
+    let healthy_persisted_b: Vec<bool> = (0..full.writes.len()).map(|index| !only_records.contains(&index)).collect();
+    let mutant_persisted_b: Vec<bool> = order.iter().map(|original| !only_records.contains(original)).collect();
+    judge_verbose(output, "B_only_records_absent/healthy_write_order", &full, &healthy_persisted_b);
+    judge_verbose(output, "B_only_records_absent/root_before_records_write_order", &mutant, &mutant_persisted_b);
+    // 同一个崩溃镜像两张写表下逐字节相同吗：读每条写的位置比。
+    let image_healthy = CrashImage { base: &full.base, writes: &full.writes, persisted: healthy_persisted.clone() };
+    let image_mutant = CrashImage { base: &mutant.base, writes: &mutant.writes, persisted: mutant_persisted.clone() };
+    let differing = full.writes.iter().filter(|w| {
+        let length = usize::try_from(w.length_in_bytes()).expect("写长");
+        PoolReader::read(&image_healthy, w.device, w.offset, length) != PoolReader::read(&image_mutant, w.device, w.offset, length)
+    }).count();
+    output.line(format!("name=investigate_order_same_image write_positions_compared={} positions_with_differing_bytes={differing}", full.writes.len()));
+    0
+}
