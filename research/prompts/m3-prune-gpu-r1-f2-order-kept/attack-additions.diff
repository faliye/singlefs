+fn describe_publishes(writes: &[RetainedWrite]) -> String {
+    let publishes = singlefs_harness::memory_pool::publishes_of_one_recording(writes, 0);
+    let mut assigned: BTreeSet<usize> = BTreeSet::new();
+    let mut parts = Vec::new();
+    for publish in &publishes {
+        assigned.extend(publish.units.iter().copied());
+        assigned.extend(publish.records.iter().copied());
+        parts.push(format!("(txg={} root={} units={} records={:?})", publish.checkpoint_txg, publish.root, publish.units.len(), publish.records));
+    }
+    let unassigned_records: Vec<usize> = writes
+        .iter()
+        .enumerate()
+        .filter(|(index, write)| write.kind == StepKind::JournalRecord && !assigned.contains(index))
+        .map(|(index, _)| index)
+        .collect();
+    format!("publishes=[{}] journal_records_in_no_publish={unassigned_records:?}", parts.join(","))
+}
+
+fn judge_verbose(output: &mut ResultLines, label: &str, history: &History, persisted: &[bool]) {
+    let image = CrashImage { base: &history.base, writes: &history.writes, persisted: persisted.to_vec() };
+    let consulted = recover(&image, JournalPolicy::Consult);
+    let ignored = recover(&image, JournalPolicy::Ignore);
+    let describe_outcome = |report: &RecoveryReport| match &report.outcome {
+        RecoveryOutcome::NoFile { root } => format!("NoFile(root={root:?})"),
+        RecoveryOutcome::FileRead { root, content } => format!("FileRead(root={root:?},content_matches_version={})", history.versions.iter().any(|v| v.content == *content)),
+        RecoveryOutcome::Failed { root, failure } => format!("Failed(root={root:?},{failure:?})"),
+    };
+    let records = singlefs_checker_tier::crash::check_records_against(&image, &image, &history.writes, persisted, singlefs_harness::memory_pool::RecordStreamContinuity::OneRecording, consulted.effective_root);
+    let judgment = judge_image(&image, &history.versions);
+    let persisted_kinds: Vec<String> = history.writes.iter().zip(persisted).map(|(w, p)| format!("{}{}", w.kind.name(), if *p { "+" } else { "-" })).collect();
+    output.line(format!(
+        "name=investigate_order_state label={label} recovery_consult={} recovery_ignore={} consult_journal={:?} record_check={records:?} red_all_judgments={:?} tail_write_kinds_persisted={:?}",
+        describe_outcome(&consulted), describe_outcome(&ignored), consulted.journal, judgment.red, &persisted_kinds[persisted_kinds.len().saturating_sub(8)..]
+    ));
+}
