+/// 真实现的改坏（副本里 transaction.rs 的 persist_publish_writes 改成先根后记录）录出的流：逐状态跑五样判定，另按「根之后、下一次根之前」
+/// 的记录认每次发布自己的记录（与 publishes_of_one_recording 不共用），数「根在而它自己的记录一条都不在」的状态。
+fn investigate_order_implementation_stream(output: &mut ResultLines) -> i32 {
+    let history = first_history();
+    let kinds: Vec<String> = history.segments.iter().map(|segment| {
+        let names: Vec<&str> = segment.iter().map(|i| history.writes[*i].kind.name()).collect();
+        format!("{}x{}", names.len(), names.first().copied().unwrap_or(""))
+    }).collect();
+    output.line(format!("name=investigate_order_impl segments={kinds:?} write_count={}", history.writes.len()));
+    output.line(format!("name=investigate_order_impl {}", describe_publishes(&history.writes)));
+    let roots: Vec<usize> = history.writes.iter().enumerate().filter(|(_, w)| w.kind == StepKind::RootRecordFua).map(|(i, _)| i).collect();
+    // 按记录自己的字节认它属于哪次发布：实例代号在偏移 16（4 字节）、checkpoint_txg 在偏移 26（8 字节）（journal.rs 的 to_bytes），与根身份比。
+    let record_identity = |write: &RetainedWrite| {
+        let bytes = write.bytes().expect("记录写带字节");
+        (u32::from_le_bytes(bytes[16..20].try_into().expect("4")), u64::from_le_bytes(bytes[26..34].try_into().expect("8")))
+    };
+    let own_records: Vec<(usize, Vec<usize>)> = roots.iter().map(|root| {
+        let (instance, txg) = root_identity_of_root_write(&history.writes[*root]);
+        (*root, (0..history.writes.len()).filter(|i| history.writes[*i].kind == StepKind::JournalRecord && record_identity(&history.writes[*i]) == (instance.0, txg.0)).collect())
+    }).collect();
+    output.line(format!("name=investigate_order_impl own_records_after_each_root={own_records:?}"));
+    let small = |_: usize, segment: &[usize]| segment.len() < 16;
+    guarded_state_count(output, "implementation_root_before_records", &history, &small);
+    let mut states = 0u64;
+    let mut should_be_red = 0u64;
+    let mut should_be_red_and_red = 0u64;
+    let mut red_by_name: BTreeMap<String, u64> = BTreeMap::new();
+    let mut example: Option<String> = None;
+    enumerate_observing(&history, &small, &mut |image, _report| {
+        states += 1;
+        let judgment = judge_image(image, &history.versions);
+        for name in &judgment.red {
+            *red_by_name.entry(name.clone()).or_insert(0) += 1;
+        }
+        let hole = own_records.iter().any(|(root, records)| {
+            !records.is_empty() && image.persisted[*root] && records.iter().all(|r| !image.persisted[*r])
+        });
+        if hole {
+            should_be_red += 1;
+            if !judgment.red.is_empty() {
+                should_be_red_and_red += 1;
+            }
+            if example.is_none() {
+                example = Some(image.writes.iter().zip(&image.persisted).skip(30).map(|(w, p)| format!("{}{}", w.kind.name(), if *p { "+" } else { "-" })).collect::<Vec<_>>().join(","));
+            }
+        }
+    });
+    output.line(format!(
+        "name=investigate_order_impl states={states} states_root_persisted_own_records_all_absent={should_be_red} of_those_red_by_any_judgment={should_be_red_and_red} red_by_name={red_by_name:?} example_tail_from_write_30={example:?}"
+    ));
+    0
+}
