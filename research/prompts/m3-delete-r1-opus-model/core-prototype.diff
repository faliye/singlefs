+thread_local! {
+    /// 原型（m3-delete-r1 攻方腿，副本专用，被攻过零轮）：删除批的形状。`Some((保留的单元数 M, 删后 size))` 时，
+    /// 不写文件内容的发布把第一个文件的 extent 截到前 M 个数据单元（从尾部删，M..N 经映射释放）、改写 inode 1 记录的 size。
+    pub static UNLINK_BATCH_FOR_TESTS: std::cell::Cell<Option<(u64, u64)>> = const { std::cell::Cell::new(None) };
+}
+
+fn unlink_batch_for_tests() -> Option<(u64, u64)> {
+    UNLINK_BATCH_FOR_TESTS.with(std::cell::Cell::get)
+}
+
+/// 原型（m3-delete-r1 攻方腿，副本专用，被攻过零轮）：删除的一批——一次发布把第一个文件从尾部截到前 `keep_units` 个数据单元，
+/// inode 1 记录 size 改成 `size_after`、nlink 由 `crate::records::NLINK_ZERO_INODE_FOR_TESTS` 定；数据单元不重写（照抄前 M 个）。
+/// `keep_units` = 0 时 extent 上段那条叶条目写「没有单元」（标签 0）。
+///
+/// # Errors
+/// 同 `publish_new_inodes`。
+pub fn publish_unlink_batch_for_tests<Device: BlockDevice>(
+    pool: &mut PoolWriter<'_, Device>,
+    allocator: &mut PoolAllocator,
+    previous: &TransactionOutput,
+    keep_units: u64,
+    size_after: u64,
+    instance: InstanceGeneration,
+) -> Result<TransactionOutput, PublishError> {
+    let txg = checkpoint_txg_of_the_publish_after(previous.root.checkpoint_txg)?;
+    let transaction_number = previous.highest_transaction_number_in_this_instance + 1;
+    UNLINK_BATCH_FOR_TESTS.with(|cell| cell.set(Some((keep_units, size_after))));
+    let result = publish_version(
+        pool,
+        allocator,
+        PublishPlan {
+            txg,
+            counter: previous.record.counter + 1,
+            transaction: transaction_number,
+            highest_transaction_number_before_this_publish: previous
+                .highest_transaction_number_in_this_instance,
+            instance,
+            back_chain: back_chain_of(&previous.record_bytes),
+            file: None,
+            new_inode_records: &[],
+            instance_table: InstanceTablePlan::Carry(previous.root.instance_table),
+            tree_birth_txg: previous.tree_birth_txg(),
+            tree_identifier_watermark: previous.root.tree_identifier_watermark,
+            rollback_floor: previous.root.rollback_floor,
+        },
+        Some(previous),
+    );
+    UNLINK_BATCH_FOR_TESTS.with(|cell| cell.set(None));
+    result
+}
