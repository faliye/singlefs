C commit-publish-nofence

(*
 * commit-publish 的对照组：去掉屏障。
 *
 * 它存在的唯一目的是**证明上面那个测试有判别力**——
 * 如果这一份也判 Never，说明这个模式本来就撞不上，
 * 那么 commit-publish 判 Never 就什么都没证明。
 *
 * 按 rules/show-me-test.md：不能证明会红的检查等于没写。
 * 对照组就是这条规则在内存序上的形态。
 *
 * singlefs-expect: Sometimes
 *)

{}

P0(int *blk, int *gen)
{
	WRITE_ONCE(*blk, 1);
	WRITE_ONCE(*gen, 1);
}

P1(int *blk, int *gen)
{
	int r0;
	int r1;

	r0 = READ_ONCE(*gen);
	r1 = READ_ONCE(*blk);
}

exists (1:r0=1 /\ 1:r1=0)
