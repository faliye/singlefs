C first-txn-root-implies-units

(*
 * 第一个事务的持久顺序（D16（发布语义） 已定项 7，实现在 crates/singlefs-core 的 transaction::publish_first_file）：
 * 单元 -> 屏障 -> journal 记录 -> 屏障 -> 根槽 FUA。
 * 坏结果 = 恢复择到了新根，却读不到新根引用的单元（层 0 oracle 的「根槽已持久而走读失败」那一格）。
 *
 * P0 = 发布；P1 = 恢复（先择根，再沿树读单元）。屏障写成 smp_wmb，恢复一侧的先后写成 smp_rmb：
 * herd7 判的是这条屏障形态在 LKMM 下的序，不是块层的 FLUSH；块层那一半在虚机里的真设备上验。
 *
 * singlefs-expect: Never
 * singlefs-models: crates/singlefs-core/src/transaction.rs::publish_first_file 写者（P0）
 * singlefs-models: crates/singlefs-core/src/recovery.rs::choose_root 读者（P1：先择根，再沿树读单元）
 *)

{}

P0(int *unit, int *journal, int *root)
{
	WRITE_ONCE(*unit, 1);
	smp_wmb();
	WRITE_ONCE(*journal, 1);
	smp_wmb();
	WRITE_ONCE(*root, 1);
}

P1(int *unit, int *journal, int *root)
{
	int r0;
	int r1;

	r0 = READ_ONCE(*root);
	smp_rmb();
	r1 = READ_ONCE(*unit);
}

exists (1:r0=1 /\ 1:r1=0)
